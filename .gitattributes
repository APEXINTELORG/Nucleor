# Default: text, autoconverted line endings on checkout
* text=auto

# Source files: always LF in the repo
*.nr   text eol=lf
*.c    text eol=lf
*.h    text eol=lf
*.cu   text eol=lf
*.rs   text eol=lf
*.toml text eol=lf
*.tsv  text eol=lf
*.md   text eol=lf
*.json text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
nuc    text eol=lf
tools/examples.list text eol=lf

# The bootstrap IR seed must be byte-identical everywhere. Linux clang
# reads it for stage-1 link, and verify gates compare it against a
# fresh self-host compile. Force LF so Git line-ending conversion
# cannot change the bytes.
*.ll   text eol=lf
*.sh   text eol=lf

# Windows scripts: CRLF
*.bat  text eol=crlf
*.ps1  text eol=crlf

# Binaries
*.exe  binary
*.dll  binary
*.lib  binary
*.wasm binary
*.png  binary
*.jpg  binary
*.gif  binary
