// gen_rt_name_fn.nr — TSV → Nucleor source generator for get_rt_name.
//
// Reads compiler/s1/get_rt_name.tsv (the canonical Nucleor name →
// runtime symbol mapping table) and writes compiler/s1/get_rt_name.gen.nr
// containing the full get_rt_name fn body. compiler/s1/builtins.nr
// imports the generated file in place of an inline definition so the
// 977-line dispatch table never has to be hand-edited or hand-reviewed —
// edits land in the TSV, the generator regenerates the .nr, and the
// drift gate (tools/check_rt_name_table.sh) enforces parity.
//
// Usage: build, then run from the repo root:
//   ./bin/nucleor build tools/gen_rt_name_fn.nr -o gen_rt_name_fn
//   ./target/gen_rt_name_fn
//
// Bootstrap note: the generated file MUST be checked into git. The
// compiler build does NOT invoke this generator — re-running and
// committing the diff is a developer step, gated by the verify drift
// check. This keeps the bootstrap pipeline a single-source build with
// no codegen dependency.

fn main() -> i64 {
    let tsv_path: str = "compiler/s1/get_rt_name.tsv";
    let out_path: str = "compiler/s1/get_rt_name.gen.nr";
    let tsv: str = file_read_string(tsv_path);
    if str_len(tsv) == 0 {
        print(str_concat("ERROR: cannot read ", tsv_path));
        return 1;
    };

    let mut sb: i64 = sb_new_with_cap(50000);
    sb_append(sb, "// AUTO-GENERATED by tools/gen_rt_name_fn.nr from\n");
    sb_append(sb, "// compiler/s1/get_rt_name.tsv. Do not edit by hand —\n");
    sb_append(sb, "// edit the TSV and re-run the generator. Drift is\n");
    sb_append(sb, "// enforced by tools/check_rt_name_table.sh in verify.sh.\n");
    sb_append(sb, "#[manual_drop]\n");
    sb_append(sb, "fn get_rt_name(name: str) -> str {\n");

    let slen: i64 = str_len(tsv);
    let mut p: i64 = 0;
    let mut entries: i64 = 0;
    let mut header_done: i64 = 0;
    while p < slen {
        let mut eol: i64 = p;
        while eol < slen && str_char_at(tsv, eol) != 10 { eol = eol + 1; };
        // Content end trims a trailing CR so a CRLF-checked-out TSV
        // (core.autocrlf=true; *.tsv is pinned eol=lf in .gitattributes,
        // this is defense-in-depth) does not leave \r on the last field.
        // `eol` still points at the LF for advancing p below.
        let mut cend: i64 = eol;
        if cend > p && str_char_at(tsv, cend - 1) == 13 { cend = cend - 1; };
        if cend > p {
            if str_char_at(tsv, p) == 35 {
                // Comment line. The first run of '#' lines is the TSV file
                // header (column key + meta). Skip those; pass through any
                // subsequent comments (which document specific entry
                // clusters in the original get_rt_name body) as // comments.
                if header_done == 1 {
                    sb_append(sb, "    //");
                    if cend - p > 1 {
                        // Drop the leading '#' and the space after it (if any).
                        let mut cstart: i64 = p + 1;
                        if cstart < cend && str_char_at(tsv, cstart) == 32 { cstart = cstart + 1; };
                        sb_append(sb, " ");
                        sb_append(sb, str_substring(tsv, cstart, cend));
                    };
                    sb_append(sb, "\n");
                };
            } else {
                header_done = 1;
                // Find tab separator.
                let mut tab: i64 = p;
                while tab < eol && str_char_at(tsv, tab) != 9 { tab = tab + 1; };
                if tab < eol {
                    let nuc_name: str = str_substring(tsv, p, tab);
                    let rt_name: str = str_substring(tsv, tab + 1, eol);
                    sb_append(sb, "    if str_eq(name, \"");
                    sb_append(sb, nuc_name);
                    sb_append(sb, "\") { return \"");
                    sb_append(sb, rt_name);
                    sb_append(sb, "\"; };\n");
                    entries = entries + 1;
                };
            };
        };
        p = eol + 1;
    };

    sb_append(sb, "    return \"\";\n");
    sb_append(sb, "}\n");

    let out: str = sb_to_str(sb);
    file_write_string(out_path, out);
    print(str_concat("wrote ", out_path));
    print(str_concat("entries: ", str_from_int(entries)));
    return 0;
}
