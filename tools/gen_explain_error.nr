// gen_explain_error.nr — DUP-7: generator for the `nuc explain` text table.
//
// Reads the canonical data file compiler/ts/explain_error.tsv (one row per
// error code: code <TAB> title <TAB> summary <TAB> explanation <TAB> steps,
// where `steps` is unit-separator (0x1F) joined and the text fields are stored
// in Nucleor source-literal form, i.e. already-escaped) and emits
// compiler/ts/explain_error.gen.nr with the four lookup functions. The data
// lives in ONE place (the TSV); the if-chains are generated, not hand-edited.
// tools/check_explain_error_table.sh round-trips this and `cmp`s the result,
// the same drift-gate pattern as get_rt_name.gen.nr.
#[allow(PERF-3)]

// field-at: return the i-th TAB-separated field of `line` (0-based), or "".
fn ee_field(line: str, idx: i64) -> str {
    let n: i64 = str_len(line);
    let mut start: i64 = 0;
    let mut f: i64 = 0;
    let mut i: i64 = 0;
    while i <= n {
        if i == n || str_char_at(line, i) == 9 {
            if f == idx { return str_substring(line, start, i); };
            f = f + 1;
            start = i + 1;
        };
        i = i + 1;
    };
    return "";
}

fn ee_emit_str_fn(sb: i64, fnname: str, lines: Vec<i32>, field: i64) {
    sb_append(sb, "#[manual_drop]\nfn ");
    sb_append(sb, fnname);
    sb_append(sb, "(code: str) -> str {\n");
    let mut i: i64 = 0;
    while i < vec_len(lines) {
        let line: str = vec_get(lines, i);
        if str_len(line) > 0 {
            let code: str = ee_field(line, 0);
            let val: str = ee_field(line, field);
            sb_append(sb, "    if str_eq(code, \"");
            sb_append(sb, code);
            sb_append(sb, "\") { return \"");
            sb_append(sb, val);
            sb_append(sb, "\"; };\n");
        };
        i = i + 1;
    };
    sb_append(sb, "    return \"\";\n}\n\n");
}

fn main() -> i64 {
    let src: str = file_read_string("compiler/ts/explain_error.tsv");
    // split into lines
    let lines: Vec<str> = Vec::new();
    let n: i64 = str_len(src);
    let mut start: i64 = 0;
    let mut i: i64 = 0;
    while i <= n {
        if i == n || str_char_at(src, i) == 10 {
            if i > start { lines.push(str_substring(src, start, i)); };
            start = i + 1;
        };
        i = i + 1;
    };

    let mut sb: i64 = sb_new();
    sb_append(sb, "// AUTO-GENERATED by tools/gen_explain_error.nr from\n");
    sb_append(sb, "// compiler/ts/explain_error.tsv — DO NOT EDIT BY HAND.\n");
    sb_append(sb, "// Edit the .tsv and regenerate; tools/check_explain_error_table.sh\n");
    sb_append(sb, "// gates that this file stays in sync with the .tsv.\n");
    sb_append(sb, "#[allow(PERF-3)]\n\n");

    ee_emit_str_fn(sb, "explain_error_title", lines, 1);
    ee_emit_str_fn(sb, "explain_error_summary", lines, 2);
    ee_emit_str_fn(sb, "explain_error_explanation", lines, 3);

    // next_steps: per-code push blocks (codes with a non-empty steps field).
    sb_append(sb, "#[manual_drop]\nfn explain_error_next_steps(code: str) -> Vec<i32> {\n");
    sb_append(sb, "    let mut steps: Vec<i32> = Vec::new();\n");
    i = 0;
    while i < vec_len(lines) {
        let line: str = vec_get(lines, i);
        let steps_field: str = ee_field(line, 4);
        if str_len(steps_field) > 0 {
            let code: str = ee_field(line, 0);
            sb_append(sb, "    if str_eq(code, \"");
            sb_append(sb, code);
            sb_append(sb, "\") {\n");
            // split steps_field on 0x1F
            let sl: i64 = str_len(steps_field);
            let mut s0: i64 = 0;
            let mut k: i64 = 0;
            while k <= sl {
                if k == sl || str_char_at(steps_field, k) == 31 {
                    if k > s0 {
                        sb_append(sb, "        steps.push(\"");
                        sb_append(sb, str_substring(steps_field, s0, k));
                        sb_append(sb, "\");\n");
                    };
                    s0 = k + 1;
                };
                k = k + 1;
            };
            sb_append(sb, "    };\n");
        };
        i = i + 1;
    };
    sb_append(sb, "    return steps;\n}\n");

    file_write_string("compiler/ts/explain_error.gen.nr", sb_to_str(sb));
    print("wrote compiler/ts/explain_error.gen.nr\n");
    return 0;
}
