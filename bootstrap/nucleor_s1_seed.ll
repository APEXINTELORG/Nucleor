@.str.5412 = private unnamed_addr constant [6 x i8] c"#[no_\00"
@.str.5413 = private unnamed_addr constant [7 x i8] c"alloc]\00"
@.str.5414 = private unnamed_addr constant [7 x i8] c"panic]\00"
