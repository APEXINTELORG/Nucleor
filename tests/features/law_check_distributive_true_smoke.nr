// R14 Phase 3b: distributive_over is now a bounded integer law
// generated by `nuc test --check-laws`.
//
// Expected plain run: rc=0.
// Expected with `nuc test --check-laws`: rc=0 plus generated
// distributive_over checks.

@law(commutative, associative, identity = 0)
fn add_law(a: i64, b: i64) -> i64 {
    return a + b;
}

@law(commutative, associative, identity = 1, absorbing = 0, distributive_over = add_law)
fn mul_law(a: i64, b: i64) -> i64 {
    return a * b;
}

fn main() -> i64 {
    if mul_law(2, add_law(3, 5)) != add_law(mul_law(2, 3), mul_law(2, 5)) { return 1; };
    if mul_law(add_law(2, 3), 5) != add_law(mul_law(2, 5), mul_law(3, 5)) { return 2; };
    return 0;
}
