// T1.9 (v0.2.337) smoke: `nuc test` discovers #[test] functions
// and reports PASS for each. Run via `nuc test`; the harness
// generated by the compiler invokes each test fn and prints
// PASS / FAIL per name.

#[test]
fn test_arithmetic_addition() {
    assert_eq(2 + 3, 5);
}

#[test]
fn test_arithmetic_subtraction() {
    assert_eq(10 - 4, 6);
}

#[test]
fn test_assert_ne_distinct() {
    assert_ne(7, 8);
}

#[test]
fn test_division() {
    assert_eq(20 / 4, 5);
    assert_ne(20 / 4, 6);
}

// T1.1 ↔ T1.9 cross-compiler narrow-width regression guard.
// Strict arithmetic now traps on implicit u8 overflow; keep the
// runner coverage by spelling the intended wrap explicitly.
#[test]
fn test_narrow_wrap_u8_in_test_fn() {
    let a: i64 = 250;
    let b: i64 = 10;
    let c: i64 = wrapping_add_u8(a, b);
    assert_eq(c, 4);
}

fn main() -> i64 { return 0; }
