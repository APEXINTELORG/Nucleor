// rods/fsp — Bipedal footstep planner.
//
// Discrete A* search over reachable footstep poses with a user-
// supplied action set + terrain-validity callback. Foundation for
// bipedal locomotion planning where the front-end picks where each
// foot lands and the back-end (e.g., a whole-body controller)
// realizes the steps.
//
// State: (x, y, θ, foot ∈ {LEFT=0, RIGHT=1}). Successors are
// generated by applying each registered action — an offset
// (dx, dy, dθ) in the stance foot's frame. The y-component is
// mirrored when the stance foot is the right foot, so the action
// set is written once in left-foot coordinates and gives symmetric
// gait patterns in both directions.
//
// Workflow:
//
//   import "stdlib/rods/fsp.nr"
//
//   let h = fsp_new();
//
//   // Optionally tune discretization + goal tolerances.
//   //   defaults: res_xy=0.05 m, res_theta=5°
//   //             goal_tol_xy=0.10 m, goal_tol_theta=10°
//   fsp_set_resolution(h, res_xy_b, res_theta_b);
//   fsp_set_goal_tolerance(h, tol_xy_b, tol_t_b);
//
//   // Register the action set: each action is (dx, dy, dθ, cost)
//   // in the LEFT stance foot's frame. Will be mirrored for right
//   // stance.
//   fsp_add_action(h, dx_b, dy_b, dtheta_b, cost_b);
//   ...
//
//   // Plan from (x0, y0, θ0, foot0) to (xg, yg, θg).
//   //   valid_fp is fn(x_b, y_b, theta_b) -> i64; returns 1 if the
//   //   foot placement is allowed at (x, y, θ), 0 if not.
//   let n = fsp_plan(h, x0_b, y0_b, t0_b, foot0,
//                       xg_b, yg_b, tg_b,
//                       max_iters, valid_fp);
//
//   // Read back the footstep sequence (length n; index 0 is start).
//   for i in 0..n {
//       let x_b = fsp_path_x(h, i);
//       let y_b = fsp_path_y(h, i);
//       let t_b = fsp_path_theta(h, i);
//       let f   = fsp_path_foot(h, i);  // 0 = LEFT, 1 = RIGHT
//   }
//
//   fsp_free(h);
//
// Limitations (mid-stance trajectories / smoothed gait /
// dynamic stability constraints land in v0.6 if needed):
// - Static (geometric) planning only — no dynamics or ZMP/CoM
//   constraints. The output is a sequence of foot placements, not
//   a feasible whole-body trajectory.
// - Per-step cost = action.cost + Euclidean(prev → next); no
//   per-step terrain cost (would need a separate cost callback).
// - Hash table is capped at 1M slots; plenty for typical room-
//   scale plans (< 10k expansions).
//
// See `stdlib/runtime/fsp_rt.c`.
#cfile "../runtime/fsp_rt.c"

extern fn nuc_fsp_new() -> i64;
extern fn nuc_fsp_set_resolution(h: i64, res_xy_b: i64, res_theta_b: i64);
extern fn nuc_fsp_set_goal_tolerance(h: i64, tol_xy_b: i64, tol_t_b: i64);
extern fn nuc_fsp_add_action(h: i64,
    dx_b: i64, dy_b: i64, dtheta_b: i64, cost_b: i64) -> i64;
extern fn nuc_fsp_plan(h: i64,
    x0_b: i64, y0_b: i64, t0_b: i64, foot0: i64,
    xg_b: i64, yg_b: i64, tg_b: i64,
    max_iters: i64, valid_fp: i64) -> i64;
extern fn nuc_fsp_path_len(h: i64) -> i64;
extern fn nuc_fsp_path_x(h: i64, i: i64) -> i64;
extern fn nuc_fsp_path_y(h: i64, i: i64) -> i64;
extern fn nuc_fsp_path_theta(h: i64, i: i64) -> i64;
extern fn nuc_fsp_path_foot(h: i64, i: i64) -> i64;
extern fn nuc_fsp_path_cost(h: i64) -> i64;
extern fn nuc_fsp_free(h: i64);

fn fsp_new() -> i64 { return nuc_fsp_new(); }

// Override default discretization (defaults: res_xy=0.05 m,
// res_theta=5°). Smaller values yield finer resolution at the cost
// of a larger search space.
fn fsp_set_resolution(h: i64, res_xy_b: i64, res_theta_b: i64) {
    nuc_fsp_set_resolution(h, res_xy_b, res_theta_b);
}

// Override default goal tolerances (defaults: tol_xy=0.10 m,
// tol_theta=10°).
fn fsp_set_goal_tolerance(h: i64, tol_xy_b: i64, tol_t_b: i64) {
    nuc_fsp_set_goal_tolerance(h, tol_xy_b, tol_t_b);
}

// Register one footstep action: an offset (dx, dy, dθ) in the
// left stance foot's frame, with a base cost. The dy component is
// auto-mirrored for right stance, so write actions assuming the
// stance foot is the LEFT foot.
fn fsp_add_action(h: i64, dx_b: i64, dy_b: i64, dtheta_b: i64, cost_b: i64) -> i64 {
    return nuc_fsp_add_action(h, dx_b, dy_b, dtheta_b, cost_b);
}

// Plan from (x0, y0, θ0, foot0) to (xg, yg, θg). Returns the
// path length (number of footsteps including start; ≥ 1 on success;
// 0 on failure). `valid_fp` is `fn(x_b, y_b, theta_b) -> i64` and
// must return 1 if the foot placement at (x, y, θ) is allowed,
// 0 otherwise.
fn fsp_plan(h: i64,
    x0_b: i64, y0_b: i64, t0_b: i64, foot0: i64,
    xg_b: i64, yg_b: i64, tg_b: i64,
    max_iters: i64, valid_fp: i64) -> i64
{
    return nuc_fsp_plan(h, x0_b, y0_b, t0_b, foot0,
        xg_b, yg_b, tg_b, max_iters, valid_fp);
}

fn fsp_path_len(h: i64) -> i64 { return nuc_fsp_path_len(h); }
fn fsp_path_x(h: i64, i: i64) -> i64 { return nuc_fsp_path_x(h, i); }
fn fsp_path_y(h: i64, i: i64) -> i64 { return nuc_fsp_path_y(h, i); }
fn fsp_path_theta(h: i64, i: i64) -> i64 { return nuc_fsp_path_theta(h, i); }
fn fsp_path_foot(h: i64, i: i64) -> i64 { return nuc_fsp_path_foot(h, i); }
fn fsp_path_cost(h: i64) -> i64 { return nuc_fsp_path_cost(h); }

fn fsp_free(h: i64) { nuc_fsp_free(h); }
