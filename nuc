#!/usr/bin/env bash
# nuc — Nucleor CLI launcher (POSIX)
#
# Mirrors nuc.bat behavior for Linux / macOS / BSD. Resolves clang onto PATH
# if not already there, then execs bin/nucleor with all arguments passed
# through verbatim.
#
# Configuration via environment:
#   NUCLEOR_CLANG_PATH   — explicit path to clang binary
#   LLVM_SYS_180_PREFIX  — LLVM 18 prefix (bin/clang expected inside)
#   NUCLEOR_ROOT         — override repo root (defaults to script dir)
#   NUCLEOR_BIN          — override binary path (defaults to $ROOT/bin/nucleor)
#   NO_COLOR             — disable ANSI color output (standard)

set -u

ROOT="${NUCLEOR_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)}"
BIN="${NUCLEOR_BIN:-$ROOT/bin/nucleor}"

# --- Resolve clang onto PATH if not already there ---
# Resolution order (matches docs/milestones/v0.3.0.md phase 2):
#   1. $NUCLEOR_CLANG_PATH      — explicit override
#   2. $LLVM_SYS_180_PREFIX/bin — Rust-toolchain-style prefix env
#   3. Linux distro paths       — /usr/lib/llvm-18, /usr/bin/clang-18, /usr/bin/clang
#   4. macOS Homebrew paths     — Apple Silicon then Intel, both versioned + unversioned
clang_resolved=""
if command -v clang >/dev/null 2>&1; then
    clang_resolved="$(command -v clang)"
elif [ -n "${NUCLEOR_CLANG_PATH:-}" ] && [ -x "${NUCLEOR_CLANG_PATH}" ]; then
    export PATH="$(dirname "$NUCLEOR_CLANG_PATH"):$PATH"
    clang_resolved="$NUCLEOR_CLANG_PATH"
elif [ -n "${LLVM_SYS_180_PREFIX:-}" ] && [ -x "${LLVM_SYS_180_PREFIX}/bin/clang" ]; then
    export PATH="${LLVM_SYS_180_PREFIX}/bin:$PATH"
    clang_resolved="${LLVM_SYS_180_PREFIX}/bin/clang"
elif [ -x "/usr/lib/llvm-18/bin/clang" ]; then
    export PATH="/usr/lib/llvm-18/bin:$PATH"
    clang_resolved="/usr/lib/llvm-18/bin/clang"
elif [ -x "/usr/lib/llvm-17/bin/clang" ]; then
    export PATH="/usr/lib/llvm-17/bin:$PATH"
    clang_resolved="/usr/lib/llvm-17/bin/clang"
elif [ -x "/usr/bin/clang-18" ]; then
    export PATH="/usr/bin:$PATH"
    clang_resolved="/usr/bin/clang-18"
elif [ -x "/usr/bin/clang" ]; then
    export PATH="/usr/bin:$PATH"
    clang_resolved="/usr/bin/clang"
elif [ -x "/opt/homebrew/opt/llvm@18/bin/clang" ]; then
    export PATH="/opt/homebrew/opt/llvm@18/bin:$PATH"
    clang_resolved="/opt/homebrew/opt/llvm@18/bin/clang"
elif [ -x "/opt/homebrew/opt/llvm/bin/clang" ]; then
    export PATH="/opt/homebrew/opt/llvm/bin:$PATH"
    clang_resolved="/opt/homebrew/opt/llvm/bin/clang"
elif [ -x "/usr/local/opt/llvm@18/bin/clang" ]; then
    export PATH="/usr/local/opt/llvm@18/bin:$PATH"
    clang_resolved="/usr/local/opt/llvm@18/bin/clang"
elif [ -x "/usr/local/opt/llvm/bin/clang" ]; then
    export PATH="/usr/local/opt/llvm/bin:$PATH"
    clang_resolved="/usr/local/opt/llvm/bin/clang"
fi

# --- Fail fast with install instructions if clang is needed but missing ---
# Skip the clang check for subcommands that don't need it (help, --version,
# any --help/-h, etc.) so users can self-diagnose without LLVM installed.
needs_clang=1
case "${1:-}" in
    ""|help|--help|-h|--version|-V|version) needs_clang=0 ;;
esac

if [ "$needs_clang" -eq 1 ] && [ -z "$clang_resolved" ]; then
    cat >&2 <<EOF
nuc: clang not found.

Nucleor needs LLVM 18 (or 17) clang to link compiled output. Install
one of the following for your platform:

  Ubuntu / Debian:    sudo apt install clang-18
  Fedora:             sudo dnf install clang
  Arch / Manjaro:     sudo pacman -S clang
  macOS (Homebrew):   brew install llvm@18

If clang is installed at a non-standard location, set:
  export NUCLEOR_CLANG_PATH=/path/to/clang

Resolution chain attempted (none of these existed):
  - \$NUCLEOR_CLANG_PATH       — not set or invalid
  - \$LLVM_SYS_180_PREFIX/bin  — not set or invalid
  - /usr/lib/llvm-18/bin/clang
  - /usr/lib/llvm-17/bin/clang
  - /usr/bin/clang-18
  - /usr/bin/clang
  - /opt/homebrew/opt/llvm@18/bin/clang  (macOS Apple Silicon)
  - /opt/homebrew/opt/llvm/bin/clang
  - /usr/local/opt/llvm@18/bin/clang     (macOS Intel)
  - /usr/local/opt/llvm/bin/clang

EOF
    exit 1
fi

# --- Launch the compiler binary ---
if [ ! -x "$BIN" ]; then
    cat >&2 <<EOF
nuc: compiler binary not found at $BIN

Nucleor v0.2.x ships a Windows x86_64 binary only. Native Linux and
macOS binaries are scoped for v0.3.0 — see
$ROOT/docs/milestones/v0.3.0.md.

Workarounds in the interim:
  1. Run the Windows binary through Wine (experimental):
       wine $ROOT/bin/nucleor.exe "\$@"
  2. Bootstrap from source on Linux (requires LLVM 18 + an existing
     bin/nucleor.exe to stage from):
       see $ROOT/docs/milestones/v0.3.0.md phase 1
  3. Use the Windows release on a Windows host.

EOF
    exit 1
fi

exec "$BIN" "$@"
