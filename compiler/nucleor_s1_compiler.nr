                let lhs_name_assign_v840: str = node_field(pool, lhs, 1);
                if frame_mismatch_visible(lhs_t, rhs_t) == 1 {
                    let f_action_assign_v840: str = str_concat("cannot assign to '", str_concat(lhs_name_assign_v840, "'"));
