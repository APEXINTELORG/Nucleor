    // v0.4.37 RFC-0028 phase 5: `{:X}` upper-case hex helper.
    if str_eq(name, "int_to_hex_upper") { return "__nucleor_int_to_hex_upper"; };
    // v0.4.38 RFC-0028 phase 5: `{:e}` / `{:E}` scientific notation for f64.
