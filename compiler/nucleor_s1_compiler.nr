            if str_eq(init_t, "void") == 0 && node_kind(pool, init) == 7 {
                let init_callee_v064: str = node_field(pool, init, 1);
                if str_eq(init_callee_v064, "vec_pop") == 1 {
                    init_t = "void";
                };
