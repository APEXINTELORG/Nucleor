            let op_fixed_v091: str = if op == 20 { "+" } else if op == 21 { "-" } else if op == 22 { "*" } else if op == 23 { "/" } else { "%" };
            if lt_fixed_v091 == 1 && rt_fixed_v091 == 1 {
