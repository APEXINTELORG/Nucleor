                if n1 != 92 && n2 == 39 {
                    tokens.push(tok_new(2, n1, st));
                    p = p + 3;
                    handled = 1;
                };
            };
            if handled == 0 && p + 3 < slen && str_char_at(src, p + 1) == 92 && str_char_at(src, p + 3) == 39 {
                let esc: i64 = str_char_at(src, p + 2);
                let mut val: i64 = esc;
                if esc == 110 { val = 10; };       // \n
                if esc == 116 { val = 9; };        // \t
                if esc == 114 { val = 13; };       // \r
                if esc == 48  { val = 0; };        // \0
                if esc == 92  { val = 92; };       // \\
                if esc == 39  { val = 39; };       // \'
                if esc == 34  { val = 34; };       // \"
