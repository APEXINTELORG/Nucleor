                        let g6_has_hm: i64 = if str_index_of(g6_atype, "HashMap<") >= 0 { 1 } else { 0 };
                        let g6_has_refcell: i64 = if str_index_of(g6_atype, "RefCell<") >= 0 { 1 } else { 0 };
                        let g6_has_cell: i64 = if str_index_of(g6_atype, "Cell<") >= 0 { 1 } else { 0 };
