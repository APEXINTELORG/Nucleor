// =====================================================
// Nucleor Stage 1 Compiler
// =====================================================
// A complete Nucleor compiler written in Nucleor.
// Reads a .nr source file, compiles it through:
//   source -> lex -> parse -> lower -> emit LLVM IR -> clang -> native exe
// Usage: nucleor_s1 <source.nr> <output_name>
// =====================================================

// T1.1 Phase 3c (v0.2.310): widened internal arithmetic to i64 so
// large register IDs and IR constant values (up to i64 max) are
// formatted correctly. The parameter remains `i32` for source
// compatibility; arithmetic moves to i64 to avoid Phase 1's
// narrow-as-i32 hook truncating values that exceed i32 range.
// v0.4.72: doc-#2 §5 P1 — str_from_int(i32) signature was lying.
// Body handled i64::MIN, but the param is declared i32. Nucleor's
// i64-everywhere ABI lets i64 values flow through the i32 param at
// runtime — so the i64::MIN branch IS reachable. Added str_from_i64
// as the truthful entry point; str_from_int kept as a wrapper for
// backward compat. No call-site changes required; adopters who want
// to be type-honest can switch to str_from_i64 going forward.
fn str_from_i64(n: i64) -> str {
    if n == 0 { return "0"; };
    // v0.3.146: handle i64::MIN specially. `0 - MIN_I64` overflows
    // back to MIN_I64 (because -MIN_I64 = MAX_I64 + 1, doesn't fit
    // in signed i64). Pre-fix, the `while val > 0` loop never executed
    // because val stayed negative — `s` ended as `""`, then the `n < 0`
    // branch prepended `"-"` and we returned just `"-"`. Any const-fold
    // that produced MIN_I64 (e.g. `i64::MAX + 1`) emitted invalid IR.
    // Detect MIN_I64 without using its literal: `n < -MAX_I64` is
    // only true when n == MIN_I64.
    let neg_max: i64 = 0 - 9223372036854775807;
    if n < neg_max { return "-9223372036854775808"; };
    let mut val: i64 = n;
    if val < 0 { val = 0 - val; };
    let mut s: str = "";
    while val > 0 {
        let d: i64 = val - (val / 10) * 10;
        let mut ch: str = "0";
        if d == 1 { ch = "1"; } else if d == 2 { ch = "2"; } else if d == 3 { ch = "3"; }
        else if d == 4 { ch = "4"; } else if d == 5 { ch = "5"; } else if d == 6 { ch = "6"; }
        else if d == 7 { ch = "7"; } else if d == 8 { ch = "8"; } else if d == 9 { ch = "9"; };
        s = str_concat(ch, s);
        val = val / 10;
    };
    if n < 0 { s = str_concat("-", s); };
    return s;
}

// v0.5 (v0.4.233 integration) — declared param widened i32 → i64.
// Nucleor's i64-everywhere ABI passes the arg as i64; the body
// forwards to `str_from_i64`. The pre-fix `i32` was a known-bug
// workaround kept after v0.4.221's phase 3c trunc-on-entry attempt
// broke self-build, and was the sole driver of the cross-width
// audit surface (1734 hits in compiler self-build, 1291 in
// tools-suite). One-line cleanup; required substrate for the
// typed-param-alloca restore below.
fn str_from_int(n: i64) -> str {
    return str_from_i64(n);
}
fn str_to_int(s: str) -> i64 {
    // v0.3.208: wrap arithmetic via wrapping_mul/add so that large
    // literals like u64::MAX (18446744073709551615) parse correctly
    // under strict-arithmetic mode without panicking. The accumulator
    // is intentionally allowed to wrap into the negative i64 range
    // (the resulting bit pattern is what u64 callers want anyway).
    let slen: i64 = str_len(s);
    let mut result: i64 = 0;
    let mut i: i64 = 0;
    let mut neg: i64 = 0;
    if slen > 0 && str_char_at(s, 0) == 45 { neg = 1; i = 1; };
    while i < slen {
        result = wrapping_add(wrapping_mul(result, 10), str_char_at(s, i) - 48);
        i = i + 1;
    };
    if neg == 1 { return 0 - result; };
    return result;
}
fn str_is_digits(s: str) -> i64 {
    let slen: i64 = str_len(s);
    if slen == 0 { return 0; };
    let mut i: i64 = 0;
    while i < slen {
        let c: i64 = str_char_at(s, i);
        if c < 48 || c > 57 { return 0; };
        i = i + 1;
    };
    return 1;
}

// =====================================================
// LEXER (from T29, unchanged)
// =====================================================
fn tok_new(tt: i64, v: i64, p: i64) -> Vec<i32> {
    let mut t: Vec<i32> = Vec::with_capacity(3); t.push(tt); t.push(v); t.push(p); return t;
}
fn tok_type(t: Vec<i32>) -> i64 { return vec_get(t, 0); }
fn tok_val(t: Vec<i32>) -> i64 { return vec_get(t, 1); }
fn tok_pos(t: Vec<i32>) -> i64 { return vec_get(t, 2); }
fn is_ws(c: i64) -> i64 { if c == 32 || c == 9 || c == 10 || c == 13 { return 1; }; return 0; }
fn is_digit(c: i64) -> i64 { if c >= 48 && c <= 57 { return 1; }; return 0; }
fn is_alpha(c: i64) -> i64 {
    if c >= 65 && c <= 90 { return 1; }; if c >= 97 && c <= 122 { return 1; };
    if c == 95 { return 1; }; return 0;
}
fn is_alnum(c: i64) -> i64 { if is_alpha(c) == 1 || is_digit(c) == 1 { return 1; }; return 0; }
fn classify_kw(w: str) -> i64 {
    if str_eq(w, "fn") { return 10; }; if str_eq(w, "let") { return 11; };
    if str_eq(w, "mut") { return 12; }; if str_eq(w, "if") { return 13; };
    if str_eq(w, "else") { return 14; }; if str_eq(w, "while") { return 15; };
    if str_eq(w, "return") { return 16; }; if str_eq(w, "struct") { return 17; };
    if str_eq(w, "break") { return 18; }; if str_eq(w, "continue") { return 19; };
    if str_eq(w, "extern") { return 20; };
    if str_eq(w, "for") { return 56; }; if str_eq(w, "in") { return 57; };
    if str_eq(w, "enum") { return 62; }; if str_eq(w, "match") { return 63; };
    if str_eq(w, "trait") { return 66; }; if str_eq(w, "impl") { return 67; };
    // v0.3.137: `pure` is contextual — only a keyword when followed by `fn`.
    // Pre-v0.3.137, classifying `pure` as kw 68 unconditionally meant a user
    // fn or call site named `pure(...)` lexed to a non-identifier token,
    // parse_primary silently fell through to its `int_lit 0` default, and
    // the entire call was replaced by 0 in the IR with NO diagnostic.
    // Same hazard class as the v0.3.126 user-fn shadowing bug — silent
    // miscompute for any adopter who happens to name a fn `pure`. The
    // `pure fn` declaration form is recognised in parse_program by
    // checking `pkv == "pure" && pk(cp+1) == 10`, so the modifier still
    // works without paying the contextual-keyword tax in expression
    // position. See tests/fixtures/t411_user_fn_named_pure.nr.
    if str_eq(w, "pub") { return 72; };
    if str_eq(w, "const") { return 73; };
    if str_eq(w, "type") { return 74; };
    // v0.3.139: `requires` is contextual — only meaningful as a fn-decl
    // annotation (`fn foo() -> T requires [<predicate>]`) per RFC-0030.
    // Pre-v0.3.139, classifying it as kw 75 unconditionally triggered the
    // same silent-miscompute trap as the v0.3.137 `pure` and v0.3.138
    // `scope`/`spawn` fixes — `parse_primary` had no branch for token 75
    // and silently fell through to its `int_lit 0` default. Any user fn
    // or call site named `requires` (e.g. auth gates `requires_admin`,
    // capability checks, type-class witness fns) collapsed to constant 0
    // in the IR with no diagnostic. The 4 `pk(...) == 75` annotation
    // checks in parse_fn_decl / parse_extern_fn / parse_trait_method /
    // parse_impl_method are rewritten to identifier-with-pkv lookahead
    // so the annotation form still works.
    // v0.3.140: removed `restricts` kw classification. Same hazard
    // class as v0.3.137 `pure`, v0.3.138 `scope`/`spawn`, v0.3.139
    // `requires` — `restricts [...] { ... }` was a planned RFC-0030
    // contract-block form that had ZERO usage in stdlib, examples,
    // tests, or docs. The kw classification still forced the lexer
    // to refuse the name as identifier, and parse_primary's branch
    // for token 76 (skip_bracket_list + parse_passthrough_block_expr)
    // mangled `restricts(x)` call sites — bracket-list skip silently
    // returned pos unchanged when it found `(` instead of `[`, and
    // parse_passthrough_block_expr swallowed the rest of main's body
    // into a phantom block expression. Result: silent miscompute,
    // returns 0 instead of the user fn's return value.
    // v0.3.149: `unsafe` is contextual — only meaningful as the
    // RFC-0003 `unsafe { ... }` block prefix. Pre-v0.3.149, classifying
    // it as kw 77 unconditionally meant a user fn or call site named
    // `unsafe(x)` lex'd to a non-identifier token. parse_primary's
    // tt==77 branch called parse_passthrough_block_expr which expected
    // `{`, found `(` instead, and printed two parse errors -- but the
    // build did NOT halt. Downstream codegen still emitted .ll, clang
    // still linked, and the exe returned 0 instead of the user fn's
    // result. Silent miscompute hidden behind loud-looking but
    // non-fatal parse-error output. Same hazard class as v0.3.137-v0.3.142
    // contextual-kw fixes. Now: lexer emits identifier token 1 with
    // value `"unsafe"`. parse_primary's branch checks pkv lookahead.
    // Block form `unsafe { ... }` continues to work.
    // v0.3.150: `wrapping` and `saturating` are contextual. Pre-fix,
    // both lex'd as hard kw tokens for the RFC overflow-block forms
    // `wrapping { ... }` / `saturating { ... }` -- but parse_primary's
    // tt == 78/79 branches called parse_wrapped_block_expr, which when
    // given `(x)` instead of `{x}` parsed the inner expression as the
    // wrap target and emitted a call to __nucleor_wrap_i32. That helper
    // doesn't exist for the i64 ABI -- adopters writing
    // `fn wrapping(x) { ... }` and calling `wrapping(41)` got a clang
    // LINK error pointing at IR they didn't write. Same hazard class
    // as the v0.3.149 unsafe fix: noisy non-fatal-looking failure mode
    // that doesn't actually halt cleanly. Both names have ZERO block-form
    // usage in the codebase, same as v0.3.140 restricts.
    // v0.3.138: removed reserved-but-unused `scope` (was 80) and
    // `spawn` (was 81) keyword classifications. Same hazard class
    // as the v0.3.137 `pure` fix — the lexer hard-classified these
    // names as keywords, but parse_primary had no branch for tokens
    // 80/81 in expression position so any user fn or call site named
    // `scope` or `spawn` collapsed to silent `int_lit 0` in the IR.
    // Both names are common in user code (RAII helpers, threading /
    // async wrappers, parser combinators) and zero `scope { … }` /
    // `spawn { … }` block-form usage exists in the entire repo —
    // the parse_stmts branch that consumed those tokens was dead.
    // Future RFCs that resurrect block-form `scope { … }` will need
    // contextual lexing (pkv lookahead) instead of hard kw mapping.
    // v0.3.141: `loop` is contextual — only meaningful when followed
    // by `{` (the `loop { BODY }` block form, which desugars to
    // `while true { BODY }`). Pre-v0.3.141, classifying it as kw 84
    // unconditionally triggered the same silent-miscompute trap as
    // the v0.3.137 `pure` / v0.3.138 `scope`/`spawn` / v0.3.139
    // `requires` / v0.3.140 `restricts` fixes — `parse_primary` had
    // no branch for token 84 (the kw branch lived in `parse_stmts`)
    // so any `loop(x)` call site fell through to the `int_lit 0`
    // default and collapsed to a constant 0 in the IR with no
    // diagnostic. The `loop { ... }` stmt-form check in parse_stmts
    // and the top-level kw-at-module-scope rejection in parse_program
    // are rewritten to use pkv lookahead. tests/lang/loop_kw.nr still
    // exercises the canonical block form.
    // v0.3.142: `as` is contextual — only meaningful as a postfix cast
    // operator (`x as T`), which always follows an expression. When `as`
    // appears at the start of a primary expression (e.g. `as(41)` as a
    // user fn call), it MUST be an identifier. Pre-v0.3.142, classifying
    // it as kw 86 unconditionally triggered the same silent-miscompute
    // trap as the v0.3.137 `pure` / v0.3.138 `scope`/`spawn` /
    // v0.3.139 `requires` / v0.3.140 `restricts` / v0.3.141 `loop`
    // fixes — `parse_primary` had no branch for token 86 so any user
    // fn or call site named `as` collapsed to silent `int_lit 0` in
    // the IR with no diagnostic. The cast operator's parse_postfix_cast
    // check is rewritten to use pkv lookahead.
    return 1;
}
fn lex(src: str) -> Vec<i32> {
    let mut tokens: Vec<i32> = Vec::new();
    let slen: i64 = str_len(src);
    let mut p: i64 = 0;
    while p < slen {
        let c: i64 = str_char_at(src, p);
        if is_ws(c) == 1 { p = p + 1; }
        else if c == 64 {
            if p + 1 < slen && is_alnum(str_char_at(src, p + 1)) == 1 {
                // Skip attributes like @authored(...), @policy(...), @hot, @const_fn.
                p = p + 1;
                while p < slen && is_alnum(str_char_at(src, p)) == 1 { p = p + 1; };
                if p < slen && str_char_at(src, p) == 40 {
                    let mut depth: i64 = 1;
                    p = p + 1;
                    while p < slen && depth > 0 {
                        let ch: i64 = str_char_at(src, p);
                        if ch == 34 {
                            p = p + 1;
                            while p < slen && str_char_at(src, p) != 34 {
                                if str_char_at(src, p) == 92 && p + 1 < slen { p = p + 2; }
                                else { p = p + 1; };
                            };
                            if p < slen { p = p + 1; };
                        } else {
                            if ch == 40 { depth = depth + 1; }
                            else if ch == 41 { depth = depth - 1; };
                            p = p + 1;
                        };
                    };
                };
            } else {
                tokens.push(tok_new(122, 0, p));
                p = p + 1;
            };
        }
        else if c == 35 && p + 1 < slen && str_char_at(src, p + 1) == 91 {
            // Rust-style outer attribute: #[name], #[name(args)], #[name = val].
            // Lex-time skip with quoted-string + bracket-depth awareness.
            // Forward-compatible with RFC-0001/0021 attribute family; semantics
            // ship in later RFC implementation phases.
            p = p + 2;
            let mut depth: i64 = 1;
            while p < slen && depth > 0 {
                let ch: i64 = str_char_at(src, p);
                if ch == 34 {
                    p = p + 1;
                    while p < slen && str_char_at(src, p) != 34 {
                        if str_char_at(src, p) == 92 && p + 1 < slen { p = p + 2; }
                        else { p = p + 1; };
                    };
                    if p < slen { p = p + 1; };
                } else {
                    if ch == 91 { depth = depth + 1; }
                    else if ch == 93 { depth = depth - 1; };
                    p = p + 1;
                };
            };
        }
        else if c == 47 && p + 1 < slen && str_char_at(src, p + 1) == 47 {
            while p < slen && str_char_at(src, p) != 10 { p = p + 1; };
        }
        else if c == 92 && p + 1 < slen && str_char_at(src, p + 1) == 32 {
            while p < slen && str_char_at(src, p) != 10 { p = p + 1; };
        }
        else if is_alpha(c) == 1 {
            let st: i64 = p;
            while p < slen && is_alnum(str_char_at(src, p)) == 1 { p = p + 1; };
            let w: str = str_substring(src, st, p);
            tokens.push(tok_new(classify_kw(w), w, st));
        }
        else if is_digit(c) == 1 {
            // RFC-0015 phase 1+5: integer/float lexer with hex/oct/bin literals,
            // underscores, and type suffixes.
            //   0x... = hex   (e.g., 0xAB, 0xFFFF_FFFF)
            //   0o... = octal (e.g., 0o777)
            //   0b... = binary (e.g., 0b1010_0001)
            //   Otherwise decimal.
            // Recognised suffixes: i8 i16 i32 i64 i128 isize u8 u16 u32 u64 u128
            // usize (lexed; full type-check arrives in later phases).
            let st: i64 = p;
            let mut int_value: i64 = 0;
            let mut handled_radix: i64 = 0;
            // Detect 0x / 0o / 0b prefix
            if c == 48 && p + 1 < slen {
                let nx: i64 = str_char_at(src, p + 1);
                if nx == 120 || nx == 88 {
                    // hex -- v0.3.208: wrapping_* lets 0xFFFFFFFFFFFFFFFF
                    // (and other 64-bit-MAX-aligned literals) parse under
                    // strict-arithmetic mode. The accumulator is meant to
                    // wrap; the resulting bit pattern is what callers want.
                    p = p + 2;
                    while p < slen {
                        let hc: i64 = str_char_at(src, p);
                        if hc == 95 { p = p + 1; }
                        else if hc >= 48 && hc <= 57 { int_value = wrapping_add(wrapping_mul(int_value, 16), hc - 48); p = p + 1; }
                        else if hc >= 97 && hc <= 102 { int_value = wrapping_add(wrapping_mul(int_value, 16), hc - 87); p = p + 1; }
                        else if hc >= 65 && hc <= 70 { int_value = wrapping_add(wrapping_mul(int_value, 16), hc - 55); p = p + 1; }
                        else { break; };
                    };
                    handled_radix = 1;
                } else if nx == 111 || nx == 79 {
                    // octal -- v0.3.208: wrapping_* (see hex path).
                    p = p + 2;
                    while p < slen {
                        let oc: i64 = str_char_at(src, p);
                        if oc == 95 { p = p + 1; }
                        else if oc >= 48 && oc <= 55 { int_value = wrapping_add(wrapping_mul(int_value, 8), oc - 48); p = p + 1; }
                        else { break; };
                    };
                    handled_radix = 1;
                } else if nx == 98 || nx == 66 {
                    // binary -- v0.3.208: wrapping_* (see hex path).
                    p = p + 2;
                    while p < slen {
                        let bc: i64 = str_char_at(src, p);
                        if bc == 95 { p = p + 1; }
                        else if bc == 48 { int_value = wrapping_mul(int_value, 2); p = p + 1; }
                        else if bc == 49 { int_value = wrapping_add(wrapping_mul(int_value, 2), 1); p = p + 1; }
                        else { break; };
                    };
                    handled_radix = 1;
                };
            };
            let mut digit_sb: i64 = sb_new();
            if handled_radix == 0 {
                while p < slen && (is_digit(str_char_at(src, p)) == 1 || str_char_at(src, p) == 95) {
                    if str_char_at(src, p) != 95 {
                        sb_append(digit_sb, str_substring(src, p, p + 1));
                    };
                    p = p + 1;
                };
            };
            // v0.5.24: digits-only e/E exponent (no fractional dot).
            // Closes part of probe finding 2026-05-01-float-to-int-cast-out-of-range-silent-ub
            // — probe's repro `let big: f64 = 1e20;` actually demonstrated
            // a LEXER bug, not the saturating-cast UB it claimed (the
            // saturating cast already works correctly per v0.3.208 et al.).
            // Pre-fix `1e20` lexed as int 1 + ident `e20`; the let-binding
            // type-coerced to f64 = 1.0. Now `<digits>e<digits>` lexes as a
            // float literal directly (Rust accepts both `1e20` and `1.0e20`).
            // The detection is gated on the CHARACTER AFTER digits being
            // 'e'/'E' followed by an optional sign + at least one digit;
            // identifier-shaped suffixes like `e_helper` still lex as
            // ident.
            let mut digits_only_exp: i64 = 0;
            if handled_radix == 0 && p < slen && (str_char_at(src, p) == 101 || str_char_at(src, p) == 69) {
                let mut probe_p: i64 = p + 1;
                if probe_p < slen {
                    let sign_ch_p: i64 = str_char_at(src, probe_p);
                    if sign_ch_p == 43 || sign_ch_p == 45 { probe_p = probe_p + 1; };
                };
                if probe_p < slen && is_digit(str_char_at(src, probe_p)) == 1 {
                    digits_only_exp = 1;
                };
            };
            if digits_only_exp == 1 {
                // Promote to f64 raw-bits path. Construct the literal text
                // as `<digits>e<+/->? <digits>` and let str_to_f64 (strtod)
                // parse it.
                let lit_st: i64 = st;
                let exp_st_p: i64 = p;
                let mut exp_p: i64 = p + 1;
                if exp_p < slen {
                    let sign_ch_e: i64 = str_char_at(src, exp_p);
                    if sign_ch_e == 43 || sign_ch_e == 45 { exp_p = exp_p + 1; };
                };
                while exp_p < slen && is_digit(str_char_at(src, exp_p)) == 1 { exp_p = exp_p + 1; };
                let lit_text: str = str_substring(src, lit_st, exp_p);
                let bits: i64 = str_to_f64(lit_text);
                tokens.push(tok_new(124, bits, lit_st));
                p = exp_p;
                continue;
            };
            // Check for f64 literal: digits DOT digits
            if p < slen && str_char_at(src, p) == 46 && p + 1 < slen && is_digit(str_char_at(src, p + 1)) == 1 {
                // f64 literal — parse integer.fraction, encode as bitcast i64
                let int_part: i64 = str_to_int(sb_to_str(digit_sb));
                p = p + 1; // skip dot
                let frac_st: i64 = p;
                let mut frac_sb: i64 = sb_new();
                while p < slen && (is_digit(str_char_at(src, p)) == 1 || str_char_at(src, p) == 95) {
                    if str_char_at(src, p) != 95 {
                        sb_append(frac_sb, str_substring(src, p, p + 1));
                    };
                    p = p + 1;
                };
                let raw_frac_str: str = sb_to_str(frac_sb);
                // v0.3.130: NUC-FEEDBACK-005 — truncate fractional digits to
                // the encoder's 6-digit (millionth) precision BEFORE
                // computing frac_div. The truncate path handles literals
                // where the first 6 frac digits carry meaningful value.
                //
                // v0.3.133: NUC-FEEDBACK-006 — for SUB-MICRO literals
                // (`0.00000001` = 1e-8 used as AdamW eps, etc.), the
                // first 6 frac digits are all '0' and truncation still
                // produces zero. Falling back to the runtime
                // `__nucleor_str_to_f64` parser via the str_to_f64
                // helper gives full IEEE-754 precision. The bit
                // pattern is stored as token kind 124 (raw-bits f64
                // literal); parse_primary emits AST kind 72 which
                // lower_expr emits as a direct const_int (no
                // f64_from_scaled divide needed since the value IS
                // already the f64 bit pattern).
                //
                // v0.3.197: NUC-FEEDBACK-005 corrected — the all-zero
                // gate was too narrow. Long literals with non-zero
                // first six digits like `0.7978845608028654` still
                // fell into the truncate-to-six path and silently lost
                // 10+ decimal digits of precision (the literal became
                // `0.797884` after divide-by-1e6). Promote ANY literal
                // with more than six fractional digits to the raw-bits
                // path. Short literals (≤ 6 frac digits) still use the
                // scaled-int path — frac_div is an exact power of ten,
                // so the runtime divide rounds once to the closest f64
                // (same precision an IEEE parser would give).
                // v0.4.220: scientific notation (e/E exponent). Pre-fix
                // `1.0e30` lexed as `1.0` then identifier-`e` then int-30,
                // silently truncating the value to 1.0 and surfacing as a
                // bizarre downstream type error or as `big as i32 = 1`
                // (the user's reported f64-out-of-range repro). Adopters
                // writing canonical Rust literals (`1.0e10`, `2.5e-3`, etc.)
                // got silent miscomputes.
                // Detect e/E after fractional digits, consume optional sign
                // + digits, append to literal text, and force the raw-bits
                // path so str_to_f64 (strtod) parses with full precision.
                let mut exp_str: str = "";
                if p < slen {
                    let exp_ch: i64 = str_char_at(src, p);
                    if exp_ch == 101 || exp_ch == 69 {
                        let exp_st: i64 = p;
                        let mut exp_p: i64 = p + 1;
                        if exp_p < slen {
                            let sign_ch: i64 = str_char_at(src, exp_p);
                            if sign_ch == 43 || sign_ch == 45 { exp_p = exp_p + 1; };
                        };
                        let mut has_exp_digits: i64 = 0;
                        while exp_p < slen && is_digit(str_char_at(src, exp_p)) == 1 {
                            has_exp_digits = 1;
                            exp_p = exp_p + 1;
                        };
                        if has_exp_digits == 1 {
                            exp_str = str_substring(src, exp_st, exp_p);
                            p = exp_p;
                        };
                    };
                };
                let raw_frac_len: i64 = str_len(raw_frac_str);
                let mut use_raw_bits: i64 = 0;
                if raw_frac_len > 6 { use_raw_bits = 1; };
                if str_len(exp_str) > 0 { use_raw_bits = 1; };
                if use_raw_bits == 1 {
                    let lit_text: str = str_concat(str_from_int(int_part), str_concat(".", str_concat(raw_frac_str, exp_str)));
                    let bits: i64 = str_to_f64(lit_text);
                    tokens.push(tok_new(124, bits, st));
                } else {
                    let frac_str: str = if raw_frac_len > 6 { str_substring(raw_frac_str, 0, 6) } else { raw_frac_str };
                    let frac_val: i64 = str_to_int(frac_str);
                    let frac_len: i64 = str_len(frac_str);
                    // Compute frac_divisor = 10^frac_len
                    let mut frac_div: i64 = 1;
                    let mut fi: i64 = 0;
                    while fi < frac_len { frac_div = frac_div * 10; fi = fi + 1; };
                    // Encode: store int_part and frac as token type 70 (f64 literal)
                    // Value = int_part * 1000000 + frac_val * (1000000 / frac_div)
                    let encoded: i64 = int_part * 1000000 + frac_val * (1000000 / frac_div);
                    tokens.push(tok_new(70, encoded, st));
                };
                // Consume optional float suffix: f32 or f64
                if p < slen && str_char_at(src, p) == 102 {
                    let suf_st: i64 = p;
                    while p < slen && is_alnum(str_char_at(src, p)) == 1 { p = p + 1; };
                    let suf: str = str_substring(src, suf_st, p);
                    if str_eq(suf, "f32") == 0 && str_eq(suf, "f64") == 0 {
                        // Not actually a suffix; rewind.
                        p = suf_st;
                    } else if str_eq(suf, "f32") == 1 {
                        // v0.4.24 (NUC-FEEDBACK-002 fix): rewrite the just-
                        // emitted token type from 70 (generic float) to 125
                        // (f32-typed) so the parser/lowerer can route the
                        // literal through f32_from_scaled instead of
                        // f64_from_scaled. Pre-fix the f32 suffix was
                        // consumed and discarded -> 1.0f32 silently became
                        // 1.0f64 bits, which when read back as f32 = 0.0
                        // (silent miscompute on Vec<f32> push of literals).
                        let last_tok: Vec<i32> = vec_get(tokens, vec_len(tokens) - 1);
                        vec_set(last_tok, 0, 125);
                    };
                };
                if p < slen && str_char_at(src, p) == 123 {
                    tokens.push(tok_new(83, 0, p));
                    p = p + 1;
                }
            } else {
                // v0.4.119: NUM-021 — decimal literal too wide for u64.
                // Pre-fix `let x: i64 = 99999999999999999999;` (a 20-digit
                // value > u64::MAX) silently wrapped through str_to_int's
                // wrapping_mul/add accumulator, producing
                // 7766279631452241919 — a meaningless garbage bit pattern.
                // Single sb_to_str call (consumes digit_sb), use the
                // string both for the check AND the str_to_int call.
                // Hex/oct/bin literals (handled_radix == 1) keep the
                // existing wrap behavior since their bit pattern is
                // expected.
                let dig_str_v119: str = if handled_radix == 1 { "" } else { sb_to_str(digit_sb) };
                if handled_radix == 0 {
                    let dig_len_v119: i64 = str_len(dig_str_v119);
                    let mut overflow_v119: i64 = 0;
                    if dig_len_v119 > 20 { overflow_v119 = 1; };
                    if dig_len_v119 == 20 {
                        let u64_max_v119: str = "18446744073709551615";
                        let mut cmp_i_v119: i64 = 0;
                        while cmp_i_v119 < 20 {
                            let dc_v119: i64 = str_char_at(dig_str_v119, cmp_i_v119);
                            let mc_v119: i64 = str_char_at(u64_max_v119, cmp_i_v119);
                            if dc_v119 > mc_v119 { overflow_v119 = 1; cmp_i_v119 = 20; }
                            else if dc_v119 < mc_v119 { cmp_i_v119 = 20; }
                            else { cmp_i_v119 = cmp_i_v119 + 1; };
                        };
                    };
                    if overflow_v119 == 1 {
                        panic(str_concat("error[NUM-021]: integer literal `", str_concat(dig_str_v119, "` exceeds u64::MAX (18446744073709551615). Pre-v0.4.119 the value silently wrapped through the str_to_int accumulator and produced a meaningless bit pattern. Use a smaller literal, switch to a wide-int library, or write the value as a hex literal `0x...` if you intentionally want a specific bit pattern."))));
                    };
                };
                let int_lit_value: i64 = if handled_radix == 1 { int_value } else { str_to_int(dig_str_v119) };
                tokens.push(tok_new(2, int_lit_value, st));
                // Consume optional integer suffix: i8 i16 i32 i64 u8 u16 u32 u64 usize isize
                if p < slen && (str_char_at(src, p) == 105 || str_char_at(src, p) == 117) {
                    let suf_st: i64 = p;
                    while p < slen && is_alnum(str_char_at(src, p)) == 1 { p = p + 1; };
                    let suf: str = str_substring(src, suf_st, p);
                    let mut is_known: i64 = 0;
                    if str_eq(suf, "i8") == 1 { is_known = 1; };
                    if str_eq(suf, "i16") == 1 { is_known = 1; };
                    if str_eq(suf, "i32") == 1 { is_known = 1; };
                    if str_eq(suf, "i64") == 1 { is_known = 1; };
                    if str_eq(suf, "i128") == 1 { is_known = 1; };
                    if str_eq(suf, "isize") == 1 { is_known = 1; };
                    if str_eq(suf, "u8") == 1 { is_known = 1; };
                    if str_eq(suf, "u16") == 1 { is_known = 1; };
                    if str_eq(suf, "u32") == 1 { is_known = 1; };
                    if str_eq(suf, "u64") == 1 { is_known = 1; };
                    if str_eq(suf, "u128") == 1 { is_known = 1; };
                    if str_eq(suf, "usize") == 1 { is_known = 1; };
                    if is_known == 0 {
                        // Not actually a suffix; rewind so it lexes as identifier.
                        p = suf_st;
                    };
                };
                if p < slen && str_char_at(src, p) == 123 {
                    tokens.push(tok_new(83, 0, p));
                    p = p + 1;
                }
            };
        }
        else if c == 34 {
            let st: i64 = p; p = p + 1;
            let mut sb: i64 = sb_new();
            while p < slen && str_char_at(src, p) != 34 {
                if str_char_at(src, p) == 92 && p + 1 < slen {
                    let nc: i64 = str_char_at(src, p + 1);
                    if nc == 110 { sb_append(sb, "\n"); } else if nc == 116 { sb_append(sb, "\t"); }
                    else if nc == 34 { sb_append(sb, "\""); } else if nc == 92 { sb_append(sb, "\\"); }
                    else if nc == 114 { sb_append_char(sb, 13); }                          // v0.5.20: \r → CR byte (ASCII 13)
                    else if nc == 48  { sb_append_char(sb, 0); }                           // v0.5.20: \0 → NUL byte (ASCII 0). Closes probe finding 2026-05-01-str-escape-null-byte-silently-literal.
                    else if nc == 39  { sb_append(sb, "'"); }                              // \' — single quote
                    else {
                        // v0.4.121: unknown escape sequence. Pre-fix the
                        // backslash was silently dropped and the next
                        // char emitted as-is — so `"a\zb"` became `"azb"`
                        // with no signal. Adopters typo'ing escapes (or
                        // pasting Rust raw-string content) got silent
                        // miscomputation. Halt cleanly. To opt out and
                        // get the literal next char, escape the
                        // backslash explicitly: `"a\\zb"`.
                        let bad_esc: str = str_substring(src, p, p + 2);
                        panic(str_concat("error[NR025]: unknown escape sequence `", str_concat(bad_esc, "` in string literal. Pre-v0.4.121 the backslash was silently dropped and the next char emitted as-is. Recognized escapes: `\\n`, `\\t`, `\\\"`, `\\\\`, `\\r`, `\\0`, `\\'`. To get a literal backslash + char, escape the backslash explicitly (e.g. `\\\\z`).")));
                    };
                    p = p + 2;
                } else { sb_append(sb, str_substring(src, p, p + 1)); p = p + 1; };
            };
            if p < slen { p = p + 1; };
            tokens.push(tok_new(3, sb_to_str(sb), st));
        }
        else if c == 45 && p + 1 < slen && str_char_at(src, p + 1) == 62 { tokens.push(tok_new(41, 0, p)); p = p + 2; }
        else if c == 61 && p + 1 < slen && str_char_at(src, p + 1) == 61 { tokens.push(tok_new(30, 0, p)); p = p + 2; }
        else if c == 61 && p + 1 < slen && str_char_at(src, p + 1) == 62 { tokens.push(tok_new(64, 0, p)); p = p + 2; }
        else if c == 33 && p + 1 < slen && str_char_at(src, p + 1) == 61 { tokens.push(tok_new(31, 0, p)); p = p + 2; }
        else if c == 60 && p + 1 < slen && str_char_at(src, p + 1) == 61 { tokens.push(tok_new(34, 0, p)); p = p + 2; }
        else if c == 62 && p + 1 < slen && str_char_at(src, p + 1) == 61 { tokens.push(tok_new(35, 0, p)); p = p + 2; }
        else if c == 38 && p + 1 < slen && str_char_at(src, p + 1) == 38 { tokens.push(tok_new(36, 0, p)); p = p + 2; }
        // v0.3.105: bitwise compound assigns. `&=` → token 117,
        // `|=` → 118, `^=` → 119. Lexed BEFORE the bare `&`/`|`/`^`
        // single-token rules below so `&=` doesn't split as `&` `=`.
        // `<<=` and `>>=` follow the same pattern (120/121).
        else if c == 38 && p + 1 < slen && str_char_at(src, p + 1) == 61 { tokens.push(tok_new(117, 0, p)); p = p + 2; }
        else if c == 38 { tokens.push(tok_new(82, 0, p)); p = p + 1; }
        else if c == 124 && p + 1 < slen && str_char_at(src, p + 1) == 124 { tokens.push(tok_new(37, 0, p)); p = p + 2; }
        else if c == 124 && p + 1 < slen && str_char_at(src, p + 1) == 61 { tokens.push(tok_new(118, 0, p)); p = p + 2; }
        else if c == 124 { tokens.push(tok_new(65, 0, p)); p = p + 1; }
        // v0.3.103: bitwise XOR `^` as token 94 — paired with the
        // `parse_bitwise` tier (tier between parse_eq and parse_and_expr)
        // and tok_to_ir mapping (94 → iop 15 = LLVM xor i64).
        else if c == 94 && p + 1 < slen && str_char_at(src, p + 1) == 61 { tokens.push(tok_new(119, 0, p)); p = p + 2; }
        else if c == 94 { tokens.push(tok_new(94, 0, p)); p = p + 1; }
        // v0.3.104: shift-left `<<` as token 115. Shift-right `>>`
        // is intentionally NOT lexed as a single token — generic
        // syntax `Vec<Vec<i64>>` ends in `>>` and the seven angle-
        // group skips would all need updating to handle the merged
        // form. Instead, parse_shift detects two adjacent `>` tokens
        // and consumes both as shift-right at parse time. `<<` has
        // no such conflict so a single token is safe here.
        else if c == 60 && p + 2 < slen && str_char_at(src, p + 1) == 60 && str_char_at(src, p + 2) == 61 { tokens.push(tok_new(120, 0, p)); p = p + 3; }
        else if c == 60 && p + 1 < slen && str_char_at(src, p + 1) == 60 { tokens.push(tok_new(115, 0, p)); p = p + 2; }
        // v0.3.105: `>>=` lexed as a single token 121 — has no
        // conflict with generics because `>>=` (3 chars) doesn't
        // appear in any valid generic-position form.
        else if c == 62 && p + 2 < slen && str_char_at(src, p + 1) == 62 && str_char_at(src, p + 2) == 61 { tokens.push(tok_new(121, 0, p)); p = p + 3; }
        else if c == 58 && p + 1 < slen && str_char_at(src, p + 1) == 58 { tokens.push(tok_new(46, 0, p)); p = p + 2; }
        // v0.3.77: compound-assignment tokens (`+=`, `-=`, `*=`, `/=`, `%=`).
        // Lex as single tokens kind 110-114 so the parser can desugar
        // `LHS op= RHS` to `LHS = LHS op RHS` cleanly. Without this,
        // `x += 5;` lexed as separate `+` and `=` tokens which the parser
        // dropped silently. Token kinds 110/111/112/113/114 are reserved
        // for the five compound-op forms in op-token order.
        else if c == 43 && p + 1 < slen && str_char_at(src, p + 1) == 61 { tokens.push(tok_new(110, 0, p)); p = p + 2; }
        else if c == 43 { tokens.push(tok_new(20, 0, p)); p = p + 1; }
        else if c == 45 && p + 1 < slen && str_char_at(src, p + 1) == 61 { tokens.push(tok_new(111, 0, p)); p = p + 2; }
        else if c == 45 { tokens.push(tok_new(21, 0, p)); p = p + 1; }
        else if c == 42 && p + 1 < slen && str_char_at(src, p + 1) == 61 { tokens.push(tok_new(112, 0, p)); p = p + 2; }
        else if c == 42 { tokens.push(tok_new(22, 0, p)); p = p + 1; }
        else if c == 47 && p + 1 < slen && str_char_at(src, p + 1) == 61 { tokens.push(tok_new(113, 0, p)); p = p + 2; }
        else if c == 47 { tokens.push(tok_new(23, 0, p)); p = p + 1; }
        else if c == 37 && p + 1 < slen && str_char_at(src, p + 1) == 61 { tokens.push(tok_new(114, 0, p)); p = p + 2; }
        else if c == 37 { tokens.push(tok_new(24, 0, p)); p = p + 1; }
        else if c == 61 { tokens.push(tok_new(40, 0, p)); p = p + 1; }
        else if c == 60 { tokens.push(tok_new(32, 0, p)); p = p + 1; }
        else if c == 62 { tokens.push(tok_new(33, 0, p)); p = p + 1; }
        else if c == 33 { tokens.push(tok_new(38, 0, p)); p = p + 1; }
        else if c == 58 { tokens.push(tok_new(42, 0, p)); p = p + 1; }
        else if c == 59 { tokens.push(tok_new(43, 0, p)); p = p + 1; }
        else if c == 44 { tokens.push(tok_new(44, 0, p)); p = p + 1; }
        else if c == 46 && p + 1 < slen && str_char_at(src, p + 1) == 46 && p + 2 < slen && str_char_at(src, p + 2) == 61 {
            // ..= inclusive range
            tokens.push(tok_new(96, 0, p));
            p = p + 3;
        }
        else if c == 46 && p + 1 < slen && str_char_at(src, p + 1) == 46 { tokens.push(tok_new(58, 0, p)); p = p + 2; }
        else if c == 46 { tokens.push(tok_new(45, 0, p)); p = p + 1; }
        else if c == 40 { tokens.push(tok_new(50, 0, p)); p = p + 1; }
        else if c == 41 { tokens.push(tok_new(51, 0, p)); p = p + 1; }
        else if c == 123 { tokens.push(tok_new(52, 0, p)); p = p + 1; }
        else if c == 125 { tokens.push(tok_new(53, 0, p)); p = p + 1; }
        else if c == 91 { tokens.push(tok_new(54, 0, p)); p = p + 1; }
        else if c == 93 { tokens.push(tok_new(55, 0, p)); p = p + 1; }
        else if c == 63 { tokens.push(tok_new(97, 0, p)); p = p + 1; }
        else if c == 39 {
            // v0.3.105: char literals `'X'` and escape forms
            // `'\n'`/`'\t'`/`'\r'`/`'\0'`/`'\\'`/`'\''`. Emit as int
            // literal (token kind 2 with the codepoint as the value)
            // — matches Rust semantics where `'A' as i64 == 65` and
            // matches the convention documented at the prior
            // lifetime-only branch ("chars use u8/u32 via int literals").
            // Pre-v0.3.105, `'\n'` was lexed as a malformed lifetime
            // marker and silently produced 0 at runtime, a HIGH-blast
            // miscompute for any code using char escapes (parsers,
            // I/O, ASCII manipulation). Lifetime parsing is preserved
            // as the fallback when the pattern doesn't match
            // `'<one-char>'`.
            let st: i64 = p;
            // Try to recognize a char literal first.
            let mut handled: i64 = 0;
            if p + 2 < slen {
                let n1: i64 = str_char_at(src, p + 1);
                let n2: i64 = str_char_at(src, p + 2);
                // Plain `'X'` form — single non-backslash char.
                if n1 != 92 && n2 == 39 {
                    tokens.push(tok_new(2, n1, st));
                    p = p + 3;
                    handled = 1;
                };
            };
            if handled == 0 && p + 3 < slen && str_char_at(src, p + 1) == 92 && str_char_at(src, p + 3) == 39 {
                let esc: i64 = str_char_at(src, p + 2);
                let mut val: i64 = esc;
                if esc == 110 { val = 10; };       // \n
                if esc == 116 { val = 9; };        // \t
                if esc == 114 { val = 13; };       // \r
                if esc == 48  { val = 0; };        // \0
                if esc == 92  { val = 92; };       // \\
                if esc == 39  { val = 39; };       // \'
                if esc == 34  { val = 34; };       // \"
                tokens.push(tok_new(2, val, st));
                p = p + 4;
                handled = 1;
            };
            if handled == 0 {
                // T2.5 (v0.2.351) fallback: apostrophe → lifetime token.
                p = p + 1;
                let id_st: i64 = p;
                while p < slen && (is_alnum(str_char_at(src, p)) == 1 || str_char_at(src, p) == 95) { p = p + 1; };
                let lt_name: str = str_substring(src, id_st, p);
                tokens.push(tok_new(98, lt_name, st));
            };
        }
        else { p = p + 1; };
    };
    tokens.push(tok_new(0, 0, slen));
    return tokens;
}
fn tok_at(tokens: Vec<i32>, idx: i64) -> Vec<i32> {
    if idx >= vec_len(tokens) { return tok_new(0, 0, 0); }; return vec_get(tokens, idx);
}
fn tok_type_at(tokens: Vec<i32>, idx: i64) -> i64 { return tok_type(tok_at(tokens, idx)); }
fn tok_val_at(tokens: Vec<i32>, idx: i64) -> i64 { return tok_val(tok_at(tokens, idx)); }

// =====================================================
// PARSER (from T29, unchanged)
// =====================================================
fn node_add(pool: Vec<i32>, nd: Vec<i32>) -> i64 { let nid: i64 = vec_len(pool); pool.push(nd); return nid; }
fn node_kind(pool: Vec<i32>, nid: i64) -> i64 { let nd: Vec<i32> = vec_get(pool, nid); return vec_get(nd, 0); }
fn node_field(pool: Vec<i32>, nid: i64, idx: i64) -> i64 { let nd: Vec<i32> = vec_get(pool, nid); return vec_get(nd, idx); }
fn node_span_sentinel() -> i64 { return 0 - 873521; }
fn node_set_span(pool: Vec<i32>, nid: i64, byte_off: i64) -> i64 {
    if nid < 0 || nid >= vec_len(pool) { return nid; };
    if byte_off < 0 { return nid; };
    if node_kind(pool, nid) == 40 { return nid; };
    let nd: Vec<i32> = vec_get(pool, nid);
    nd.push(node_span_sentinel());
    nd.push(byte_off);
    return nid;
}
fn node_get_span(pool: Vec<i32>, nid: i64) -> i64 {
    if nid < 0 || nid >= vec_len(pool) { return 0 - 1; };
    if node_kind(pool, nid) == 40 { return 0 - 1; };
    let nd: Vec<i32> = vec_get(pool, nid);
    let n: i64 = vec_len(nd);
    if n >= 3 && vec_get(nd, n - 2) == node_span_sentinel() { return vec_get(nd, n - 1); };
    return 0 - 1;
}
fn mk2(pool: Vec<i32>, k: i64, a: i64) -> i64 { let mut n: Vec<i32> = Vec::with_capacity(2); n.push(k); n.push(a); return node_add(pool, n); }
fn mk3(pool: Vec<i32>, k: i64, a: i64, b: i64) -> i64 { let mut n: Vec<i32> = Vec::with_capacity(3); n.push(k); n.push(a); n.push(b); return node_add(pool, n); }
fn mk4(pool: Vec<i32>, k: i64, a: i64, b: i64, c: i64) -> i64 { let mut n: Vec<i32> = Vec::with_capacity(4); n.push(k); n.push(a); n.push(b); n.push(c); return node_add(pool, n); }
fn mk5(pool: Vec<i32>, k: i64, a: i64, b: i64, c: i64, d: i64) -> i64 { let mut n: Vec<i32> = Vec::with_capacity(5); n.push(k); n.push(a); n.push(b); n.push(c); n.push(d); return node_add(pool, n); }
fn mk6(pool: Vec<i32>, k: i64, a: i64, b: i64, c: i64, d: i64, e: i64) -> i64 { let mut n: Vec<i32> = Vec::with_capacity(6); n.push(k); n.push(a); n.push(b); n.push(c); n.push(d); n.push(e); return node_add(pool, n); }
fn mk_list(pool: Vec<i32>, items: Vec<i32>) -> i64 {
    let mut n: Vec<i32> = Vec::with_capacity(vec_len(items) + 1); n.push(40);
    let mut i: i64 = 0; while i < vec_len(items) { n.push(vec_get(items, i)); i = i + 1; };
    return node_add(pool, n);
}
fn list_len(pool: Vec<i32>, lid: i64) -> i64 { let nd: Vec<i32> = vec_get(pool, lid); return vec_len(nd) - 1; }
fn list_get(pool: Vec<i32>, lid: i64, idx: i64) -> i64 { let nd: Vec<i32> = vec_get(pool, lid); return vec_get(nd, idx + 1); }

fn free_token_vec(tokens: Vec<i32>) -> i64 {
    let mut i: i64 = 0;
    while i < vec_len(tokens) {
        let tok: Vec<i32> = vec_get(tokens, i);
        vec_free(tok);
        i = i + 1;
    };
    vec_free(tokens);
    return 0;
}

fn free_node_pool(pool: Vec<i32>) -> i64 {
    let mut i: i64 = 0;
    while i < vec_len(pool) {
        let nd: Vec<i32> = vec_get(pool, i);
        vec_free(nd);
        i = i + 1;
    };
    vec_free(pool);
    return 0;
}

fn pr(p: i64, v: i64) -> Vec<i32> { let mut r: Vec<i32> = Vec::with_capacity(2); r.push(p); r.push(v); return r; }
fn pr_pos(r: Vec<i32>) -> i64 { return vec_get(r, 0); }
fn pr_val(r: Vec<i32>) -> i64 { return vec_get(r, 1); }

fn pk(tokens: Vec<i32>, pos: i64) -> i64 { return tok_type_at(tokens, pos); }
fn pkv(tokens: Vec<i32>, pos: i64) -> i64 { return tok_val_at(tokens, pos); }
fn tok_pos_at(tokens: Vec<i32>, idx: i64) -> i64 { return tok_pos(tok_at(tokens, idx)); }
// v0.4.208: human-readable names for the most common NR020 tokens.
// Closes two findings (tuple-struct-decl-panic + match-on-unit-panic)
// which both surfaced as "expected token N got M" with raw IDs.
// Trimmed to the high-impact punct/keyword set to avoid bloating
// the compiler binary; less-common tokens fall back to "token N".
fn tok_name(tt: i64) -> str {
    if tt == 0 { return "<EOF>"; };
    if tt == 1 { return "identifier"; };
    if tt == 2 { return "integer literal"; };
    if tt == 3 { return "string literal"; };
    if tt == 40 { return "`=`"; };
    if tt == 41 { return "`->`"; };
    if tt == 42 { return "`:`"; };
    if tt == 43 { return "`;`"; };
    if tt == 44 { return "`,`"; };
    if tt == 50 { return "`(`"; };
    if tt == 51 { return "`)`"; };
    if tt == 52 { return "`{`"; };
    if tt == 53 { return "`}`"; };
    if tt == 54 { return "`[`"; };
    if tt == 55 { return "`]`"; };
    if tt == 64 { return "`=>`"; };
    if tt == 70 { return "float literal"; };
    return str_concat("token ", str_from_int(tt));
}

fn expect_tok(tokens: Vec<i32>, pos: i64, tt: i64) -> i64 {
    if pk(tokens, pos) != tt {
        // v0.4.78 NR020 — was a `print()` warning that returned `pos + 1`
        // and continued parsing. The parser produced a likely-broken AST,
        // type-check + lower happily consumed it, and codegen emitted a
        // silently-wrong binary. Triaged via the `@` binding pattern
        // probe (`x @ 1..=10`) which printed a parse error AND ran to
        // exit=0 with no output. Promoted to a hard panic — adopters
        // who hit this previously shipped broken binaries.
        // v0.4.208: emit token-name table output instead of raw IDs.
        // Pre-fix message: "expected token 52 got 50" — opaque.
        // Post-fix: "expected `{` got `(`" — actionable.
        let tok: Vec<i32> = tok_at(tokens, pos);
        let byte_pos: i64 = vec_get(tok, 2);
        let got_tt: i64 = pk(tokens, pos);
        panic(str_concat("error[NR020]: parse error at byte ", str_concat(str_from_int(byte_pos), str_concat(": expected ", str_concat(tok_name(tt), str_concat(", got ", str_concat(tok_name(got_tt), ". Pre-v0.4.78 this printed a warning and continued, producing a likely-broken binary; v0.4.208 added token names to make the diagnostic actionable.")))))));
    };
    return pos + 1;
}

fn parse_args(tokens: Vec<i32>, pos: i64, pool: Vec<i32>) -> Vec<i32> {
    let mut args: Vec<i32> = Vec::new();
    let mut cp: i64 = pos;
    if pk(tokens, cp) != 51 {
        let mut r: Vec<i32> = parse_expr(tokens, cp, pool);
        args.push(pr_val(r)); cp = pr_pos(r);
        while pk(tokens, cp) == 44 {
            if pk(tokens, cp + 1) == 51 { cp = cp + 1; }
            else {
                r = parse_expr(tokens, cp + 1, pool); args.push(pr_val(r)); cp = pr_pos(r);
            };
        };
    };
    return pr(cp + 1, mk_list(pool, args));
}

fn skip_bracket_list(tokens: Vec<i32>, pos: i64) -> i64 {
    let mut cp: i64 = expect_tok(tokens, pos, 54);
    let mut depth: i64 = 1;
    while depth > 0 && pk(tokens, cp) != 0 {
        if pk(tokens, cp) == 54 { depth = depth + 1; }
        else if pk(tokens, cp) == 55 { depth = depth - 1; };
        cp = cp + 1;
    };
    return cp;
}

fn skip_effect_clause(tokens: Vec<i32>, pos: i64) -> i64 {
    if pk(tokens, pos) == 1 && str_eq(pkv(tokens, pos), "with") == 1 {
        return skip_bracket_list(tokens, pos + 1);
    };
    return pos;
}

fn skip_angle_group(tokens: Vec<i32>, pos: i64) -> i64 {
    if pk(tokens, pos) != 32 { return pos; };
    let mut cp: i64 = pos + 1;
    let mut depth: i64 = 1;
    while depth > 0 && pk(tokens, cp) != 0 {
        let tt: i64 = pk(tokens, cp);
        if depth == 1 {
            if tt == 2 || tt == 3 || tt == 40 || tt == 41 || tt == 43 || tt == 52 || tt == 53 || tt == 54 || tt == 55 || tt == 64 { return pos; };
            if tt == 30 || tt == 31 || tt == 34 || tt == 35 || tt == 36 || tt == 37 || tt == 38 || tt == 39 { return pos; };
        };
        if tt == 32 { depth = depth + 1; }
        else if tt == 33 { depth = depth - 1; };
        cp = cp + 1;
    };
    if depth != 0 { return pos; };
    if pk(tokens, cp) == 50 || pk(tokens, cp) == 52 || pk(tokens, cp) == 46 { return cp; };
    return pos;
}

fn skip_where_clause(tokens: Vec<i32>, pos: i64) -> i64 {
    let mut cp: i64 = pos;
    if pk(tokens, cp) == 1 && str_eq(pkv(tokens, cp), "where") == 1 {
        cp = cp + 1;
        while pk(tokens, cp) != 52 && pk(tokens, cp) != 43 && pk(tokens, cp) != 0 {
            cp = cp + 1;
        };
    };
    return cp;
}

fn parse_match_binding_block(tokens: Vec<i32>, pos: i64) -> Vec<i32> {
    let mut cp: i64 = pos;
    let mut binding: str = "";
    while pk(tokens, cp) != 53 && pk(tokens, cp) != 0 {
        if str_len(binding) > 0 {
            cp = expect_tok(tokens, cp, 44);
            if pk(tokens, cp) == 53 { break; };
            binding = str_concat(binding, "|");
        };
        let mut name: str = pkv(tokens, cp);
        cp = cp + 1;
        if pk(tokens, cp) == 42 {
            cp = cp + 1;
            name = pkv(tokens, cp);
            cp = cp + 1;
        };
        binding = str_concat(binding, name);
    };
    cp = expect_tok(tokens, cp, 53);
    return pr(cp, binding);
}

fn str_find_char_local(s: str, ch: i64) -> i64 {
    let slen: i64 = str_len(s);
    let mut i: i64 = 0;
    while i < slen {
        if str_char_at(s, i) == ch { return i; };
        i = i + 1;
    };
    return 0 - 1;
}

fn str_before_char_local(s: str, ch: i64) -> str {
    let p: i64 = str_find_char_local(s, ch);
    if p < 0 { return s; };
    return str_substring(s, 0, p);
}

fn str_after_char_local(s: str, ch: i64) -> str {
    let p: i64 = str_find_char_local(s, ch);
    if p < 0 { return ""; };
    return str_substring(s, p + 1, str_len(s));
}

fn pattern_append_binding(binding: str, piece: str) -> str {
    if str_len(piece) == 0 { return binding; };
    if str_len(binding) == 0 { return piece; };
    return str_concat(binding, str_concat("|", piece));
}

fn pattern_prepend_at_binding(binding: str, at_name: str) -> str {
    if str_len(at_name) == 0 { return binding; };
    let head: str = str_concat("@", at_name);
    if str_len(binding) == 0 { return head; };
    return str_concat(head, str_concat("|", binding));
}

fn pattern_binding_item_name(item: str) -> str {
    if str_len(item) == 0 { return ""; };
    if str_eq(item, "_") == 1 || str_eq(item, "..") == 1 { return ""; };
    let mut s: str = item;
    if str_char_at(s, 0) == 64 { s = str_substring(s, 1, str_len(s)); };
    let colon: i64 = str_find_char_local(s, 58);
    if colon >= 0 { s = str_substring(s, colon + 1, str_len(s)); };
    if str_eq(s, "_") == 1 || str_eq(s, "..") == 1 { return ""; };
    return s;
}

fn pattern_binding_key_from_list(binding: str) -> str {
    let blen: i64 = str_len(binding);
    let mut key: str = "";
    let mut start: i64 = 0;
    while start < blen {
        let mut end: i64 = start;
        while end < blen && str_char_at(binding, end) != 124 { end = end + 1; };
        let item: str = str_substring(binding, start, end);
        let name: str = pattern_binding_item_name(item);
        key = pattern_append_binding(key, name);
        start = end + 1;
    };
    return key;
}

fn pattern_binding_key(ename: str, binding: str) -> str {
    if str_eq(ename, "__range") == 1 || str_eq(ename, "__range_bad") == 1 { return ""; };
    if str_eq(ename, "__range_at") == 1 || str_eq(ename, "__range_bad_at") == 1 {
        return pattern_binding_key_from_list(str_after_char_local(binding, 124));
    };
    return pattern_binding_key_from_list(binding);
}

fn parse_match_struct_binding_block(tokens: Vec<i32>, pos: i64) -> Vec<i32> {
    let mut cp: i64 = pos;
    let mut binding: str = "";
    while pk(tokens, cp) != 53 && pk(tokens, cp) != 0 {
        if str_len(binding) > 0 {
            cp = expect_tok(tokens, cp, 44);
            if pk(tokens, cp) == 53 { break; };
        };
        let fname: str = pkv(tokens, cp);
        let mut bname: str = fname;
        cp = cp + 1;
        if pk(tokens, cp) == 42 {
            cp = cp + 1;
            // v0.4.163 MATCH-012 — pre-fix `Point { x: 0, y: 0 } => ...` fed the
            // raw int-literal value into pkv (which returns i64) and bound it as
            // a str to `bname`, producing garbage that crashed codegen with an
            // ACCESS VIOLATION. Now: require an identifier after `:` and emit a
            // clean diagnostic if anything else appears. Field-equality literal
            // patterns (`{ field: <literal> }`) are deferred to v0.5+.
            if pk(tokens, cp) != 1 {
                // v0.4.276 — fold the dual print+panic into a single
                // panic() carrying the full diag text. Matches the
                // MATCH-013 pattern (line ~1040). Probe finding
                // 2026-04-30: pre-fix adopters saw "error[MATCH-012]:
                // ..." followed by a duplicate "PANIC: nucleor:
                // MATCH-012..." line. Single panic eliminates the
                // stutter; the leading "PANIC: " prefix from the
                // runtime helper remains (removing that requires
                // adding a `diag_halt` runtime helper that exits
                // without the prefix — deferred follow-up).
                panic("error[MATCH-012]: struct pattern field after `:` must be an identifier (rename-binding form, e.g. `Point { x: rename }`). Field-equality literal patterns like `Point { x: 0, y: 0 }` are not yet supported — match the field with a binding (`Point { x, y }`) and use a guard `if x == 0 && y == 0 => ...` instead.");
            };
            bname = pkv(tokens, cp);
            cp = cp + 1;
        };
        binding = pattern_append_binding(binding, str_concat(fname, str_concat(":", bname)));
    };
    cp = expect_tok(tokens, cp, 53);
    return pr(cp, binding);
}

fn parse_match_list_binding(tokens: Vec<i32>, pos: i64, end_tok: i64, allow_rest: i64) -> Vec<i32> {
    let mut cp: i64 = pos;
    let mut binding: str = "";
    let mut saw_rest: i64 = 0;
    while pk(tokens, cp) != end_tok && pk(tokens, cp) != 0 {
        if str_len(binding) > 0 {
            cp = expect_tok(tokens, cp, 44);
            if pk(tokens, cp) == end_tok { break; };
        };
        let mut piece: str = "";
        if allow_rest == 1 && pk(tokens, cp) == 58 {
            if saw_rest == 1 {
                print("error[MATCH-009]: slice pattern contains more than one `..` rest marker");
                panic("nucleor: MATCH-009 slice pattern overlap");
            };
            piece = "..";
            saw_rest = 1;
            cp = cp + 1;
        } else if pk(tokens, cp) == 1 {
            piece = pkv(tokens, cp);
            cp = cp + 1;
        } else {
            print("error[MATCH-009]: only identifier, `_`, and `..` elements are supported in tuple/slice patterns");
            panic("nucleor: unsupported tuple/slice pattern element");
        };
        binding = pattern_append_binding(binding, piece);
    };
    cp = expect_tok(tokens, cp, end_tok);
    return pr(cp, binding);
}

fn parse_match_one_pattern(tokens: Vec<i32>, pos: i64, pool: Vec<i32>) -> Vec<i32> {
    let mut cp: i64 = pos;
    let mut at_name: str = "";
    if pk(tokens, cp) == 1 && pk(tokens, cp + 1) == 122 {
        at_name = pkv(tokens, cp);
        cp = cp + 2;
    };
    let att: i64 = pk(tokens, cp);
    // v0.4.206: reject float-literal patterns at parse time.
    // Pre-fix `match <f64> { 1.5 => ..., _ => ... }` (or any
    // float-lit pattern) crashed the compiler with ACCESS_VIOLATION
    // (Windows -1073741819 / SIGSEGV) — the parser fell through to
    // the wildcard branch (line 1034) which assigned `binding`
    // to `pkv(...)` of the float-lit token (an i64 bit pattern,
    // not a str ptr); a downstream str op then dereferenced the
    // i64 as a heap address. Float equality patterns are fragile
    // (NaN ≠ NaN; round-off drift) so this is the right intentional
    // rejection — Rust forbids float patterns since 1.0.
    // Catches at parse time so the rejection fires regardless of
    // scrutinee type (`match 1.5 { 1.5 => ... }` and `match x { 1.5
    // => ... }` both halt cleanly).
    // Tokens: 70 = f-suffix-typed lit, 124 = f64 raw-bits lit,
    // 125 = f32 lit. All three trigger the same hazard.
    if att == 70 || att == 124 || att == 125 {
        panic("error[MATCH-013]: float-literal pattern in `match` arm is not supported. Float equality is fragile (NaN ≠ NaN; round-off drift means literal-equality matches surprise-fail), so pattern-matching on `f32`/`f64` values has no defined semantics here. Pre-v0.4.206 the compiler crashed with ACCESS_VIOLATION (no diagnostic) attempting to lower the float-lit pattern. Use an `if`-chain (`if (x - 1.5).abs() < 0.001 { ... }`) for tolerance-based comparison, or convert via `(x * 100.0) as i32` to match on integer scaled values.");
    };
    let mut ename: str = "";
    let mut vname: str = "";
    let mut binding: str = "";
    if att == 2 {
        let lo_val: i64 = pkv(tokens, cp);
        cp = cp + 1;
        let next_tok: i64 = pk(tokens, cp);
        if next_tok == 96 || next_tok == 58 {
            let inclusive: i64 = if next_tok == 96 { 1 } else { 0 };
            cp = cp + 1;
            if pk(tokens, cp) == 2 {
                let hi_raw: i64 = pkv(tokens, cp);
                cp = cp + 1;
                let hi_norm: i64 = if inclusive == 1 { hi_raw } else { hi_raw - 1 };
                if lo_val <= hi_norm { ename = "__range"; } else { ename = "__range_bad"; };
                vname = lo_val;
                binding = str_from_int(hi_norm);
            } else {
                ename = "__int";
                vname = lo_val;
            };
        } else {
            ename = "__int";
            vname = lo_val;
        };
    } else if att == 3 {
        ename = "__str";
        vname = pkv(tokens, cp);
        cp = cp + 1;
    } else if att == 1 && str_eq(pkv(tokens, cp), "_") == 1 {
        ename = "__wild";
        cp = cp + 1;
    } else if att == 1 && pk(tokens, cp + 1) == 46 {
        ename = pkv(tokens, cp);
        cp = expect_tok(tokens, cp + 1, 46);
        vname = pkv(tokens, cp); cp = cp + 1;
        if pk(tokens, cp) == 50 {
            cp = cp + 1;
            let mut first: i64 = 1;
            while pk(tokens, cp) != 51 && pk(tokens, cp) != 0 {
                if first == 0 { cp = expect_tok(tokens, cp, 44); };
                let bn: str = pkv(tokens, cp); cp = cp + 1;
                binding = pattern_append_binding(binding, bn);
                first = 0;
            };
            cp = expect_tok(tokens, cp, 51);
        } else if pk(tokens, cp) == 52 {
            let mut br: Vec<i32> = parse_match_binding_block(tokens, cp + 1);
            binding = pr_val(br);
            cp = pr_pos(br);
        };
    } else if att == 1 && pk(tokens, cp + 1) == 45 {
        ename = pkv(tokens, cp);
        cp = cp + 2;
        vname = pkv(tokens, cp); cp = cp + 1;
        if pk(tokens, cp) == 50 {
            cp = cp + 1;
            binding = pkv(tokens, cp); cp = cp + 1;
            cp = expect_tok(tokens, cp, 51);
        } else if pk(tokens, cp) == 52 {
            let mut br: Vec<i32> = parse_match_binding_block(tokens, cp + 1);
            binding = pr_val(br);
            cp = pr_pos(br);
        };
    } else if att == 1 && pk(tokens, cp + 1) == 52
        && str_eq(pkv(tokens, cp), "Some") == 0
        && str_eq(pkv(tokens, cp), "None") == 0
        && str_eq(pkv(tokens, cp), "Ok") == 0
        && str_eq(pkv(tokens, cp), "Err") == 0 {
        ename = "__struct";
        vname = pkv(tokens, cp);
        let mut br: Vec<i32> = parse_match_struct_binding_block(tokens, cp + 2);
        binding = pr_val(br);
        cp = pr_pos(br);
    } else if att == 50 {
        ename = "__tuple";
        let mut br: Vec<i32> = parse_match_list_binding(tokens, cp + 1, 51, 0);
        binding = pr_val(br);
        vname = str_from_int(pattern_list_value_count(binding));
        cp = pr_pos(br);
    } else if att == 54 {
        ename = "__slice";
        let mut br: Vec<i32> = parse_match_list_binding(tokens, cp + 1, 55, 1);
        binding = pr_val(br);
        vname = "slice";
        cp = pr_pos(br);
    } else if att == 1 && (str_eq(pkv(tokens, cp), "Some") == 1 || str_eq(pkv(tokens, cp), "None") == 1 || str_eq(pkv(tokens, cp), "Ok") == 1 || str_eq(pkv(tokens, cp), "Err") == 1) {
        vname = pkv(tokens, cp);
        if str_eq(vname, "Ok") == 1 || str_eq(vname, "Err") == 1 { ename = "Result"; }
        else { ename = "Option"; };
        cp = cp + 1;
        if pk(tokens, cp) == 50 {
            cp = cp + 1;
            if pk(tokens, cp) != 51 { binding = pkv(tokens, cp); cp = cp + 1; };
            cp = expect_tok(tokens, cp, 51);
        } else if pk(tokens, cp) == 52 {
            let mut br: Vec<i32> = parse_match_binding_block(tokens, cp + 1);
            binding = pr_val(br);
            cp = pr_pos(br);
        };
    } else {
        ename = "__wild";
        binding = pkv(tokens, cp);
        cp = cp + 1;
    };
    if str_len(at_name) > 0 {
        if str_eq(ename, "__range") == 1 {
            ename = "__range_at";
            binding = str_concat(binding, str_concat("|@", at_name));
        } else if str_eq(ename, "__range_bad") == 1 {
            ename = "__range_bad_at";
            binding = str_concat(binding, str_concat("|@", at_name));
        } else if str_eq(ename, "__int") == 1 || str_eq(ename, "__str") == 1 || str_eq(ename, "__wild") == 1 {
            binding = at_name;
        } else {
            binding = pattern_prepend_at_binding(binding, at_name);
        };
    };
    let mut out: Vec<i32> = Vec::new();
    out.push(cp); out.push(ename); out.push(vname); out.push(binding);
    return out;
}

fn mk_passthrough_block_expr(pool: Vec<i32>, body: i64) -> i64 {
    return mk4(pool, 23, mk2(pool, 1, 1), body, 0 - 1);
}

fn parse_passthrough_block_expr(tokens: Vec<i32>, pos: i64, pool: Vec<i32>) -> Vec<i32> {
    let mut cp: i64 = expect_tok(tokens, pos, 52);
    let mut br: Vec<i32> = parse_stmts(tokens, cp, pool);
    cp = expect_tok(tokens, pr_pos(br), 53);
    return pr(cp, mk_passthrough_block_expr(pool, pr_val(br)));
}

fn parse_wrapped_block_expr(tokens: Vec<i32>, pos: i64, pool: Vec<i32>, mode: i64) -> Vec<i32> {
    let mut cp: i64 = expect_tok(tokens, pos, 52);
    let mut br: Vec<i32> = parse_stmts(tokens, cp, pool);
    cp = expect_tok(tokens, pr_pos(br), 53);
    return pr(cp, mk3(pool, 52, mode, pr_val(br)));
}

fn parse_primary(tokens: Vec<i32>, pos: i64, pool: Vec<i32>) -> Vec<i32> {
    let tt: i64 = pk(tokens, pos);
    if tt == 2 {
        let mut cp: i64 = pos + 1;
        if pk(tokens, cp) == 83 {
            let mut depth: i64 = 1;
            cp = cp + 1;
            while depth > 0 && pk(tokens, cp) != 0 {
                if pk(tokens, cp) == 52 { depth = depth + 1; }
                else if pk(tokens, cp) == 53 { depth = depth - 1; };
                cp = cp + 1;
            };
        };
        return pr(cp, mk2(pool, 1, pkv(tokens, pos)));
    };
    // f64 literal (token 70) — encoded as int_part*1000000 + frac_millionths
    if tt == 70 {
        let mut cp: i64 = pos + 1;
        if pk(tokens, cp) == 83 {
            let mut depth: i64 = 1;
            cp = cp + 1;
            while depth > 0 && pk(tokens, cp) != 0 {
                if pk(tokens, cp) == 52 { depth = depth + 1; }
                else if pk(tokens, cp) == 53 { depth = depth - 1; };
                cp = cp + 1;
            };
        };
        return pr(cp, mk2(pool, 71, pkv(tokens, pos)));
    };
    // v0.4.24 (NUC-FEEDBACK-002): f32-typed float literal token (lexer
    // tagged it 125 because of an `f32` suffix). Same body as tt==70
    // but emits AST kind 73 instead of 71 so lower_expr routes it
    // through f32_from_scaled.
    if tt == 125 {
        let mut cp: i64 = pos + 1;
        if pk(tokens, cp) == 83 {
            let mut depth: i64 = 1;
            cp = cp + 1;
            while depth > 0 && pk(tokens, cp) != 0 {
                if pk(tokens, cp) == 52 { depth = depth + 1; }
                else if pk(tokens, cp) == 53 { depth = depth - 1; };
                cp = cp + 1;
            };
        };
        return pr(cp, mk2(pool, 73, pkv(tokens, pos)));
    };
    // v0.3.133: f64 raw-bits literal (token 124) — value IS the i64
    // bit pattern of the parsed float (via str_to_f64 at lex time).
    // Emits AST kind 72 which lower_expr handles by emitting the
    // bit pattern directly as a const_int (no scaled-int divide).
    if tt == 124 {
        let mut cp: i64 = pos + 1;
        if pk(tokens, cp) == 83 {
            let mut depth: i64 = 1;
            cp = cp + 1;
            while depth > 0 && pk(tokens, cp) != 0 {
                if pk(tokens, cp) == 52 { depth = depth + 1; }
                else if pk(tokens, cp) == 53 { depth = depth - 1; };
                cp = cp + 1;
            };
        };
        return pr(cp, mk2(pool, 72, pkv(tokens, pos)));
    };
    if tt == 3 { return pr(pos + 1, mk2(pool, 2, pkv(tokens, pos))); };
    if tt == 52 { return parse_passthrough_block_expr(tokens, pos, pool); };
    if tt == 50 {
        let mut r: Vec<i32> = parse_expr(tokens, pos + 1, pool);
        let mut cp: i64 = pr_pos(r);
        if pk(tokens, cp) != 44 {
            return pr(expect_tok(tokens, cp, 51), pr_val(r));
        };
        let mut items: Vec<i32> = Vec::new();
        items.push(pr_val(r));
        while pk(tokens, cp) == 44 {
            r = parse_expr(tokens, cp + 1, pool);
            items.push(pr_val(r));
            cp = pr_pos(r);
        };
        cp = expect_tok(tokens, cp, 51);
        return pr(cp, mk2(pool, 48, mk_list(pool, items)));
    };
    if tt == 54 {
        let mut cp: i64 = pos + 1;
        let mut items: Vec<i32> = Vec::new();
        while pk(tokens, cp) != 55 && pk(tokens, cp) != 0 {
            if vec_len(items) > 0 { cp = expect_tok(tokens, cp, 44); };
            let mut er: Vec<i32> = parse_expr(tokens, cp, pool);
            items.push(pr_val(er));
            cp = pr_pos(er);
        };
        cp = expect_tok(tokens, cp, 55);
        return pr(cp, mk2(pool, 47, mk_list(pool, items)));
    };
    // if-expression
    if tt == 13 { let mut r: Vec<i32> = parse_if(tokens, pos + 1, pool); return r; };
    if tt == 63 { let mut r: Vec<i32> = parse_match_stmt(tokens, pos + 1, pool, tok_pos_at(tokens, pos)); return r; };
    // v0.3.140: removed dead `tt == 76` branch (restricts) — see
    // classify_kw notes. The `restricts [...] { ... }` form had zero
    // usage so this branch was unreachable for legitimate code; in
    // practice it only fired on user fns named `restricts` and
    // mangled the call site into a phantom block expression.
    // v0.3.149: `unsafe` contextual block — only when followed by `{`.
    // Otherwise let the identifier path handle it (so `unsafe(x)` as
    // a user fn call works). Uses && short-circuit (now correct since
    // v0.3.148) to safely guard the pkv dereference.
    if tt == 1 && str_eq(pkv(tokens, pos), "unsafe") == 1 && pk(tokens, pos + 1) == 52 {
        return parse_passthrough_block_expr(tokens, pos + 1, pool);
    };
    // v0.4.102: `wrapping { ... }` block form. Default i32/i64 arithmetic
    // already two's-complement-wraps under the i64 ABI (probe verified:
    // 2147483647 + 1 i32 = -2147483648; 100000 * 100000 i32 = 1410065408),
    // so the block is semantically a passthrough. This is the v1 close —
    // a future overflow-checked default mode would route arithmetic
    // ops inside this block back to wrapping intrinsics. Same lookahead
    // gate as `unsafe` above so user fns named `wrapping` keep working.
    if tt == 1 && str_eq(pkv(tokens, pos), "wrapping") == 1 && pk(tokens, pos + 1) == 52 {
        // v0.4.239: route `wrapping { ... }` through the kind-52
        // mode-1 wrapped-block-expr so the lower_expr handler sets
        // sym["__arith_mode"]=1 in the body's sym before lowering
        // the contained arithmetic. Pre-fix this called the
        // passthrough parser which produces a kind-25 (or similar)
        // block with no mode flag, so __arith_mode was never set
        // and Track E's `arith_mode_explicit <= 0` precedence
        // guard at both intrinsic emit sites couldn't fire. With
        // v0.4.238's NUCLEOR_INT_STRICT_INTRIN=1 default, every
        // `wrapping { a + b }` block emitted the strict-intrinsic
        // trap path and panicked at runtime on real overflow —
        // the exact opposite of the user's intent. The wrap_i32
        // tail clamp (kind-52 mode==1 in lower_expr) was the only
        // thing keeping the block's final value pinned to i32
        // range; per-op behavior was broken pre-v0.4.238 too,
        // just invisibly because nsw doesn't trap.
        return parse_wrapped_block_expr(tokens, pos + 1, pool, 1);
    };
    // v0.4.153: `saturating { ... }` block. Arithmetic inside the
    // block lowers per operation to saturating_add/sub/mul helpers
    // instead of clamping only the final block result (the v0.4.105
    // approach where inner arithmetic still overflowed at the i64
    // level and only the block's final value got pinned to i32 range
    // was insufficient — multi-step expressions wrapped). Same
    // lookahead gate as `unsafe`/`wrapping` above so user fns named
    // `saturating` keep working.
    if tt == 1 && str_eq(pkv(tokens, pos), "saturating") == 1 && pk(tokens, pos + 1) == 52 {
        return parse_wrapped_block_expr(tokens, pos + 1, pool, 2);
    };
    // v0.3.150: removed dead tt == 78/79 branches (wrapping/saturating).
    // classify_kw no longer maps these to 78/79; the kw block forms had
    // zero usage anywhere in the codebase. User fns named `wrapping` or
    // `saturating` now lex/parse as normal identifiers.
    if tt == 1 {
        // v0.5 ship 7 — capture identifier byte offset for spanning
        // call expressions (kind 7) and the var-ref fallback.
        let ident_span: i64 = tok_pos_at(tokens, pos);
        let name: i64 = pkv(tokens, pos);
        if str_eq(name, "Some") == 1 || str_eq(name, "None") == 1 || str_eq(name, "Ok") == 1 || str_eq(name, "Err") == 1 {
            let mut tname: str = "Option";
            if str_eq(name, "Ok") == 1 || str_eq(name, "Err") == 1 { tname = "Result"; };
            if pk(tokens, pos + 1) == 50 {
                let mut ar: Vec<i32> = parse_args(tokens, pos + 2, pool);
                return pr(pr_pos(ar), mk4(pool, 12, tname, name, pr_val(ar)));
            };
            let mut empty: Vec<i32> = Vec::new();
            return pr(pos + 1, mk4(pool, 12, tname, name, mk_list(pool, empty)));
        };
        let p2: i64 = pos + 1;
        let cp2: i64 = skip_angle_group(tokens, p2);
        if pk(tokens, cp2) == 52 {
            // v0.3.114: also recognize pure-shorthand struct init —
            // `IDENT,` (multi-field shorthand) and `IDENT}` (single-
            // field shorthand). Pre-v0.3.114, only `IDENT:` (named
            // field) and `}` (empty) triggered struct-init parse.
            // Pure shorthand like `P { x, y }` (no `:`) fell through
            // to the bare identifier path; the `{ x, y }` was treated
            // as a separate block which left `@P` as an unresolved
            // global ref. Hard adoption blocker for any constructor
            // body using the canonical shorthand form
            // (`fn make(x, y) -> P { P { x, y } }`).
            //
            // For shorthand-only patterns (`,` / `}` after IDENT, no
            // `:` to confirm field-init shape), require the TYPE
            // identifier (`name`) to start with an uppercase letter.
            // Without this guard, `if foo { bar }` and
            // `while x { y }` patterns misfire — the lowercase `foo`
            // looks like a struct name to the disambiguator and the
            // single-ident body `bar` becomes a phantom shorthand
            // field. Rust convention reserves CamelCase for types,
            // so the case check is a clean boundary.
            let name_first: i64 = if str_len(name) > 0 { str_char_at(name, 0) } else { 0 };
            let is_upper: i64 = if name_first >= 65 && name_first <= 90 { 1 } else { 0 };
            // v0.4.218: empty struct-init `IDENT { }` now also requires
            // uppercase name. Pre-fix `match x { }` (empty match body)
            // parsed as `x { }` empty struct-init, the closing `}`
            // disappeared into the struct-init's parser, and the next
            // token (`;`) collided with parse_match_stmt's expect_tok(52)
            // for the match body's `{`. Adopters got a confusing
            // `expected backtick { backtick, got backtick ; backtick`
            // panic (after v0.4.208's token-name table; raw IDs pre-v0.4.208).
            // Same uppercase guard family as v0.3.114 for shorthand.
            // Closes findings/inbox/2026-04-30-empty-match-body-panic.md
            // — the empty match body now parses correctly with zero arms,
            // surfacing later as MATCH-001 if rtype-checked or running to
            // exit cleanly with no arm matched (intentional).
            if (is_upper == 1 && pk(tokens, cp2 + 1) == 53)
               || (pk(tokens, cp2 + 1) == 1 && pk(tokens, cp2 + 2) == 42)
               || (is_upper == 1 && pk(tokens, cp2 + 1) == 1 && pk(tokens, cp2 + 2) == 44)
               || (is_upper == 1 && pk(tokens, cp2 + 1) == 1 && pk(tokens, cp2 + 2) == 53) {
                return parse_struct_init(tokens, pos, pool);
            };
        };
        // v0.3.115: turbofish syntax `name::<TypeArgs>(args)`. Pre-
        // v0.3.115, the `::<` after `name` was treated as `::ident` —
        // qname captured the `<` token's value (garbage), the
        // following `(` failed to match the kind-12 dispatch shape,
        // and the call lowered as an associated-fn-call with a bogus
        // qname → diagnostic + zero placeholder. Adopters reaching
        // for the canonical `Vec::<i64>::new()` / `id::<T>(x)` pattern
        // saw silent miscomputes alongside an informational error.
        // Strip `::<TypeArgs>` and re-dispatch via the regular fn-call
        // path; the type args are advisory at lower-time anyway.
        if pk(tokens, cp2) == 46 && pk(tokens, cp2 + 1) == 32 {
            let after_args: i64 = skip_angle_group(tokens, cp2 + 1);
            if pk(tokens, after_args) == 50 {
                let mut ar: Vec<i32> = parse_args(tokens, after_args + 1, pool);
                let cn1: i64 = mk3(pool, 7, name, pr_val(ar));
                node_set_span(pool, cn1, ident_span);
                return pr(pr_pos(ar), cn1);
            };
        };
        if pk(tokens, cp2) == 46 {
            let qname: i64 = pkv(tokens, cp2 + 1);
            if pk(tokens, cp2 + 2) == 50 {
                let mut ar: Vec<i32> = parse_args(tokens, cp2 + 3, pool);
                return pr(pr_pos(ar), mk4(pool, 12, name, qname, pr_val(ar)));
            } else if pk(tokens, cp2 + 2) == 52 && (pk(tokens, cp2 + 3) == 53 || (pk(tokens, cp2 + 3) == 1 && pk(tokens, cp2 + 4) == 42)) {
                // v0.3.87: struct-like enum variant constructor
                // `EnumName::Variant { field: val, ... }`. Parse the
                // named fields and produce a kind-12 with values in
                // SOURCE order (field names are discarded).
                //
                // v0.3.88: disambiguation guard. Only fire if what's
                // inside the `{` looks like a field-init list (empty
                // `}` or IDENT followed by `:`). Without this, the
                // branch incorrectly captured the match body in
                // `match Stream::Done { Stream::More(v) => ... }`
                // because the SCRUTINEE position has `IDENT::IDENT {`
                // followed by patterns, not field initializers.
                let mut cp3: i64 = cp2 + 3;
                let mut sargs: Vec<i32> = Vec::new();
                while pk(tokens, cp3) != 53 && pk(tokens, cp3) != 0 {
                    if vec_len(sargs) > 0 { cp3 = expect_tok(tokens, cp3, 44); };
                    if pk(tokens, cp3) == 53 { break; };
                    cp3 = cp3 + 1;
                    cp3 = expect_tok(tokens, cp3, 42);
                    let mut vr: Vec<i32> = parse_expr(tokens, cp3, pool);
                    sargs.push(pr_val(vr));
                    cp3 = pr_pos(vr);
                };
                cp3 = cp3 + 1; // }
                return pr(cp3, mk4(pool, 12, name, qname, mk_list(pool, sargs)));
            } else {
                let mut empty: Vec<i32> = Vec::new();
                return pr(cp2 + 2, mk4(pool, 12, name, qname, mk_list(pool, empty)));
            };
        };
        if pk(tokens, cp2) == 50 { let mut ar: Vec<i32> = parse_args(tokens, cp2 + 1, pool); let cn2: i64 = mk3(pool, 7, name, pr_val(ar)); node_set_span(pool, cn2, ident_span); return pr(pr_pos(ar), cn2); };
        // v0.4.209 RFC-0015 phase 3a-step-3 (Option D): kind-3 var-ref
        // promoted from mk2 to mk3. Slot 2 is the width-tag for narrow-
        // typed bindings (i8/i16/u8/u16). Default 0 = untyped (i64 ABI
        // back-compat). Type-check fills it in for narrow types; codegen
        // reads it via a single node_field call (no str_concat, no
        // sym_get hash hit — the perf failure mode of v0.4.199's retry).
        // v0.5 ship 7 final: span the var-ref nid at the identifier
        // byte offset so OWN-001 (use-after-move) and other identifier-
        // anchored diagnostics caret precisely at the use site instead
        // of scanning the source text by name (which hits the FIRST
        // occurrence, not the actual use site).
        let var_nid: i64 = mk3(pool, 3, name, 0);
        node_set_span(pool, var_nid, ident_span);
        return pr(cp2, var_nid);
    };
    // Closure: |params| expr  or  |params| { stmts }  or  || expr  or  || { stmts }
    if tt == 65 || tt == 37 {
        let mut cparams: Vec<i32> = Vec::new();
        let mut cp: i64 = pos + 1;
        // tt==37 means ||, i.e. zero-param closure — skip param parsing
        if tt == 65 {
            while pk(tokens, cp) != 65 && pk(tokens, cp) != 0 {
                if vec_len(cparams) > 0 { cp = expect_tok(tokens, cp, 44); };
                let pn: i64 = pkv(tokens, cp);
                cp = cp + 1;
                if pk(tokens, cp) == 42 { cp = cp + 1; let mut tr: Vec<i32> = parse_type(tokens, cp); cp = pr_pos(tr); };
                cparams.push(pn);
            };
            cp = cp + 1;
        };
        // v0.3.101: optional `-> RetType` after the closing `|`. Pre-
        // v0.3.101, `|x: i64| -> i64 { … }` left the parser pointing
        // at `->`, which neither matched the `{ … }` block branch nor
        // parsed cleanly as an expression — the body parser then
        // produced an `@i64` global ref (clang link error
        // `use of undefined value '@i64'`). The return type is
        // advisory at lower-time anyway (closures emit i64 returns
        // by convention), so we just skip the annotation.
        if pk(tokens, cp) == 41 {
            let mut tr: Vec<i32> = parse_type(tokens, cp + 1);
            cp = pr_pos(tr);
        };
        if pk(tokens, cp) == 52 {
            cp = expect_tok(tokens, cp, 52);
            let mut br: Vec<i32> = parse_stmts(tokens, cp, pool);
            cp = expect_tok(tokens, pr_pos(br), 53);
            return pr(cp, mk3(pool, 42, mk_list(pool, cparams), pr_val(br)));
        } else {
            let mut er: Vec<i32> = parse_expr(tokens, cp, pool);
            cp = pr_pos(er);
            let mut rbody: Vec<i32> = Vec::new();
            rbody.push(mk2(pool, 22, pr_val(er)));
            return pr(cp, mk3(pool, 42, mk_list(pool, cparams), mk_list(pool, rbody)));
        };
    };
    // v0.4.99 audit doc-#1 §_p (parse_primary close): pragmatic
    // narrow-predicate approach. Pre-fix the fall-through silently
    // returned `int_lit(0)` and advanced past the unhandled token
    // for ALL tokens — including ones like `@` (binding pattern)
    // and `i:` (incomplete annotation) that adopters write
    // legitimately as Rust idioms but Nucleor doesn't yet parse.
    // Result: silent miscompute → working binary that does the
    // wrong thing.
    //
    // v0.4.72 / v0.4.81 attempts to panic unconditionally broke
    // tests/rods/pgs_smoke (token 51 = `)` legitimately reached
    // here from macro-expanded code at byte 6571). Per change-map
    // §9 the proper fix is a `parse_primary_or_recover(allow_recovery)`
    // two-arg API — but that requires finding every recovery
    // context call site of parse_primary. For now: keep silent
    // fallback ONLY for tokens that mark expression-end /
    // recovery-context (`)` `,` `;` `}` `]` `=` `EOF`). For ANY
    // OTHER unhandled token (including `@`, raw `:`, etc.), halt
    // with NR020. This catches the silent-miscompute class while
    // preserving pgs_smoke's legit recovery.
    let fall_tt: i64 = pk(tokens, pos);
    let is_recovery_marker: i64 = if fall_tt == 0
        || fall_tt == 40  // `=`
        || fall_tt == 41  // `}`
        || fall_tt == 43  // `;`
        || fall_tt == 44  // `,`
        || fall_tt == 51  // `)`
        || fall_tt == 55  // `]`
        { 1 } else { 0 };
    if is_recovery_marker == 0 {
        let fall_tok: Vec<i32> = tok_at(tokens, pos);
        let fall_byte: i64 = vec_get(fall_tok, 2);
        panic(str_concat("error[NR020]: parse_primary cannot start an expression at token kind ", str_concat(str_from_int(fall_tt), str_concat(" (byte position ", str_concat(str_from_int(fall_byte), "). Pre-v0.4.99 this silently became int_lit(0), producing a likely-broken AST node downstream consumed without diagnostic.")))));
    };
    return pr(pos + 1, mk2(pool, 1, 0));
}

fn parse_postfix(tokens: Vec<i32>, pos: i64, pool: Vec<i32>) -> Vec<i32> {
    let mut r: Vec<i32> = parse_primary(tokens, pos, pool);
    let mut cp: i64 = pr_pos(r); let mut node: i64 = pr_val(r);
    while pk(tokens, cp) == 45 || pk(tokens, cp) == 54 || pk(tokens, cp) == 97 {
        if pk(tokens, cp) == 97 {
            // RFC-0016 phase 1: `?` postfix — desugars at lower-time into
            // err-check + early return on Err / None. Inner expression is
            // expected to be Result<T, E> or Option<T> (compiler trusts the
            // layout: cell 0 = tag, cell 1 = payload; tag 0 = Err/None).
            cp = cp + 1;
            node = mk2(pool, 122, node);
        } else {
        if pk(tokens, cp) == 45 {
            let mut fname: str = "";
            if pk(tokens, cp + 1) == 2 { fname = str_from_int(pkv(tokens, cp + 1)); }
            else { fname = pkv(tokens, cp + 1); };
            let p2: i64 = cp + 2;
            let mut tname: str = "";
            let mut ctor_like: i64 = 0;
            if node_kind(pool, node) == 3 {
                tname = node_field(pool, node, 1);
                if str_len(tname) > 0 && str_len(fname) > 0 && str_char_at(tname, 0) >= 65 && str_char_at(tname, 0) <= 90 && str_char_at(fname, 0) >= 65 && str_char_at(fname, 0) <= 90 {
                    ctor_like = 1;
                };
            };
            if ctor_like == 1 && pk(tokens, p2) == 52 {
                let mut qp: i64 = p2 + 1;
                let mut qargs: Vec<i32> = Vec::new();
                while pk(tokens, qp) != 53 && pk(tokens, qp) != 0 {
                    if vec_len(qargs) > 0 {
                        qp = expect_tok(tokens, qp, 44);
                        if pk(tokens, qp) == 53 { break; };
                    };
                    let _field_name: str = pkv(tokens, qp);
                    qp = expect_tok(tokens, qp + 1, 42);
                    let mut er: Vec<i32> = parse_expr(tokens, qp, pool);
                    qargs.push(pr_val(er));
                    qp = pr_pos(er);
                };
                qp = expect_tok(tokens, qp, 53);
                cp = qp;
                node = mk4(pool, 12, tname, fname, mk_list(pool, qargs));
            } else if pk(tokens, p2) == 50 {
                let mut ar: Vec<i32> = parse_args(tokens, p2 + 1, pool);
                cp = pr_pos(ar); node = mk4(pool, 8, node, fname, pr_val(ar));
            } else if ctor_like == 1 {
                let mut empty: Vec<i32> = Vec::new();
                cp = p2;
                node = mk4(pool, 12, tname, fname, mk_list(pool, empty));
            } else { cp = p2; node = mk3(pool, 9, node, fname); };
        } else {
            let mut ir: Vec<i32> = parse_expr(tokens, cp + 1, pool);
            // v0.4.55: NUC-FEEDBACK silent-segfault guard for str/Vec
            // slice syntax. Pre-fix `s[0..5]` printed "Parse error
            // ... expected token 55 got 58" but the build silently
            // continued, producing broken IR that SIGSEGVed at runtime.
            // Slice expressions aren't yet supported in the indexer
            // surface; halt cleanly with a workaround pointing at
            // `str_substring(s, lo, hi)` (or vec_slice when shipped).
            let after_idx_tok: i64 = pk(tokens, pr_pos(ir));
            if after_idx_tok == 58 || after_idx_tok == 96 {
                print("ERROR: slice syntax `expr[lo..hi]` is not yet supported (was a silent SIGSEGV pre-v0.4.55). Workarounds: for `str` use `str_substring(s, lo, hi)`; for `Vec<T>` use an explicit element-wise loop or build a new Vec via `vec_push` over the desired range.");
                panic("nucleor: slice expression `expr[lo..hi]` not supported");
            };
            cp = expect_tok(tokens, pr_pos(ir), 55); node = mk3(pool, 10, node, pr_val(ir));
        };
        };
    };
    return pr(cp, node);
}

fn parse_unary(tokens: Vec<i32>, pos: i64, pool: Vec<i32>) -> Vec<i32> {
    if pk(tokens, pos) == 21 { let mut r: Vec<i32> = parse_unary(tokens, pos + 1, pool); return pr(pr_pos(r), mk2(pool, 5, pr_val(r))); };
    if pk(tokens, pos) == 38 { let mut r: Vec<i32> = parse_unary(tokens, pos + 1, pool); return pr(pr_pos(r), mk2(pool, 6, pr_val(r))); };
    if pk(tokens, pos) == 22 {
        let mut r: Vec<i32> = parse_unary(tokens, pos + 1, pool);
        return pr(pr_pos(r), mk2(pool, 92, pr_val(r)));
    };
    if pk(tokens, pos) == 82 {
        let mut cp: i64 = pos + 1;
        let mut is_mut: i64 = 0;
        if pk(tokens, cp) == 12 { is_mut = 1; cp = cp + 1; };
        let mut r: Vec<i32> = parse_unary(tokens, cp, pool);
        if is_mut == 1 { return pr(pr_pos(r), mk2(pool, 91, pr_val(r))); };
        return pr(pr_pos(r), mk2(pool, 90, pr_val(r)));
    };
    let mut base: Vec<i32> = parse_postfix(tokens, pos, pool);
    let mut cp: i64 = pr_pos(base);
    let mut node: i64 = pr_val(base);
    // RFC-0015 phase 2: postfix `as TYPE` cast. v0.3.142: `as` is now
    // a contextual identifier-keyword. Recognised here (post-primary)
    // only when the current token is identifier "as". Use nested `&&`
    // to ensure short-circuit (Nucleor's && currently lowers to bitwise
    // AND, so flat 2-operand chains call the RHS even when LHS is false
    // -- hazardous when RHS dereferences pkv on a non-pointer token).
    let mut as_match: i64 = 0;
    if pk(tokens, cp) == 1 {
        if str_eq(pkv(tokens, cp), "as") == 1 { as_match = 1; };
    };
    while as_match == 1 {
        // v0.5 ship 7 — capture the `as` token's byte offset as the
        // cast nid's span so NUM-003 (narrowing) and NUM-006 (narrow-
        // float vec read) carets land at the cast site instead of
        // the function name fallback.
        let as_span: i64 = tok_pos_at(tokens, cp);
        cp = cp + 1;
        let mut tr: Vec<i32> = parse_type(tokens, cp);
        cp = pr_pos(tr);
        // AST node kind 99 = "as cast"; field 1 = expr, field 2 = type name
        node = mk3(pool, 99, node, pr_val(tr));
        node_set_span(pool, node, as_span);
        as_match = 0;
        if pk(tokens, cp) == 1 {
            if str_eq(pkv(tokens, cp), "as") == 1 { as_match = 1; };
        };
    };
    return pr(cp, node);
}

fn parse_mul(tokens: Vec<i32>, pos: i64, pool: Vec<i32>) -> Vec<i32> {
    let mut r: Vec<i32> = parse_unary(tokens, pos, pool);
    let mut cp: i64 = pr_pos(r); let mut node: i64 = pr_val(r);
    while pk(tokens, cp) == 22 || pk(tokens, cp) == 23 || pk(tokens, cp) == 24 {
        let op: i64 = pk(tokens, cp); r = parse_unary(tokens, cp + 1, pool); cp = pr_pos(r); node = mk4(pool, 4, op, node, pr_val(r));
    };
    return pr(cp, node);
}
fn parse_add(tokens: Vec<i32>, pos: i64, pool: Vec<i32>) -> Vec<i32> {
    let mut r: Vec<i32> = parse_mul(tokens, pos, pool);
    let mut cp: i64 = pr_pos(r); let mut node: i64 = pr_val(r);
    while pk(tokens, cp) == 20 || pk(tokens, cp) == 21 {
        let op: i64 = pk(tokens, cp); r = parse_mul(tokens, cp + 1, pool); cp = pr_pos(r); node = mk4(pool, 4, op, node, pr_val(r));
    };
    return pr(cp, node);
}
// v0.3.104: shift tier — `<<` (token 115) and `>>` (parsed as two
// adjacent `>` tokens, so generic `Vec<Vec<T>>` keeps working).
// Between parse_add and parse_bitwise, matching Rust precedence:
// `* / %` > `+ -` > `<< >>` > `& ^ |` > `< > <= >=` > `== !=` > etc.
// tok_to_ir maps 115 → iop 16 (LLVM `shl i64`); the parser
// synthesizes a virtual `>>` token (kind 116) only at lower-time
// via mk4 → iop 17 (LLVM `ashr i64`) without touching the lexer.
fn parse_shift(tokens: Vec<i32>, pos: i64, pool: Vec<i32>) -> Vec<i32> {
    let mut r: Vec<i32> = parse_add(tokens, pos, pool);
    let mut cp: i64 = pr_pos(r); let mut node: i64 = pr_val(r);
    let mut done: i64 = 0;
    while done == 0 {
        let tt: i64 = pk(tokens, cp);
        if tt == 115 {
            r = parse_add(tokens, cp + 1, pool); cp = pr_pos(r); node = mk4(pool, 4, 115, node, pr_val(r));
        } else if tt == 33 && pk(tokens, cp + 1) == 33 {
            r = parse_add(tokens, cp + 2, pool); cp = pr_pos(r); node = mk4(pool, 4, 116, node, pr_val(r));
        } else {
            done = 1;
        };
    };
    return pr(cp, node);
}

// v0.3.103: bitwise tier — `&` `^` `|` between `<<>>` and `< >` so
// that `a & b == c` parses as `(a & b) == c` (Rust precedence).
// All three ops share one tier here for simplicity. tok_to_ir maps
// `&` (tok 82) → iop 13 (LLVM `and i64`), `|` (tok 65) → iop 14
// (LLVM `or i64`), and `^` (tok 94) → iop 15 (LLVM `xor i64`).
// Disambiguates from logical `&&`/`||` because the lexer emits
// distinct tokens 36/37 for those — never tt == 82/65 here.
fn parse_bitwise(tokens: Vec<i32>, pos: i64, pool: Vec<i32>) -> Vec<i32> {
    let mut r: Vec<i32> = parse_shift(tokens, pos, pool);
    let mut cp: i64 = pr_pos(r); let mut node: i64 = pr_val(r);
    let mut tt: i64 = pk(tokens, cp);
    while tt == 82 || tt == 65 || tt == 94 {
        r = parse_shift(tokens, cp + 1, pool); cp = pr_pos(r); node = mk4(pool, 4, tt, node, pr_val(r)); tt = pk(tokens, cp);
    };
    return pr(cp, node);
}
fn parse_cmp(tokens: Vec<i32>, pos: i64, pool: Vec<i32>) -> Vec<i32> {
    let mut r: Vec<i32> = parse_bitwise(tokens, pos, pool);
    let mut cp: i64 = pr_pos(r); let mut node: i64 = pr_val(r);
    let mut tt: i64 = pk(tokens, cp);
    while tt == 32 || tt == 33 || tt == 34 || tt == 35 {
        r = parse_bitwise(tokens, cp + 1, pool); cp = pr_pos(r); node = mk4(pool, 4, tt, node, pr_val(r)); tt = pk(tokens, cp);
    };
    return pr(cp, node);
}
fn parse_eq(tokens: Vec<i32>, pos: i64, pool: Vec<i32>) -> Vec<i32> {
    let mut r: Vec<i32> = parse_cmp(tokens, pos, pool);
    let mut cp: i64 = pr_pos(r); let mut node: i64 = pr_val(r);
    while pk(tokens, cp) == 30 || pk(tokens, cp) == 31 {
        let op: i64 = pk(tokens, cp); r = parse_cmp(tokens, cp + 1, pool); cp = pr_pos(r); node = mk4(pool, 4, op, node, pr_val(r));
    };
    return pr(cp, node);
}

fn parse_and_expr(tokens: Vec<i32>, pos: i64, pool: Vec<i32>) -> Vec<i32> {
    let mut r: Vec<i32> = parse_eq(tokens, pos, pool);
    let mut cp: i64 = pr_pos(r); let mut node: i64 = pr_val(r);
    while pk(tokens, cp) == 36 { r = parse_eq(tokens, cp + 1, pool); cp = pr_pos(r); node = mk4(pool, 4, 36, node, pr_val(r)); };
    return pr(cp, node);
}
fn parse_or_expr(tokens: Vec<i32>, pos: i64, pool: Vec<i32>) -> Vec<i32> {
    let mut r: Vec<i32> = parse_and_expr(tokens, pos, pool);
    let mut cp: i64 = pr_pos(r); let mut node: i64 = pr_val(r);
    while pk(tokens, cp) == 37 { r = parse_and_expr(tokens, cp + 1, pool); cp = pr_pos(r); node = mk4(pool, 4, 37, node, pr_val(r)); };
    return pr(cp, node);
}

fn parse_pipe_expr(tokens: Vec<i32>, pos: i64, pool: Vec<i32>) -> Vec<i32> {
    let mut r: Vec<i32> = parse_or_expr(tokens, pos, pool);
    let mut cp: i64 = pr_pos(r);
    let mut node: i64 = pr_val(r);
    while pk(tokens, cp) == 65 && pk(tokens, cp + 1) == 33 {
        let rp: i64 = cp + 2;
        if pk(tokens, rp) != 1 { return pr(rp, node); };
        let fname: str = pkv(tokens, rp);
        let rp2: i64 = rp + 1;
        let rp3: i64 = skip_angle_group(tokens, rp2);
        let mut piped_args: Vec<i32> = Vec::new();
        piped_args.push(node);
        if pk(tokens, rp3) == 50 {
            let mut ar: Vec<i32> = parse_args(tokens, rp3 + 1, pool);
            let alist: i64 = pr_val(ar);
            let ac: i64 = list_len(pool, alist);
            let mut ai: i64 = 0;
            while ai < ac {
                piped_args.push(list_get(pool, alist, ai));
                ai = ai + 1;
            };
            cp = pr_pos(ar);
        } else {
            cp = rp3;
        };
        node = mk3(pool, 7, fname, mk_list(pool, piped_args));
    };
    return pr(cp, node);
}

fn parse_expr(tokens: Vec<i32>, pos: i64, pool: Vec<i32>) -> Vec<i32> { return parse_pipe_expr(tokens, pos, pool); }

fn parse_type(tokens: Vec<i32>, pos: i64) -> Vec<i32> {
    if pk(tokens, pos) == 82 {
        let mut cp: i64 = pos + 1;
        let mut prefix: str = "&";
        // T2.5 (v0.2.351): skip optional lifetime annotation `'a` after `&`.
        // Treated as advisory — does not appear in the parsed type string.
        if pk(tokens, cp) == 98 { cp = cp + 1; };
        if pk(tokens, cp) == 12 { prefix = "&mut "; cp = cp + 1; };
        let mut tr: Vec<i32> = parse_type(tokens, cp);
        return pr(pr_pos(tr), str_concat(prefix, pr_val(tr)));
    };
    if pk(tokens, pos) == 54 {
        let mut tr: Vec<i32> = parse_type(tokens, pos + 1);
        let mut cp: i64 = expect_tok(tokens, pr_pos(tr), 43);
        let len_s: str = if pk(tokens, cp) == 2 { str_from_int(pkv(tokens, cp)) } else { pkv(tokens, cp) };
        cp = expect_tok(tokens, cp + 1, 55);
        return pr(cp, str_concat("[", str_concat(pr_val(tr), str_concat("; ", str_concat(len_s, "]")))));
    };
    if pk(tokens, pos) == 50 {
        let mut cp: i64 = pos + 1;
        let mut inner: str = "";
        while pk(tokens, cp) != 51 && pk(tokens, cp) != 0 {
            if str_len(inner) > 0 { cp = expect_tok(tokens, cp, 44); inner = str_concat(inner, ", "); };
            let mut tr: Vec<i32> = parse_type(tokens, cp);
            cp = pr_pos(tr);
            inner = str_concat(inner, pr_val(tr));
        };
        return pr(cp + 1, str_concat("(", str_concat(inner, ")")));
    };
    // v0.3.92/v0.4.112: trait object syntax `dyn Trait`.
    // Preserve the `dyn` marker so Box<dyn Trait> can be distinguished
    // from Box<Trait> during type checking.
    if pk(tokens, pos) == 1 && str_eq(pkv(tokens, pos), "dyn") == 1 {
        let mut tr: Vec<i32> = parse_type(tokens, pos + 1);
        return pr(pr_pos(tr), str_concat("dyn ", pr_val(tr)));
    };
    // v0.3.83: fn-pointer type syntax `fn(T1, T2) -> R`. Nucleor stores
    // function pointers as i64, so we consume the syntactic shape and
    // return "i64" — the existing fn-pointer/closure dispatch already
    // handles i64-typed callable values. Pre-v0.3.83, `fn(i64) -> i64`
    // in a parameter type position cascaded into 26+ parse errors.
    if pk(tokens, pos) == 10 {
        let mut cp: i64 = pos + 1;
        // Expect `(`
        if pk(tokens, cp) == 50 {
            cp = cp + 1;
            // Skip args: each arg is `parse_type` (no name needed).
            // Walk paren-balanced to allow nested fn types.
            let mut depth: i64 = 1;
            while depth > 0 && pk(tokens, cp) != 0 {
                if pk(tokens, cp) == 50 { depth = depth + 1; };
                if pk(tokens, cp) == 51 { depth = depth - 1; };
                cp = cp + 1;
            };
            // Optional `-> R` return type
            if pk(tokens, cp) == 41 {
                cp = cp + 1;
                let mut tr: Vec<i32> = parse_type(tokens, cp);
                cp = pr_pos(tr);
            };
            cp = skip_effect_clause(tokens, cp);
        };
        return pr(cp, "i64");
    };
    let name: i64 = pkv(tokens, pos); let p2: i64 = pos + 1;
    if str_eq(name, "fixed") == 1 && pk(tokens, p2) == 32 {
        let mut cp: i64 = p2 + 1;
        let mut depth: i64 = 1;
        while depth > 0 && pk(tokens, cp) != 0 {
            if pk(tokens, cp) == 32 { depth = depth + 1; }
            else if pk(tokens, cp) == 33 { depth = depth - 1; };
            cp = cp + 1;
        };
        return pr(cp, "i64");
    };
    if str_eq(name, "unit") == 1 && pk(tokens, p2) == 32 {
        let mut cp: i64 = p2 + 1;
        let mut inner: Vec<i32> = parse_type(tokens, cp);
        let base_t: str = pr_val(inner);
        cp = pr_pos(inner);
        let mut depth: i64 = 1;
        while depth > 0 && pk(tokens, cp) != 0 {
            if pk(tokens, cp) == 32 { depth = depth + 1; }
            else if pk(tokens, cp) == 33 { depth = depth - 1; };
            cp = cp + 1;
        };
        return pr(cp, base_t);
    };
    if pk(tokens, p2) == 32 {
        // Generic type: Name<T1, T2, ...>
        // T2.5 (v0.2.351): accept lifetime args alongside type args.
        // Lifetime args are skipped from the resulting type string —
        // `Vec<'a, T>` parses as `Vec<T>` since codegen doesn't see
        // lifetime info. Real lifetime threading lands in T2.5b.
        let mut cp: i64 = p2 + 1;
        let mut type_parts: Vec<i32> = Vec::new();
        let mut first_arg: i64 = 1;
        while pk(tokens, cp) != 33 && pk(tokens, cp) != 0 {
            if first_arg == 0 {
                cp = expect_tok(tokens, cp, 44);
                if pk(tokens, cp) == 33 { break; };
            };
            first_arg = 0;
            if pk(tokens, cp) == 98 {
                // Skip lifetime arg.
                cp = cp + 1;
            } else {
                let mut tr: Vec<i32> = parse_type(tokens, cp); cp = pr_pos(tr);
                type_parts.push(pr_val(tr));
            };
        };
        let n: i64 = vec_len(type_parts);
        if n == 0 { return pr(cp + 1, name); };
        let mut inner: str = vec_get(type_parts, 0);
        let mut tpi: i64 = 1;
        while tpi < n {
            inner = str_concat(inner, str_concat(", ", vec_get(type_parts, tpi)));
            tpi = tpi + 1;
        };
        return pr(cp + 1, str_concat(name, str_concat("<", str_concat(inner, ">"))));
    };
    return pr(p2, name);
}

fn parse_generic_params(tokens: Vec<i32>, pos: i64) -> Vec<i32> {
    // pos points at '<', returns (pos_after_>, list of param name strings).
    // T2.5 (v0.2.351): accepts lifetime parameters (`'a`, `'static`, etc.)
    // alongside type parameters. Lifetime params get prepended with `'`
    // in the returned list so downstream consumers can distinguish them
    // (today no consumer does, but the marker is preserved for T2.5b).
    let mut cp: i64 = pos + 1;
    let mut params: Vec<i32> = Vec::new();
    while pk(tokens, cp) != 33 && pk(tokens, cp) != 0 {
        if vec_len(params) > 0 {
            cp = expect_tok(tokens, cp, 44);
            if pk(tokens, cp) == 33 { break; };
        };
        if pk(tokens, cp) == 98 {
            // Lifetime param — store as `'<name>` for traceability.
            params.push(str_concat("'", pkv(tokens, cp)));
        } else {
            params.push(pkv(tokens, cp));
        };
        cp = cp + 1;
        // v0.4.103: trait-bound clause `<T: Addable>` / `<T: A + B>`.
        // Pre-fix this hit NR020 panic at the `:` token (42). Today
        // Nucleor's generics are type-passthrough — codegen emits one
        // monomorphic version regardless of bound — so the bound is
        // semantically a no-op at the IR level. Skip past `:` and
        // discard the bound expression up to the next `,` or `>`.
        // Closes audit doc-#1 §8 (parse-side). A future bound-enforcing
        // pass would consume + record these bounds; for now they parse
        // cleanly and the binary behaves as if the bound were omitted
        // (already validated: `<T>(a: T, b: T) -> T { a + b }` works).
        if pk(tokens, cp) == 42 {
            cp = cp + 1; // skip ':'
            // v0.4.130: capture each bound trait name as a `?<name>`
            // entry alongside the param name. Pre-v0.4.103 the bound
            // clause was an NR020 parse error; v0.4.103 parse-skipped
            // it (no signal); now we store it so a later type-check
            // pass can verify the trait exists / has at least one
            // impl. Multiple bounds (`<T: A + B>`) all get `?A`,
            // `?B` entries.
            while pk(tokens, cp) != 33 && pk(tokens, cp) != 44 && pk(tokens, cp) != 0 {
                if pk(tokens, cp) == 1 {
                    let bname: str = pkv(tokens, cp);
                    if str_len(bname) > 0 { params.push(str_concat("?", bname)); };
                };
                cp = cp + 1;
            };
        };
    };
    cp = cp + 1; // skip >
    return pr(cp, params);
}

fn parse_let(tokens: Vec<i32>, pos: i64, pool: Vec<i32>) -> Vec<i32> {
    let mut is_mut: i64 = 0; let mut cp: i64 = pos;
    if pk(tokens, cp) == 12 { is_mut = 1; cp = cp + 1; };
    // v0.3.81 safety net: tuple-destructuring `let (a, b) = (5, 7);`
    // is not yet supported. Pre-v0.3.81, the parser read `(` as a
    // var name and downstream code segfaulted with ACCESS_VIOLATION
    // on a garbage string offset. Detect the open-paren and emit a
    // clear diagnostic, then skip past the destructure-stmt to
    // recover so the rest of the program still parses.
    if pk(tokens, cp) == 50 {
        print("ERROR: tuple destructuring in `let` is not yet supported (e.g. `let (a, b) = (5, 7);`). Workaround: bind to a struct or to two separate `let` statements: `let a: i64 = 5; let b: i64 = 7;`. Tracked for a future ship — tuple-pattern lowering needed.");
        // v0.4.33: pre-fix this emitted a placeholder let-stmt with a
        // synthetic name and the build succeeded — the destructure
        // bindings (a, b) silently never came into scope and any
        // following code referencing them either failed at clang or
        // (worse) resolved to a stale shadow. Halt now.
        panic("nucleor: tuple destructuring in `let` not supported (see ERROR diagnostic above)");
        let mut sk: i64 = cp;
        while pk(tokens, sk) != 0 && pk(tokens, sk) != 43 { sk = sk + 1; };
        if pk(tokens, sk) == 43 { sk = sk + 1; };
        return pr(sk, mk5(pool, 20, "__tuple_destructure_unsupported__", 0, "", 0 - 1));
    };
    let name_span: i64 = tok_pos_at(tokens, cp);
    let name: i64 = pkv(tokens, cp); cp = cp + 1;
    let mut tstr: str = "";
    if pk(tokens, cp) == 42 { let mut tr: Vec<i32> = parse_type(tokens, cp + 1); cp = pr_pos(tr); tstr = pr_val(tr); };
    // v0.3.119: NUC-FEEDBACK-002 silent-miscompute defense.
    // `let v: Vec<f32> = …; v.push(1.0f32);` compiles cleanly today
    // but `let s: f32 = v[0]; f32_add(s, …)` produces 0 — the f32
    // bit pattern stored in the underlying i64 cell loses its type
    // tag through the vec_get → let-init chain, so the f32_add helper
    // operates on raw i64 storage. HIGH-blast for any ML/scientific
    // code reaching for narrow-float typed vectors. Real fix needs
    // expr_struct_type to propagate Vec element type through indexing
    // and let-init type propagation; until that lands, surface a hard
    // diagnostic for the broken types so adopters don't ship silently-
    // wrong tensor kernels.
    //
    // `Vec<f64>` is intentionally NOT in the rejected set — it works
    // correctly today because i64 storage cells naturally hold f64 bit
    // patterns via direct memory load (both are 64-bit). Many existing
    // fixtures (t330-t349) depend on `Vec<f64>` and would break.
    // The narrow-float family (`f32`, `f16`, `bf16`, `f8e4m3`, `f8e5m2`)
    // are all <64-bit and need the conversion-helper round-trip.
    // v0.3.204: Vec<f32> downgrade. Round-trip via f32_from_bits.
    // v0.3.206: Vec<f16>/Vec<bf16>/Vec<f8e4m3>/Vec<f8e5m2> downgraded
    // -- runtime now has pack/unpack/display helpers for all narrow-
    // float types. See tests/fixtures/t463_vec_narrow_float_round_trip.nr
    // for the canonical round-trip patterns.
    let mut init_id: i64 = 0 - 1;
    if pk(tokens, cp) == 40 { let mut er: Vec<i32> = parse_expr(tokens, cp + 1, pool); cp = pr_pos(er); init_id = pr_val(er); };
    // v0.3.103: bitwise ops (`&`, `|`, `^`) are now supported via
    // parse_bitwise (between parse_eq and parse_and_expr). The
    // v0.3.97 diag-only stub is no longer needed — parse_expr
    // consumes the full bitwise expression, so there's nothing
    // left for next_after_rhs to detect.
    if pk(tokens, cp) == 43 { cp = cp + 1; };
    let let_nid: i64 = mk5(pool, 20, name, is_mut, tstr, init_id);
    node_set_span(pool, let_nid, name_span);
    return pr(cp, let_nid);
}

fn parse_const_decl(tokens: Vec<i32>, pos: i64, pool: Vec<i32>) -> Vec<i32> {
    let name: i64 = pkv(tokens, pos);
    let mut cp: i64 = expect_tok(tokens, pos + 1, 42);
    let mut tr: Vec<i32> = parse_type(tokens, cp);
    cp = expect_tok(tokens, pr_pos(tr), 40);
    let mut er: Vec<i32> = parse_expr(tokens, cp, pool);
    cp = pr_pos(er);
    if pk(tokens, cp) == 43 { cp = cp + 1; };
    return pr(cp, mk4(pool, 50, name, pr_val(tr), pr_val(er)));
}

fn parse_type_alias_decl(tokens: Vec<i32>, pos: i64, pool: Vec<i32>) -> Vec<i32> {
    let name: i64 = pkv(tokens, pos);
    let mut cp: i64 = expect_tok(tokens, pos + 1, 40);
    let mut tr: Vec<i32> = parse_type(tokens, cp);
    cp = pr_pos(tr);
    if pk(tokens, cp) == 43 { cp = cp + 1; };
    return pr(cp, mk3(pool, 51, name, pr_val(tr)));
}

fn parse_if(tokens: Vec<i32>, pos: i64, pool: Vec<i32>) -> Vec<i32> {
    // RFC-0016 sugar: `if let PATTERN = EXPR { THEN } else { ELSE }`
    // desugars to `match EXPR { PATTERN => { THEN }, _ => { ELSE } }`.
    // Supported patterns: Some(x), None, Ok(v), Err(e), EnumName::Variant[(b)].
    if pk(tokens, pos) == 11 {
        let mut ip: i64 = pos + 1;
        let mut ename: str = "";
        let mut vname: str = "";
        let mut binding: str = "";
        let pat_tt: i64 = pk(tokens, ip);
        if pat_tt == 1 && (str_eq(pkv(tokens, ip), "Some") == 1 || str_eq(pkv(tokens, ip), "None") == 1 || str_eq(pkv(tokens, ip), "Ok") == 1 || str_eq(pkv(tokens, ip), "Err") == 1) {
            vname = pkv(tokens, ip);
            if str_eq(vname, "Ok") == 1 || str_eq(vname, "Err") == 1 { ename = "Result"; }
            else { ename = "Option"; };
            ip = ip + 1;
            if pk(tokens, ip) == 50 {
                ip = ip + 1;
                if pk(tokens, ip) != 51 { binding = pkv(tokens, ip); ip = ip + 1; };
                ip = expect_tok(tokens, ip, 51);
            };
        } else if pat_tt == 1 && pk(tokens, ip + 1) == 46 {
            ename = pkv(tokens, ip);
            ip = expect_tok(tokens, ip + 1, 46);
            vname = pkv(tokens, ip); ip = ip + 1;
            if pk(tokens, ip) == 50 {
                ip = ip + 1;
                if pk(tokens, ip) != 51 { binding = pkv(tokens, ip); ip = ip + 1; };
                ip = expect_tok(tokens, ip, 51);
            };
        };
        if str_len(ename) > 0 {
            // We have a pattern; parse `= EXPR { BODY } [else { BODY }]`
            ip = expect_tok(tokens, ip, 40); // `=`
            let mut sr: Vec<i32> = parse_expr(tokens, ip, pool);
            let mut sp: i64 = expect_tok(tokens, pr_pos(sr), 52); // `{`
            let mut br: Vec<i32> = parse_stmts(tokens, sp, pool);
            sp = expect_tok(tokens, pr_pos(br), 53); // `}`
            let mut else_body: i64 = 0;
            if pk(tokens, sp) == 14 {
                sp = sp + 1;
                sp = expect_tok(tokens, sp, 52);
                let mut er: Vec<i32> = parse_stmts(tokens, sp, pool);
                sp = expect_tok(tokens, pr_pos(er), 53);
                else_body = pr_val(er);
            } else {
                let mut empty_stmts: Vec<i32> = Vec::new();
                else_body = mk_list(pool, empty_stmts);
            };
            // v0.4.50: NUC-FEEDBACK silent-segfault guard.
            // Pre-fix `if let Some(x) = v.first()` (and .last() / .pop() /
            // vec_first / vec_last / vec_pop) silently segfaulted at
            // runtime: the helper returns a bare i64 (not Option<T>), the
            // match-arm dispatcher then called vec_get on the i64 value
            // treating it as an Option pointer, dereferencing garbage.
            // Adopters writing the canonical Rust idiom got a SIGSEGV
            // with no compile-time signal.
            //
            // Real fix is to wrap these helpers in Option<T> at the
            // stdlib level (RFC-0024 Phase 4 territory). Until then,
            // halt the build with a clear diagnostic that names the
            // call and points to the workaround.
            if str_eq(ename, "Option") == 1 {
                let src_nid: i64 = pr_val(sr);
                let src_kind: i64 = node_kind(pool, src_nid);
                let mut bad_call: str = "";
                if src_kind == 8 {
                    let mname: str = node_field(pool, src_nid, 2);
                    if str_eq(mname, "first") == 1 || str_eq(mname, "last") == 1 || str_eq(mname, "pop") == 1 {
                        bad_call = str_concat(".", mname);
                    };
                };
                if src_kind == 7 {
                    let cname: str = node_field(pool, src_nid, 1);
                    if str_eq(cname, "vec_first") == 1 || str_eq(cname, "vec_last") == 1 || str_eq(cname, "vec_pop") == 1 {
                        bad_call = cname;
                    };
                };
                if str_len(bad_call) > 0 {
                    print(str_concat("ERROR: `if let Some(...) = ", str_concat(bad_call, "(...)` silently segfaults — the helper returns a bare i64, not Option<T>. Workaround: branch on length explicitly: `if vec_len(v) > 0 { let x: i64 = v[0]; ... } else { ... }`. Pinned for a future Option<T> wrapper ship (RFC-0024 Phase 4).")));
                    panic(str_concat("nucleor: if-let on non-Option-returning helper ", bad_call));
                };
            };
            // Build match arms: [PATTERN => then_body, _ => else_body]
            let mut arms: Vec<i32> = Vec::new();
            arms.push(mk6(pool, 39, ename, vname, binding, pr_val(br), 0));
            arms.push(mk6(pool, 39, "__wild", "", "", else_body, 0));
            return pr(sp, mk3(pool, 38, pr_val(sr), mk_list(pool, arms)));
        };
        // `let` not followed by a recognized pattern — fall through to plain if.
    };
    let mut cr: Vec<i32> = parse_expr(tokens, pos, pool);
    // v0.4.69: same `=` vs `==` typo guard as parse_while_stmt.
    if pk(tokens, pr_pos(cr)) == 40 {
        print("ERROR: condition position has `=` (assignment) where `==` (equality) was expected. Pre-v0.4.69 the parser printed a parse error and silently continued. Did you mean `if x == y { ... }` instead of `if x = y { ... }`?");
        panic("nucleor: `=` in if-condition position (probably `==` typo)");
    };
    let mut cp: i64 = expect_tok(tokens, pr_pos(cr), 52);
    let mut tr: Vec<i32> = parse_stmts(tokens, cp, pool);
    cp = expect_tok(tokens, pr_pos(tr), 53);
    let mut else_id: i64 = 0 - 1;
    if pk(tokens, cp) == 14 {
        cp = cp + 1;
        if pk(tokens, cp) == 13 { cp = cp + 1;
            let mut elif: Vec<i32> = parse_if(tokens, cp, pool);
            let mut els: Vec<i32> = Vec::new(); els.push(pr_val(elif));
            else_id = mk_list(pool, els); cp = pr_pos(elif);
        } else {
            cp = expect_tok(tokens, cp, 52);
            let mut er: Vec<i32> = parse_stmts(tokens, cp, pool);
            cp = expect_tok(tokens, pr_pos(er), 53); else_id = pr_val(er);
        };
    };
    return pr(cp, mk4(pool, 23, pr_val(cr), pr_val(tr), else_id));
}

fn parse_while_stmt(tokens: Vec<i32>, pos: i64, pool: Vec<i32>) -> Vec<i32> {
    // RFC-0016 sugar: `while let PATTERN = EXPR { BODY }` desugars to
    // `loop { match EXPR { PATTERN => { BODY }, _ => break } }`.
    // For v0.1.16: implement as a while-true with an embedded match
    // that breaks on wildcard arm.
    if pk(tokens, pos) == 11 {
        let mut ip: i64 = pos + 1;
        let mut ename: str = "";
        let mut vname: str = "";
        let mut binding: str = "";
        let pat_tt: i64 = pk(tokens, ip);
        if pat_tt == 1 && (str_eq(pkv(tokens, ip), "Some") == 1 || str_eq(pkv(tokens, ip), "None") == 1 || str_eq(pkv(tokens, ip), "Ok") == 1 || str_eq(pkv(tokens, ip), "Err") == 1) {
            vname = pkv(tokens, ip);
            if str_eq(vname, "Ok") == 1 || str_eq(vname, "Err") == 1 { ename = "Result"; }
            else { ename = "Option"; };
            ip = ip + 1;
            if pk(tokens, ip) == 50 {
                ip = ip + 1;
                if pk(tokens, ip) != 51 { binding = pkv(tokens, ip); ip = ip + 1; };
                ip = expect_tok(tokens, ip, 51);
            };
        } else if pat_tt == 1 && pk(tokens, ip + 1) == 46 {
            ename = pkv(tokens, ip);
            ip = expect_tok(tokens, ip + 1, 46);
            vname = pkv(tokens, ip); ip = ip + 1;
            if pk(tokens, ip) == 50 {
                ip = ip + 1;
                if pk(tokens, ip) != 51 { binding = pkv(tokens, ip); ip = ip + 1; };
                ip = expect_tok(tokens, ip, 51);
            };
        };
        if str_len(ename) > 0 {
            ip = expect_tok(tokens, ip, 40); // `=`
            let mut sr: Vec<i32> = parse_expr(tokens, ip, pool);
            let mut sp: i64 = expect_tok(tokens, pr_pos(sr), 52); // `{`
            let mut br: Vec<i32> = parse_stmts(tokens, sp, pool);
            sp = expect_tok(tokens, pr_pos(br), 53); // `}`
            // v0.4.50: NUC-FEEDBACK silent-infinite-loop guard.
            // Pre-fix `while let Some(x) = stack.pop()` did NOT
            // segfault but DID infinite-loop printing 0s — pop()
            // returns a bare i64 (not Option), the match-arm
            // dispatcher's "Some" path always succeeded and the
            // loop never terminated. Mirrors the if-let guard at
            // line 1487+.
            if str_eq(ename, "Option") == 1 {
                let wsrc_nid: i64 = pr_val(sr);
                let wsrc_kind: i64 = node_kind(pool, wsrc_nid);
                let mut wbad: str = "";
                if wsrc_kind == 8 {
                    let wmname: str = node_field(pool, wsrc_nid, 2);
                    if str_eq(wmname, "first") == 1 || str_eq(wmname, "last") == 1 || str_eq(wmname, "pop") == 1 {
                        wbad = str_concat(".", wmname);
                    };
                };
                if wsrc_kind == 7 {
                    let wcname: str = node_field(pool, wsrc_nid, 1);
                    if str_eq(wcname, "vec_first") == 1 || str_eq(wcname, "vec_last") == 1 || str_eq(wcname, "vec_pop") == 1 {
                        wbad = wcname;
                    };
                };
                if str_len(wbad) > 0 {
                    print(str_concat("ERROR: `while let Some(...) = ", str_concat(wbad, "(...)` silently infinite-loops — the helper returns a bare i64, not Option<T>, so the Some arm always matches and the loop never terminates. Workaround: use a `while vec_len(v) > 0 { ... v.pop(); ... }` pattern. Pinned for a future Option<T> wrapper ship (RFC-0024 Phase 4).")));
                    panic(str_concat("nucleor: while-let on non-Option-returning helper ", wbad));
                };
            };
            // Build break statement (node kind 26)
            let break_stmt: i64 = mk2(pool, 26, 0);
            let mut break_stmts: Vec<i32> = Vec::new();
            break_stmts.push(break_stmt);
            // Match arms: [PATTERN => body, _ => break]
            let mut arms: Vec<i32> = Vec::new();
            arms.push(mk6(pool, 39, ename, vname, binding, pr_val(br), 0));
            arms.push(mk6(pool, 39, "__wild", "", "", mk_list(pool, break_stmts), 0));
            let match_node: i64 = mk3(pool, 38, pr_val(sr), mk_list(pool, arms));
            // Wrap match in a stmt list to be the loop body
            let mut loop_body: Vec<i32> = Vec::new();
            loop_body.push(mk2(pool, 25, match_node));
            // True condition: literal 1
            let true_node: i64 = mk2(pool, 1, 1);
            return pr(sp, mk3(pool, 24, true_node, mk_list(pool, loop_body)));
        };
    };
    let mut cr: Vec<i32> = parse_expr(tokens, pos, pool);
    // v0.4.69: NUC-FEEDBACK silent-miscompute close — detect `=` vs
    // `==` typo. Pre-fix `while x = 0 { ... }` printed a parse error
    // but silently continued, building a binary with broken IR.
    // Halt cleanly at parse time with a clear hint.
    if pk(tokens, pr_pos(cr)) == 40 {
        print("ERROR: condition position has `=` (assignment) where `==` (equality) was expected. Pre-v0.4.69 the parser printed a parse error and silently continued, building broken IR. Did you mean `while x == y { ... }` instead of `while x = y { ... }`?");
        panic("nucleor: `=` in while-condition position (probably `==` typo)");
    };
    let mut cp: i64 = expect_tok(tokens, pr_pos(cr), 52);
    let mut br: Vec<i32> = parse_stmts(tokens, cp, pool);
    cp = expect_tok(tokens, pr_pos(br), 53);
    return pr(cp, mk3(pool, 24, pr_val(cr), pr_val(br)));
}

fn parse_for_stmt(tokens: Vec<i32>, pos: i64, pool: Vec<i32>) -> Vec<i32> {
    // pos is after 'for', pointing at variable name
    let name: i64 = pkv(tokens, pos);
    let mut cp: i64 = expect_tok(tokens, pos + 1, 57); // expect 'in'
    let mut sr: Vec<i32> = parse_expr(tokens, cp, pool);
    cp = pr_pos(sr);
    if pk(tokens, cp) == 58 {
        let mut er: Vec<i32> = parse_expr(tokens, cp + 1, pool); // end expr
        cp = expect_tok(tokens, pr_pos(er), 52); // expect '{'
        let mut br: Vec<i32> = parse_stmts(tokens, cp, pool);
        cp = expect_tok(tokens, pr_pos(br), 53); // expect '}'
        return pr(cp, mk5(pool, 28, name, pr_val(sr), pr_val(er), pr_val(br)));
    };
    if pk(tokens, cp) == 96 {
        // ..= inclusive: synthesize end+1 expression so existing exclusive
        // for-loop codegen handles it. Wrap end in (end + 1).
        let mut er: Vec<i32> = parse_expr(tokens, cp + 1, pool);
        let one_node: i64 = mk2(pool, 1, 1);
        let plus_node: i64 = mk4(pool, 4, 20, pr_val(er), one_node);
        cp = expect_tok(tokens, pr_pos(er), 52);
        let mut br: Vec<i32> = parse_stmts(tokens, cp, pool);
        cp = expect_tok(tokens, pr_pos(br), 53);
        return pr(cp, mk5(pool, 28, name, pr_val(sr), plus_node, pr_val(br)));
    };
    cp = expect_tok(tokens, cp, 52); // expect '{'
    let mut br: Vec<i32> = parse_stmts(tokens, cp, pool);
    cp = expect_tok(tokens, pr_pos(br), 53); // expect '}'
    return pr(cp, mk4(pool, 49, name, pr_val(sr), pr_val(br)));
}

fn parse_return_stmt(tokens: Vec<i32>, pos: i64, pool: Vec<i32>) -> Vec<i32> {
    if pk(tokens, pos) == 43 { return pr(pos + 1, mk2(pool, 22, 0 - 1)); };
    let mut er: Vec<i32> = parse_expr(tokens, pos, pool);
    let mut cp: i64 = pr_pos(er);
    if pk(tokens, cp) == 43 { cp = cp + 1; };
    return pr(cp, mk2(pool, 22, pr_val(er)));
}

fn parse_stmt(tokens: Vec<i32>, pos: i64, pool: Vec<i32>) -> Vec<i32> {
    let tt: i64 = pk(tokens, pos);
    if tt == 11 { return parse_let(tokens, pos + 1, pool); };
    if tt == 52 { let mut r: Vec<i32> = parse_passthrough_block_expr(tokens, pos, pool); let mut cp: i64 = pr_pos(r); if pk(tokens, cp) == 43 { cp = cp + 1; }; return pr(cp, pr_val(r)); };
    if tt == 13 { let mut r: Vec<i32> = parse_if(tokens, pos + 1, pool); let mut cp: i64 = pr_pos(r); if pk(tokens, cp) == 43 { cp = cp + 1; }; return pr(cp, pr_val(r)); };
    if tt == 15 { let mut r: Vec<i32> = parse_while_stmt(tokens, pos + 1, pool); let mut cp: i64 = pr_pos(r); if pk(tokens, cp) == 43 { cp = cp + 1; }; return pr(cp, pr_val(r)); };
    if tt == 1 {
        // v0.3.141: `loop` is a contextual keyword. When the next token
        // is `{`, recognise the `loop { BODY }` stmt-form (which
        // desugars to `while true { BODY }`); otherwise let the
        // identifier path handle it. Use a nested if to ensure pkv is
        // only dereferenced when tt is the identifier kind.
        if str_eq(pkv(tokens, pos), "loop") == 1 {
            if pk(tokens, pos + 1) == 52 {
                let mut cp_l: i64 = expect_tok(tokens, pos + 1, 52);
                let mut br_l: Vec<i32> = parse_stmts(tokens, cp_l, pool);
                cp_l = expect_tok(tokens, pr_pos(br_l), 53);
                if pk(tokens, cp_l) == 43 { cp_l = cp_l + 1; };
                let true_node_l: i64 = mk2(pool, 1, 1);
                return pr(cp_l, mk3(pool, 24, true_node_l, pr_val(br_l)));
            };
        };
    };
    if tt == 84 {
        // `loop { BODY }` legacy kw branch — kept as belt-and-suspenders
        // since classify_kw no longer produces token 84 for loop in v0.3.141,
        // this is dead code in stage B+ but harmless.
        let mut cp: i64 = expect_tok(tokens, pos + 1, 52);
        let mut br: Vec<i32> = parse_stmts(tokens, cp, pool);
        cp = expect_tok(tokens, pr_pos(br), 53);
        if pk(tokens, cp) == 43 { cp = cp + 1; };
        let true_node: i64 = mk2(pool, 1, 1);
        return pr(cp, mk3(pool, 24, true_node, pr_val(br)));
    };
    if tt == 56 { let mut r: Vec<i32> = parse_for_stmt(tokens, pos + 1, pool); let mut cp: i64 = pr_pos(r); if pk(tokens, cp) == 43 { cp = cp + 1; }; return pr(cp, pr_val(r)); };
    if tt == 63 { let mut r: Vec<i32> = parse_match_stmt(tokens, pos + 1, pool, tok_pos_at(tokens, pos)); let mut cp: i64 = pr_pos(r); if pk(tokens, cp) == 43 { cp = cp + 1; }; return pr(cp, pr_val(r)); };
    // v0.3.140: removed dead `tt == 76` branch (restricts) — see
    // classify_kw notes. Same dead-code pattern as the v0.3.138
    // scope/spawn removal below.
    // v0.3.138: removed dead `tt == 80 || tt == 81` branch (the
    // `scope { … }` / `spawn { … }` passthrough-block form). The
    // surrounding kw classifications were dropped — see classify_kw
    // for the rationale (silent-miscompute hazard for user fns named
    // `scope` or `spawn`).
    if tt == 16 { return parse_return_stmt(tokens, pos + 1, pool); };
    if tt == 18 { let mut cp: i64 = pos + 1; if pk(tokens, cp) == 43 { cp = cp + 1; }; return pr(cp, mk2(pool, 26, 0)); };
    if tt == 19 { let mut cp: i64 = pos + 1; if pk(tokens, cp) == 43 { cp = cp + 1; }; return pr(cp, mk2(pool, 27, 0)); };
    let mut er: Vec<i32> = parse_expr(tokens, pos, pool);
    let mut cp: i64 = pr_pos(er);
    if pk(tokens, cp) == 40 {
        let mut vr: Vec<i32> = parse_expr(tokens, cp + 1, pool);
        cp = pr_pos(vr);
        // v0.4.111: reject chained assignment `a = b = c`. Nucleor (like
        // Rust) does not treat assignment as an expression that yields
        // a value, so `a = b = 5` would parse as `a = b` followed by
        // a stray `= 5` that the recovery loop silently dropped --
        // adopters got `a == 0, b == 0` instead of `a == 5, b == 5`.
        // Catch the trailing `=` after the RHS expression and panic
        // with NR023 before the broken stmt makes it into the AST.
        if pk(tokens, cp) == 40 {
            panic("error[NR023]: chained assignment `a = b = c` is not supported in Nucleor — assignment is a statement, not an expression. Pre-v0.4.111 the second `= c` was silently dropped, leaving `a` and `b` with their pre-assignment values. Workaround: split into two statements — `b = c; a = b;` — which makes the order of evaluation explicit.");
        };
        if pk(tokens, cp) == 43 { cp = cp + 1; };
        return pr(cp, mk3(pool, 21, pr_val(er), pr_val(vr)));
    };
    // v0.3.77: compound assignment desugar. `x += y` → `x = x + y`,
    // and likewise for `-=` (111→21), `*=` (112→22), `/=` (113→23),
    // `%=` (114→24). LHS AST node is shared between the assign LHS and
    // the desugared binop LHS; this is safe because pool nodes are
    // immutable after creation and the lowering walks each AST exactly
    // once. For LHS forms with side effects (e.g. method calls in
    // future expansions), a real Get-Modify-Set lowering would be
    // required; today only var-ref / field-access / index LHS forms
    // are syntactically allowed, all of which are pure.
    let assign_tok: i64 = pk(tokens, cp);
    if assign_tok == 110 || assign_tok == 111 || assign_tok == 112 || assign_tok == 113 || assign_tok == 114
       || assign_tok == 117 || assign_tok == 118 || assign_tok == 119 || assign_tok == 120 || assign_tok == 121 {
        let mut vr: Vec<i32> = parse_expr(tokens, cp + 1, pool);
        cp = pr_pos(vr);
        if pk(tokens, cp) == 43 { cp = cp + 1; };
        let mut bin_op: i64 = 20;
        if assign_tok == 110 { bin_op = 20; };
        if assign_tok == 111 { bin_op = 21; };
        if assign_tok == 112 { bin_op = 22; };
        if assign_tok == 113 { bin_op = 23; };
        if assign_tok == 114 { bin_op = 24; };
        // v0.3.105: bitwise / shift compound assigns. Map to the
        // raw binop tokens so the existing tok_to_ir + parse_*
        // tier do the right thing at lowering — `&=` → `&` (82),
        // `|=` → `|` (65), `^=` → `^` (94), `<<=` → `<<` (115),
        // `>>=` → `>>` synthesized at lower-time as token 116.
        if assign_tok == 117 { bin_op = 82; };
        if assign_tok == 118 { bin_op = 65; };
        if assign_tok == 119 { bin_op = 94; };
        if assign_tok == 120 { bin_op = 115; };
        if assign_tok == 121 { bin_op = 116; };
        let rhs_node: i64 = mk4(pool, 4, bin_op, pr_val(er), pr_val(vr));
        return pr(cp, mk3(pool, 21, pr_val(er), rhs_node));
    };
    if pk(tokens, cp) == 43 { cp = cp + 1; };
    return pr(cp, mk2(pool, 25, pr_val(er)));
}

fn parse_stmts(tokens: Vec<i32>, pos: i64, pool: Vec<i32>) -> Vec<i32> {
    let mut items: Vec<i32> = Vec::new(); let mut cp: i64 = pos;
    while pk(tokens, cp) != 53 && pk(tokens, cp) != 0 {
        let mut r: Vec<i32> = parse_stmt(tokens, cp, pool); items.push(pr_val(r)); cp = pr_pos(r);
    };
    return pr(cp, mk_list(pool, items));
}

fn parse_fn_decl(tokens: Vec<i32>, pos: i64, pool: Vec<i32>) -> Vec<i32> {
    let name: i64 = pkv(tokens, pos);
    let mut cp: i64 = pos + 1;
    // Optional generic params: fn name<T, U>(...)
    let mut gparams: i64 = mk_list(pool, Vec::new());
    if pk(tokens, cp) == 32 {
        let mut gr: Vec<i32> = parse_generic_params(tokens, cp);
        cp = pr_pos(gr);
        gparams = mk_list(pool, pr_val(gr));
    };
    cp = expect_tok(tokens, cp, 50); // (
    let mut params: Vec<i32> = Vec::new();
    while pk(tokens, cp) != 51 && pk(tokens, cp) != 0 {
        if vec_len(params) > 0 { cp = expect_tok(tokens, cp, 44); };
        let pn: i64 = pkv(tokens, cp); cp = expect_tok(tokens, cp + 1, 42);
        let mut tr: Vec<i32> = parse_type(tokens, cp); cp = pr_pos(tr);
        let ptype: str = pr_val(tr);
        // v0.3.93: detect &mut T parameter and emit a clear diagnostic.
        // Pre-v0.3.93, &mut T params silently passed by value (not by
        // reference), so any caller mutation via `*x = ...` was a no-op
        // — `add_one(&mut n)` returned without modifying caller's n.
        // Real implementation requires get/store-via-pointer codegen
        // (ptrtoint of alloca slot at call site, inttoptr+load/store
        // at deref). Until then, emit a clear error pointing at the
        // workaround.
        if str_len(ptype) >= 5 && str_eq(str_substring(ptype, 0, 5), "&mut ") == 1 {
            // v0.4.25: only PRIMITIVE `&mut T` is broken. `&mut Struct` /
            // `&mut Enum` already works because those are heap handles
            // passed as i64 — field stores (`s.x = ...`) go through the
            // existing struct-field codegen, no ptr-deref-store needed.
            // The silent-miscompute window is `&mut <scalar>` where
            // `*x = ...` would need ptr-deref-store codegen we don't
            // emit. Pre-fix the diagnostic printed but compile continued,
            // the body was lowered as if the parameter were pass-by-value
            // (`*x = 99` dropped), and the binary silently produced wrong
            // output. Now: print the diagnostic, then hard-abort via panic
            // so adopters can't unintentionally ship the silent-miscompute
            // binary. `&mut Struct/Enum` keeps compiling cleanly.
            let inner: str = str_substring(ptype, 5, str_len(ptype));
            let is_scalar: i64 = if str_eq(inner, "i8") == 1 || str_eq(inner, "i16") == 1
                || str_eq(inner, "i32") == 1 || str_eq(inner, "i64") == 1
                || str_eq(inner, "i128") == 1 || str_eq(inner, "isize") == 1
                || str_eq(inner, "u8") == 1 || str_eq(inner, "u16") == 1
                || str_eq(inner, "u32") == 1 || str_eq(inner, "u64") == 1
                || str_eq(inner, "u128") == 1 || str_eq(inner, "usize") == 1
                || str_eq(inner, "f16") == 1 || str_eq(inner, "f32") == 1
                || str_eq(inner, "f64") == 1 || str_eq(inner, "bf16") == 1
                || str_eq(inner, "bool") == 1 || str_eq(inner, "char") == 1 { 1 } else { 0 };
            if is_scalar == 1 {
                print(str_concat("ERROR: &mut reference parameter `", str_concat(pn, str_concat(": ", str_concat(ptype, "` (scalar) in fn signature is not yet supported. Mutations via `*x = ...` would silently NOT propagate back to the caller. Workaround: return the new value (`fn foo(x: i64) -> i64 { return x + 1; }`) or use a `Vec<i64>` for shared state. `&mut Struct` works because struct fields share the heap handle. Tracked for a future ship — get/store-via-pointer codegen needed for primitives.")))));
                panic("&mut <scalar> parameter not implemented; see ERROR diagnostic above for workarounds");
            };
        };
        // v0.4.207: NAM-001 — duplicate parameter name in fn signature.
        // Pre-fix `fn add(a: i32, a: i32)` silently shadowed the first
        // `a`. Inside the body `a + a` referenced the second `a` only,
        // so `add(3, 5)` returned 10 (5+5) instead of the naive 8 —
        // silent miscompute via lost first arg, no diagnostic. Catch
        // at parse time: every preceding param must have a different
        // name. Linear scan; param lists are small in practice.
        // Closes findings/inbox/2026-04-30-dup-fn-param-name-silent-shadow.md.
        let mut dup_check_i: i64 = 0;
        while dup_check_i < vec_len(params) {
            let prior_pid: i64 = vec_get(params, dup_check_i);
            let prior_name: str = node_field(pool, prior_pid, 1);
            if str_eq(prior_name, pn) == 1 {
                panic(str_concat("error[NAM-001]: identifier `", str_concat(pn, str_concat("` is bound more than once in this parameter list. Pre-v0.4.207 the second binding silently shadowed the first, so the first argument was unreachable inside the body — `fn add(a, a) { a + a }` called as `add(3, 5)` returned 10 (5+5) instead of 8. Rename one of the parameters."))));
            };
            dup_check_i = dup_check_i + 1;
        };
        params.push(mk3(pool, 41, pn, ptype));
    };
    cp = cp + 1;
    let mut rtype: str = "void";
    if pk(tokens, cp) == 41 { let mut tr: Vec<i32> = parse_type(tokens, cp + 1); cp = pr_pos(tr); rtype = pr_val(tr); };
    cp = skip_effect_clause(tokens, cp);
    if pk(tokens, cp) == 1 && str_eq(pkv(tokens, cp), "requires") == 1 { cp = skip_bracket_list(tokens, cp + 1); };
    cp = skip_effect_clause(tokens, cp);
    cp = skip_where_clause(tokens, cp);
    cp = expect_tok(tokens, cp, 52);
    let mut br: Vec<i32> = parse_stmts(tokens, cp, pool);
    cp = expect_tok(tokens, pr_pos(br), 53);
    return pr(cp, mk6(pool, 30, name, mk_list(pool, params), rtype, pr_val(br), gparams));
}

fn parse_extern_fn(tokens: Vec<i32>, pos: i64, pool: Vec<i32>) -> Vec<i32> {
    // pos points after 'extern fn', at the name
    let name: i64 = pkv(tokens, pos);
    let mut cp: i64 = expect_tok(tokens, pos + 1, 50);
    let mut params: Vec<i32> = Vec::new();
    while pk(tokens, cp) != 51 && pk(tokens, cp) != 0 {
        if vec_len(params) > 0 { cp = expect_tok(tokens, cp, 44); };
        let pn: i64 = pkv(tokens, cp); cp = expect_tok(tokens, cp + 1, 42);
        let mut tr: Vec<i32> = parse_type(tokens, cp); cp = pr_pos(tr);
        params.push(mk3(pool, 41, pn, pr_val(tr)));
    };
    cp = cp + 1;
    let mut rtype: str = "void";
    if pk(tokens, cp) == 41 { let mut tr: Vec<i32> = parse_type(tokens, cp + 1); cp = pr_pos(tr); rtype = pr_val(tr); };
    cp = skip_effect_clause(tokens, cp);
    if pk(tokens, cp) == 1 && str_eq(pkv(tokens, cp), "requires") == 1 { cp = skip_bracket_list(tokens, cp + 1); };
    cp = skip_effect_clause(tokens, cp);
    cp = skip_where_clause(tokens, cp);
    if pk(tokens, cp) == 43 { cp = cp + 1; };
    return pr(cp, mk4(pool, 32, name, mk_list(pool, params), rtype));
}

fn parse_struct_decl(tokens: Vec<i32>, pos: i64, pool: Vec<i32>) -> Vec<i32> {
    // pos points after 'struct', at the name
    let name: i64 = pkv(tokens, pos);
    let mut cp: i64 = pos + 1;
    // Optional generic params: struct Name<T, U> { ... }
    let mut gparams: i64 = mk_list(pool, Vec::new());
    if pk(tokens, cp) == 32 {
        let mut gr: Vec<i32> = parse_generic_params(tokens, cp);
        cp = pr_pos(gr);
        gparams = mk_list(pool, pr_val(gr));
    };
    // v0.5.28: canonical Rust unit-struct syntax `struct U;` (probe finding
    // 2026-05-01-unit-struct-semicolon-form-parse-fail). Pre-fix expected
    // `{` and panicked NR020 on `;` — translators porting Rust hit this
    // constantly because `struct Marker;` is the canonical form. Now both
    // `struct U;` and `struct U {}` lower to the same empty-fields decl
    // (kind 33 with empty fields list). Construction still requires
    // `U {}` value form; a follow-up will let `U` (bare ident) resolve
    // to the zero-field constructor.
    if pk(tokens, cp) == 43 {
        let unit_nid: i64 = mk4(pool, 33, name, mk_list(pool, Vec::new()), gparams);
        return pr(cp + 1, unit_nid);
    };
    cp = expect_tok(tokens, cp, 52); // {
    let mut fields: Vec<i32> = Vec::new();
    while pk(tokens, cp) != 53 && pk(tokens, cp) != 0 {
        if vec_len(fields) > 0 {
            cp = expect_tok(tokens, cp, 44);
            if pk(tokens, cp) == 53 { break; };
        };
        // v0.4.1 RFC-NRT-004 §D: optional `pub` field-visibility
        // qualifier. Pre-fix the parser misread `pub x: i64` as a
        // top-level `pub` item nested inside the struct body and
        // crashed with cascading "statement-level keyword at module
        // scope" errors followed by AST corruption (segfault on
        // some hosts). Nucleor's current visibility model treats
        // all struct fields as accessible from importing modules
        // regardless of field-level pub, so the qualifier is parsed
        // and discarded for now (matching Rust shape; field-private
        // enforcement can land later without breaking existing
        // sources).
        if pk(tokens, cp) == 72 { cp = cp + 1; };
        // v0.4.16: optional `mut` field qualifier. Nucleor's current
        // model treats fields as mutable if the owning binding is
        // `let mut`, so the field-level mut is informational only.
        // Pre-fix: `mut value: i64` was parsed as field name = "mut",
        // value field index slipped to -1, runtime vec_set panicked.
        if pk(tokens, cp) == 12 { cp = cp + 1; };
        let fn2: i64 = pkv(tokens, cp); cp = expect_tok(tokens, cp + 1, 42);
        let mut tr: Vec<i32> = parse_type(tokens, cp); cp = pr_pos(tr);
        fields.push(mk3(pool, 41, fn2, pr_val(tr)));
    };
    cp = cp + 1;
    return pr(cp, mk4(pool, 33, name, mk_list(pool, fields), gparams));
}

fn parse_struct_init(tokens: Vec<i32>, pos: i64, pool: Vec<i32>) -> Vec<i32> {
    // pos points at name, next is {
    // v0.5 (v0.4.237) — capture struct-name token byte offset for
    // span-aware diagnostics (TYP-008/012/013/017 struct-init field
    // diags). Each field-init nid (kind 35) also gets the field-
    // name token's offset so per-field diags caret to the offending
    // field, not the function name.
    let struct_name_span: i64 = tok_pos_at(tokens, pos);
    let name: i64 = pkv(tokens, pos);
    let mut cp: i64 = pos + 1;
    cp = skip_angle_group(tokens, cp);
    cp = expect_tok(tokens, cp, 52);
    let mut inits: Vec<i32> = Vec::new();
    while pk(tokens, cp) != 53 && pk(tokens, cp) != 0 {
        if vec_len(inits) > 0 {
            cp = expect_tok(tokens, cp, 44);
            if pk(tokens, cp) == 53 { break; };
        };
        let field_span: i64 = tok_pos_at(tokens, cp);
        let fn2: i64 = pkv(tokens, cp);
        // v0.3.90: shorthand struct init `Point { x, y }`. If the
        // next token after the field name is `,` (44) or `}` (53),
        // synthesize a var-ref expression with the same name as the
        // field (Rust shorthand `Point { x }` → `Point { x: x }`).
        // Without this, the parser called expect_tok(42) (`:`) and
        // failed when the user wrote shorthand.
        if pk(tokens, cp + 1) == 44 || pk(tokens, cp + 1) == 53 {
            let var_node: i64 = mk3(pool, 3, fn2, 0);  // v0.4.209: width slot
            cp = cp + 1;
            let init_nid: i64 = mk3(pool, 35, fn2, var_node);
            node_set_span(pool, init_nid, field_span);
            inits.push(init_nid);
        } else {
            cp = expect_tok(tokens, cp + 1, 42);
            let mut er: Vec<i32> = parse_expr(tokens, cp, pool); cp = pr_pos(er);
            let init_nid: i64 = mk3(pool, 35, fn2, pr_val(er));
            node_set_span(pool, init_nid, field_span);
            inits.push(init_nid);
        };
    };
    cp = cp + 1;
    let struct_nid: i64 = mk3(pool, 34, name, mk_list(pool, inits));
    node_set_span(pool, struct_nid, struct_name_span);
    return pr(cp, struct_nid);
}

fn parse_enum_decl(tokens: Vec<i32>, pos: i64, pool: Vec<i32>) -> Vec<i32> {
    // pos points after 'enum', at the name
    let name: i64 = pkv(tokens, pos);
    let mut cp: i64 = pos + 1;
    // Optional generic params: enum Name<T> { ... }
    let mut gparams: i64 = mk_list(pool, Vec::new());
    if pk(tokens, cp) == 32 {
        let mut gr: Vec<i32> = parse_generic_params(tokens, cp);
        cp = pr_pos(gr);
        gparams = mk_list(pool, pr_val(gr));
    };
    cp = expect_tok(tokens, cp, 52); // {
    let mut variants: Vec<i32> = Vec::new();
    while pk(tokens, cp) != 53 && pk(tokens, cp) != 0 {
        if vec_len(variants) > 0 && pk(tokens, cp) == 44 { cp = cp + 1; };
        if pk(tokens, cp) == 53 || pk(tokens, cp) == 0 { break; };
        let vname: i64 = pkv(tokens, cp); cp = cp + 1;
        let mut ptypes: Vec<i32> = Vec::new();
        if pk(tokens, cp) == 50 {
            cp = cp + 1;
            while pk(tokens, cp) != 51 && pk(tokens, cp) != 0 {
                if vec_len(ptypes) > 0 {
                    cp = expect_tok(tokens, cp, 44);
                    if pk(tokens, cp) == 51 { break; };
                };
                let mut tr: Vec<i32> = parse_type(tokens, cp); ptypes.push(pr_val(tr)); cp = pr_pos(tr);
            };
            cp = cp + 1;
        } else if pk(tokens, cp) == 52 {
            cp = cp + 1;
            while pk(tokens, cp) != 53 && pk(tokens, cp) != 0 {
                if vec_len(ptypes) > 0 {
                    cp = expect_tok(tokens, cp, 44);
                    if pk(tokens, cp) == 53 { break; };
                };
                let _fname: str = pkv(tokens, cp);
                cp = expect_tok(tokens, cp + 1, 42);
                let mut tr: Vec<i32> = parse_type(tokens, cp);
                ptypes.push(pr_val(tr));
                cp = pr_pos(tr);
            };
            cp = expect_tok(tokens, cp, 53);
        };
        variants.push(mk3(pool, 37, vname, mk_list(pool, ptypes)));
    };
    cp = cp + 1;
    return pr(cp, mk4(pool, 36, name, mk_list(pool, variants), gparams));
}

fn parse_trait_decl(tokens: Vec<i32>, pos: i64, pool: Vec<i32>) -> Vec<i32> {
    // pos points after 'trait', at the name
    let name: i64 = pkv(tokens, pos);
    let mut cp: i64 = pos + 1;
    let mut gparams: i64 = mk_list(pool, Vec::new());
    if pk(tokens, cp) == 32 {
        let mut gr: Vec<i32> = parse_generic_params(tokens, cp);
        cp = pr_pos(gr); gparams = mk_list(pool, pr_val(gr));
    };
    // v0.3.110: supertrait syntax `trait Dog: Animal { ... }` and
    // `trait Foo: Bar + Baz { ... }`. Pre-v0.3.110, the parser
    // expected `{` right after the trait name, so the canonical
    // Rust form `trait Dog: Animal { ... }` cascaded into 13+
    // parse errors. Supertrait names are accepted but not yet
    // wired into method dispatch — adopters get the syntactic
    // freedom to express the relationship; trait inheritance
    // semantics (calling super-trait default methods through the
    // sub-trait) already work because the impl block separately
    // implements both traits and method dispatch resolves through
    // the impl_table. Skip ident, optional `+ ident` repeats, and
    // the optional `where` clause until `{`.
    if pk(tokens, cp) == 42 {
        cp = cp + 1;
        cp = cp + 1; // first super-trait name
        // Optional generic args on supertrait `Foo<T>` — skip the angle group.
        if pk(tokens, cp) == 32 { cp = skip_angle_group(tokens, cp); };
        while pk(tokens, cp) == 20 {
            cp = cp + 1;
            cp = cp + 1; // additional super-trait name
            if pk(tokens, cp) == 32 { cp = skip_angle_group(tokens, cp); };
        };
    };
    cp = skip_where_clause(tokens, cp);
    cp = expect_tok(tokens, cp, 52); // {
    let mut methods: Vec<i32> = Vec::new();
    while pk(tokens, cp) != 53 && pk(tokens, cp) != 0 {
        // v0.3.85: associated constants in trait bodies aren't yet
        // supported. Pre-v0.3.85 the `const NAME: T;` line cascaded
        // into 18+ parse errors as expect_tok(fn) failed and the
        // recovery walked through the rest of the trait body
        // mis-aligned. Detect `const` (token 73) and skip to the
        // next stmt boundary with a clear diagnostic.
        if pk(tokens, cp) == 73 {
            print("ERROR: associated constants in traits are not yet supported (e.g. `trait T { const MAX: i64; }`). Workaround: declare the constant at module scope (`const MAX: i64 = 100;`) or as an inherent fn that returns the value. Tracked for a future ship.");
            // v0.4.33: pre-fix the trait body kept parsing after this
            // and the const declaration was silently dropped. Adopters
            // got a trait with missing surface and downstream impls
            // referencing the const failed at clang. Halt now.
            panic("nucleor: associated constants in traits not supported (see ERROR diagnostic above)");
            while pk(tokens, cp) != 0 && pk(tokens, cp) != 43 && pk(tokens, cp) != 53 { cp = cp + 1; };
            if pk(tokens, cp) == 43 { cp = cp + 1; };
            continue;
        };
        cp = expect_tok(tokens, cp, 10); // fn
        let mname: i64 = pkv(tokens, cp); cp = cp + 1;
        // v0.3.89: skip optional generic params on trait method
        // (`fn count<T>(self)` etc.). Pre-v0.3.89 this cascaded into
        // 22+ parse errors. The generic params are accepted but
        // discarded — Nucleor's trait dispatch is monomorphic-by-
        // mangled-name, and the generic types resolve at impl time.
        if pk(tokens, cp) == 32 {
            let mut depth: i64 = 1;
            cp = cp + 1;
            while depth > 0 && pk(tokens, cp) != 0 {
                if pk(tokens, cp) == 32 { depth = depth + 1; };
                if pk(tokens, cp) == 33 { depth = depth - 1; };
                cp = cp + 1;
            };
        };
        cp = expect_tok(tokens, cp, 50); // (
        let mut params: Vec<i32> = Vec::new();
        while pk(tokens, cp) != 51 && pk(tokens, cp) != 0 {
            if vec_len(params) > 0 { cp = expect_tok(tokens, cp, 44); };
            // v0.3.106: `&self` / `&mut self` in trait method
            // declarations. Pre-v0.3.106 the trait parser only
            // recognized bare `self`, so the canonical Rust form
            // `fn say(&self)` cascaded into 13+ parse errors. Mirror
            // the parse_impl_block branch (line 1685) but use a
            // generic `&Self` / `&mut Self` type since no concrete
            // receiver type is known here.
            if pk(tokens, cp) == 82 {
                cp = cp + 1;
                let mut ptype: str = "&Self";
                if pk(tokens, cp) == 12 { ptype = "&mut Self"; cp = cp + 1; };
                let pn2: i64 = pkv(tokens, cp); cp = cp + 1;
                params.push(mk3(pool, 41, pn2, ptype));
            } else {
                let pn: i64 = pkv(tokens, cp); cp = cp + 1;
                if pk(tokens, cp) == 42 {
                    cp = cp + 1;
                    let mut tr: Vec<i32> = parse_type(tokens, cp); cp = pr_pos(tr);
                    params.push(mk3(pool, 41, pn, pr_val(tr)));
                } else {
                    params.push(mk3(pool, 41, pn, "Self"));
                };
            };
        };
        cp = cp + 1; // )
        let mut rtype: str = "void";
        if pk(tokens, cp) == 41 { let mut tr: Vec<i32> = parse_type(tokens, cp + 1); cp = pr_pos(tr); rtype = pr_val(tr); };
        cp = skip_effect_clause(tokens, cp);
        if pk(tokens, cp) == 1 && str_eq(pkv(tokens, cp), "requires") == 1 { cp = skip_bracket_list(tokens, cp + 1); };
        cp = skip_effect_clause(tokens, cp);
        cp = skip_where_clause(tokens, cp);
        if pk(tokens, cp) == 52 {
            // Default method with body
            cp = cp + 1;
            let mut br: Vec<i32> = parse_stmts(tokens, cp, pool);
            cp = expect_tok(tokens, pr_pos(br), 53);
            methods.push(mk5(pool, 44, mname, mk_list(pool, params), rtype, pr_val(br)));
        } else {
            // Required method (no body)
            if pk(tokens, cp) == 43 { cp = cp + 1; };
            methods.push(mk5(pool, 44, mname, mk_list(pool, params), rtype, 0 - 1));
        };
    };
    cp = cp + 1; // }
    return pr(cp, mk4(pool, 43, name, mk_list(pool, methods), gparams));
}

fn parse_impl_block(tokens: Vec<i32>, pos: i64, pool: Vec<i32>) -> Vec<i32> {
    // Supports both `impl Trait for Type { ... }` and `impl Type { ... }`
    let mut first_name: str = pkv(tokens, pos);
    let mut trait_name: str = "";
    let mut type_name: str = first_name;
    let mut cp: i64 = pos + 1;
    if pk(tokens, cp) == 32 {
        let mut first_tr: Vec<i32> = parse_type(tokens, pos);
        first_name = pr_val(first_tr);
        type_name = first_name;
        cp = pr_pos(first_tr);
    };
    if pk(tokens, cp) == 56 {
        trait_name = first_name;
        let mut target_tr: Vec<i32> = parse_type(tokens, cp + 1);
        type_name = pr_val(target_tr);
        cp = pr_pos(target_tr);
    };
    cp = expect_tok(tokens, cp, 52); // {
    let mut methods: Vec<i32> = Vec::new();
    while pk(tokens, cp) != 53 && pk(tokens, cp) != 0 {
        // v0.3.85: associated constants in impl bodies aren't yet
        // supported. Same diagnostic+recovery as trait body.
        if pk(tokens, cp) == 73 {
            print("ERROR: associated constants in impl blocks are not yet supported. Workaround: declare the constant at module scope or as an inherent fn that returns the value. Tracked for a future ship.");
            // v0.4.33: same fix as the trait-body site — pre-fix the
            // const decl was silently dropped from the impl surface.
            panic("nucleor: associated constants in impl blocks not supported (see ERROR diagnostic above)");
            while pk(tokens, cp) != 0 && pk(tokens, cp) != 43 && pk(tokens, cp) != 53 { cp = cp + 1; };
            if pk(tokens, cp) == 43 { cp = cp + 1; };
            continue;
        };
        cp = expect_tok(tokens, cp, 10); // fn
        let mname: i64 = pkv(tokens, cp);
        // Parse as fn_decl but handle self without type annotation
        let mut cp2: i64 = cp + 1;
        let mut mgparams: i64 = mk_list(pool, Vec::new());
        if pk(tokens, cp2) == 32 {
            let mut gr: Vec<i32> = parse_generic_params(tokens, cp2);
            cp2 = pr_pos(gr); mgparams = mk_list(pool, pr_val(gr));
        };
        cp2 = expect_tok(tokens, cp2, 50); // (
        let mut params: Vec<i32> = Vec::new();
        while pk(tokens, cp2) != 51 && pk(tokens, cp2) != 0 {
            if vec_len(params) > 0 { cp2 = expect_tok(tokens, cp2, 44); };
            if pk(tokens, cp2) == 82 {
                cp2 = cp2 + 1;
                let mut ptype: str = str_concat("&", type_name);
                if pk(tokens, cp2) == 12 { ptype = str_concat("&mut ", type_name); cp2 = cp2 + 1; };
                let pn2: i64 = pkv(tokens, cp2); cp2 = cp2 + 1;
                params.push(mk3(pool, 41, pn2, ptype));
            } else {
                let pn: i64 = pkv(tokens, cp2); cp2 = cp2 + 1;
                if str_eq(pn, "self") && pk(tokens, cp2) != 42 {
                // self without type annotation — inject type_name
                    params.push(mk3(pool, 41, pn, type_name));
                } else {
                    cp2 = expect_tok(tokens, cp2, 42); // :
                    let mut tr: Vec<i32> = parse_type(tokens, cp2); cp2 = pr_pos(tr);
                    params.push(mk3(pool, 41, pn, pr_val(tr)));
                };
            };
        };
        cp2 = cp2 + 1; // )
        let mut rtype: str = "void";
        if pk(tokens, cp2) == 41 { let mut tr: Vec<i32> = parse_type(tokens, cp2 + 1); cp2 = pr_pos(tr); rtype = pr_val(tr); };
        // v0.3.111: substitute `Self` (and `&Self` / `&mut Self`) in
        // the return type with the impl's actual `type_name`. Pre-
        // v0.3.111, `impl Point { fn new() -> Self { ... } }` left
        // rtype = "Self" verbatim, so the populate_fn_returns_in_sym
        // pass registered `__fnret_Point__new = "Self"`. Downstream,
        // expr_struct_type couldn't resolve "Self" to a known struct,
        // and the call result fell back to a zero placeholder. The
        // canonical Rust `fn new() -> Self` constructor pattern
        // silently miscomputed (returned 0 instead of the constructed
        // value). Param-side substitution already happens for
        // `&self` / `&mut self` at the param-loop above; this mirrors
        // it for the return slot.
        if str_eq(rtype, "Self") == 1 { rtype = type_name; };
        if str_eq(rtype, "&Self") == 1 { rtype = str_concat("&", type_name); };
        if str_eq(rtype, "&mut Self") == 1 { rtype = str_concat("&mut ", type_name); };
        cp2 = skip_effect_clause(tokens, cp2);
        if pk(tokens, cp2) == 1 && str_eq(pkv(tokens, cp2), "requires") == 1 { cp2 = skip_bracket_list(tokens, cp2 + 1); };
        cp2 = skip_effect_clause(tokens, cp2);
        cp2 = skip_where_clause(tokens, cp2);
        cp2 = expect_tok(tokens, cp2, 52); // {
        let mut br: Vec<i32> = parse_stmts(tokens, cp2, pool);
        cp2 = expect_tok(tokens, pr_pos(br), 53); // }
        methods.push(mk6(pool, 30, mname, mk_list(pool, params), rtype, pr_val(br), mgparams));
        cp = cp2;
    };
    cp = cp + 1; // }
    return pr(cp, mk4(pool, 45, trait_name, type_name, mk_list(pool, methods)));
}

fn parse_match_stmt(tokens: Vec<i32>, pos: i64, pool: Vec<i32>, match_span: i64) -> Vec<i32> {
    // pos is after 'match', at the expression
    let mut er: Vec<i32> = parse_expr(tokens, pos, pool);
    let mut cp: i64 = expect_tok(tokens, pr_pos(er), 52); // {
    let mut arms: Vec<i32> = Vec::new();
    while pk(tokens, cp) != 53 && pk(tokens, cp) != 0 {
        if vec_len(arms) > 0 && pk(tokens, cp) == 44 { cp = cp + 1; };
        if pk(tokens, cp) == 53 || pk(tokens, cp) == 0 { break; };
        let mut pat: Vec<i32> = parse_match_one_pattern(tokens, cp, pool);
        cp = vec_get(pat, 0);
        let ename: str = vec_get(pat, 1);
        let vname: str = vec_get(pat, 2);
        let binding: str = vec_get(pat, 3);
        // v0.4.49: or-patterns (`A | B | C => body`). Pre-fix this
        // silently miscomputed: the parser printed parse errors but
        // continued, the build succeeded, and the match returned the
        // wildcard arm value (e.g. `match 2 { 1 | 2 => 100, _ => 0 }`
        // returned 0). Now: collect the OR'd patterns into pat_list,
        // parse the body once, and push one arm per pattern with the
        // same body + guard. Currently supports int-literal and
        // wildcard patterns (the common case for matching numeric
        // values); enum or-patterns and binding or-patterns fall
        // through to the existing parse-error path with a clear
        // diagnostic for now.
        let mut pat_list: Vec<i32> = Vec::new();
        pat_list.push(ename); pat_list.push(vname); pat_list.push(binding);
        while pk(tokens, cp) == 65 {
            cp = cp + 1;
            let mut orpat: Vec<i32> = parse_match_one_pattern(tokens, cp, pool);
            cp = vec_get(orpat, 0);
            let oren: str = vec_get(orpat, 1);
            let orvn: str = vec_get(orpat, 2);
            let orbn: str = vec_get(orpat, 3);
            if str_eq(pattern_binding_key(ename, binding), pattern_binding_key(oren, orbn)) == 0 {
                print("error[MATCH-008]: or-pattern alternatives must bind the same names");
                panic("nucleor: MATCH-008 or-pattern binding mismatch");
            };
            if str_len(oren) > 0 {
                pat_list.push(oren); pat_list.push(orvn); pat_list.push(orbn);
            };
        };
        // Optional guard: if condition
        let mut guard_nid: i64 = 0;
        if pk(tokens, cp) == 13 {
            cp = cp + 1;
            let mut gr: Vec<i32> = parse_expr(tokens, cp, pool);
            cp = pr_pos(gr);
            guard_nid = pr_val(gr);
        };
        cp = expect_tok(tokens, cp, 64); // =>
        let mut body_list: i64 = 0;
        if pk(tokens, cp) == 52 {
            cp = cp + 1;
            let mut br: Vec<i32> = parse_stmts(tokens, cp, pool);
            cp = expect_tok(tokens, pr_pos(br), 53); // }
            body_list = pr_val(br);
        } else if pk(tokens, cp) == 16 {
            // v0.3.79: arm body `return EXPR` — Rust-style. Parse as a
            // return stmt (kind 22) so the lowering treats it as a
            // divergent stmt rather than an expression. Pre-v0.3.79 this
            // hit parse_expr(return ...) which failed silently and left
            // cp parked on `return`, producing the cascading "expected
            // token 64 got 44/16" parse errors as the next arm's
            // pattern-parse re-entered partway through the previous
            // arm's body.
            cp = cp + 1;
            let mut rstmts: Vec<i32> = Vec::new();
            if pk(tokens, cp) == 43 {
                rstmts.push(mk2(pool, 22, 0 - 1));
                cp = cp + 1;
            } else {
                let mut rer: Vec<i32> = parse_expr(tokens, cp, pool);
                cp = pr_pos(rer);
                rstmts.push(mk2(pool, 22, pr_val(rer)));
            };
            body_list = mk_list(pool, rstmts);
        } else if pk(tokens, cp) == 18 {
            // v0.3.79: arm body `break;` (or bare `break`).
            cp = cp + 1;
            if pk(tokens, cp) == 43 { cp = cp + 1; };
            let mut bstmts: Vec<i32> = Vec::new();
            bstmts.push(mk2(pool, 26, 0));
            body_list = mk_list(pool, bstmts);
        } else if pk(tokens, cp) == 19 {
            // v0.3.79: arm body `continue;` (or bare `continue`).
            cp = cp + 1;
            if pk(tokens, cp) == 43 { cp = cp + 1; };
            let mut cstmts: Vec<i32> = Vec::new();
            cstmts.push(mk2(pool, 27, 0));
            body_list = mk_list(pool, cstmts);
        } else {
            // v0.3.84: detect assignment LHS = RHS in arm body. Pre-v0.3.84,
            // parse_expr stopped at `=` and the result wrapped as kind 25
            // (expression-stmt) — the `= RHS` was silently dropped, so
            // `total = v` arm bodies became no-op expression-stmts of just
            // `total`. Now: parse the LHS expression, then if next token is
            // `=` (40), parse the RHS and produce a kind 21 (assign) stmt.
            // Mirrors parse_stmt's expr-stmt-or-assign discrimination.
            let mut er: Vec<i32> = parse_expr(tokens, cp, pool);
            cp = pr_pos(er);
            let mut stmts: Vec<i32> = Vec::new();
            if pk(tokens, cp) == 40 {
                let mut vr: Vec<i32> = parse_expr(tokens, cp + 1, pool);
                cp = pr_pos(vr);
                stmts.push(mk3(pool, 21, pr_val(er), pr_val(vr)));
            } else {
                stmts.push(mk2(pool, 25, pr_val(er)));
            };
            body_list = mk_list(pool, stmts);
        };
        // v0.4.49: emit one arm per pattern in pat_list (or-patterns).
        // For the common single-pattern case pat_list has exactly one
        // triplet so this is identical to the pre-fix behavior.
        let pcount: i64 = vec_len(pat_list) / 3;
        let mut pi: i64 = 0;
        while pi < pcount {
            let pen: str = vec_get(pat_list, pi * 3);
            let pvn: str = vec_get(pat_list, pi * 3 + 1);
            let pbn: str = vec_get(pat_list, pi * 3 + 2);
            arms.push(mk6(pool, 39, pen, pvn, pbn, body_list, guard_nid));
            pi = pi + 1;
        };
    };
    cp = cp + 1;
    let match_nid: i64 = mk3(pool, 38, pr_val(er), mk_list(pool, arms));
    node_set_span(pool, match_nid, match_span);
    return pr(cp, match_nid);
}

fn has_main_decl(pool: Vec<i32>, items: Vec<i32>) -> i64 {
    let mut i: i64 = 0;
    while i < vec_len(items) {
        let nid: i64 = vec_get(items, i);
        if node_kind(pool, nid) == 30 && str_eq(node_field(pool, nid, 1), "main") { return 1; };
        i = i + 1;
    };
    return 0;
}

fn remove_main_decl(pool: Vec<i32>, items: Vec<i32>) -> Vec<i32> {
    let mut out: Vec<i32> = Vec::new();
    let mut i: i64 = 0;
    while i < vec_len(items) {
        let nid: i64 = vec_get(items, i);
        let mut keep: i64 = 1;
        if node_kind(pool, nid) == 30 && str_eq(node_field(pool, nid, 1), "main") { keep = 0; };
        if node_kind(pool, nid) == 46 && str_eq(node_field(pool, nid, 1), "main") { keep = 0; };
        if keep == 1 { out.push(nid); };
        i = i + 1;
    };
    return out;
}

fn parse_program(tokens: Vec<i32>, pool: Vec<i32>) -> Vec<i32> {
    let mut items: Vec<i32> = Vec::new(); let mut cp: i64 = 0;
    // T1.5b (v0.2.341): track `pub` keyword on top-level items.
    // Previously the `pub` token was silently swallowed. Now: when
    // we see `pub`, we set `pending_pub = 1` and re-enter the loop
    // without consuming any item. The next item we successfully
    // parse gets a marker node (kind 76 = pub_marker) emitted into
    // `items` immediately before the item itself, mirroring the
    // pattern already established for `pure fn` (kind 46). The
    // marker carries the item's name so downstream tools (the
    // visibility surface in `nuc summary`, the `nuc abi --exports`
    // walker, and T1.5c's resolver-layer enforcement) can identify
    // pub items without re-walking the source text.
    let mut pending_pub: i64 = 0;
    while pk(tokens, cp) != 0 {
        if pk(tokens, cp) == 72 {
            pending_pub = 1;
            cp = cp + 1;
        }
        else if pk(tokens, cp) == 20 && pk(tokens, cp + 1) == 10 {
            // extern fn — never carries `pub` (extern is its own visibility).
            let mut r: Vec<i32> = parse_extern_fn(tokens, cp + 2, pool); items.push(pr_val(r)); cp = pr_pos(r);
            pending_pub = 0;
        }
        else if pk(tokens, cp) == 20 && pk(tokens, cp + 1) == 3 && pk(tokens, cp + 2) == 10 {
            // v0.3.112: `extern "C" fn name(...)` (or any ABI string).
            // Pre-v0.3.112, the parser only recognized bare `extern fn`,
            // so the canonical Rust form `extern "C" fn abs(x: i64) -> i64;`
            // cascaded into 4+ parse errors. The ABI string is accepted
            // and discarded — Nucleor's only ABI today is the C calling
            // convention used by all extern declarations, so the explicit
            // marker is informational. Skip ABI literal then call into
            // parse_extern_fn at the `fn` token.
            let mut r: Vec<i32> = parse_extern_fn(tokens, cp + 3, pool); items.push(pr_val(r)); cp = pr_pos(r);
            pending_pub = 0;
        }
        else if pk(tokens, cp) == 73 {
            let mut r: Vec<i32> = parse_const_decl(tokens, cp + 1, pool);
            let nid: i64 = pr_val(r);
            if pending_pub == 1 { items.push(mk2(pool, 76, node_field(pool, nid, 1))); pending_pub = 0; };
            items.push(nid); cp = pr_pos(r);
        }
        else if pk(tokens, cp) == 74 {
            let mut r: Vec<i32> = parse_type_alias_decl(tokens, cp + 1, pool);
            let nid: i64 = pr_val(r);
            if pending_pub == 1 { items.push(mk2(pool, 76, node_field(pool, nid, 1))); pending_pub = 0; };
            items.push(nid); cp = pr_pos(r);
        }
        else if pk(tokens, cp) == 17 {
            let mut r: Vec<i32> = parse_struct_decl(tokens, cp + 1, pool);
            let nid: i64 = pr_val(r);
            if pending_pub == 1 { items.push(mk2(pool, 76, node_field(pool, nid, 1))); pending_pub = 0; };
            items.push(nid); cp = pr_pos(r);
        }
        else if pk(tokens, cp) == 62 {
            let mut r: Vec<i32> = parse_enum_decl(tokens, cp + 1, pool);
            let nid: i64 = pr_val(r);
            if pending_pub == 1 { items.push(mk2(pool, 76, node_field(pool, nid, 1))); pending_pub = 0; };
            items.push(nid); cp = pr_pos(r);
        }
        else if pk(tokens, cp) == 66 {
            let mut r: Vec<i32> = parse_trait_decl(tokens, cp + 1, pool);
            let nid: i64 = pr_val(r);
            if pending_pub == 1 { items.push(mk2(pool, 76, node_field(pool, nid, 1))); pending_pub = 0; };
            items.push(nid); cp = pr_pos(r);
        }
        else if pk(tokens, cp) == 67 {
            // impl blocks don't carry pub (the items inside do).
            let mut r: Vec<i32> = parse_impl_block(tokens, cp + 1, pool); items.push(pr_val(r)); cp = pr_pos(r);
            pending_pub = 0;
        }
        else if pk(tokens, cp) == 1 && str_eq(pkv(tokens, cp), "pure") == 1 && pk(tokens, cp + 1) == 10 {
            // pure fn — parse as fn_decl, mark name with __pure_ prefix internally
            let mut r: Vec<i32> = parse_fn_decl(tokens, cp + 2, pool);
            let fn_nid: i64 = pr_val(r);
            if str_eq(node_field(pool, fn_nid, 1), "main") == 1 && has_main_decl(pool, items) == 1 { items = remove_main_decl(pool, items); };
            // Tag function as pure by storing a marker node (kind 46).
            items.push(mk2(pool, 46, node_field(pool, fn_nid, 1)));
            if pending_pub == 1 { items.push(mk2(pool, 76, node_field(pool, fn_nid, 1))); pending_pub = 0; };
            items.push(fn_nid);
            cp = pr_pos(r);
        }
        else if pk(tokens, cp) == 10 {
            let mut r: Vec<i32> = parse_fn_decl(tokens, cp + 1, pool);
            let fn_nid: i64 = pr_val(r);
            if str_eq(node_field(pool, fn_nid, 1), "main") == 1 && has_main_decl(pool, items) == 1 { items = remove_main_decl(pool, items); };
            if pending_pub == 1 { items.push(mk2(pool, 76, node_field(pool, fn_nid, 1))); pending_pub = 0; };
            items.push(fn_nid);
            cp = pr_pos(r);
        }
        else if pk(tokens, cp) == 11 {
            // v0.3.73: `let` is a statement-level binding — it cannot
            // appear at module scope. Pre-v0.3.73, the parser silently
            // skipped the entire `let NAME: T = EXPR;` token-by-token
            // and downstream codegen emitted `@NAME` references that
            // failed at clang link with "use of undefined value '@NAME'"
            // when main referenced the binding. Surface a clear
            // diagnostic with the canonical workaround (`const`) and
            // skip the let-stmt cleanly so the rest of the program
            // still parses for any other diagnostics the user needs.
            // v0.4.79: was print + skip to `;` — silent miscompute,
            // the `let` binding was dropped from the module surface
            // and any downstream reference produced broken IR.
            print("ERROR: `let` is not allowed at module scope. Use `const NAME: T = VALUE;` for module-scope constants. (`let` is statement-only — the parser previously dropped this declaration silently and emitted broken IR.)");
            panic("nucleor: `let` at module scope not allowed (see ERROR diagnostic above)");
        }
        else if pk(tokens, cp) == 13 || pk(tokens, cp) == 15 || pk(tokens, cp) == 16 || pk(tokens, cp) == 18 || pk(tokens, cp) == 19 || pk(tokens, cp) == 56 || pk(tokens, cp) == 63 {
            // v0.3.75: catch other statement-level keywords at module
            // scope. `if` (13), `while` (15), `return` (16), `break` (18),
            // `continue` (19), `for` (56), `match` (63) all belong inside
            // fn bodies — at module scope they have no
            // (v0.3.141: `loop` removed from this list since it became
            // a contextual identifier-keyword; the contextual form is
            // already caught at parse_stmts level. Top-level `loop {`
            // would now silently skip — accepted limitation since the
            // top-level form has zero usage in the codebase.)
            // meaning and the pre-v0.3.75 silent fall-through dropped
            // them token-by-token. Surface a clear diagnostic so the
            // user sees their malformed top-level construct named
            // explicitly. Recovery: skip to the next semicolon (43)
            // OR the next opening brace (40) — whichever comes first
            // — so block-form constructs (`if/while/loop { ... }`)
            // get cleaned up in one go rather than dribbling broken
            // body tokens through the rest of the program.
            // v0.4.79: was print + skip-block recover — silent
            // miscompute, the stmt at module scope was dropped and
            // any reference to its bindings produced broken IR.
            print("ERROR: statement-level keyword at module scope. Only `fn`, `extern fn`, `pure fn`, `const`, `type`, `struct`, `enum`, `trait`, `impl`, and `pub` (with the above) are allowed as top-level items. Move statement-level constructs into a fn body.");
            panic("nucleor: statement-level keyword at module scope (see ERROR diagnostic above)");
        }
        else { cp = cp + 1; pending_pub = 0; };
    };
    return pr(cp, mk_list(pool, items));
}

// =====================================================
// IR DATA STRUCTURES (from T29, extended)
// =====================================================
fn ir_inst(op: i64, d: i64, tid: i64, o1: i64, o2: i64, ex: i64) -> Vec<i32> {
    let mut ii: Vec<i32> = Vec::with_capacity(6); ii.push(op); ii.push(d); ii.push(tid); ii.push(o1); ii.push(o2); ii.push(ex); return ii;
}
fn ir_op(ii: Vec<i32>) -> i64 { return vec_get(ii, 0); }
fn ir_dest(ii: Vec<i32>) -> i64 { return vec_get(ii, 1); }
// v0.4.196 RFC-0015 phase 3a: slot 2 is a width tag for IR ops that
// reference a typed memory slot (alloca/load/store). 0 = "i64" default
// (current behavior); 8/16/32 select narrower LLVM types. Other ops
// leave the slot 0; emit dispatch only consults it for ops 16/17/18.
fn ir_tid(ii: Vec<i32>) -> i64 { return vec_get(ii, 2); }
fn ir_op1(ii: Vec<i32>) -> i64 { return vec_get(ii, 3); }
fn ir_op2(ii: Vec<i32>) -> i64 { return vec_get(ii, 4); }
fn ir_extra(ii: Vec<i32>) -> i64 { return vec_get(ii, 5); }

// v0.4.196 RFC-0015 phase 3a: width → LLVM integer type. Default 0
// means "no explicit width" → i64 (matches all pre-phase-3 emits).
fn width_to_llvm_type(w: i64) -> str {
    if w == 8  { return "i8"; };
    if w == 16 { return "i16"; };
    if w == 32 { return "i32"; };
    if w == 1  { return "i1"; };
    return "i64";
}

fn is_atomic_ordered_builtin(name: str) -> i64 {
    if str_starts_with(name, "atomic_i64_load_") == 1 {
        if str_ends_with(name, "_relaxed") == 1 || str_ends_with(name, "_acquire") == 1 || str_ends_with(name, "_seqcst") == 1 { return 1; };
        return 0;
    };
    if str_starts_with(name, "atomic_i64_store_") == 1 {
        if str_ends_with(name, "_relaxed") == 1 || str_ends_with(name, "_release") == 1 || str_ends_with(name, "_seqcst") == 1 { return 1; };
        return 0;
    };
    if str_starts_with(name, "atomic_i64_fetch_add_") == 1 || str_starts_with(name, "atomic_i64_fetch_sub_") == 1 || str_starts_with(name, "atomic_i64_fetch_and_") == 1 || str_starts_with(name, "atomic_i64_fetch_or_") == 1 || str_starts_with(name, "atomic_i64_fetch_xor_") == 1 {
        if str_ends_with(name, "_relaxed") == 1 || str_ends_with(name, "_acquire") == 1 || str_ends_with(name, "_release") == 1 || str_ends_with(name, "_acqrel") == 1 || str_ends_with(name, "_seqcst") == 1 { return 1; };
        return 0;
    };
    if str_starts_with(name, "atomic_i64_swap_") == 1 {
        if str_ends_with(name, "_relaxed") == 1 || str_ends_with(name, "_acquire") == 1 || str_ends_with(name, "_release") == 1 || str_ends_with(name, "_acqrel") == 1 || str_ends_with(name, "_seqcst") == 1 { return 1; };
        return 0;
    };
    if str_starts_with(name, "atomic_i64_compare_exchange_") == 1 {
        if str_ends_with(name, "_relaxed_relaxed") == 1 { return 1; };
        if str_ends_with(name, "_acquire_relaxed") == 1 || str_ends_with(name, "_acquire_acquire") == 1 { return 1; };
        if str_ends_with(name, "_release_relaxed") == 1 { return 1; };
        if str_ends_with(name, "_acqrel_relaxed") == 1 || str_ends_with(name, "_acqrel_acquire") == 1 { return 1; };
        if str_ends_with(name, "_seqcst_relaxed") == 1 || str_ends_with(name, "_seqcst_acquire") == 1 || str_ends_with(name, "_seqcst_seqcst") == 1 { return 1; };
        return 0;
    };
    return 0;
}

fn atomic_tail_order_llvm(name: str) -> str {
    if str_contains(name, "_seqcst") == 1 { return "seq_cst"; };
    if str_contains(name, "_acqrel") == 1 { return "acq_rel"; };
    if str_contains(name, "_release") == 1 { return "release"; };
    if str_contains(name, "_acquire") == 1 { return "acquire"; };
    return "monotonic";
}

fn atomic_cmpxchg_success_order_llvm(name: str) -> str {
    if str_contains(name, "compare_exchange_seqcst_") == 1 { return "seq_cst"; };
    if str_contains(name, "compare_exchange_acqrel_") == 1 { return "acq_rel"; };
    if str_contains(name, "compare_exchange_release_") == 1 { return "release"; };
    if str_contains(name, "compare_exchange_acquire_") == 1 { return "acquire"; };
    return "monotonic";
}

fn atomic_cmpxchg_failure_order_llvm(name: str) -> str {
    if str_contains(name, "_seqcst_seqcst") == 1 { return "seq_cst"; };
    if str_contains(name, "_acquire_acquire") == 1 { return "acquire"; };
    if str_contains(name, "_acqrel_acquire") == 1 { return "acquire"; };
    if str_contains(name, "_seqcst_acquire") == 1 { return "acquire"; };
    return "monotonic";
}

fn atomic_rmw_op_llvm(name: str) -> str {
    // Order matters: check `swap` before the fetch_* family. The new
    // ordered helper `atomic_i64_swap_<order>` lowers to `atomicrmw
    // xchg`. Default fall-through is `add` for fetch_add (no infix).
    if str_contains(name, "_swap_") == 1 { return "xchg"; };
    if str_contains(name, "fetch_sub") == 1 { return "sub"; };
    if str_contains(name, "fetch_and") == 1 { return "and"; };
    if str_contains(name, "fetch_or") == 1 { return "or"; };
    if str_contains(name, "fetch_xor") == 1 { return "xor"; };
    return "add";
}

fn emit_atomic_ordered_call(sb: i64, name: str, d: i64, argc: i64, args: Vec<i32>) -> i64 {
    let ds: str = str_from_int(d);
    if argc <= 0 {
        sb_append(sb, "  %r."); sb_append(sb, ds); sb_append(sb, " = add i64 0, 0\n");
        return 0;
    };
    sb_append(sb, "  %r."); sb_append(sb, ds); sb_append(sb, ".atomic.ptr = inttoptr i64 %r.");
    sb_append(sb, str_from_int(vec_get(args, 0))); sb_append(sb, " to ptr\n");
    if str_starts_with(name, "atomic_i64_load_") == 1 {
        sb_append(sb, "  %r."); sb_append(sb, ds); sb_append(sb, " = load atomic i64, ptr %r.");
        sb_append(sb, ds); sb_append(sb, ".atomic.ptr "); sb_append(sb, atomic_tail_order_llvm(name));
        sb_append(sb, ", align 8\n");
        return 0;
    };
    if str_starts_with(name, "atomic_i64_store_") == 1 {
        if argc > 1 {
            sb_append(sb, "  store atomic i64 %r."); sb_append(sb, str_from_int(vec_get(args, 1)));
            sb_append(sb, ", ptr %r."); sb_append(sb, ds); sb_append(sb, ".atomic.ptr ");
            sb_append(sb, atomic_tail_order_llvm(name)); sb_append(sb, ", align 8\n");
        };
        sb_append(sb, "  %r."); sb_append(sb, ds); sb_append(sb, " = add i64 0, 0\n");
        return 0;
    };
    if str_starts_with(name, "atomic_i64_compare_exchange_") == 1 {
        if argc >= 3 {
            sb_append(sb, "  %r."); sb_append(sb, ds); sb_append(sb, ".atomic.pair = cmpxchg ptr %r.");
            sb_append(sb, ds); sb_append(sb, ".atomic.ptr, i64 %r.");
            sb_append(sb, str_from_int(vec_get(args, 1))); sb_append(sb, ", i64 %r.");
            sb_append(sb, str_from_int(vec_get(args, 2))); sb_append(sb, " ");
            sb_append(sb, atomic_cmpxchg_success_order_llvm(name)); sb_append(sb, " ");
            sb_append(sb, atomic_cmpxchg_failure_order_llvm(name)); sb_append(sb, "\n");
            sb_append(sb, "  %r."); sb_append(sb, ds); sb_append(sb, " = extractvalue { i64, i1 } %r.");
            sb_append(sb, ds); sb_append(sb, ".atomic.pair, 0\n");
        } else {
            sb_append(sb, "  %r."); sb_append(sb, ds); sb_append(sb, " = add i64 0, 0\n");
        };
        return 0;
    };
    if argc > 1 {
        sb_append(sb, "  %r."); sb_append(sb, ds); sb_append(sb, " = atomicrmw ");
        sb_append(sb, atomic_rmw_op_llvm(name)); sb_append(sb, " ptr %r."); sb_append(sb, ds);
        sb_append(sb, ".atomic.ptr, i64 %r."); sb_append(sb, str_from_int(vec_get(args, 1)));
        sb_append(sb, " "); sb_append(sb, atomic_tail_order_llvm(name)); sb_append(sb, "\n");
    } else {
        sb_append(sb, "  %r."); sb_append(sb, ds); sb_append(sb, " = add i64 0, 0\n");
    };
    return 0;
}

// v0.4.196 RFC-0015 phase 3a: typed allocas/loads/stores. Existing
// untyped builders (ir_alloca, ir_load, ir_store) call these with
// width=0 to preserve byte-identical IR output for current call sites.
fn ir_alloca_t(d: i64, w: i64) -> Vec<i32> { return ir_inst(16, d, w, 0, 0, 0); }
fn ir_load_t(d: i64, ptr: i64, w: i64) -> Vec<i32> { return ir_inst(17, d, w, ptr, 0, 0); }
fn ir_store_t(v: i64, ptr: i64, w: i64) -> Vec<i32> { return ir_inst(18, 0, w, v, ptr, 0); }

// v0.4.197 RFC-0015 phase 3a-step-2: sext + trunc IR ops for crossing
// the narrower-slot ↔ i64-arith boundary. Used by future call sites
// that wire typed allocas: load narrower value with `ir_load_t(reg,
// slot, w)`, then `ir_sext(wide, reg, w)` to widen for arith. Symmetric
// trunc on the store side: `ir_trunc(narrow, val, w)` then
// `ir_store_t(narrow, slot, w)`. Encoding: op 32 = sext, op 33 = trunc;
// slot 2 carries the SOURCE width (sext) or TARGET width (trunc).
// emit_inst dispatch reads the width tag and emits the right LLVM op.
fn ir_sext(d: i64, src: i64, src_w: i64) -> Vec<i32> { return ir_inst(32, d, src_w, src, 0, 0); }
// v0.4.209 RFC-0015 phase 3a-step-3: zext companion to ir_sext for
// unsigned narrow types (u8/u16). Same shape as ir_sext but emits
// `zext iX %S to i64` (zero-extension, top bits cleared) instead of
// `sext` (sign-extension). Required because u16 max (65535) sext'd
// to i64 becomes -1; zext'd it stays 65535. Op 34.
fn ir_zext(d: i64, src: i64, src_w: i64) -> Vec<i32> { return ir_inst(34, d, src_w, src, 0, 0); }
fn ir_trunc(d: i64, src: i64, dst_w: i64) -> Vec<i32> { return ir_inst(33, d, dst_w, src, 0, 0); }

fn ir_const_int(d: i64, v: i64) -> Vec<i32> { return ir_inst(0, d, 0, v, 0, 0); }
fn ir_binop(iop: i64, d: i64, a: i64, b: i64) -> Vec<i32> { return ir_inst(iop, d, 0, a, b, 0); }
// v0.4.211 RFC-0015 phase 3b: typed binop. Same op codes as ir_binop
// (2..6 for arith, 7..12 for cmp, 13..15 + 23..24 for bitwise/shift)
// but slot 2 carries the operand width (8/16/32). emit_inst dispatch
// reads tid: 0 stays at i64 (byte-identical fast path); >0 emits
// `<op> iN`. Caller is lower_expr kind 4 narrow path.
fn ir_binop_t(iop: i64, d: i64, a: i64, b: i64, w: i64) -> Vec<i32> { return ir_inst(iop, d, w, a, b, 0); }
// v0.5 3e.1 spike: signed LLVM overflow-intrinsic arithmetic.
// Opcodes 35/36/37 mirror add/sub/mul. tid carries width (0 => i64),
// extra carries the trap label; the continuation label is trap + 1.
fn ir_add_with_overflow(d: i64, a: i64, b: i64, w: i64, trap_lbl: i64) -> Vec<i32> { return ir_inst(35, d, w, a, b, trap_lbl); }
fn ir_sub_with_overflow(d: i64, a: i64, b: i64, w: i64, trap_lbl: i64) -> Vec<i32> { return ir_inst(36, d, w, a, b, trap_lbl); }
fn ir_mul_with_overflow(d: i64, a: i64, b: i64, w: i64, trap_lbl: i64) -> Vec<i32> { return ir_inst(37, d, w, a, b, trap_lbl); }
fn ir_binop_overflow(iop: i64, d: i64, a: i64, b: i64, w: i64, trap_lbl: i64) -> Vec<i32> {
    if iop == 2 { return ir_add_with_overflow(d, a, b, w, trap_lbl); };
    if iop == 3 { return ir_sub_with_overflow(d, a, b, w, trap_lbl); };
    if iop == 4 { return ir_mul_with_overflow(d, a, b, w, trap_lbl); };
    return ir_binop_t(iop, d, a, b, w);
}
fn ir_cmpop(iop: i64, d: i64, a: i64, b: i64) -> Vec<i32> { return ir_inst(iop, d, 0, a, b, 0); }
fn ir_alloca(d: i64) -> Vec<i32> { return ir_inst(16, d, 0, 0, 0, 0); }
fn ir_load(d: i64, ptr: i64) -> Vec<i32> { return ir_inst(17, d, 0, ptr, 0, 0); }
fn ir_store(v: i64, ptr: i64) -> Vec<i32> { return ir_inst(18, 0, 0, v, ptr, 0); }
fn ir_ret(v: i64) -> Vec<i32> { return ir_inst(20, 0, 0, v, 0, 0); }
fn ir_br(lbl: i64) -> Vec<i32> { return ir_inst(21, 0, 0, lbl, 0, 0); }
fn ir_br_cond(cond: i64, t: i64, f: i64) -> Vec<i32> { return ir_inst(22, 0, 0, cond, t, f); }
fn ir_param_ref(d: i64, pidx: i64) -> Vec<i32> { return ir_inst(26, d, 0, pidx, 0, 0); }
fn ir_const_str(d: i64, str_idx: i64) -> Vec<i32> { return ir_inst(27, d, 0, str_idx, 0, 0); }
fn ir_call_ex(d: i64, fn_name: str, args: Vec<i32>) -> Vec<i32> {
    let mut ii: Vec<i32> = Vec::with_capacity(6);
    ii.push(19); ii.push(d); ii.push(0); ii.push(fn_name); ii.push(vec_len(args)); ii.push(args);
    return ii;
}

// v0.3.126: ir_user_call — bypass the runtime-helper name lookup
// in emit_inst so a user-defined fn that happens to share a name
// with a runtime helper (e.g. user `pow(base, exp)`) dispatches
// to `@pow` (the user-emitted definition) instead of being
// hijacked by `@__nucleor_pow` (the f64 floating-point helper).
// Pre-v0.3.126 the runtime helper always won — silent miscompute
// with NO diagnostic for the very-common pattern of writing a
// math helper named the same as a builtin.
fn ir_user_call(d: i64, fn_name: str, args: Vec<i32>) -> Vec<i32> {
    let mut ii: Vec<i32> = Vec::with_capacity(6);
    ii.push(31); ii.push(d); ii.push(0); ii.push(fn_name); ii.push(vec_len(args)); ii.push(args);
    return ii;
}

fn ir_fn_ptr(d: i64, fn_name: str) -> Vec<i32> {
    let mut ii: Vec<i32> = Vec::with_capacity(6);
    ii.push(29); ii.push(d); ii.push(0); ii.push(fn_name); ii.push(0); ii.push(0);
    return ii;
}
fn ir_indirect_call(d: i64, closure_reg: i64, args: Vec<i32>) -> Vec<i32> {
    let mut ii: Vec<i32> = Vec::with_capacity(6);
    ii.push(30); ii.push(d); ii.push(0); ii.push(closure_reg); ii.push(vec_len(args)); ii.push(args);
    return ii;
}

fn ir_block_new(lbl: i64) -> Vec<i32> {
    let mut b: Vec<i32> = Vec::with_capacity(2); b.push(lbl);
    let mut insts: Vec<i32> = Vec::new(); b.push(insts); return b;
}
fn ir_block_label(b: Vec<i32>) -> i64 { return vec_get(b, 0); }
fn ir_block_add(b: Vec<i32>, inst: Vec<i32>) -> i64 { let mut insts: Vec<i32> = vec_get(b, 1); insts.push(inst); return 0; }
fn ir_block_inst_count(b: Vec<i32>) -> i64 { let insts: Vec<i32> = vec_get(b, 1); return vec_len(insts); }
fn ir_block_get_inst(b: Vec<i32>, idx: i64) -> Vec<i32> { let insts: Vec<i32> = vec_get(b, 1); return vec_get(insts, idx); }

fn ir_fn_new(name: str, pc: i64) -> Vec<i32> {
    let mut f: Vec<i32> = Vec::with_capacity(5); f.push(name); f.push(pc);
    let mut entry_allocas: Vec<i32> = Vec::new(); f.push(entry_allocas);
    let mut blocks: Vec<i32> = Vec::new(); f.push(blocks);
    // v0.4.209 RFC-0015 phase 3a-step-3 (Option F-light): per-fn
    // widths-by-reg table. Slot 4 stores a Vec<i32> indexed by
    // alloca-reg id; values are sign-encoded narrow widths
    // (positive=signed, negative=unsigned, 0=untyped/i64). Grows
    // on demand at set time. Read at every var-ref load + store
    // for typed-IR dispatch. Two vec_gets per read on the hot path
    // — no str_concat, no sym_get hash.
    let mut widths_by_reg: Vec<i32> = Vec::new(); f.push(widths_by_reg);
    return f;
}
fn ir_fn_set_width(f: Vec<i32>, reg: i64, w: i64) -> i64 {
    let mut widths: Vec<i32> = vec_get(f, 4);
    while vec_len(widths) <= reg { widths.push(0); };
    vec_set(widths, reg, w);
    return 0;
}
fn ir_fn_get_width(f: Vec<i32>, reg: i64) -> i64 {
    let widths: Vec<i32> = vec_get(f, 4);
    if reg >= vec_len(widths) { return 0; };
    return vec_get(widths, reg);
}
fn ir_fn_name(f: Vec<i32>) -> str { return vec_get(f, 0); }
fn ir_fn_param_count(f: Vec<i32>) -> i64 { return vec_get(f, 1); }
fn ir_fn_add_block(f: Vec<i32>, blk: Vec<i32>) -> i64 { let mut b: Vec<i32> = vec_get(f, 3); b.push(blk); return 0; }
fn ir_fn_block_count(f: Vec<i32>) -> i64 { let b: Vec<i32> = vec_get(f, 3); return vec_len(b); }
fn ir_fn_get_block(f: Vec<i32>, idx: i64) -> Vec<i32> { let b: Vec<i32> = vec_get(f, 3); return vec_get(b, idx); }
fn ir_fn_add_entry_alloca(f: Vec<i32>, reg: i64) -> i64 {
    let mut ea: Vec<i32> = vec_get(f, 2);
    ea.push(ir_alloca(reg));
    return 0;
}

// v0.4.199 RFC-0015 phase 3a-step-3: typed entry-alloca for narrower-
// width bindings. Caller is lower_stmt kind-20 (let) when the binding's
// declared type is i8/i16/u8/u16/etc. width=0 falls back to untyped
// (i64) for back-compat.
fn ir_fn_add_entry_alloca_t(f: Vec<i32>, reg: i64, w: i64) -> i64 {
    let mut ea: Vec<i32> = vec_get(f, 2);
    if w == 0 { ea.push(ir_alloca(reg)); } else { ea.push(ir_alloca_t(reg, w)); };
    return 0;
}

fn free_ir_inst(ii: Vec<i32>) -> i64 {
    let op: i64 = ir_op(ii);
    if op == 19 || op == 30 || op == 31 {
        let args: Vec<i32> = vec_get(ii, 5);
        vec_free(args);
    };
    vec_free(ii);
    return 0;
}

fn free_ir_fn(f: Vec<i32>) -> i64 {
    let entry_allocas: Vec<i32> = vec_get(f, 2);
    let mut ai: i64 = 0;
    while ai < vec_len(entry_allocas) {
        free_ir_inst(vec_get(entry_allocas, ai));
        ai = ai + 1;
    };
    vec_free(entry_allocas);
    let blocks: Vec<i32> = vec_get(f, 3);
    let mut bi: i64 = 0;
    while bi < vec_len(blocks) {
        let blk: Vec<i32> = vec_get(blocks, bi);
        let insts: Vec<i32> = vec_get(blk, 1);
        let mut ii: i64 = 0;
        while ii < vec_len(insts) {
            free_ir_inst(vec_get(insts, ii));
            ii = ii + 1;
        };
        vec_free(insts);
        vec_free(blk);
        bi = bi + 1;
    };
    vec_free(blocks);
    vec_free(f);
    return 0;
}

fn free_ir_fns(fns: Vec<i32>) -> i64 {
    let mut fi: i64 = 0;
    while fi < vec_len(fns) {
        free_ir_fn(vec_get(fns, fi));
        fi = fi + 1;
    };
    vec_free(fns);
    return 0;
}

fn block_has_term(blk: Vec<i32>) -> i64 {
    let ic: i64 = ir_block_inst_count(blk);
    if ic == 0 { return 0; };
    let op: i64 = ir_op(ir_block_get_inst(blk, ic - 1));
    if op == 20 || op == 21 || op == 22 { return 1; }; return 0;
}

// =====================================================
// OPTIMIZER PASSES (S6)
// =====================================================

// --- Constant map: tracks register -> constant value ---
fn cmap_new() -> Vec<i32> { let mut m: Vec<i32> = Vec::new(); return m; }
fn cmap_set(m: Vec<i32>, reg: i64, val: i64) -> i64 {
    let mc: i64 = vec_len(m);
    let mut i: i64 = 0;
    while i < mc {
        if vec_get(m, i) == reg { vec_set(m, i + 1, val); return 0; };
        i = i + 2;
    };
    m.push(reg); m.push(val); return 0;
}
fn cmap_get(m: Vec<i32>, reg: i64) -> i64 {
    let mc: i64 = vec_len(m);
    let mut i: i64 = 0;
    while i < mc {
        if vec_get(m, i) == reg { return vec_get(m, i + 1); };
        i = i + 2;
    };
    return 0 - 9999999;
}
fn cmap_has(m: Vec<i32>, reg: i64) -> i64 {
    let mc: i64 = vec_len(m);
    let mut i: i64 = 0;
    while i < mc {
        if vec_get(m, i) == reg { return 1; };
        i = i + 2;
    };
    return 0;
}

// --- Pass 1: Constant Folding ---
// Scans instructions in a block. When both operands of an arithmetic/comparison
// op are known constants, replaces the instruction with a const_int.
fn opt_fold_block(blk: Vec<i32>) -> i64 {
    let mut cm: Vec<i32> = cmap_new();
    let ic: i64 = ir_block_inst_count(blk);
    let insts: Vec<i32> = vec_get(blk, 1);
    let mut folded: i64 = 0;
    let mut i: i64 = 0;
    while i < ic {
        let inst: Vec<i32> = vec_get(insts, i);
        let op: i64 = ir_op(inst);
        let d: i64 = ir_dest(inst);
        // Track const_int values
        if op == 0 {
            cmap_set(cm, d, ir_op1(inst));
        }
        // Fold arithmetic: add(2), sub(3), mul(4), div(5), mod(6).
        // v0.3.145: div/mod by zero must NOT fold. Pre-v0.3.145, the
        // `else { i = i + 1; }` branch on `vb == 0` pre-incremented `i`
        // (so the outer `i = i + 1` at the bottom of the loop skipped
        // the next instruction entirely) AND fell through to the
        // vec_set lines that replaced the divide with `const_int 0`.
        // Two compounding bugs: (a) silent miscompute — `100 / 0` became
        // const 0 instead of trapping at runtime, (b) the very next
        // IR instruction silently disappeared from the block. Adopters
        // who wrote any literal `x / 0` (typically as a deliberate
        // panic test or a bug introduced during refactoring) saw the
        // program return 0 and silently skip whatever statement
        // followed.
        //
        // Fix: when divisor is zero, skip the fold entirely (leave the
        // div/mod instruction in place — at runtime LLVM `sdiv i64 X, 0`
        // is undefined behavior, typically SIGFPE, which is a loud
        // failure the adopter actually sees). Do NOT touch `i`.
        else if op >= 2 && op <= 6 {
            let a: i64 = ir_op1(inst);
            let b: i64 = ir_op2(inst);
            if cmap_has(cm, a) == 1 && cmap_has(cm, b) == 1 {
                let va: i64 = cmap_get(cm, a);
                let vb: i64 = cmap_get(cm, b);
                let mut do_fold: i64 = 1;
                let mut result: i64 = 0;
                // v0.3.208: use wrapping_* in the fold so the
                // compiler's own constant-folding pass doesn't
                // panic when both operands are known and the
                // result overflows. Strict-mode runtime emit will
                // still panic at runtime; the fold matches that
                // bit-pattern (so folded == unfolded for any
                // computable constant pair).
                if op == 2 { result = wrapping_add(va, vb); }
                else if op == 3 { result = wrapping_sub(va, vb); }
                else if op == 4 { result = wrapping_mul(va, vb); }
                else if op == 5 {
                    if vb != 0 { result = va / vb; } else { do_fold = 0; };
                }
                else if op == 6 {
                    if vb != 0 { result = va - (va / vb) * vb; } else { do_fold = 0; };
                };
                if do_fold == 1 {
                    vec_set(inst, 0, 0);
                    vec_set(inst, 3, result);
                    vec_set(inst, 4, 0);
                    vec_set(inst, 5, 0);
                    cmap_set(cm, d, result);
                    folded = folded + 1;
                };
            };
        }
        // Fold comparisons: eq(7), ne(8), slt(9), sgt(10), sle(11), sge(12)
        else if op >= 7 && op <= 12 {
            let a: i64 = ir_op1(inst);
            let b: i64 = ir_op2(inst);
            if cmap_has(cm, a) == 1 && cmap_has(cm, b) == 1 {
                let va: i64 = cmap_get(cm, a);
                let vb: i64 = cmap_get(cm, b);
                let mut result: i64 = 0;
                if op == 7 { if va == vb { result = 1; }; }
                else if op == 8 { if va != vb { result = 1; }; }
                else if op == 9 { if va < vb { result = 1; }; }
                else if op == 10 { if va > vb { result = 1; }; }
                else if op == 11 { if va <= vb { result = 1; }; }
                else if op == 12 { if va >= vb { result = 1; }; };
                vec_set(inst, 0, 0);
                vec_set(inst, 3, result);
                vec_set(inst, 4, 0);
                vec_set(inst, 5, 0);
                cmap_set(cm, d, result);
                folded = folded + 1;
            };
        }
        // v0.3.103: Fold bitwise: and(13), or(14), xor(15). Pre-v0.3.103
        // ops 13/14 were folded with LOGICAL semantics (`va != 0 && vb != 0`
        // → 1 or 0), which matched the historical interpretation of
        // these iops as `&&`/`||`. But the runtime LLVM emit for these
        // iops is `and i64`/`or i64` — pure bitwise — so the const-fold
        // was diverging from what the un-folded code would compute. With
        // bitwise `&` `|` `^` now wired through these iops too, fold
        // bitwise so both paths produce identical answers for constant
        // inputs (e.g. 255 & 15 → 15, not 1 from "both truthy").
        //
        // v0.3.103: Fold bitwise: and(13), or(14), xor(15).
        //
        // v0.3.147: skip the bitwise fold when either operand is negative.
        // The while-shift bit-extraction below uses
        // `ra - (ra/2)*2 == 1` to detect a set LSB. For negative odd ra,
        // C-style integer division (Nucleor's semantics) rounds toward
        // zero so `ra/2` underflows: `-1/2 == 0` and `-1 - 0*2 == -1`,
        // not `1`. The `== 1` check fails, the bit is never recorded as
        // set, and the entire fold collapses high-bit operands to ~0.
        // `255 & -1` const-folded to `0` instead of `255`. Adopters
        // using bitmasks against `-1` (all-ones sentinel) silently
        // computed wrong values. The runtime LLVM `and i64` is correct
        // on signed-i64-as-bits — the bug is purely the s1-emulated fold.
        // Safe fallback: don't fold negative operands; let runtime LLVM
        // compute it. (The same fold-skip pattern as v0.3.145 div/mod
        // by zero, using a do_fold flag so the loop counter isn't
        // touched.)
        else if op == 13 || op == 14 || op == 15 {
            let a: i64 = ir_op1(inst);
            let b: i64 = ir_op2(inst);
            if cmap_has(cm, a) == 1 && cmap_has(cm, b) == 1 {
                let va: i64 = cmap_get(cm, a);
                let vb: i64 = cmap_get(cm, b);
                let mut do_bit_fold: i64 = 1;
                if va < 0 { do_bit_fold = 0; };
                if vb < 0 { do_bit_fold = 0; };
                if do_bit_fold == 1 {
                let mut result: i64 = 0;
                // Use sym_get's hash-style int-pair AND emulation: Nucleor
                // doesn't expose a `&` operator at this self-host level
                // either (chicken-and-egg), so do it via while-shift.
                if op == 13 {
                    let mut acc: i64 = 0;
                    let mut bit: i64 = 1;
                    let mut ra: i64 = va;
                    let mut rb: i64 = vb;
                    let mut k: i64 = 0;
                    while k < 64 {
                        if ra - (ra / 2) * 2 == 1 && rb - (rb / 2) * 2 == 1 { acc = wrapping_add(acc, bit); };
                        ra = ra / 2; rb = rb / 2; bit = wrapping_add(bit, bit);
                        k = k + 1;
                    };
                    result = acc;
                } else if op == 14 {
                    let mut acc: i64 = 0;
                    let mut bit: i64 = 1;
                    let mut ra: i64 = va;
                    let mut rb: i64 = vb;
                    let mut k: i64 = 0;
                    while k < 64 {
                        if ra - (ra / 2) * 2 == 1 || rb - (rb / 2) * 2 == 1 { acc = wrapping_add(acc, bit); };
                        ra = ra / 2; rb = rb / 2; bit = wrapping_add(bit, bit);
                        k = k + 1;
                    };
                    result = acc;
                } else {
                    let mut acc: i64 = 0;
                    let mut bit: i64 = 1;
                    let mut ra: i64 = va;
                    let mut rb: i64 = vb;
                    let mut k: i64 = 0;
                    while k < 64 {
                        let bita: i64 = ra - (ra / 2) * 2;
                        let bitb: i64 = rb - (rb / 2) * 2;
                        if bita != bitb { acc = wrapping_add(acc, bit); };
                        ra = ra / 2; rb = rb / 2; bit = wrapping_add(bit, bit);
                        k = k + 1;
                    };
                    result = acc;
                };
                vec_set(inst, 0, 0);
                vec_set(inst, 3, result);
                vec_set(inst, 4, 0);
                vec_set(inst, 5, 0);
                cmap_set(cm, d, result);
                folded = folded + 1;
                };
            };
        };
        i = i + 1;
    };
    return folded;
}

// --- Pass 2: Dead Code Elimination ---
// Removes instructions whose dest register is never used by any later instruction.
// Side-effecting ops (store, call, ret, br, br_cond, alloca) are never removed.
fn opt_dce_block(blk: Vec<i32>) -> i64 {
    let insts: Vec<i32> = vec_get(blk, 1);
    let ic: i64 = vec_len(insts);
    if ic == 0 { return 0; };
    let last_op: i64 = ir_op(vec_get(insts, ic - 1));
    // This pass is block-local only. Once a block branches, its pure values may
    // still be consumed in successor blocks, so intra-block liveness is unsafe.
    if last_op == 21 || last_op == 22 { return 0; };
    // Build used-register set: scan all instructions for operand references
    let mut used: Vec<i32> = Vec::new();
    let mut i: i64 = 0;
    while i < ic {
        let inst: Vec<i32> = vec_get(insts, i);
        let op: i64 = ir_op(inst);
        // Collect register operands that are used
        if op >= 2 && op <= 15 { used.push(ir_op1(inst)); used.push(ir_op2(inst)); }
        else if op == 23 || op == 24 { used.push(ir_op1(inst)); used.push(ir_op2(inst)); }
        // Overflow-intrinsic arithmetic is side-effecting from the optimizer's
        // point of view because it emits a flag branch plus panic path.
        else if op == 35 || op == 36 || op == 37 { used.push(ir_op1(inst)); used.push(ir_op2(inst)); }
        else if op == 17 { used.push(ir_op1(inst)); }
        else if op == 18 { used.push(ir_op1(inst)); used.push(ir_op2(inst)); }
        // v0.4.209: sext/zext/trunc ops use ir_op1 as source register.
        // Pre-fix DCE missed this and removed the source load when its
        // only consumer was a sext/zext, breaking typed-IR var-ref reads.
        else if op == 32 || op == 33 || op == 34 { used.push(ir_op1(inst)); }
        else if op == 20 { used.push(ir_op1(inst)); }
        else if op == 22 { used.push(ir_op1(inst)); }
        else if op == 28 { used.push(ir_op1(inst)); used.push(ir_op2(inst)); used.push(ir_extra(inst)); }
        else if op == 30 { used.push(ir_op1(inst)); let cargs: Vec<i32> = vec_get(inst, 5); let mut ci: i64 = 0; while ci < vec_len(cargs) { used.push(vec_get(cargs, ci)); ci = ci + 1; }; }
        else if op == 19 || op == 31 {
            // Call: args are in the args Vec (index 5)
            let args: Vec<i32> = vec_get(inst, 5);
            let ac: i64 = vec_len(args);
            let mut ai: i64 = 0;
            while ai < ac { used.push(vec_get(args, ai)); ai = ai + 1; };
        };
        i = i + 1;
    };
    // Now remove dead instructions (rebuild insts list)
    let mut new_insts: Vec<i32> = Vec::new();
    let mut removed: i64 = 0;
    i = 0;
    while i < ic {
        let inst: Vec<i32> = vec_get(insts, i);
        let op: i64 = ir_op(inst);
        let d: i64 = ir_dest(inst);
        let mut keep: i64 = 1;
        // Only consider removing pure value-producing ops
        if op == 0 || (op >= 2 && op <= 15) || op == 17 || op == 23 || op == 24 || op == 26 || op == 27 || op == 28 || op == 29 || op == 32 || op == 33 || op == 34 {
            if d > 0 {
                // Check if d is in used set
                let mut found: i64 = 0;
                let uc: i64 = vec_len(used);
                let mut ui: i64 = 0;
                while ui < uc {
                    if vec_get(used, ui) == d { found = 1; ui = uc; };
                    ui = ui + 1;
                };
                if found == 0 { keep = 0; };
            };
        };
        if keep == 1 { new_insts.push(inst); }
        else { removed = removed + 1; };
        i = i + 1;
    };
    // Replace instruction list
    if removed > 0 { vec_set(blk, 1, new_insts); };
    return removed;
}

// --- Pass 3: Store-Load Constant Propagation ---
// Propagates known constants through store/load chains within a block.
// If a constant is stored to a slot and later loaded, replaces the load with const_int.
fn opt_prop_block(blk: Vec<i32>) -> i64 {
    let mut cm: Vec<i32> = cmap_new();
    let mut sv: Vec<i32> = cmap_new();
    let insts: Vec<i32> = vec_get(blk, 1);
    let ic: i64 = vec_len(insts);
    let mut count: i64 = 0;
    let mut i: i64 = 0;
    while i < ic {
        let inst: Vec<i32> = vec_get(insts, i);
        let op: i64 = ir_op(inst);
        let d: i64 = ir_dest(inst);
        if op == 0 { cmap_set(cm, d, ir_op1(inst)); }
        else if op == 18 {
            let val: i64 = ir_op1(inst);
            let ptr: i64 = ir_op2(inst);
            if cmap_has(cm, val) == 1 { cmap_set(sv, ptr, cmap_get(cm, val)); }
            else { cmap_set(sv, ptr, 0 - 9999999); };
        }
        else if op == 17 {
            let ptr: i64 = ir_op1(inst);
            if cmap_has(sv, ptr) == 1 {
                let cv: i64 = cmap_get(sv, ptr);
                if cv != 0 - 9999999 {
                    vec_set(inst, 0, 0);
                    vec_set(inst, 3, cv);
                    vec_set(inst, 4, 0);
                    vec_set(inst, 5, 0);
                    cmap_set(cm, d, cv);
                    count = count + 1;
                };
            };
        }
        else if op == 19 || op == 30 || op == 31 { sv = cmap_new(); };
        i = i + 1;
    };
    return count;
}

// --- Pass 4: Dead Store Elimination ---
// Removes stores that are overwritten before being read within the same block.
fn opt_dead_store_block(blk: Vec<i32>) -> i64 {
    let insts: Vec<i32> = vec_get(blk, 1);
    let ic: i64 = vec_len(insts);
    if ic == 0 { return 0; };
    let mut last_store: Vec<i32> = cmap_new();
    let mut dead: Vec<i32> = Vec::new();
    let mut i: i64 = 0;
    while i < ic {
        let inst: Vec<i32> = vec_get(insts, i);
        let op: i64 = ir_op(inst);
        if op == 18 {
            let ptr: i64 = ir_op2(inst);
            if cmap_has(last_store, ptr) == 1 {
                let prev_idx: i64 = cmap_get(last_store, ptr);
                if prev_idx >= 0 { dead.push(prev_idx); };
            };
            cmap_set(last_store, ptr, i);
        }
        else if op == 17 {
            let ptr: i64 = ir_op1(inst);
            cmap_set(last_store, ptr, 0 - 1);
        }
        else if op == 19 || op == 20 || op == 21 || op == 22 || op == 30 || op == 31 {
            last_store = cmap_new();
        };
        i = i + 1;
    };
    if vec_len(dead) == 0 { return 0; };
    let mut new_insts: Vec<i32> = Vec::new();
    let mut removed: i64 = 0;
    i = 0;
    while i < ic {
        let mut is_dead: i64 = 0;
        let dc: i64 = vec_len(dead);
        let mut di: i64 = 0;
        while di < dc {
            if vec_get(dead, di) == i { is_dead = 1; di = dc; };
            di = di + 1;
        };
        if is_dead == 0 { new_insts.push(vec_get(insts, i)); }
        else { removed = removed + 1; };
        i = i + 1;
    };
    if removed > 0 { vec_set(blk, 1, new_insts); };
    return removed;
}

// --- Pass 5: Common Subexpression Elimination ---
// Deduplicates identical pure computations within a block.
// When a duplicate is found, rewrites all uses of its dest to the original dest.
fn opt_cse_block(blk: Vec<i32>) -> i64 {
    let insts: Vec<i32> = vec_get(blk, 1);
    let ic: i64 = vec_len(insts);
    if ic < 2 { return 0; };
    let mut seen_op: Vec<i32> = Vec::new();
    let mut seen_o1: Vec<i32> = Vec::new();
    let mut seen_o2: Vec<i32> = Vec::new();
    let mut seen_dst: Vec<i32> = Vec::new();
    let mut rewrites: i64 = 0;
    let mut i: i64 = 0;
    while i < ic {
        let inst: Vec<i32> = vec_get(insts, i);
        let op: i64 = ir_op(inst);
        let d: i64 = ir_dest(inst);
        let o1: i64 = ir_op1(inst);
        let o2: i64 = ir_op2(inst);
        if op == 0 || (op >= 2 && op <= 14) || op == 27 {
            let sc: i64 = vec_len(seen_op);
            let mut found: i64 = 0 - 1;
            let mut si: i64 = 0;
            while si < sc {
                if vec_get(seen_op, si) == op && vec_get(seen_o1, si) == o1 && vec_get(seen_o2, si) == o2 {
                    found = vec_get(seen_dst, si); si = sc;
                };
                si = si + 1;
            };
            if found >= 0 {
                // Rewrite all forward uses of d to found (opcode-aware)
                let mut j: i64 = i + 1;
                while j < ic {
                    let jinst: Vec<i32> = vec_get(insts, j);
                    let jop: i64 = ir_op(jinst);
                    if jop == 19 {
                        let args: Vec<i32> = vec_get(jinst, 5);
                        let ac: i64 = vec_len(args);
                        let mut ai: i64 = 0;
                        while ai < ac {
                            if vec_get(args, ai) == d { vec_set(args, ai, found); };
                            ai = ai + 1;
                        };
                    }
                    else if jop >= 2 && jop <= 14 {
                        // arithmetic/cmp/logic: op1 and op2 are registers
                        if ir_op1(jinst) == d { vec_set(jinst, 3, found); };
                        if ir_op2(jinst) == d { vec_set(jinst, 4, found); };
                    }
                    else if jop == 17 { if ir_op1(jinst) == d { vec_set(jinst, 3, found); }; }
                    else if jop == 18 {
                        if ir_op1(jinst) == d { vec_set(jinst, 3, found); };
                        if ir_op2(jinst) == d { vec_set(jinst, 4, found); };
                    }
                    else if jop == 20 { if ir_op1(jinst) == d { vec_set(jinst, 3, found); }; }
                    else if jop == 22 { if ir_op1(jinst) == d { vec_set(jinst, 3, found); }; }
                    else if jop == 28 {
                        if ir_op1(jinst) == d { vec_set(jinst, 3, found); };
                        if ir_op2(jinst) == d { vec_set(jinst, 4, found); };
                        if ir_extra(jinst) == d { vec_set(jinst, 5, found); };
                    }
                    else if jop == 30 {
                        if ir_op1(jinst) == d { vec_set(jinst, 3, found); };
                        let jargs: Vec<i32> = vec_get(jinst, 5);
                        let jac: i64 = vec_len(jargs);
                        let mut jai: i64 = 0;
                        while jai < jac {
                            if vec_get(jargs, jai) == d { vec_set(jargs, jai, found); };
                            jai = jai + 1;
                        };
                    };
                    // ops 0, 16, 21, 26, 27, 29: no register operands to rewrite
                    j = j + 1;
                };
                rewrites = rewrites + 1;
            } else {
                seen_op.push(op); seen_o1.push(o1); seen_o2.push(o2); seen_dst.push(d);
            };
        };
        i = i + 1;
    };
    return rewrites;
}

// --- Optimizer driver: runs all passes on an entire function ---
fn opt_fn(f: Vec<i32>) -> i64 {
    let mut total: i64 = 0;
    let mut bi: i64 = 0;
    // Iteration 1: fold → prop → fold → CSE → dead store → DCE
    let mut bc: i64 = ir_fn_block_count(f);
    bi = 0;
    while bi < bc {
        let blk: Vec<i32> = ir_fn_get_block(f, bi);
        total = total + opt_fold_block(blk);
        total = total + opt_prop_block(blk);
        total = total + opt_fold_block(blk);
        total = total + opt_cse_block(blk);
        total = total + opt_dead_store_block(blk);
        total = total + opt_dce_block(blk);
        bi = bi + 1;
    };
    // Block merging disabled — predecessor counting doesn't account for
    // new predecessors created when a merged block's terminator branches elsewhere.
    // Iteration 2: re-run per-block passes on merged blocks
    bc = ir_fn_block_count(f);
    bi = 0;
    while bi < bc {
        let blk: Vec<i32> = ir_fn_get_block(f, bi);
        total = total + opt_fold_block(blk);
        total = total + opt_prop_block(blk);
        total = total + opt_fold_block(blk);
        total = total + opt_dead_store_block(blk);
        total = total + opt_dce_block(blk);
        bi = bi + 1;
    };
    return total;
}

