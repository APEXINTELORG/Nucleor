                tokens.push(tok_new(98, lt_name, st));
            };
        }
        else {
            // Lane 4 / F-066: terminal `else { p = p + 1; };` was the
            // root-cause silent-accept path (closes F-003/004/005/007/
            // 008/009/010 in one move). Every byte that didn't match
            // any preceding lex rule was silently consumed without a
            // token, so adopters wrote `~`, `$`, BOM, smart-quotes,
            // zero-width space, RTL ident bytes, etc. and got exit=0
            // with the offending bytes deleted. Now: emit a precise
            // lex-time diagnostic at the offending byte. Special-case
            // a couple of common typos so the message is actionable.
            //
            // F-011 (NUL byte): also caught here because preflight's
            // C-string read truncates at the first NUL. The preflight
            // check we add reports it explicitly with byte offset, but
            // keep this branch defensive in case a later code path
            // synthesises a NUL byte mid-string.
            if c == 0 {
                panic(str_concat("error[LEX-002]: NUL byte (0x00) in source at byte ", str_concat(str_from_int(p), ". Nucleor source must not contain embedded NUL bytes — pre-fix the file was silently truncated at the first NUL via C-string semantics, masking everything after it. Re-save the file as plain UTF-8 (or ASCII) without embedded NULs.")));
            };
            // F-009 (zero-width space U+200B = E2 80 8B), F-008 (smart
            // quotes “ ” = E2 80 9C / 9D), F-010 (any non-ASCII high
            // byte). Group 0xE2 prefix for the common Unicode-typography
            // class so the diag can name it. Otherwise just say
            // "unexpected byte 0xNN".
            let mut hint: str = "";
            if c == 226 && p + 2 < slen {
                let b1: i64 = str_char_at(src, p + 1);
                let b2: i64 = str_char_at(src, p + 2);
                if b1 == 128 && b2 == 139 { hint = " (looks like a U+200B zero-width space — known supply-chain attack vector; remove it)"; };
                if b1 == 128 && (b2 == 156 || b2 == 157) { hint = " (looks like a Unicode smart-quote U+201C/D — replace with a plain ASCII `\"`)"; };
                if b1 == 128 && (b2 == 152 || b2 == 153) { hint = " (looks like a Unicode smart-apostrophe U+2018/9 — replace with a plain ASCII `'`)"; };
            };
            if c == 36 { hint = " — `$` is not part of Nucleor's identifier grammar (idents are [A-Za-z_][A-Za-z0-9_]*)"; };
            if c == 96 { hint = " — backtick `` ` `` is not a Nucleor token"; };
            if c == 126 { hint = " — `~` is not a Nucleor operator (Rust uses `!` for bitwise-not; Nucleor doesn't yet have a bitwise-not op)"; };
            if c == 92 { hint = " — bare `\\` is not a Nucleor token (string-escape `\\n`/`\\t`/etc. work only inside `\"...\"`)"; };
            if c >= 128 { hint = " — non-ASCII byte; Nucleor identifiers are restricted to ASCII (RFC §1.3)"; };
            // Hex of the byte for the diag.
            let hex_chars: str = "0123456789ABCDEF";
            let hi: i64 = (c / 16) % 16;
            let lo: i64 = c % 16;
            let hex_str: str = str_concat(str_substring(hex_chars, hi, hi + 1), str_substring(hex_chars, lo, lo + 1));
            panic(str_concat("error[LEX-001]: unexpected byte 0x", str_concat(hex_str, str_concat(" at byte ", str_concat(str_from_int(p), str_concat(hint, ". Pre-fix the byte was silently consumed by the lexer's terminal fall-through, masking ~10 silent-accept findings (F-003 through F-010, F-066). Remove or replace the offending byte.")))))));
        };
    };
    tokens.push(tok_new(0, 0, slen));
    return tokens;
}
#[manual_drop]
fn tok_at(tokens: Vec<i32>, idx: i64) -> Vec<i32> {
    if idx >= vec_len(tokens) { return tok_new(0, 0, 0); }; return vec_get(tokens, idx);
}
#[manual_drop]
fn tok_type_at(tokens: Vec<i32>, idx: i64) -> i64 { return tok_type(tok_at(tokens, idx)); }
#[manual_drop]
fn tok_val_at(tokens: Vec<i32>, idx: i64) -> i64 { return tok_val(tok_at(tokens, idx)); }

// =====================================================
// PARSER (from T29, unchanged)
// =====================================================
extern fn nuc_node_kind(pool: Vec<i32>, nid: i64) -> i64;
extern fn nuc_node_field(pool: Vec<i32>, nid: i64, idx: i64) -> i64;
extern fn nuc_list_len(pool: Vec<i32>, lid: i64) -> i64;
extern fn nuc_list_get(pool: Vec<i32>, lid: i64, idx: i64) -> i64;

#[manual_drop]
fn node_add(pool: Vec<i32>, nd: Vec<i32>) -> i64 { let nid: i64 = vec_len(pool); pool.push(nd); return nid; }
#[manual_drop]
fn node_kind(pool: Vec<i32>, nid: i64) -> i64 { return nuc_node_kind(pool, nid); }
#[manual_drop]
fn node_field(pool: Vec<i32>, nid: i64, idx: i64) -> i64 { return nuc_node_field(pool, nid, idx); }
#[manual_drop]
fn node_span_sentinel() -> i64 { return 0 - 873521; }
#[manual_drop]
fn node_set_span(pool: Vec<i32>, nid: i64, byte_off: i64) -> i64 {
    if nid < 0 || nid >= vec_len(pool) { return nid; };
    if byte_off < 0 { return nid; };
    if node_kind(pool, nid) == 40 { return nid; };
    let nd: Vec<i32> = vec_get(pool, nid);
    nd.push(node_span_sentinel());
    nd.push(byte_off);
    return nid;
}
#[manual_drop]
fn node_get_span(pool: Vec<i32>, nid: i64) -> i64 {
    if nid < 0 || nid >= vec_len(pool) { return 0 - 1; };
    if node_kind(pool, nid) == 40 { return 0 - 1; };
    let nd: Vec<i32> = vec_get(pool, nid);
    let n: i64 = vec_len(nd);
    if n >= 3 && vec_get(nd, n - 2) == node_span_sentinel() { return vec_get(nd, n - 1); };
    return 0 - 1;
}
#[manual_drop]
fn mk2(pool: Vec<i32>, k: i64, a: i64) -> i64 { let mut n: Vec<i32> = Vec::with_capacity(2); n.push(k); n.push(a); return node_add(pool, n); }
#[manual_drop]
fn mk3(pool: Vec<i32>, k: i64, a: i64, b: i64) -> i64 { let mut n: Vec<i32> = Vec::with_capacity(3); n.push(k); n.push(a); n.push(b); return node_add(pool, n); }
#[manual_drop]
fn mk4(pool: Vec<i32>, k: i64, a: i64, b: i64, c: i64) -> i64 { let mut n: Vec<i32> = Vec::with_capacity(4); n.push(k); n.push(a); n.push(b); n.push(c); return node_add(pool, n); }
#[manual_drop]
fn mk5(pool: Vec<i32>, k: i64, a: i64, b: i64, c: i64, d: i64) -> i64 { let mut n: Vec<i32> = Vec::with_capacity(5); n.push(k); n.push(a); n.push(b); n.push(c); n.push(d); return node_add(pool, n); }
#[manual_drop]
fn mk6(pool: Vec<i32>, k: i64, a: i64, b: i64, c: i64, d: i64, e: i64) -> i64 { let mut n: Vec<i32> = Vec::with_capacity(6); n.push(k); n.push(a); n.push(b); n.push(c); n.push(d); n.push(e); return node_add(pool, n); }
#[manual_drop]
fn mk_list(pool: Vec<i32>, items: Vec<i32>) -> i64 {
    let mut n: Vec<i32> = Vec::with_capacity(vec_len(items) + 1); n.push(40);
    let mut i: i64 = 0; while i < vec_len(items) { n.push(vec_get(items, i)); i = i + 1; };
    return node_add(pool, n);
}
#[manual_drop]
fn list_len(pool: Vec<i32>, lid: i64) -> i64 { return nuc_list_len(pool, lid); }
#[manual_drop]
fn list_get(pool: Vec<i32>, lid: i64, idx: i64) -> i64 { return nuc_list_get(pool, lid, idx); }
#[manual_drop]
fn free_token_vec(tokens: Vec<i32>) -> i64 {
    let mut i: i64 = 0;
    while i < vec_len(tokens) {
        let tok: Vec<i32> = vec_get(tokens, i);
        vec_free(tok);
        i = i + 1;
    };
    vec_free(tokens);
    return 0;
}

#[manual_drop]
fn free_node_pool(pool: Vec<i32>) -> i64 {
    let mut i: i64 = 0;
    while i < vec_len(pool) {
        let nd: Vec<i32> = vec_get(pool, i);
        vec_free(nd);
        i = i + 1;
    };
    vec_free(pool);
    return 0;
}

#[manual_drop]
fn pr(p: i64, v: i64) -> Vec<i32> { let mut r: Vec<i32> = Vec::with_capacity(2); r.push(p); r.push(v); return r; }
#[manual_drop]
fn pr_pos(r: Vec<i32>) -> i64 { return vec_get(r, 0); }
#[manual_drop]
fn pr_val(r: Vec<i32>) -> i64 { return vec_get(r, 1); }

#[manual_drop]
fn pk(tokens: Vec<i32>, pos: i64) -> i64 { return tok_type_at(tokens, pos); }
#[manual_drop]
fn pkv(tokens: Vec<i32>, pos: i64) -> i64 { return tok_val_at(tokens, pos); }
#[manual_drop]
fn tok_pos_at(tokens: Vec<i32>, idx: i64) -> i64 { return tok_pos(tok_at(tokens, idx)); }
// v0.4.208: human-readable names for the most common NR020 tokens.
// Closes two findings (tuple-struct-decl-panic + match-on-unit-panic)
// which both surfaced as "expected token N got M" with raw IDs.
// Trimmed to the high-impact punct/keyword set to avoid bloating
// the compiler binary; less-common tokens fall back to "token N".
#[manual_drop]
fn tok_name(tt: i64) -> str {
    if tt == 0 { return "<EOF>"; };
    if tt == 1 { return "identifier"; };
    if tt == 2 { return "integer literal"; };
    if tt == 3 { return "string literal"; };
    if tt == 40 { return "`=`"; };
    if tt == 41 { return "`->`"; };
    if tt == 42 { return "`:`"; };
    if tt == 43 { return "`;`"; };
    if tt == 44 { return "`,`"; };
    if tt == 50 { return "`(`"; };
    if tt == 51 { return "`)`"; };
    if tt == 52 { return "`{`"; };
    if tt == 53 { return "`}`"; };
    if tt == 54 { return "`[`"; };
    if tt == 55 { return "`]`"; };
    if tt == 64 { return "`=>`"; };
    if tt == 70 { return "float literal"; };
    if tt == 130 { return "`++`"; };
    if tt == 131 { return "`--`"; };
    return str_concat("token ", str_from_int(tt));
}

#[manual_drop]
fn expect_tok(tokens: Vec<i32>, pos: i64, tt: i64) -> i64 {
    if pk(tokens, pos) != tt {
        // v0.4.78 NR020 — was a `print()` warning that returned `pos + 1`
        // and continued parsing. The parser produced a likely-broken AST,
        // type-check + lower happily consumed it, and codegen emitted a
        // silently-wrong binary. Triaged via the `@` binding pattern
        // probe (`x @ 1..=10`) which printed a parse error AND ran to
        // exit=0 with no output. Promoted to a hard panic — adopters
        // who hit this previously shipped broken binaries.
        // v0.4.208: emit token-name table output instead of raw IDs.
        // Pre-fix message: "expected token 52 got 50" — opaque.
        // Post-fix: "expected `{` got `(`" — actionable.
        let tok: Vec<i32> = tok_at(tokens, pos);
        let byte_pos: i64 = vec_get(tok, 2);
        let got_tt: i64 = pk(tokens, pos);
        panic(str_concat("error[NR020]: parse error at byte ", str_concat(str_from_int(byte_pos), str_concat(": expected ", str_concat(tok_name(tt), str_concat(", got ", str_concat(tok_name(got_tt), ". Pre-v0.4.78 this printed a warning and continued, producing a likely-broken binary; v0.4.208 added token names to make the diagnostic actionable.")))))));
    };
    return pos + 1;
}

#[manual_drop]
fn parse_args(tokens: Vec<i32>, pos: i64, pool: Vec<i32>) -> Vec<i32> {
    let mut args: Vec<i32> = Vec::new();
    let mut cp: i64 = pos;
    if pk(tokens, cp) != 51 {
        // Lane 4 / F-037: leading comma `h(,1)` silent accept. Reject.
        if pk(tokens, cp) == 44 {
            let v_args_byte_f037l: i64 = tok_pos_at(tokens, cp);
            panic(str_concat("error[PARSE-ARGS-COMMA]: leading `,` in fn-call argument list at byte ", str_concat(str_from_int(v_args_byte_f037l), ". Pre-fix `f(,1)` was silently accepted as a 1-arg call. Remove the leading comma.")));
        };
        let mut r: Vec<i32> = parse_expr(tokens, cp, pool);
        args.push(pr_val(r)); cp = pr_pos(r);
        while pk(tokens, cp) == 44 {
            if pk(tokens, cp + 1) == 51 { cp = cp + 1; }
            else if pk(tokens, cp + 1) == 44 {
                // Lane 4 / F-037: extra comma `h(1,, 2)` silent accept.
                let v_args_byte_f037: i64 = tok_pos_at(tokens, cp + 1);
                panic(str_concat("error[PARSE-ARGS-COMMA]: extra `,` in fn-call argument list at byte ", str_concat(str_from_int(v_args_byte_f037), ". Pre-fix `f(1,, 2)` silently dropped the missing argument expression. Remove the duplicate comma.")));
            }
            else {
                r = parse_expr(tokens, cp + 1, pool); args.push(pr_val(r)); cp = pr_pos(r);
            };
        };
    };
    return pr(cp + 1, mk_list(pool, args));
}

