// Walk all four allow/deny collectors; emit warning[DIAG-001] for
// any CODE whose prefix doesn't match the canonical set. Hint
// names docs/spec/Nucleor_Error_Codes.md as the catalog. The
// emitted diags themselves can be suppressed via #[allow(DIAG-001)]
// on a noisy refactor.
fn emit_diag001_unknown_codes(diags: Vec<i32>, source: str) -> Vec<i32> {
    let allowed: Vec<i32> = collect_allowed_codes(source);
    let allow_fn_pairs: Vec<i32> = collect_allow_fn_pairs(source);
    let denied: Vec<i32> = collect_denied_codes(source);
    let deny_fn_pairs: Vec<i32> = collect_deny_fn_pairs(source);
    let mut i: i64 = 0;
    let an: i64 = vec_len(allowed);
    while i < an {
        let code: str = vec_get(allowed, i);
        if is_known_diag_code(code) == 0 {
            let msg: str = str_concat("unknown diagnostic code '", str_concat(code, "' in #[allow(...)] -- not in canonical diagnostic code set; suppression has no effect (check spelling against docs/spec/Nucleor_Error_Codes.md)"));
            diag_add_ex(diags, "warning", "diag", "DIAG-001", msg, "", 0, 0, "");
        };
        i = i + 1;
    };
    i = 0;
    let dn: i64 = vec_len(denied);
    while i < dn {
        let code: str = vec_get(denied, i);
        if is_known_diag_code(code) == 0 {
            let msg: str = str_concat("unknown diagnostic code '", str_concat(code, "' in #[deny(...)] -- not in canonical diagnostic code set; promotion has no effect (check spelling against docs/spec/Nucleor_Error_Codes.md)"));
            diag_add_ex(diags, "warning", "diag", "DIAG-001", msg, "", 0, 0, "");
        };
        i = i + 1;
    };
    let pn: i64 = vec_len(allow_fn_pairs);
    let mut pi: i64 = 0;
    while pi + 1 < pn {
        let fname: str = vec_get(allow_fn_pairs, pi);
        let code: str = vec_get(allow_fn_pairs, pi + 1);
        if is_known_diag_code(code) == 0 {
            let msg: str = str_concat("unknown diagnostic code '", str_concat(code, str_concat("' in #[allow_fn(...)] on fn '", str_concat(fname, "' -- not in canonical diagnostic code set; suppression has no effect (check spelling against docs/spec/Nucleor_Error_Codes.md)"))));
            diag_add_ex(diags, "warning", "diag", "DIAG-001", msg, fname, 0, 0, "");
        };
        pi = pi + 2;
    };
    let qn: i64 = vec_len(deny_fn_pairs);
    let mut qi: i64 = 0;
    while qi + 1 < qn {
        let fname: str = vec_get(deny_fn_pairs, qi);
        let code: str = vec_get(deny_fn_pairs, qi + 1);
        if is_known_diag_code(code) == 0 {
            let msg: str = str_concat("unknown diagnostic code '", str_concat(code, str_concat("' in #[deny_fn(...)] on fn '", str_concat(fname, "' -- not in canonical diagnostic code set; promotion has no effect (check spelling against docs/spec/Nucleor_Error_Codes.md)"))));
            diag_add_ex(diags, "warning", "diag", "DIAG-001", msg, fname, 0, 0, "");
        };
        qi = qi + 2;
    };
    return diags;
}

fn promote_denied_to_errors(diags: Vec<i32>, source: str) -> Vec<i32> {
    let denied: Vec<i32> = collect_denied_codes(source);
    let deny_fn_pairs: Vec<i32> = collect_deny_fn_pairs(source);
    if vec_len(denied) == 0 && vec_len(deny_fn_pairs) == 0 { return diags; };
    let n: i64 = vec_len(diags);
    let mut i: i64 = 0;
    while i < n {
        let d: Vec<i32> = vec_get(diags, i);
        let sev: str = vec_get(d, 0);
        let code: str = vec_get(d, 2);
        let fn_name: str = vec_get(d, 4);
        if str_eq(sev, "warning") == 1 {
            let mut promoted: i64 = 0;
            let mut j: i64 = 0;
            let m: i64 = vec_len(denied);
            while j < m && promoted == 0 {
                if str_eq(vec_get(denied, j), code) == 1 {
                    vec_set(d, 0, "error");
                    promoted = 1;
                };
                j = j + 1;
            };
            if promoted == 0 {
                let pn: i64 = vec_len(deny_fn_pairs);
                let mut pi: i64 = 0;
                while pi + 1 < pn && promoted == 0 {
                    if str_eq(vec_get(deny_fn_pairs, pi), fn_name) == 1
                       && str_eq(vec_get(deny_fn_pairs, pi + 1), code) == 1 {
                        vec_set(d, 0, "error");
                        promoted = 1;
                    };
                    pi = pi + 2;
                };
            };
        };
        i = i + 1;
    };
    return diags;
}

// RFC-0001 phase 1 — `#[no_alloc]` v1 (file-wide source-level
// static check). Scans for `#[no_alloc]` attribute lines and
// associates each with the next `fn NAME(` declaration. For every
// such fn, scans its body text for forbidden allocator-builtin
// call patterns (literal `<name>(` substrings) and fires `RT-001`
// per violation.
//
// Limitations of the source-level check (acceptable for v1):
//   - False positive if the literal pattern (e.g. `vec_push(`)
//     appears inside a string or comment in the body. Rare in
//     practice; rewrites are easy.
//   - Does not chase transitive calls. `#[no_alloc]` fn that calls
//     `helper()` which itself calls `vec_push` will not fire.
//     v0.4 lifts this once trait-resolution + call-graph analysis
//     ships.
//   - Per-file scope only; no module boundary tracking.
//
// AST-based v2 ships with the rest of RFC-0001 (`#[no_panic]`,
// `#[no_dyn]`, `#[deadline]`).

// T3.7 (v0.3.6): mask string literals + `//` line comments out of a
// fn body before the RT-001/002/003 substring checks scan it. The
// v1 checks were naive str_contains, so a literal `"Vec::new"` in
// a string or `// vec_push(x)` in a comment would false-positive.
// We replace masked ranges with spaces (preserving length so any
// downstream position math stays valid) — `(` characters get
// blanked too, which means the `<name>(` anchor pattern can no
// longer match anywhere inside a quoted/commented region.
fn strip_strings_and_line_comments(s: str) -> str {
    let slen: i64 = str_len(s);
    let mut sb: i64 = sb_new();
    let mut p: i64 = 0;
    while p < slen {
        let c: i64 = str_char_at(s, p);
        if c == 47 && p + 1 < slen && str_char_at(s, p + 1) == 47 {
            // Line comment: emit spaces until newline.
            while p < slen && str_char_at(s, p) != 10 {
                sb_append(sb, " ");
                p = p + 1;
            };
            if p < slen { sb_append(sb, "\n"); p = p + 1; };
        } else if c == 34 {
            // Double-quoted string: emit space for the opening quote,
            // then walk past escape sequences until the closing quote.
            sb_append(sb, " ");
            p = p + 1;
            while p < slen && str_char_at(s, p) != 34 {
                if str_char_at(s, p) == 92 && p + 1 < slen {
                    sb_append(sb, "  ");
                    p = p + 2;
                } else {
                    sb_append(sb, " ");
                    p = p + 1;
                };
            };
            if p < slen { sb_append(sb, " "); p = p + 1; };
        } else if c == 39 {
            // Single-quoted char: same shape as double-quote but with `'`.
            sb_append(sb, " ");
            p = p + 1;
            while p < slen && str_char_at(s, p) != 39 {
                if str_char_at(s, p) == 92 && p + 1 < slen {
                    sb_append(sb, "  ");
                    p = p + 2;
                } else {
                    sb_append(sb, " ");
                    p = p + 1;
                };
            };
            if p < slen { sb_append(sb, " "); p = p + 1; };
        } else {
            sb_append(sb, str_substring(s, p, p + 1));
            p = p + 1;
        };
    };
    return sb_to_str(sb);
}

fn rt_string_vec_append(v: Vec<i32>, extra: Vec<i32>) -> i64 {
    let n: i64 = vec_len(extra);
    let mut i: i64 = 0;
    while i < n {
        v.push(vec_get(extra, i));
        i = i + 1;
    };
    return vec_len(v);
}

fn rt_header_has_effect(header: str, effect_name: str) -> i64 {
    if str_contains(header, "with") == 0 { return 0; };
    let hlen: i64 = str_len(header);
    let elen: i64 = str_len(effect_name);
    if elen == 0 || hlen < elen { return 0; };
    let mut p: i64 = 0;
    while p + elen <= hlen {
        if str_eq_at(header, p, effect_name) == 1 {
            let before_ok: i64 = if p == 0 { 1 } else {
                let b: i64 = str_char_at(header, p - 1);
                if is_alnum(b) == 0 && b != 95 { 1 } else { 0 }
            };
            let after_ok: i64 = if p + elen >= hlen { 1 } else {
                let a: i64 = str_char_at(header, p + elen);
                if is_alnum(a) == 0 && a != 95 { 1 } else { 0 }
            };
            if before_ok == 1 && after_ok == 1 { return 1; };
        };
        p = p + 1;
    };
    return 0;
}

fn collect_headers_with_effect(source: str, effect_name: str, pat: str) -> Vec<i32> {
    let mut fns: Vec<i32> = Vec::new();
    if str_contains(source, "with") == 0 { return fns; };
    let slen: i64 = str_len(source);
    let plen: i64 = str_len(pat);
    let mut p: i64 = 0;
    while p + plen <= slen {
        if p + 1 < slen && str_char_at(source, p) == 47 && str_char_at(source, p + 1) == 47 {
            while p < slen && str_char_at(source, p) != 10 { p = p + 1; };
            p = p + 1;
            continue;
        };
        if str_char_at(source, p) == 34 {
            p = p + 1;
            while p < slen && str_char_at(source, p) != 34 {
                if str_char_at(source, p) == 92 && p + 1 < slen { p = p + 2; }
                else { p = p + 1; };
            };
            p = p + 1;
            continue;
        };
        if str_char_at(source, p) == 39 {
            p = p + 1;
            while p < slen && str_char_at(source, p) != 39 {
                if str_char_at(source, p) == 92 && p + 1 < slen { p = p + 2; }
                else { p = p + 1; };
            };
            p = p + 1;
            continue;
        };
        if str_eq_at(source, p, pat) == 1 {
            let is_extern_fn: i64 = if str_eq(pat, "fn ") == 1 && p >= 7 && str_eq_at(source, p - 7, "extern ") == 1 { 1 } else { 0 };
            if is_extern_fn == 1 {
                p = p + plen;
            } else {
                let mut q: i64 = p + plen;
                let name_start: i64 = q;
                while q < slen && (is_alnum(str_char_at(source, q)) == 1 || str_char_at(source, q) == 95) { q = q + 1; };
                if q > name_start {
                    let name: str = str_substring(source, name_start, q);
                    let mut h: i64 = q;
                    while h < slen && str_char_at(source, h) != 123 && str_char_at(source, h) != 59 { h = h + 1; };
                    if h > p {
                        let header: str = str_substring(source, p, h);
                        if rt_header_has_effect(header, effect_name) == 1 {
                            fns.push(name);
                        } else {
                            str_free(name);
                        };
                        str_free(header);
                    };
                    p = h + 1;
                } else {
                    p = p + 1;
                };
            };
        } else {
            p = p + 1;
        };
    };
    return fns;
}

fn collect_fns_with_effect(source: str, effect_name: str) -> Vec<i32> {
    return collect_headers_with_effect(source, effect_name, "fn ");
}

fn collect_externs_with_effect(source: str, effect_name: str) -> Vec<i32> {
    return collect_headers_with_effect(source, effect_name, "extern fn ");
}

fn collect_no_alloc_fns(source: str) -> Vec<i32> {
    let mut fns: Vec<i32> = Vec::new();
    let slen: i64 = str_len(source);
    let pat: str = "#[no_alloc]";
    let plen: i64 = str_len(pat);
    let mut p: i64 = 0;
    while p + plen <= slen {
        // Skip the rest of any line that starts with `//` so the
        // pattern in a comment (including this comment when the
        // s1 compiles itself) doesn't get treated as a real
        // attribute. Doc comments above the next fn would
        // otherwise collide with their own subject.
        if p + 1 < slen && str_char_at(source, p) == 47 && str_char_at(source, p + 1) == 47 {
            while p < slen && str_char_at(source, p) != 10 { p = p + 1; };
            p = p + 1;
            continue;
        };
        // Skip string literals — `let pat: str = "#[no_alloc]"`
        // would otherwise be matched as a real attribute. Walk
        // through escape sequences (`\"` is not the closing
        // quote). The s1 itself contains the literal `#[no_alloc]`
        // in a string for use by this scanner; without this guard
        // the s1 false-positives on its own helper fn.
        if str_char_at(source, p) == 34 {
            p = p + 1;
            while p < slen && str_char_at(source, p) != 34 {
                if str_char_at(source, p) == 92 && p + 1 < slen { p = p + 2; }
                else { p = p + 1; };
            };
            p = p + 1;
            continue;
        };
        let mut m: i64 = 1;
        let mut k: i64 = 0;
        while k < plen {
            if str_char_at(source, p + k) != str_char_at(pat, k) { m = 0; break; };
            k = k + 1;
        };
        if m == 1 {
            let mut q: i64 = p + plen;
            // Skip whitespace until we hit the next 'fn '.
            while q + 3 <= slen {
                let c0: i64 = str_char_at(source, q);
                let c1: i64 = str_char_at(source, q + 1);
                let c2: i64 = str_char_at(source, q + 2);
                if c0 == 102 && c1 == 110 && c2 == 32 {
                    // 'fn ' — read the name identifier.
                    q = q + 3;
                    let name_start: i64 = q;
                    while q < slen && (is_alnum(str_char_at(source, q)) == 1 || str_char_at(source, q) == 95) {
                        q = q + 1;
                    };
                    if q > name_start {
                        let name: str = str_substring(source, name_start, q);
                        fns.push(name);
                    };
                    p = q;
                    break;
                };
                q = q + 1;
            };
            if q + 3 > slen { p = slen; };
        } else {
            p = p + 1;
        };
    };
    rt_string_vec_append(fns, collect_fns_with_effect(source, "no_alloc"));
    return fns;
}

// v0.4.244 RFC-0006 substrate — `#[require(EXPR)]` source-text
// scanner. Mirrors `collect_no_alloc_fns` shape: scans the source
// for the literal pattern, walks paren-balanced expression text,
// captures the next `fn NAME` identifier, and stores a flat
// (fn_name, expr_text) pair in the result Vec. Lex-time the `#[
// require(...)]` is discarded as an unknown attribute, so the
// parser never sees it; this side-channel scanner recovers the
// information.
//
// Returns a flat Vec of alternating (fn_name, expr_text) entries:
//   [name0, expr0, name1, expr1, ...]
//
// String-literal and `//` comment skipping mirror the no_alloc
// pattern so the s1 compiler doesn't false-positive on the literal
// pattern strings inside its own scanner code.
fn collect_fn_requires(source: str) -> Vec<i32> {
    let mut entries: Vec<i32> = Vec::new();
    let slen: i64 = str_len(source);
    let pat: str = "#[require(";
    let plen: i64 = str_len(pat);
    let mut p: i64 = 0;
    while p + plen <= slen {
        if p + 1 < slen && str_char_at(source, p) == 47 && str_char_at(source, p + 1) == 47 {
            while p < slen && str_char_at(source, p) != 10 { p = p + 1; };
            p = p + 1;
            continue;
        };
        if str_char_at(source, p) == 34 {
            p = p + 1;
            while p < slen && str_char_at(source, p) != 34 {
                if str_char_at(source, p) == 92 && p + 1 < slen { p = p + 2; }
                else { p = p + 1; };
            };
            p = p + 1;
            continue;
        };
        let mut m: i64 = 1;
        let mut k: i64 = 0;
        while k < plen {
            if str_char_at(source, p + k) != str_char_at(pat, k) { m = 0; break; };
            k = k + 1;
        };
        if m == 1 {
            // p points at `#`. p + plen points at the first byte of the
            // expression (just past the `(`). Walk paren-balanced text
            // to find the closing `)` of the require expression.
            let expr_start: i64 = p + plen;
            let mut q: i64 = expr_start;
            let mut paren_depth: i64 = 1;
            while q < slen && paren_depth > 0 {
                let cc: i64 = str_char_at(source, q);
                if cc == 34 {
                    q = q + 1;
                    while q < slen && str_char_at(source, q) != 34 {
                        if str_char_at(source, q) == 92 && q + 1 < slen { q = q + 2; }
                        else { q = q + 1; };
                    };
                    if q < slen { q = q + 1; };
                    continue;
                };
                if cc == 40 { paren_depth = paren_depth + 1; }
                else if cc == 41 { paren_depth = paren_depth - 1; if paren_depth == 0 { break; }; };
                q = q + 1;
            };
            let expr_end: i64 = q;
            // Skip past the `)]` and any whitespace, then look for `fn `.
            let mut r: i64 = expr_end + 1;
            if r < slen && str_char_at(source, r) == 93 { r = r + 1; };
            while r + 3 <= slen {
                let c0: i64 = str_char_at(source, r);
                let c1: i64 = str_char_at(source, r + 1);
                let c2: i64 = str_char_at(source, r + 2);
                if c0 == 102 && c1 == 110 && c2 == 32 {
                    r = r + 3;
                    let name_start: i64 = r;
                    while r < slen && (is_alnum(str_char_at(source, r)) == 1 || str_char_at(source, r) == 95) {
                        r = r + 1;
                    };
                    if r > name_start && expr_end > expr_start {
                        let fname: str = str_substring(source, name_start, r);
                        let etext: str = str_substring(source, expr_start, expr_end);
                        entries.push(fname);
                        entries.push(etext);
                    };
                    // v0.4.250 — advance p past the closing `]` of
                    // this attribute (not past the fn name) so a
                    // subsequent #[require(...)] before the same
                    // fn still gets captured by the outer loop.
                    p = expr_end + 2;
                    break;
                };
                r = r + 1;
            };
            if r + 3 > slen { p = slen; };
        } else {
            p = p + 1;
        };
    };
    return entries;
}

// Look up the `#[require(...)]` expression text for a given fn
// name. Returns "" if no require attribute was attached. Linear
// scan; the require list is small in practice.
fn lookup_fn_require_expr(requires: Vec<i32>, fn_name: str) -> str {
    let n: i64 = vec_len(requires);
    let mut i: i64 = 0;
    while i + 1 < n {
        let nm: str = vec_get(requires, i);
        if str_eq(nm, fn_name) == 1 { return vec_get(requires, i + 1); };
        i = i + 2;
    };
    return "";
}

// v0.4.246 RFC-0006 substrate — `#[ensure(EXPR)]` source-text
// scanner. Mirror of collect_fn_requires but for the ensure
// attribute (postcondition checked at fn exit).
fn collect_fn_ensures(source: str) -> Vec<i32> {
    let mut entries: Vec<i32> = Vec::new();
    let slen: i64 = str_len(source);
    let pat: str = "#[ensure(";
    let plen: i64 = str_len(pat);
    let mut p: i64 = 0;
    while p + plen <= slen {
        if p + 1 < slen && str_char_at(source, p) == 47 && str_char_at(source, p + 1) == 47 {
            while p < slen && str_char_at(source, p) != 10 { p = p + 1; };
            p = p + 1;
            continue;
        };
        if str_char_at(source, p) == 34 {
            p = p + 1;
            while p < slen && str_char_at(source, p) != 34 {
                if str_char_at(source, p) == 92 && p + 1 < slen { p = p + 2; }
                else { p = p + 1; };
            };
            p = p + 1;
            continue;
        };
        let mut m: i64 = 1;
        let mut k: i64 = 0;
        while k < plen {
            if str_char_at(source, p + k) != str_char_at(pat, k) { m = 0; break; };
            k = k + 1;
        };
        if m == 1 {
            let expr_start: i64 = p + plen;
            let mut q: i64 = expr_start;
            let mut paren_depth: i64 = 1;
            while q < slen && paren_depth > 0 {
                let cc: i64 = str_char_at(source, q);
                if cc == 34 {
                    q = q + 1;
                    while q < slen && str_char_at(source, q) != 34 {
                        if str_char_at(source, q) == 92 && q + 1 < slen { q = q + 2; }
                        else { q = q + 1; };
                    };
                    if q < slen { q = q + 1; };
                    continue;
                };
                if cc == 40 { paren_depth = paren_depth + 1; }
                else if cc == 41 { paren_depth = paren_depth - 1; if paren_depth == 0 { break; }; };
                q = q + 1;
            };
            let expr_end: i64 = q;
            let mut r: i64 = expr_end + 1;
            if r < slen && str_char_at(source, r) == 93 { r = r + 1; };
            while r + 3 <= slen {
                let c0: i64 = str_char_at(source, r);
                let c1: i64 = str_char_at(source, r + 1);
                let c2: i64 = str_char_at(source, r + 2);
                if c0 == 102 && c1 == 110 && c2 == 32 {
                    r = r + 3;
                    let name_start: i64 = r;
                    while r < slen && (is_alnum(str_char_at(source, r)) == 1 || str_char_at(source, r) == 95) {
                        r = r + 1;
                    };
                    if r > name_start && expr_end > expr_start {
                        let fname: str = str_substring(source, name_start, r);
                        let etext: str = str_substring(source, expr_start, expr_end);
                        entries.push(fname);
                        entries.push(etext);
                    };
                    // v0.4.250 — same multiple-attr support as
                    // collect_fn_requires.
                    p = expr_end + 2;
                    break;
                };
                r = r + 1;
            };
            if r + 3 > slen { p = slen; };
        } else {
            p = p + 1;
        };
    };
    return entries;
}

// v0.4.251 RFC-0006 — `old(expr)` snapshot text rewriter.
// Walks the ensure expression's TEXT, finds every `old(...)`
// pattern (paren-balanced, string-literal aware), and rewrites
// each to a synthesized binding name `__old_<fn_name>_<idx>`.
// The inner expression text per `old(...)` is captured separately.
// Returns a flat Vec encoding [rewritten_text, n, synth0, inner0,
// synth1, inner1, ...] where n is the number of olds.
//
// At lower-time, the pre-pass lex+parses each inner into the AST
// pool, and lower_fn pre-evaluates each inner at fn entry storing
// to an alloca. The rewritten ensure expression's `__old_*`
// var-refs then resolve to loads from those allocas.
fn rewrite_old_in_ensure(ens_text: str, fn_name: str) -> Vec<i32> {
    let mut out: Vec<i32> = Vec::new();
    let slen: i64 = str_len(ens_text);
    let mut sb: i64 = sb_new();
    let mut inners: Vec<i32> = Vec::new();
    let mut idx_counter: i64 = 0;
    let mut p: i64 = 0;
    while p < slen {
        // Skip string literals — never rewrite inside.
        if str_char_at(ens_text, p) == 34 {
            sb_append(sb, str_substring(ens_text, p, p + 1));
            p = p + 1;
            while p < slen && str_char_at(ens_text, p) != 34 {
                if str_char_at(ens_text, p) == 92 && p + 1 < slen {
                    sb_append(sb, str_substring(ens_text, p, p + 2));
                    p = p + 2;
                } else {
                    sb_append(sb, str_substring(ens_text, p, p + 1));
                    p = p + 1;
                };
            };
            if p < slen { sb_append(sb, str_substring(ens_text, p, p + 1)); p = p + 1; };
            continue;
        };
        // Detect `old(` only when preceded by non-identifier
        // (so e.g. `old_value` is NOT matched). Check prev char.
        let mut is_id_boundary: i64 = 1;
        if p > 0 {
            let prev: i64 = str_char_at(ens_text, p - 1);
            if is_alnum(prev) == 1 || prev == 95 { is_id_boundary = 0; };
        };
        if is_id_boundary == 1 && p + 4 <= slen
            && str_char_at(ens_text, p) == 111
            && str_char_at(ens_text, p + 1) == 108
            && str_char_at(ens_text, p + 2) == 100
            && str_char_at(ens_text, p + 3) == 40 {
            // Found `old(`. Walk paren-balanced inner.
            let inner_start: i64 = p + 4;
            let mut q: i64 = inner_start;
            let mut paren_depth: i64 = 1;
            while q < slen && paren_depth > 0 {
                let cc: i64 = str_char_at(ens_text, q);
                if cc == 34 {
                    q = q + 1;
                    while q < slen && str_char_at(ens_text, q) != 34 {
                        if str_char_at(ens_text, q) == 92 && q + 1 < slen { q = q + 2; }
                        else { q = q + 1; };
                    };
                    if q < slen { q = q + 1; };
                    continue;
                };
                if cc == 40 { paren_depth = paren_depth + 1; }
                else if cc == 41 { paren_depth = paren_depth - 1; if paren_depth == 0 { break; }; };
                q = q + 1;
            };
            let inner_end: i64 = q;
            let inner_text: str = str_substring(ens_text, inner_start, inner_end);
            let synth: str = str_concat("__old_", str_concat(fn_name, str_concat("_", str_from_int(idx_counter))));
            sb_append(sb, synth);
            inners.push(synth);
            inners.push(inner_text);
            idx_counter = idx_counter + 1;
            p = inner_end + 1;
        } else {
            sb_append(sb, str_substring(ens_text, p, p + 1));
            p = p + 1;
        };
    };
    out.push(sb_to_str(sb));
    out.push(str_from_int(idx_counter));
    let mut ki: i64 = 0;
    while ki + 1 < vec_len(inners) {
        out.push(vec_get(inners, ki));
        out.push(vec_get(inners, ki + 1));
        ki = ki + 2;
    };
    return out;
}

fn lookup_fn_ensure_expr(ensures: Vec<i32>, fn_name: str) -> str {
    let n: i64 = vec_len(ensures);
    let mut i: i64 = 0;
    while i + 1 < n {
        let nm: str = vec_get(ensures, i);
        if str_eq(nm, fn_name) == 1 { return vec_get(ensures, i + 1); };
        i = i + 2;
    };
    return "";
}

// v0.4.248 RFC-0006 substrate — `#[invariant(EXPR)]` source-text
// scanner. Matches inherent impl blocks: `#[invariant(EXPR)] impl
// <Type> { ... }`. Trait-impl form (`impl Trait for Type`) is
// recognized by walking past the trait identifier and the `for`
// keyword to find the receiver type. Returns flat (type_name,
// expr_text) pairs.
fn collect_impl_invariants(source: str) -> Vec<i32> {
    let mut entries: Vec<i32> = Vec::new();
    let slen: i64 = str_len(source);
    let pat: str = "#[invariant(";
    let plen: i64 = str_len(pat);
    let mut p: i64 = 0;
    while p + plen <= slen {
        if p + 1 < slen && str_char_at(source, p) == 47 && str_char_at(source, p + 1) == 47 {
            while p < slen && str_char_at(source, p) != 10 { p = p + 1; };
            p = p + 1;
            continue;
        };
        if str_char_at(source, p) == 34 {
            p = p + 1;
            while p < slen && str_char_at(source, p) != 34 {
                if str_char_at(source, p) == 92 && p + 1 < slen { p = p + 2; }
                else { p = p + 1; };
            };
            p = p + 1;
            continue;
        };
        let mut m: i64 = 1;
        let mut k: i64 = 0;
        while k < plen {
            if str_char_at(source, p + k) != str_char_at(pat, k) { m = 0; break; };
            k = k + 1;
        };
        if m == 1 {
            let expr_start: i64 = p + plen;
            let mut q: i64 = expr_start;
            let mut paren_depth: i64 = 1;
            while q < slen && paren_depth > 0 {
                let cc: i64 = str_char_at(source, q);
                if cc == 34 {
                    q = q + 1;
                    while q < slen && str_char_at(source, q) != 34 {
                        if str_char_at(source, q) == 92 && q + 1 < slen { q = q + 2; }
                        else { q = q + 1; };
                    };
                    if q < slen { q = q + 1; };
                    continue;
                };
                if cc == 40 { paren_depth = paren_depth + 1; }
                else if cc == 41 { paren_depth = paren_depth - 1; if paren_depth == 0 { break; }; };
                q = q + 1;
            };
            let expr_end: i64 = q;
            let mut r: i64 = expr_end + 1;
            if r < slen && str_char_at(source, r) == 93 { r = r + 1; };
            // Walk forward to find `impl ` keyword.
            while r + 5 <= slen {
                let c0: i64 = str_char_at(source, r);
                let c1: i64 = str_char_at(source, r + 1);
                let c2: i64 = str_char_at(source, r + 2);
                let c3: i64 = str_char_at(source, r + 3);
                let c4: i64 = str_char_at(source, r + 4);
                if c0 == 105 && c1 == 109 && c2 == 112 && c3 == 108 && c4 == 32 {
                    // `impl `. Read first identifier.
                    r = r + 5;
                    let id1_start: i64 = r;
                    while r < slen && (is_alnum(str_char_at(source, r)) == 1 || str_char_at(source, r) == 95) {
                        r = r + 1;
                    };
                    let id1: str = str_substring(source, id1_start, r);
                    // Skip whitespace.
                    while r < slen && (str_char_at(source, r) == 32 || str_char_at(source, r) == 9) { r = r + 1; };
                    // Optional `for <Type>` for trait impl form.
                    let mut tname: str = id1;
                    if r + 4 <= slen
                        && str_char_at(source, r) == 102
                        && str_char_at(source, r + 1) == 111
                        && str_char_at(source, r + 2) == 114
                        && str_char_at(source, r + 3) == 32 {
                        r = r + 4;
                        let id2_start: i64 = r;
                        while r < slen && (is_alnum(str_char_at(source, r)) == 1 || str_char_at(source, r) == 95) {
                            r = r + 1;
                        };
                        tname = str_substring(source, id2_start, r);
                    };
                    if str_len(tname) > 0 && expr_end > expr_start {
                        let etext: str = str_substring(source, expr_start, expr_end);
                        entries.push(tname);
                        entries.push(etext);
                    };
                    p = r;
                    break;
                };
                r = r + 1;
            };
            if r + 5 > slen { p = slen; };
        } else {
            p = p + 1;
        };
    };
    return entries;
}

fn lookup_type_invariant_expr(invariants: Vec<i32>, type_name: str) -> str {
    let n: i64 = vec_len(invariants);
    let mut i: i64 = 0;
    while i + 1 < n {
        let nm: str = vec_get(invariants, i);
        if str_eq(nm, type_name) == 1 { return vec_get(invariants, i + 1); };
        i = i + 2;
    };
    return "";
}

// v0.4.258 RFC-0006 — `#[no_check]` per-fn opt-out scanner.
// Returns flat Vec of fn names that carry the `#[no_check]`
// attribute; the require/ensure pre-passes skip these so the
// contract emit-sites produce no runtime checks. Useful for
// hot-path fns where the contract is documentation-only.
//
// `#[no_check]` does NOT take an expression — marker attr only.
// Pattern: `#[no_check]` followed by whitespace and `fn NAME`.
fn collect_no_check_fns(source: str) -> Vec<i32> {
    let mut entries: Vec<i32> = Vec::new();
    let slen: i64 = str_len(source);
    let pat: str = "#[no_check]";
    let plen: i64 = str_len(pat);
    let mut p: i64 = 0;
    while p + plen <= slen {
        if p + 1 < slen && str_char_at(source, p) == 47 && str_char_at(source, p + 1) == 47 {
            while p < slen && str_char_at(source, p) != 10 { p = p + 1; };
            p = p + 1;
            continue;
        };
        if str_char_at(source, p) == 34 {
            p = p + 1;
            while p < slen && str_char_at(source, p) != 34 {
                if str_char_at(source, p) == 92 && p + 1 < slen { p = p + 2; }
                else { p = p + 1; };
            };
            p = p + 1;
            continue;
        };
        let mut m: i64 = 1;
        let mut k: i64 = 0;
        while k < plen {
            if str_char_at(source, p + k) != str_char_at(pat, k) { m = 0; break; };
            k = k + 1;
        };
        if m == 1 {
            let mut r: i64 = p + plen;
            while r + 3 <= slen {
                let c0: i64 = str_char_at(source, r);
                let c1: i64 = str_char_at(source, r + 1);
                let c2: i64 = str_char_at(source, r + 2);
                if c0 == 102 && c1 == 110 && c2 == 32 {
                    r = r + 3;
                    let name_start: i64 = r;
                    while r < slen && (is_alnum(str_char_at(source, r)) == 1 || str_char_at(source, r) == 95) {
                        r = r + 1;
                    };
                    if r > name_start {
                        let fname: str = str_substring(source, name_start, r);
                        entries.push(fname);
                    };
                    p = r;
                    break;
                };
                r = r + 1;
            };
            if r + 3 > slen { p = slen; };
        } else {
            p = p + 1;
        };
    };
    return entries;
}

fn name_in_no_check(no_check: Vec<i32>, fn_name: str) -> i64 {
    let n: i64 = vec_len(no_check);
    let mut i: i64 = 0;
    while i < n {
        if str_eq(vec_get(no_check, i), fn_name) == 1 { return 1; };
        i = i + 1;
    };
    return 0;
}

// RFC-0042 first cut — opt-in auto-drop scanner.
// Mirrors the #[no_check] marker scanner: source text is the least
// invasive way to add function-level attributes without perturbing
// the parser's AST layout. Pattern: `#[auto_drop]` followed by
// whitespace/comments/other attrs and then `fn NAME`.
fn collect_auto_drop_fns(source: str) -> Vec<i32> {
    let mut entries: Vec<i32> = Vec::new();
    let slen: i64 = str_len(source);
    let pat: str = "#[auto_drop]";
    let plen: i64 = str_len(pat);
    let mut p: i64 = 0;
    while p + plen <= slen {
        if p + 1 < slen && str_char_at(source, p) == 47 && str_char_at(source, p + 1) == 47 {
            while p < slen && str_char_at(source, p) != 10 { p = p + 1; };
            p = p + 1;
            continue;
        };
        if str_char_at(source, p) == 34 {
            p = p + 1;
            while p < slen && str_char_at(source, p) != 34 {
                if str_char_at(source, p) == 92 && p + 1 < slen { p = p + 2; }
                else { p = p + 1; };
            };
            p = p + 1;
            continue;
        };
        let mut m: i64 = 1;
        let mut k: i64 = 0;
        while k < plen {
            if str_char_at(source, p + k) != str_char_at(pat, k) { m = 0; break; };
            k = k + 1;
        };
        if m == 1 {
            let mut r: i64 = p + plen;
            while r + 3 <= slen {
                if r + 1 < slen && str_char_at(source, r) == 47 && str_char_at(source, r + 1) == 47 {
                    while r < slen && str_char_at(source, r) != 10 { r = r + 1; };
                };
                let c0: i64 = str_char_at(source, r);
                let c1: i64 = str_char_at(source, r + 1);
                let c2: i64 = str_char_at(source, r + 2);
                if c0 == 102 && c1 == 110 && c2 == 32 {
                    r = r + 3;
                    let name_start: i64 = r;
                    while r < slen && (is_alnum(str_char_at(source, r)) == 1 || str_char_at(source, r) == 95) {
                        r = r + 1;
                    };
                    if r > name_start {
                        let fname: str = str_substring(source, name_start, r);
                        entries.push(fname);
                    };
                    p = r;
                    break;
                };
                r = r + 1;
            };
            if r + 3 > slen { p = slen; };
        } else {
            p = p + 1;
        };
    };
    return entries;
}

fn name_in_auto_drop(auto_drop: Vec<i32>, fn_name: str) -> i64 {
    let n: i64 = vec_len(auto_drop);
    let mut i: i64 = 0;
    while i < n {
        if str_eq(vec_get(auto_drop, i), fn_name) == 1 { return 1; };
        i = i + 1;
    };
    return 0;
}

// v0.4.271 RFC-0006 — heap-aliased type detection for `old()` reject.
// The i64-everywhere ABI represents Vec/String/HashMap/HashSet/
// BTreeMap/BTreeSet/VecDeque/Box as a single i64 pointer to heap
// storage. Snapshotting the i64 captures the POINTER, not the
// buffer contents — so `old(v)` for `v: Vec<T>` aliases the post-
// mutation pointer and gives wrong ensure semantics. Reject at
// compile time with CONTRACT-006.
fn is_heap_aliased_type(ty: str) -> i64 {
    if str_starts_with(ty, "Vec<") == 1 { return 1; };
    if str_eq(ty, "String") == 1 { return 1; };
    if str_starts_with(ty, "String<") == 1 { return 1; };
    if str_starts_with(ty, "HashMap<") == 1 { return 1; };
    if str_starts_with(ty, "HashSet<") == 1 { return 1; };
    if str_starts_with(ty, "BTreeMap<") == 1 { return 1; };
    if str_starts_with(ty, "BTreeSet<") == 1 { return 1; };
    if str_starts_with(ty, "VecDeque<") == 1 { return 1; };
    if str_starts_with(ty, "Box<") == 1 { return 1; };
    return 0;
}

// v0.4.271 RFC-0006 — text-level lookup of a fn's named param type.
// Finds `fn FNAME(...)`, scans the param list with paren/angle-
// bracket depth tracking so `Vec<HashMap<i64, str>>` parses correctly,
// and returns the type-text of the param matching PNAME. Returns ""
// on miss. Used by the old() heap-aliased reject; matching pattern
// shape with the no_check / require / ensure scanners (text-level
// pre-pass before the AST is built).
fn fn_param_type(source: str, fn_name: str, param_name: str) -> str {
    let needle: str = str_concat("fn ", str_concat(fn_name, "("));
    let pat_pos: i64 = str_index_of(source, needle);
    if pat_pos < 0 { return ""; };
    let params_start: i64 = pat_pos + str_len(needle);
    let n: i64 = str_len(source);
    let mut depth: i64 = 1;
    let mut p: i64 = params_start;
    let mut params_end: i64 = 0 - 1;
    while p < n {
        let ch: str = str_substring(source, p, p + 1);
        if str_eq(ch, "(") == 1 { depth = depth + 1; };
        if str_eq(ch, ")") == 1 {
            depth = depth - 1;
            if depth == 0 { params_end = p; p = n; };
        };
        p = p + 1;
    };
    if params_end < 0 { return ""; };
    // Walk params: split on comma at depth 0 (angle-bracket / paren depth).
    let mut q: i64 = params_start;
    let mut start: i64 = params_start;
    let mut adepth: i64 = 0;
    let mut pdepth: i64 = 0;
    while q <= params_end {
        let at_end: i64 = if q >= params_end { 1 } else { 0 };
        let cch: str = if at_end == 1 { "," } else { str_substring(source, q, q + 1) };
        if str_eq(cch, "<") == 1 { adepth = adepth + 1; };
        if str_eq(cch, ">") == 1 { adepth = adepth - 1; };
        if str_eq(cch, "(") == 1 { pdepth = pdepth + 1; };
        if str_eq(cch, ")") == 1 { pdepth = pdepth - 1; };
        let comma_at_depth_zero: i64 = if str_eq(cch, ",") == 1 { if adepth == 0 { if pdepth == 0 { 1 } else { 0 } } else { 0 } } else { 0 };
        if comma_at_depth_zero == 1 || at_end == 1 {
            let param_text: str = str_substring(source, start, q);
            let colon_pos: i64 = str_index_of(param_text, ":");
            if colon_pos > 0 {
                let lhs: str = str_trim(str_substring(param_text, 0, colon_pos));
                let rhs: str = str_trim(str_substring(param_text, colon_pos + 1, str_len(param_text)));
                let lhs2: str = if str_starts_with(lhs, "mut ") == 1 { str_trim(str_substring(lhs, 4, str_len(lhs))) } else { lhs };
                if str_eq(lhs2, param_name) == 1 { return rhs; };
            };
            start = q + 1;
        };
        q = q + 1;
    };
    return "";
}

// v0.4.272 RFC-0006 — text-level lookup of a fn's return type.
// Finds `fn FNAME(...)`, walks past the param list with paren
// depth tracking, then returns the text between `->` and `{`
// trimmed. Returns "" if the fn has no return arrow (i.e. void
// return type). Used by the void-fn-result-ref reject.
fn fn_return_type(source: str, fn_name: str) -> str {
    let needle: str = str_concat("fn ", str_concat(fn_name, "("));
    let pat_pos: i64 = str_index_of(source, needle);
    if pat_pos < 0 { return ""; };
    let params_start: i64 = pat_pos + str_len(needle);
    let n: i64 = str_len(source);
    let mut depth: i64 = 1;
    let mut p: i64 = params_start;
    let mut params_end: i64 = 0 - 1;
    while p < n {
        let ch: str = str_substring(source, p, p + 1);
        if str_eq(ch, "(") == 1 { depth = depth + 1; };
        if str_eq(ch, ")") == 1 {
            depth = depth - 1;
            if depth == 0 { params_end = p; p = n; };
        };
        p = p + 1;
    };
    if params_end < 0 { return ""; };
    // Walk past `)` to find `->` or `{`.
    let mut q: i64 = params_end + 1;
    while q < n - 1 {
        let c2: str = str_substring(source, q, q + 2);
        let c1: str = str_substring(source, q, q + 1);
        if str_eq(c2, "->") == 1 {
            // Find the next `{` or `;` after the arrow.
            let mut r: i64 = q + 2;
            while r < n {
                let cr: str = str_substring(source, r, r + 1);
                if str_eq(cr, "{") == 1 { break; };
                if str_eq(cr, ";") == 1 { break; };
                r = r + 1;
            };
            if r > q + 2 {
                return str_trim(str_substring(source, q + 2, r));
            };
            return "";
        };
        if str_eq(c1, "{") == 1 { return ""; };
        if str_eq(c1, ";") == 1 { return ""; };
        q = q + 1;
    };
    return "";
}

// v0.4.277 RFC-0006 — scan a contract-predicate text for `old(`
// pseudo-call. Same word-boundary technique as
// `ensure_text_uses_result`: `old` must be preceded by start-of-
// text or non-ident char (so `older` / `bold(...)` don't match)
// and followed by `(`. Used to reject `#[require(old(...) ...)]`
// at compile time.
fn contract_text_uses_old(text: str) -> i64 {
    let needle: str = "old";
    let nlen: i64 = str_len(needle);
    let tlen: i64 = str_len(text);
    let mut i: i64 = 0;
    while i + nlen + 1 <= tlen {
        let win: str = str_substring(text, i, i + nlen);
        if str_eq(win, needle) == 1 {
            let prev_ok: i64 = if i == 0 { 1 } else {
                let pc: str = str_substring(text, i - 1, i);
                let p_alpha: i64 = if str_index_of("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_", pc) >= 0 { 1 } else { 0 };
                let p_digit: i64 = if str_index_of("0123456789", pc) >= 0 { 1 } else { 0 };
                if p_alpha == 0 { if p_digit == 0 { 1 } else { 0 } } else { 0 }
            };
            let next_paren: i64 = if str_eq(str_substring(text, i + nlen, i + nlen + 1), "(") == 1 { 1 } else { 0 };
            if prev_ok == 1 { if next_paren == 1 { return 1; }; };
        };
        i = i + 1;
    };
    return 0;
}

// v0.4.283 RFC-0006 — scan a contract-predicate text for any
// identifier that doesn't resolve to a fn parameter, a DbC
// keyword (result / old / self / true / false / None / Some /
// Ok / Err / null), a CamelCase type or enum variant (first
// char uppercase), an ALL_CAPS const (all chars uppercase /
// digits / underscores), or a fn-call site (followed by `(`).
// Returns the unbound ident name on first match, or "" if all
// idents resolve. Conservative: we'd rather miss a real
// undefined-ident (false negative — adopter sees the existing
// clang-link error) than reject a valid identifier.
//
// Probe-agent finding 2026-05-01: pre-fix,
// `#[require(undefined_var > 0)]` surfaced a misleading clang-
// link "undefined function `undefined_var()`" error. CONTRACT-011
// halts at parse time with the actual unbound ident named.
fn find_unbound_ident_in_contract(source: str, fn_name: str, predicate: str) -> str {
    let n: i64 = str_len(predicate);
    let mut i: i64 = 0;
    while i < n {
        let c: str = str_substring(predicate, i, i + 1);
        // Find start of an identifier: [A-Za-z_]
        let is_ident_start: i64 = if str_index_of("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_", c) >= 0 { 1 } else { 0 };
        if is_ident_start == 0 { i = i + 1; continue; };
        // Walk to end of ident.
        let start: i64 = i;
        let mut end: i64 = i;
        let mut keep_going: i64 = 1;
        while end < n && keep_going == 1 {
            let ch: str = str_substring(predicate, end, end + 1);
            let alpha: i64 = if str_index_of("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_", ch) >= 0 { 1 } else { 0 };
            let digit: i64 = if str_index_of("0123456789", ch) >= 0 { 1 } else { 0 };
            if alpha == 0 {
                if digit == 0 { keep_going = 0; }
                else { end = end + 1; };
            } else {
                end = end + 1;
            };
        };
        i = end;
        let ident: str = str_substring(predicate, start, end);
        // Skip if followed by `(` (fn call site) — also accepts whitespace.
        let mut k: i64 = end;
        while k < n {
            let kc: str = str_substring(predicate, k, k + 1);
            if str_eq(kc, " ") == 1 || str_eq(kc, "\t") == 1 || str_eq(kc, "\n") == 1 { k = k + 1; continue; };
            break;
        };
        let next_char: str = if k >= n { "" } else { str_substring(predicate, k, k + 1) };
        let next_two: str = if k + 1 >= n { next_char } else { str_substring(predicate, k, k + 2) };
        // Skip if preceded by `.` (field/method access) — scan back through whitespace.
        let mut j: i64 = start;
        while j > 0 {
            let jc: str = str_substring(predicate, j - 1, j);
            if str_eq(jc, " ") == 1 || str_eq(jc, "\t") == 1 || str_eq(jc, "\n") == 1 { j = j - 1; continue; };
            break;
        };
        let prev_char: str = if j == 0 { "" } else { str_substring(predicate, j - 1, j) };
        let prev_two: str = if j < 2 { prev_char } else { str_substring(predicate, j - 2, j) };
        // === Skip rules (any one matches → not unbound) ===
        // Followed by `(` — fn call site.
        if str_eq(next_char, "(") == 1 { continue; };
        // Followed by `::` — path syntax.
        if str_eq(next_two, "::") == 1 { continue; };
        // Followed by `[` — index expr (caller chose this form).
        if str_eq(next_char, "[") == 1 { continue; };
        // Followed by `{` — struct-init expr.
        if str_eq(next_char, "{") == 1 { continue; };
        // Preceded by `.` — field/method access.
        if str_eq(prev_char, ".") == 1 { continue; };
        // Preceded by `::` — path tail (already-resolved variant).
        if str_eq(prev_two, "::") == 1 { continue; };
        // DbC keyword allowlist.
        if str_eq(ident, "result") == 1 { continue; };
        if str_eq(ident, "old") == 1 { continue; };
        if str_eq(ident, "self") == 1 { continue; };
        if str_eq(ident, "true") == 1 { continue; };
        if str_eq(ident, "false") == 1 { continue; };
        if str_eq(ident, "None") == 1 { continue; };
        if str_eq(ident, "Some") == 1 { continue; };
        if str_eq(ident, "Ok") == 1 { continue; };
        if str_eq(ident, "Err") == 1 { continue; };
        if str_eq(ident, "null") == 1 { continue; };
        // CamelCase first char (Type / Variant / Module name).
        let first_char: str = str_substring(ident, 0, 1);
        if str_index_of("ABCDEFGHIJKLMNOPQRSTUVWXYZ", first_char) >= 0 { continue; };
        // Fn parameter.
        let pty: str = fn_param_type(source, fn_name, ident);
        if str_len(pty) > 0 { continue; };
        // Looks unbound — return it.
        return ident;
    };
    return "";
}

// v0.4.272 RFC-0006 — scan an ensure-predicate text for a bare
// `result` identifier reference. Walks the text, tracking word
// boundaries: a hit must be preceded by start-of-text or non-
// ident char, and followed by end-of-text or non-ident char.
// Used to reject `#[ensure(result ...)]` on void fns.
fn ensure_text_uses_result(text: str) -> i64 {
    let needle: str = "result";
    let nlen: i64 = str_len(needle);
    let tlen: i64 = str_len(text);
    let mut i: i64 = 0;
    while i + nlen <= tlen {
        let win: str = str_substring(text, i, i + nlen);
        if str_eq(win, needle) == 1 {
            let prev_ok: i64 = if i == 0 { 1 } else {
                let pc: str = str_substring(text, i - 1, i);
                let p_alpha: i64 = if str_index_of("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_", pc) >= 0 { 1 } else { 0 };
                let p_digit: i64 = if str_index_of("0123456789", pc) >= 0 { 1 } else { 0 };
                if p_alpha == 0 { if p_digit == 0 { 1 } else { 0 } } else { 0 }
            };
            let next_ok: i64 = if i + nlen >= tlen { 1 } else {
                let nc: str = str_substring(text, i + nlen, i + nlen + 1);
                let n_alpha: i64 = if str_index_of("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_", nc) >= 0 { 1 } else { 0 };
                let n_digit: i64 = if str_index_of("0123456789", nc) >= 0 { 1 } else { 0 };
                if n_alpha == 0 { if n_digit == 0 { 1 } else { 0 } } else { 0 }
            };
            if prev_ok == 1 { if next_ok == 1 { return 1; }; };
        };
        i = i + 1;
    };
    return 0;
}

// v0.4.271 RFC-0006 — quick check whether `text` is a bare identifier
// (only `[A-Za-z_][A-Za-z0-9_]*`, no whitespace / punctuation /
// operators). Conservative: complex `old()` expressions like
// `old(self.field)` or `old(get_vec())` skip the heap-aliased
// reject (false negative is preferred over false positive — the
// runtime panic still surfaces in those edge cases).
fn is_bare_ident(text: str) -> i64 {
    let t: str = str_trim(text);
    let n: i64 = str_len(t);
    if n == 0 { return 0; };
    let mut i: i64 = 0;
    while i < n {
        let c: str = str_substring(t, i, i + 1);
        let is_alpha: i64 = if str_index_of("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_", c) >= 0 { 1 } else { 0 };
        let is_digit: i64 = if str_index_of("0123456789", c) >= 0 { 1 } else { 0 };
        if i == 0 {
            if is_alpha == 0 { return 0; };
        } else {
            if is_alpha == 0 {
                if is_digit == 0 { return 0; };
            };
        };
        i = i + 1;
    };
    return 1;
}

// v0.4.257 RFC-0006 Liskov substrate — count #[require] and
// #[ensure] attributes per trait method declaration. Returns flat
// Vec of (trait_name, method_name, req_count, ens_count) tuples
// where the count fields are stored as decimal strings (the flat
// Vec<i32> representation forces all entries to be the same shape).
//
// Walking heuristic: scan source for `trait NAME {` blocks; track
// brace depth so nested decls don't escape; within the trait,
// scan for `fn METHOD(`; before each fn, scan back/forward for
// preceding `#[require(...)]` / `#[ensure(...)]` attributes
// (those that fall between the previous statement boundary and
// the fn keyword).
fn collect_trait_method_attrs(source: str) -> Vec<i32> {
    let mut out: Vec<i32> = Vec::new();
    let slen: i64 = str_len(source);
    let trait_pat: str = "trait ";
    let tplen: i64 = str_len(trait_pat);
    let mut p: i64 = 0;
    while p + tplen <= slen {
        if p + 1 < slen && str_char_at(source, p) == 47 && str_char_at(source, p + 1) == 47 {
            while p < slen && str_char_at(source, p) != 10 { p = p + 1; };
            p = p + 1;
            continue;
        };
        if str_char_at(source, p) == 34 {
            p = p + 1;
            while p < slen && str_char_at(source, p) != 34 {
                if str_char_at(source, p) == 92 && p + 1 < slen { p = p + 2; }
                else { p = p + 1; };
            };
            p = p + 1;
            continue;
        };
        // Match "trait " only at identifier boundary.
        let mut at_boundary: i64 = 1;
        if p > 0 {
            let prev: i64 = str_char_at(source, p - 1);
            if is_alnum(prev) == 1 || prev == 95 { at_boundary = 0; };
        };
        let mut tm: i64 = at_boundary;
        if tm == 1 {
            let mut k: i64 = 0;
            while k < tplen {
                if str_char_at(source, p + k) != str_char_at(trait_pat, k) { tm = 0; break; };
                k = k + 1;
            };
        };
        if tm == 1 {
            let n_start: i64 = p + tplen;
            let mut q: i64 = n_start;
            while q < slen && (is_alnum(str_char_at(source, q)) == 1 || str_char_at(source, q) == 95) {
                q = q + 1;
            };
            let trait_name: str = str_substring(source, n_start, q);
            // Skip whitespace to find `{`.
            while q < slen && str_char_at(source, q) != 123 && str_char_at(source, q) != 59 { q = q + 1; };
            if q >= slen || str_char_at(source, q) == 59 {
                p = q + 1;
                continue;
            };
            // q points at `{`. Walk brace-balanced trait body.
            q = q + 1;
            let mut brace_depth: i64 = 1;
            let mut last_attr_end: i64 = q;
            while q < slen && brace_depth > 0 {
                let cc: i64 = str_char_at(source, q);
                if cc == 47 && q + 1 < slen && str_char_at(source, q + 1) == 47 {
                    while q < slen && str_char_at(source, q) != 10 { q = q + 1; };
                    continue;
                };
                if cc == 34 {
                    q = q + 1;
                    while q < slen && str_char_at(source, q) != 34 {
                        if str_char_at(source, q) == 92 && q + 1 < slen { q = q + 2; }
                        else { q = q + 1; };
                    };
                    if q < slen { q = q + 1; };
                    continue;
                };
                if cc == 123 { brace_depth = brace_depth + 1; q = q + 1; continue; };
                if cc == 125 { brace_depth = brace_depth - 1; q = q + 1; continue; };
                // Within the trait body, look for `fn METHOD(`.
                if brace_depth == 1 && cc == 102 && q + 3 < slen
                    && str_char_at(source, q + 1) == 110 && str_char_at(source, q + 2) == 32 {
                    let mut at_fn_boundary: i64 = 1;
                    if q > 0 {
                        let prev_fn: i64 = str_char_at(source, q - 1);
                        if is_alnum(prev_fn) == 1 || prev_fn == 95 { at_fn_boundary = 0; };
                    };
                    if at_fn_boundary == 1 {
                        let m_start: i64 = q + 3;
                        let mut mq: i64 = m_start;
                        while mq < slen && (is_alnum(str_char_at(source, mq)) == 1 || str_char_at(source, mq) == 95) {
                            mq = mq + 1;
                        };
                        let method_name: str = str_substring(source, m_start, mq);
                        // Count #[require( and #[ensure( in the
                        // window [last_attr_end, q).
                        let mut req_n: i64 = 0;
                        let mut ens_n: i64 = 0;
                        let mut wp: i64 = last_attr_end;
                        let req_pat: str = "#[require(";
                        let req_plen: i64 = str_len(req_pat);
                        let ens_pat: str = "#[ensure(";
                        let ens_plen: i64 = str_len(ens_pat);
                        while wp < q {
                            if wp + req_plen <= q {
                                let mut mr: i64 = 1;
                                let mut kk: i64 = 0;
                                while kk < req_plen {
                                    if str_char_at(source, wp + kk) != str_char_at(req_pat, kk) { mr = 0; break; };
                                    kk = kk + 1;
                                };
                                if mr == 1 { req_n = req_n + 1; wp = wp + req_plen; continue; };
                            };
                            if wp + ens_plen <= q {
                                let mut me: i64 = 1;
                                let mut kk2: i64 = 0;
                                while kk2 < ens_plen {
                                    if str_char_at(source, wp + kk2) != str_char_at(ens_pat, kk2) { me = 0; break; };
                                    kk2 = kk2 + 1;
                                };
                                if me == 1 { ens_n = ens_n + 1; wp = wp + ens_plen; continue; };
                            };
                            wp = wp + 1;
                        };
                        out.push(trait_name);
                        out.push(method_name);
                        out.push(str_from_int(req_n));
                        out.push(str_from_int(ens_n));
                        // Walk past the fn signature + body to set
                        // last_attr_end = position after fn's `;` or `}`.
                        // Simplest: continue from current q; the next
                        // attribute search will start after the fn line.
                        q = mq;
                        last_attr_end = mq;
                        continue;
                    };
                };
                q = q + 1;
            };
            p = q;
            continue;
        };
        p = p + 1;
    };
    return out;
}

// v0.4.257 RFC-0006 Liskov substrate — count #[require] and
// #[ensure] attributes per impl-trait method definition. Returns
// flat Vec of (trait_name, type_name, method_name, req_count,
// ens_count) tuples. Only trait impls (the `impl Trait for Type`
// form) are captured; inherent impls (`impl Type`) are skipped.
fn collect_impl_trait_method_attrs(source: str) -> Vec<i32> {
    let mut out: Vec<i32> = Vec::new();
    let slen: i64 = str_len(source);
    let impl_pat: str = "impl ";
    let iplen: i64 = str_len(impl_pat);
    let mut p: i64 = 0;
    while p + iplen <= slen {
        if p + 1 < slen && str_char_at(source, p) == 47 && str_char_at(source, p + 1) == 47 {
            while p < slen && str_char_at(source, p) != 10 { p = p + 1; };
            p = p + 1;
            continue;
        };
        if str_char_at(source, p) == 34 {
            p = p + 1;
            while p < slen && str_char_at(source, p) != 34 {
                if str_char_at(source, p) == 92 && p + 1 < slen { p = p + 2; }
                else { p = p + 1; };
            };
            p = p + 1;
            continue;
        };
        let mut at_boundary: i64 = 1;
        if p > 0 {
            let prev: i64 = str_char_at(source, p - 1);
            if is_alnum(prev) == 1 || prev == 95 { at_boundary = 0; };
        };
        let mut im: i64 = at_boundary;
        if im == 1 {
            let mut k: i64 = 0;
            while k < iplen {
                if str_char_at(source, p + k) != str_char_at(impl_pat, k) { im = 0; break; };
                k = k + 1;
            };
        };
        if im == 1 {
            let id1_start: i64 = p + iplen;
            let mut q: i64 = id1_start;
            while q < slen && (is_alnum(str_char_at(source, q)) == 1 || str_char_at(source, q) == 95) {
                q = q + 1;
            };
            let id1: str = str_substring(source, id1_start, q);
            // Skip whitespace.
            while q < slen && (str_char_at(source, q) == 32 || str_char_at(source, q) == 9) { q = q + 1; };
            // Look for `for ` to confirm trait-impl form.
            if q + 4 > slen
                || str_char_at(source, q) != 102
                || str_char_at(source, q + 1) != 111
                || str_char_at(source, q + 2) != 114
                || str_char_at(source, q + 3) != 32 {
                p = q;
                continue;
            };
            q = q + 4;
            let id2_start: i64 = q;
            while q < slen && (is_alnum(str_char_at(source, q)) == 1 || str_char_at(source, q) == 95) {
                q = q + 1;
            };
            let id2: str = str_substring(source, id2_start, q);
            // Skip to `{`.
            while q < slen && str_char_at(source, q) != 123 { q = q + 1; };
            if q >= slen { p = q; continue; };
            q = q + 1;
            let mut brace_depth: i64 = 1;
            let mut last_attr_end: i64 = q;
            while q < slen && brace_depth > 0 {
                let cc: i64 = str_char_at(source, q);
                if cc == 47 && q + 1 < slen && str_char_at(source, q + 1) == 47 {
                    while q < slen && str_char_at(source, q) != 10 { q = q + 1; };
                    continue;
                };
                if cc == 34 {
                    q = q + 1;
                    while q < slen && str_char_at(source, q) != 34 {
                        if str_char_at(source, q) == 92 && q + 1 < slen { q = q + 2; }
                        else { q = q + 1; };
                    };
                    if q < slen { q = q + 1; };
                    continue;
                };
                if cc == 123 { brace_depth = brace_depth + 1; q = q + 1; continue; };
                if cc == 125 { brace_depth = brace_depth - 1; q = q + 1; continue; };
                if brace_depth == 1 && cc == 102 && q + 3 < slen
                    && str_char_at(source, q + 1) == 110 && str_char_at(source, q + 2) == 32 {
                    let mut at_fn_b: i64 = 1;
                    if q > 0 {
                        let prev_fn: i64 = str_char_at(source, q - 1);
                        if is_alnum(prev_fn) == 1 || prev_fn == 95 { at_fn_b = 0; };
                    };
                    if at_fn_b == 1 {
                        let m_start: i64 = q + 3;
                        let mut mq: i64 = m_start;
                        while mq < slen && (is_alnum(str_char_at(source, mq)) == 1 || str_char_at(source, mq) == 95) {
                            mq = mq + 1;
                        };
                        let method_name: str = str_substring(source, m_start, mq);
                        let mut req_n: i64 = 0;
                        let mut ens_n: i64 = 0;
                        let mut wp: i64 = last_attr_end;
                        let req_pat: str = "#[require(";
                        let req_plen: i64 = str_len(req_pat);
                        let ens_pat: str = "#[ensure(";
                        let ens_plen: i64 = str_len(ens_pat);
                        while wp < q {
                            if wp + req_plen <= q {
                                let mut mr: i64 = 1;
                                let mut kk: i64 = 0;
                                while kk < req_plen {
                                    if str_char_at(source, wp + kk) != str_char_at(req_pat, kk) { mr = 0; break; };
                                    kk = kk + 1;
                                };
                                if mr == 1 { req_n = req_n + 1; wp = wp + req_plen; continue; };
                            };
                            if wp + ens_plen <= q {
                                let mut me: i64 = 1;
                                let mut kk2: i64 = 0;
                                while kk2 < ens_plen {
                                    if str_char_at(source, wp + kk2) != str_char_at(ens_pat, kk2) { me = 0; break; };
                                    kk2 = kk2 + 1;
                                };
                                if me == 1 { ens_n = ens_n + 1; wp = wp + ens_plen; continue; };
                            };
                            wp = wp + 1;
                        };
                        out.push(id1);
                        out.push(id2);
                        out.push(method_name);
                        out.push(str_from_int(req_n));
                        out.push(str_from_int(ens_n));
                        q = mq;
                        last_attr_end = mq;
                        continue;
                    };
                };
                q = q + 1;
            };
            p = q;
            continue;
        };
        p = p + 1;
    };
    return out;
}

// Look up (req_count, ens_count) for a trait method. Returns
// `(0 - 1, 0 - 1)` if not found.
fn lookup_trait_method_counts(attrs: Vec<i32>, trait_name: str, method_name: str) -> Vec<i32> {
    let mut out: Vec<i32> = Vec::new();
    let n: i64 = vec_len(attrs);
    let mut i: i64 = 0;
    while i + 3 < n {
        if str_eq(vec_get(attrs, i), trait_name) == 1
            && str_eq(vec_get(attrs, i + 1), method_name) == 1 {
            out.push(str_to_int(vec_get(attrs, i + 2)));
            out.push(str_to_int(vec_get(attrs, i + 3)));
            return out;
        };
        i = i + 4;
    };
    out.push(0 - 1);
    out.push(0 - 1);
    return out;
}

// For a given fn_name marked #[no_alloc], scan its body text for
// literal `<alloc_call>(` patterns and emit RT-001 diags into
// `diags` for each match.
fn check_no_alloc_violations(diags: Vec<i32>, source: str, fn_name: str) {
    let needle: str = str_concat("fn ", str_concat(fn_name, "("));
    let nlen: i64 = str_len(needle);
    let slen: i64 = str_len(source);
    let mut p: i64 = 0;
    while p + nlen <= slen {
        let mut m: i64 = 1;
        let mut k: i64 = 0;
        while k < nlen {
            if str_char_at(source, p + k) != str_char_at(needle, k) { m = 0; break; };
            k = k + 1;
        };
        if m == 1 {
            // Walk to the body's opening '{'.
            let mut q: i64 = p + nlen;
            while q < slen && str_char_at(source, q) != 123 { q = q + 1; };
            if q < slen {
                let body_start: i64 = q + 1;
                let mut depth: i64 = 1;
                q = q + 1;
                while q < slen && depth > 0 {
                    let c: i64 = str_char_at(source, q);
                    if c == 123 { depth = depth + 1; };
                    if c == 125 { depth = depth - 1; };
                    q = q + 1;
                };
                let body_raw: str = str_substring(source, body_start, q - 1);
                // T3.7 (v0.3.6): strip `"..."` strings and `// ...`
                // line comments before scanning so a `"Vec::new"` or
                // `// uses vec_push` text doesn't false-positive.
                let body: str = strip_strings_and_line_comments(body_raw);
                // Walk every alloc-builtin name and check str_contains
                // for `<name>(` in the body. Each match becomes one
                // diag; we don't dedup, so two `vec_push(...)` calls
                // produce two RT-001 entries.
                let alloc_names: Vec<i32> = no_alloc_check_list();
                let mut ai: i64 = 0;
                while ai < vec_len(alloc_names) {
                    let n: str = vec_get(alloc_names, ai);
                    // For dot-prefixed method-call sugar (e.g. `.push`)
                    // the `(` separator is already implied; for the
                    // bare names append `(` to anchor the match.
                    let pat: str = str_concat(n, "(");
                    if str_contains(body, pat) == 1 {
                        let msg: str = str_concat("`", str_concat(n, str_concat("` allocates but `", str_concat(fn_name, "` is marked #[no_alloc]"))));
                        diag_add_ex(diags, "error", "rt", "RT-001", msg, fn_name, 0, 0, "");
                    };
                    ai = ai + 1;
                };
            };
            return;
        };
        p = p + 1;
    };
}

// The list of allocator-call patterns to scan for in a #[no_alloc]
// body. Each entry is matched as a literal substring with `(`
// appended (so `vec_push` matches `vec_push(` but not `vec_pushy`),
// EXCEPT entries already containing `(` or `::` are matched verbatim
// so they can encode method-call / constructor forms.
//
// Includes both the underlying builtin names (rare in user code) and
// the user-facing forms (`Vec::new(`, `.push(`, etc.) that the s1
// lowers to those builtins. The dot-prefixed forms catch the method-
// call sugar; this is the only way the source-level v1 check can see
// `vec.push(x)` without an AST.
fn no_alloc_check_list() -> Vec<i32> {
    let mut v: Vec<i32> = Vec::new();
    // Vec — constructor + method calls
    v.push("Vec::new");
    v.push(".push");
    v.push(".pop");
    v.push(".extend");
    v.push(".insert_at");
    v.push(".remove_at");
    // Vec — builtin names (in case user reaches past the sugar)
    v.push("vec_new"); v.push("vec_push"); v.push("vec_pop");
    v.push("vec_extend"); v.push("vec_insert_at"); v.push("vec_remove_at");
    // String builder
    v.push("sb_new"); v.push("sb_append");
    // String allocators
    v.push("str_concat"); v.push("str_substring"); v.push("str_repeat");
    v.push("str_pad_left"); v.push("str_pad_right");
    v.push("str_center"); v.push("str_join");
    // Format-string helpers (every one mallocs)
    v.push("format_i64"); v.push("format_str"); v.push("format_f64");
    v.push("format_hex"); v.push("format_bool");
    v.push("format2_ii"); v.push("format2_si"); v.push("format2_ss");
    v.push("format2_is"); v.push("format2_ff");
    v.push("format3_iii"); v.push("format3_sii"); v.push("format3_iss"); v.push("format3_sss");
    v.push("format3_ssi"); v.push("format3_sis");
    v.push("format3_iis"); v.push("format3_isi");
    v.push("format3_iif"); v.push("format3_iff"); v.push("format3_sff");
    v.push("format3_ssf"); v.push("format3_sif"); v.push("format3_isf");
    // Number-to-string
    v.push("int_to_str"); v.push("f64_to_str"); v.push("bool_to_str");
    // Bare arena builtins (RFC-0002 phase 1) — also alloc
    v.push("arena_new"); v.push("arena_alloc");
    return v;
}

fn enforce_no_alloc(diags: Vec<i32>, source: str) -> Vec<i32> {
    let no_alloc_fns: Vec<i32> = collect_no_alloc_fns(source);
    let alloc_effect_fns: Vec<i32> = collect_fns_with_effect(source, "Alloc");
    let mut i: i64 = 0;
    while i < vec_len(no_alloc_fns) {
        let fn_name: str = vec_get(no_alloc_fns, i);
        check_no_alloc_violations(diags, source, fn_name);
        check_effect_call_violations(diags, source, fn_name, alloc_effect_fns, "Alloc", "no_alloc");
        i = i + 1;
    };
    return diags;
}

// === T3.2 (v0.3.1): #[no_panic] enforcement (RT-002) ===
// Mirror of the #[no_alloc] source-level scanner. Walks for the
// `#[no_panic]` attribute, associates each with the next fn,
// then scans the fn body for panic-prone call patterns and emits
// RT-002 per violation.
//
// What "can panic" includes:
//   - `panic("...")`         — explicit panic builtin
//   - `assert_eq` / `assert_ne` — abort on failure
//   - `unwrap` / `.unwrap()`  — Option/Result unwrap (panics on None/Err)
//   - `expect` / `.expect()`  — same with custom message
//   - `dbg!`                  — convention: panics on assertion fail
//
// Same v1 limitations as #[no_alloc]:
//   - Source-level only (no AST, no transitive call-graph chase)
//   - String/comment-aware skip
//   - Per-file scope

fn collect_no_panic_fns(source: str) -> Vec<i32> {
    let mut fns: Vec<i32> = Vec::new();
    let slen: i64 = str_len(source);
    let pat: str = "#[no_panic]";
    let plen: i64 = str_len(pat);
    let mut p: i64 = 0;
    while p + plen <= slen {
        if p + 1 < slen && str_char_at(source, p) == 47 && str_char_at(source, p + 1) == 47 {
            while p < slen && str_char_at(source, p) != 10 { p = p + 1; };
            p = p + 1;
            continue;
        };
        if str_char_at(source, p) == 34 {
            p = p + 1;
            while p < slen && str_char_at(source, p) != 34 {
                if str_char_at(source, p) == 92 && p + 1 < slen { p = p + 2; }
                else { p = p + 1; };
            };
            p = p + 1;
            continue;
        };
        let mut m: i64 = 1;
        let mut k: i64 = 0;
        while k < plen {
            if str_char_at(source, p + k) != str_char_at(pat, k) { m = 0; break; };
            k = k + 1;
        };
        if m == 1 {
            let mut q: i64 = p + plen;
            while q + 3 <= slen {
                let c0: i64 = str_char_at(source, q);
                let c1: i64 = str_char_at(source, q + 1);
                let c2: i64 = str_char_at(source, q + 2);
                if c0 == 102 && c1 == 110 && c2 == 32 {
                    q = q + 3;
                    let name_start: i64 = q;
                    while q < slen && (is_alnum(str_char_at(source, q)) == 1 || str_char_at(source, q) == 95) {
                        q = q + 1;
                    };
                    if q > name_start {
                        let name: str = str_substring(source, name_start, q);
                        fns.push(name);
                    };
                    p = q;
                    break;
                };
                q = q + 1;
            };
            if q + 3 > slen { p = slen; };
        } else {
            p = p + 1;
        };
    };
    rt_string_vec_append(fns, collect_fns_with_effect(source, "no_panic"));
    return fns;
}

fn no_panic_check_list() -> Vec<i32> {
    // Call patterns to flag inside #[no_panic] fns. Each entry is
    // a literal substring search; the body MUST contain `<entry>(`
    // (or `.unwrap`/`.expect` for method-call form). Same approach
    // as no_alloc_check_list — easy to extend as new panic-prone
    // primitives ship.
    let mut v: Vec<i32> = Vec::new();
    v.push("panic");
    v.push("assert_eq");
    v.push("assert_ne");
    v.push("unwrap");
    v.push("expect");
    v.push(".unwrap");
    v.push(".expect");
    return v;
}

fn check_no_panic_violations(diags: Vec<i32>, source: str, fn_name: str) {
    let needle: str = str_concat("fn ", str_concat(fn_name, "("));
    let nlen: i64 = str_len(needle);
    let slen: i64 = str_len(source);
    let mut p: i64 = 0;
    while p + nlen <= slen {
        let mut m: i64 = 1;
        let mut k: i64 = 0;
        while k < nlen {
            if str_char_at(source, p + k) != str_char_at(needle, k) { m = 0; break; };
            k = k + 1;
        };
        if m == 1 {
            let mut q: i64 = p + nlen;
            while q < slen && str_char_at(source, q) != 123 { q = q + 1; };
            if q < slen {
                let body_start: i64 = q + 1;
                let mut depth: i64 = 1;
                q = q + 1;
                while q < slen && depth > 0 {
                    let c: i64 = str_char_at(source, q);
                    if c == 123 { depth = depth + 1; };
                    if c == 125 { depth = depth - 1; };
                    q = q + 1;
                };
                let body_raw: str = str_substring(source, body_start, q - 1);
                let body: str = strip_strings_and_line_comments(body_raw);
                let panic_names: Vec<i32> = no_panic_check_list();
                let mut ai: i64 = 0;
                while ai < vec_len(panic_names) {
                    let n: str = vec_get(panic_names, ai);
                    let pat: str = str_concat(n, "(");
                    if str_contains(body, pat) == 1 {
                        let msg: str = str_concat("`", str_concat(n, str_concat("` can panic but `", str_concat(fn_name, "` is marked #[no_panic]"))));
                        diag_add_ex(diags, "error", "rt", "RT-002", msg, fn_name, 0, 0, "");
                    };
                    ai = ai + 1;
                };
            };
            return;
        };
        p = p + 1;
    };
}

fn enforce_no_panic(diags: Vec<i32>, source: str) -> Vec<i32> {
    let no_panic_fns: Vec<i32> = collect_no_panic_fns(source);
    let panic_effect_fns: Vec<i32> = collect_fns_with_effect(source, "Panic");
    let mut i: i64 = 0;
    while i < vec_len(no_panic_fns) {
        let fn_name: str = vec_get(no_panic_fns, i);
        check_no_panic_violations(diags, source, fn_name);
        check_effect_call_violations(diags, source, fn_name, panic_effect_fns, "Panic", "no_panic");
        i = i + 1;
    };
    return diags;
}

fn collect_atomic_fns(source: str) -> Vec<i32> {
    let mut fns: Vec<i32> = Vec::new();
    let slen: i64 = str_len(source);
    let pat: str = "#[atomic]";
    let plen: i64 = str_len(pat);
    let mut p: i64 = 0;
    while p + plen <= slen {
        if p + 1 < slen && str_char_at(source, p) == 47 && str_char_at(source, p + 1) == 47 {
            while p < slen && str_char_at(source, p) != 10 { p = p + 1; };
            p = p + 1;
            continue;
        };
        if str_char_at(source, p) == 34 {
            p = p + 1;
            while p < slen && str_char_at(source, p) != 34 {
                if str_char_at(source, p) == 92 && p + 1 < slen { p = p + 2; }
                else { p = p + 1; };
            };
            p = p + 1;
            continue;
        };
        let mut m: i64 = 1;
        let mut k: i64 = 0;
        while k < plen {
            if str_char_at(source, p + k) != str_char_at(pat, k) { m = 0; break; };
            k = k + 1;
        };
        if m == 1 {
            let mut q: i64 = p + plen;
            while q + 3 <= slen {
                let c0: i64 = str_char_at(source, q);
                let c1: i64 = str_char_at(source, q + 1);
                let c2: i64 = str_char_at(source, q + 2);
                if c0 == 102 && c1 == 110 && c2 == 32 {
                    q = q + 3;
                    let name_start: i64 = q;
                    while q < slen && (is_alnum(str_char_at(source, q)) == 1 || str_char_at(source, q) == 95) {
                        q = q + 1;
                    };
                    if q > name_start { fns.push(str_substring(source, name_start, q)); };
                    p = q;
                    break;
                };
                q = q + 1;
            };
            if q + 3 > slen { p = slen; };
        } else {
            p = p + 1;
        };
    };
    return fns;
}

fn source_fn_body_for_scan(source: str, fn_name: str) -> str {
    let needle: str = str_concat("fn ", str_concat(fn_name, "("));
    let nlen: i64 = str_len(needle);
    let slen: i64 = str_len(source);
    let mut p: i64 = 0;
    while p + nlen <= slen {
        let mut m: i64 = 1;
        let mut k: i64 = 0;
        while k < nlen {
            if str_char_at(source, p + k) != str_char_at(needle, k) { m = 0; break; };
            k = k + 1;
        };
        if m == 1 {
            let mut q: i64 = p + nlen;
            while q < slen && str_char_at(source, q) != 123 { q = q + 1; };
            if q < slen {
                let body_start: i64 = q + 1;
                let mut depth: i64 = 1;
                q = q + 1;
                while q < slen && depth > 0 {
                    let c: i64 = str_char_at(source, q);
                    if c == 123 { depth = depth + 1; };
                    if c == 125 { depth = depth - 1; };
                    q = q + 1;
                };
                return str_substring(source, body_start, q - 1);
            };
            return "";
        };
        p = p + 1;
    };
    return "";
}

fn check_effect_call_violations(diags: Vec<i32>, source: str, fn_name: str, effect_fns: Vec<i32>, effect_name: str, contract_name: str) -> i64 {
    if vec_len(effect_fns) == 0 { return 0; };
    let body_raw: str = source_fn_body_for_scan(source, fn_name);
    if str_len(body_raw) == 0 { return 0; };
    let body: str = strip_strings_and_line_comments(body_raw);
    let mut emitted: i64 = 0;
    let n: i64 = vec_len(effect_fns);
    let mut i: i64 = 0;
    while i < n {
        let callee: str = vec_get(effect_fns, i);
        if str_eq(callee, fn_name) == 0 {
            let pat: str = str_concat(callee, "(");
            if str_contains(body, pat) == 1 {
                let msg: str = str_concat("call to `", str_concat(callee, str_concat("()` requires effect `", str_concat(effect_name, str_concat("` but `", str_concat(fn_name, str_concat("` is declared with [", str_concat(contract_name, "]"))))))));
                diag_add_ex(diags, "error", "effect", "EFF-003", msg, fn_name, 0, 0, "");
                emitted = emitted + 1;
            };
        };
        i = i + 1;
    };
    return emitted;
}

fn atomic_blocking_check_list() -> Vec<i32> {
    let mut v: Vec<i32> = Vec::new();
    v.push("mutex_lock"); v.push(".lock"); v.push("rwlock_read"); v.push("rwlock_write");
    v.push(".read"); v.push(".write"); v.push("channel_recv"); v.push(".recv");
    v.push("sleep_ms"); v.push("sleep_us"); v.push("system"); v.push("process_spawn");
    v.push("socket_accept"); v.push("file_read_string");
    return v;
}

fn atomic_cell_check_list() -> Vec<i32> {
    let mut v: Vec<i32> = Vec::new();
    v.push("Cell<"); v.push("RefCell<"); v.push("Cell::"); v.push("RefCell::");
    v.push("cell_new"); v.push("refcell_new");
    return v;
}

fn check_atomic_contract_violations(diags: Vec<i32>, source: str, fn_name: str) {
    let body_raw: str = source_fn_body_for_scan(source, fn_name);
    if str_len(body_raw) == 0 { return; };
    let body: str = strip_strings_and_line_comments(body_raw);
    let blocking: Vec<i32> = atomic_blocking_check_list();
    let mut i: i64 = 0;
    while i < vec_len(blocking) {
        let n: str = vec_get(blocking, i);
        let pat: str = str_concat(n, "(");
        if str_contains(body, pat) == 1 {
            let msg: str = str_concat("`", str_concat(n, str_concat("` may block but `", str_concat(fn_name, "` is marked #[atomic]"))));
            diag_add_ex(diags, "error", "atomic", "ATOMIC-001", msg, fn_name, 0, 0, "");
        };
        i = i + 1;
    };
    let allocs: Vec<i32> = no_alloc_check_list();
    i = 0;
    while i < vec_len(allocs) {
        let n2: str = vec_get(allocs, i);
        let pat2: str = str_concat(n2, "(");
        if str_contains(body, pat2) == 1 {
            let msg2: str = str_concat("`", str_concat(n2, str_concat("` allocates but `", str_concat(fn_name, "` is marked #[atomic]"))));
            diag_add_ex(diags, "error", "atomic", "ATOMIC-002", msg2, fn_name, 0, 0, "");
        };
        i = i + 1;
    };
    let cells: Vec<i32> = atomic_cell_check_list();
    i = 0;
    while i < vec_len(cells) {
        let n3: str = vec_get(cells, i);
        if str_contains(body, n3) == 1 {
            let msg3: str = str_concat("`", str_concat(n3, "` is interior mutability with runtime borrow state and is forbidden inside #[atomic]"));
            diag_add_ex(diags, "error", "atomic", "ATOMIC-003", msg3, fn_name, 0, 0, "");
        };
        i = i + 1;
    };
}

fn atomic_find_pattern_from(text: str, pat: str, start: i64) -> i64 {
    let tlen: i64 = str_len(text);
    let plen: i64 = str_len(pat);
    if plen == 0 || tlen < plen { return 0 - 1; };
    let mut p: i64 = start;
    while p + plen <= tlen {
        if str_eq_at(text, p, pat) == 1 { return p; };
        p = p + 1;
    };
    return 0 - 1;
}

fn atomic_find_call_end(text: str, open_pos: i64) -> i64 {
    let tlen: i64 = str_len(text);
    let mut p: i64 = open_pos;
    let mut depth: i64 = 0;
    while p < tlen {
        let c: i64 = str_char_at(text, p);
        if c == 40 { depth = depth + 1; }
        else if c == 41 {
            depth = depth - 1;
            if depth == 0 { return p; };
        };
        p = p + 1;
    };
    return 0 - 1;
}

fn atomic_order_code_at(call: str, p: i64) -> i64 {
    if str_eq_at(call, p, "MemOrder::Relaxed") == 1 { return 0; };
    if str_eq_at(call, p, "MemOrder::Acquire") == 1 { return 1; };
    if str_eq_at(call, p, "MemOrder::Release") == 1 { return 2; };
    if str_eq_at(call, p, "MemOrder::AcqRel") == 1 { return 3; };
    if str_eq_at(call, p, "MemOrder::SeqCst") == 1 { return 4; };
    return 0 - 1;
}

fn atomic_nth_order_code(call: str, nth: i64) -> i64 {
    let mut p: i64 = 0;
    let mut seen: i64 = 0;
    while p >= 0 {
        p = atomic_find_pattern_from(call, "MemOrder::", p);
        if p < 0 { return 0 - 1; };
        seen = seen + 1;
        if seen == nth { return atomic_order_code_at(call, p); };
        p = p + 10;
    };
    return 0 - 1;
}

fn atomic_cmpxchg_orders_valid(success: i64, failure: i64) -> i64 {
    if failure == 2 || failure == 3 { return 0; };
    if success == 0 { if failure == 0 { return 1; }; return 0; };
    if success == 1 { if failure == 0 || failure == 1 { return 1; }; return 0; };
    if success == 2 { if failure == 0 { return 1; }; return 0; };
    if success == 3 { if failure == 0 || failure == 1 { return 1; }; return 0; };
    if success == 4 { if failure == 0 || failure == 1 || failure == 4 { return 1; }; return 0; };
    return 0;
}

fn atomic_scan_call_invalid_order(diags: Vec<i32>, code_text: str, callee_pat: str, bad_a: str, bad_b: str, code: str, message: str) -> i64 {
    let plen: i64 = str_len(callee_pat);
    let mut p: i64 = 0;
    let mut emitted: i64 = 0;
    while p >= 0 {
        p = atomic_find_pattern_from(code_text, callee_pat, p);
        if p < 0 { return emitted; };
        let endp: i64 = atomic_find_call_end(code_text, p + plen - 1);
        if endp > p {
            let call: str = str_substring(code_text, p, endp + 1);
            if str_contains(call, bad_a) == 1 || (str_len(bad_b) > 0 && str_contains(call, bad_b) == 1) {
                diag_add_ex(diags, "error", "atomic", code, message, "main", 0, 0, "");
                emitted = emitted + 1;
            };
            p = endp + 1;
        } else {
            p = p + plen;
        };
    };
    return emitted;
}

// v0.4.280 — closure-body atomic call detection (ATOMIC-006).
// Probe-agent finding 2026-05-01: closures whose body calls
// `atomic_*` helpers crash the compiler with `vec_get OOB`
// because the closure-lowering path doesn't inherit the
// parent fn's enum-variant etag entries — `MemOrder::SeqCst`
// dispatches to the unsupported-associated-fn-call branch
// which panics with bad state. Real fix is sym-table inheritance
// in closure lowering — multi-cycle. This temporary halt catches
// the dangerous pattern at parse-time and emits a clean diag
// instead of letting the meltdown surface. Adopters get a
// useful "closures + atomics not yet supported" message.
fn enforce_no_atomic_in_closure(source: str) -> i64 {
    let code: str = strip_strings_and_line_comments(source);
    let n: i64 = str_len(code);
    // Conservative scan: find `||` (zero-arg closure literal),
    // then look ahead up to 200 chars for an `atomic_` substring
    // before hitting `}` or `;` (closure body terminator).
    let mut p: i64 = 0;
    while p + 1 < n {
        let two: str = str_substring(code, p, p + 2);
        if str_eq(two, "||") == 1 {
            // Found zero-arg closure literal. Look ahead.
            let look_end: i64 = if p + 200 < n { p + 200 } else { n };
            let mut q: i64 = p + 2;
            while q + 7 <= look_end {
                let win: str = str_substring(code, q, q + 7);
                if str_eq(win, "atomic_") == 1 {
                    return 1;
                };
                let ch1: str = str_substring(code, q, q + 1);
                if str_eq(ch1, ";") == 1 { q = look_end; };
                q = q + 1;
            };
        };
        p = p + 1;
    };
    return 0;
}

fn enforce_atomic_ordering(diags: Vec<i32>, source: str) -> Vec<i32> {
    let code: str = strip_strings_and_line_comments(source);
    atomic_scan_call_invalid_order(diags, code, "atomic_load(", "MemOrder::Release", "MemOrder::AcqRel", "ATOMIC-005", "atomic_load only accepts Relaxed, Acquire, or SeqCst memory ordering");
    atomic_scan_call_invalid_order(diags, code, "atomic_store(", "MemOrder::Acquire", "MemOrder::AcqRel", "ATOMIC-005", "atomic_store only accepts Relaxed, Release, or SeqCst memory ordering");
    let callee_pat: str = "atomic_compare_exchange(";
    let plen: i64 = str_len(callee_pat);
    let mut p: i64 = 0;
    while p >= 0 {
        p = atomic_find_pattern_from(code, callee_pat, p);
        if p < 0 { return diags; };
        let endp: i64 = atomic_find_call_end(code, p + plen - 1);
        if endp > p {
            let call: str = str_substring(code, p, endp + 1);
            let success: i64 = atomic_nth_order_code(call, 1);
            let failure: i64 = atomic_nth_order_code(call, 2);
            if success >= 0 && failure >= 0 && atomic_cmpxchg_orders_valid(success, failure) == 0 {
                diag_add_ex(diags, "error", "atomic", "ATOMIC-004", "compare_exchange failure ordering must not be Release/AcqRel and must not be stronger than success ordering", "main", 0, 0, "");
            };
            p = endp + 1;
        } else {
            p = p + plen;
        };
    };
    return diags;
}

fn enforce_atomic_contracts(diags: Vec<i32>, source: str) -> Vec<i32> {
    let atomic_fns: Vec<i32> = collect_atomic_fns(source);
    let mut i: i64 = 0;
    while i < vec_len(atomic_fns) {
        check_atomic_contract_violations(diags, source, vec_get(atomic_fns, i));
        i = i + 1;
    };
    return enforce_atomic_ordering(diags, source);
}

// === T3.6 (v0.3.5): #[no_dyn] enforcement (RT-003) ===
// Forbids dynamic dispatch in the marked fn — `Box<dyn Trait>`,
// `&dyn Trait`, `&mut dyn Trait`, and bare `dyn Trait` types.
// Matches the v1 source-level pattern of #[no_alloc] / #[no_panic]:
// scan the resolved source for `#[no_dyn]\nfn NAME(...)` pairs,
// then walk each fn body for the literal substring `dyn ` (a
// trailing space rules out identifiers like `dyn_var`). The same
// comment-and-string skip the other RT scanners use guards against
// false positives on the `let pat: str = "#[no_dyn]"` literal in
// this very compiler.

fn collect_no_dyn_fns(source: str) -> Vec<i32> {
    let mut fns: Vec<i32> = Vec::new();
    let slen: i64 = str_len(source);
    let pat: str = "#[no_dyn]";
    let plen: i64 = str_len(pat);
    let mut p: i64 = 0;
    while p + plen <= slen {
        if p + 1 < slen && str_char_at(source, p) == 47 && str_char_at(source, p + 1) == 47 {
            while p < slen && str_char_at(source, p) != 10 { p = p + 1; };
            p = p + 1;
            continue;
        };
        if str_char_at(source, p) == 34 {
            p = p + 1;
            while p < slen && str_char_at(source, p) != 34 {
                if str_char_at(source, p) == 92 && p + 1 < slen { p = p + 2; }
                else { p = p + 1; };
            };
            p = p + 1;
            continue;
        };
        let mut m: i64 = 1;
        let mut k: i64 = 0;
        while k < plen {
            if str_char_at(source, p + k) != str_char_at(pat, k) { m = 0; break; };
            k = k + 1;
        };
        if m == 1 {
            let mut q: i64 = p + plen;
            while q + 3 <= slen {
                let c0: i64 = str_char_at(source, q);
                let c1: i64 = str_char_at(source, q + 1);
                let c2: i64 = str_char_at(source, q + 2);
                if c0 == 102 && c1 == 110 && c2 == 32 {
                    q = q + 3;
                    let name_start: i64 = q;
                    while q < slen && (is_alnum(str_char_at(source, q)) == 1 || str_char_at(source, q) == 95) {
                        q = q + 1;
                    };
                    if q > name_start {
                        let name: str = str_substring(source, name_start, q);
                        fns.push(name);
                    };
                    p = q;
                    break;
                };
                q = q + 1;
            };
            if q + 3 > slen { p = slen; };
        } else {
            p = p + 1;
        };
    };
    rt_string_vec_append(fns, collect_fns_with_effect(source, "no_dyn"));
    return fns;
}

fn check_no_dyn_violations(diags: Vec<i32>, source: str, fn_name: str) {
    let needle: str = str_concat("fn ", str_concat(fn_name, "("));
    let nlen: i64 = str_len(needle);
    let slen: i64 = str_len(source);
    let mut p: i64 = 0;
    while p + nlen <= slen {
        let mut m: i64 = 1;
        let mut k: i64 = 0;
        while k < nlen {
            if str_char_at(source, p + k) != str_char_at(needle, k) { m = 0; break; };
            k = k + 1;
        };
        if m == 1 {
            // Scan the SIGNATURE (between fn_name and `{`) AND the
            // body (between matching braces). dyn Trait can appear in
            // either parameters or local bindings.
            let mut sig_q: i64 = p + nlen;
            let sig_start: i64 = sig_q;
            while sig_q < slen && str_char_at(source, sig_q) != 123 { sig_q = sig_q + 1; };
            let sig_text: str = str_substring(source, sig_start, sig_q);
            if sig_q < slen {
                let body_start: i64 = sig_q + 1;
                let mut depth: i64 = 1;
                let mut q: i64 = body_start;
                while q < slen && depth > 0 {
                    let c: i64 = str_char_at(source, q);
                    if c == 123 { depth = depth + 1; };
                    if c == 125 { depth = depth - 1; };
                    q = q + 1;
                };
                let body_raw: str = str_substring(source, body_start, q - 1);
                let body: str = strip_strings_and_line_comments(body_raw);
                // The signature itself contains the user-facing type
                // names (`&dyn Trait` etc.) — we want to KEEP those
                // matches, so only the body gets the strip pass. (A
                // `dyn` inside a signature-level string literal is a
                // pathological edge case; not worth slowing v1 for.)
                let combined: str = str_concat(sig_text, str_concat(" ", body));
                if str_contains(combined, "dyn ") == 1 {
                    let msg: str = str_concat("dynamic dispatch (`dyn`) used but `", str_concat(fn_name, "` is marked #[no_dyn]"));
                    diag_add_ex(diags, "error", "rt", "RT-003", msg, fn_name, 0, 0, "");
                };
            };
            return;
        };
        p = p + 1;
    };
}

fn enforce_no_dyn(diags: Vec<i32>, source: str) -> Vec<i32> {
    let no_dyn_fns: Vec<i32> = collect_no_dyn_fns(source);
    let mut i: i64 = 0;
    while i < vec_len(no_dyn_fns) {
        let fn_name: str = vec_get(no_dyn_fns, i);
        check_no_dyn_violations(diags, source, fn_name);
        i = i + 1;
    };
    return diags;
}

// === T3.9 (v0.3.8): RT-005 — FFI call in RT-marked fn ===
// `extern fn` declarations are unknown to the compiler and may
// allocate, panic, take indeterminate time, or do IO. Calling
// one from inside a #[no_alloc] / #[no_panic] / #[deadline] fn
// breaks every RT contract. Until ffi annotations like
// #[ffi_no_alloc] ship (deferred to v0.4), every extern fn call
// from an RT body fires `warning[RT-005]`. Suppressible via
// `#[allow(RT-005)]`.

fn collect_extern_fn_names(source: str) -> Vec<i32> {
    let mut names: Vec<i32> = Vec::new();
    let slen: i64 = str_len(source);
    let pat: str = "extern fn ";
    let plen: i64 = str_len(pat);
    let mut p: i64 = 0;
    while p + plen <= slen {
        if p + 1 < slen && str_char_at(source, p) == 47 && str_char_at(source, p + 1) == 47 {
            while p < slen && str_char_at(source, p) != 10 { p = p + 1; };
            p = p + 1;
            continue;
        };
        if str_char_at(source, p) == 34 {
            p = p + 1;
            while p < slen && str_char_at(source, p) != 34 {
                if str_char_at(source, p) == 92 && p + 1 < slen { p = p + 2; }
                else { p = p + 1; };
            };
            p = p + 1;
            continue;
        };
        let mut m: i64 = 1;
        let mut k: i64 = 0;
        while k < plen {
            if str_char_at(source, p + k) != str_char_at(pat, k) { m = 0; break; };
            k = k + 1;
        };
        if m == 1 {
            let mut q: i64 = p + plen;
            let nm_start: i64 = q;
            while q < slen && (is_alnum(str_char_at(source, q)) == 1 || str_char_at(source, q) == 95) { q = q + 1; };
            if q > nm_start {
                let nm: str = str_substring(source, nm_start, q);
                let mut already: i64 = 0;
                let mut j: i64 = 0;
                while j < vec_len(names) && already == 0 {
                    if str_eq(vec_get(names, j), nm) == 1 { already = 1; };
                    j = j + 1;
                };
                if already == 0 { names.push(nm); };
            };
            p = q;
        } else {
            p = p + 1;
        };
    };
    return names;
}

fn check_no_ffi_violations(diags: Vec<i32>, source: str, fn_name: str, externs: Vec<i32>, attr_label: str) {
    if vec_len(externs) == 0 { return; };
    let needle: str = str_concat("fn ", str_concat(fn_name, "("));
    let nlen: i64 = str_len(needle);
    let slen: i64 = str_len(source);
    let mut p: i64 = 0;
    while p + nlen <= slen {
        let mut m: i64 = 1;
        let mut k: i64 = 0;
        while k < nlen {
            if str_char_at(source, p + k) != str_char_at(needle, k) { m = 0; break; };
            k = k + 1;
        };
        if m == 1 {
            let mut q: i64 = p + nlen;
            while q < slen && str_char_at(source, q) != 123 { q = q + 1; };
            if q < slen {
                let body_start: i64 = q + 1;
                let mut depth: i64 = 1;
                q = q + 1;
                while q < slen && depth > 0 {
                    let c: i64 = str_char_at(source, q);
                    if c == 123 { depth = depth + 1; };
                    if c == 125 { depth = depth - 1; };
                    q = q + 1;
                };
                let body_raw: str = str_substring(source, body_start, q - 1);
                let body: str = strip_strings_and_line_comments(body_raw);
                let mut ei: i64 = 0;
                let en: i64 = vec_len(externs);
                while ei < en {
                    let ext_name: str = vec_get(externs, ei);
                    let pat: str = str_concat(ext_name, "(");
                    if str_contains(body, pat) == 1 {
                        let msg: str = str_concat("FFI call '", str_concat(ext_name, str_concat("' from ", str_concat(attr_label, str_concat(" fn '", str_concat(fn_name, "' -- extern fns may allocate, panic, or block (mark the extern with #[ffi_no_alloc] / #[ffi_no_panic] for per-symbol opt-out, or #[allow(RT-005)] for file-wide)"))))));
                        diag_add_ex(diags, "warning", "rt", "RT-005", msg, fn_name, 0, 0, "");
                    };
                    ei = ei + 1;
                };
            };
            return;
        };
        p = p + 1;
    };
}

// v0.3.24 (T3.15): per-symbol FFI safety markers. An `extern fn`
// declaration prefixed with `#[ffi_no_alloc]` tells the RT-005
// check that this particular FFI symbol is known not to allocate;
// `#[ffi_no_panic]` does the same for panic-prone behaviour.
// The two markers can stack on the same extern declaration. RT
// fns calling an annotated-safe extern stay clean; RT fns calling
// an UNannotated extern still fire RT-005 (the conservative
// default — we don't know what the C side does).
fn collect_externs_with_marker(source: str, marker_pat: str) -> Vec<i32> {
    let mut names: Vec<i32> = Vec::new();
    let slen: i64 = str_len(source);
    let plen: i64 = str_len(marker_pat);
    let mut p: i64 = 0;
    while p + plen <= slen {
        if p + 1 < slen && str_char_at(source, p) == 47 && str_char_at(source, p + 1) == 47 {
            while p < slen && str_char_at(source, p) != 10 { p = p + 1; };
            p = p + 1;
            continue;
        };
        if str_char_at(source, p) == 34 {
            p = p + 1;
            while p < slen && str_char_at(source, p) != 34 {
                if str_char_at(source, p) == 92 && p + 1 < slen { p = p + 2; }
                else { p = p + 1; };
            };
            p = p + 1;
            continue;
        };
        let mut m: i64 = 1;
        let mut k: i64 = 0;
        while k < plen {
            if str_char_at(source, p + k) != str_char_at(marker_pat, k) { m = 0; break; };
            k = k + 1;
        };
        if m == 1 {
            // Walk forward past blanks/`///`/other-attribute lines for `extern fn NAME(`.
            let mut q: i64 = p + plen;
            while q < slen && str_char_at(source, q) != 10 { q = q + 1; };
            if q < slen { q = q + 1; };
            let mut found: i64 = 0;
            while q + 10 <= slen && found == 0 {
                while q < slen && (str_char_at(source, q) == 32 || str_char_at(source, q) == 9 || str_char_at(source, q) == 10 || str_char_at(source, q) == 13) {
                    q = q + 1;
                };
                if q + 10 > slen { found = 0 - 1; }
                else if str_char_at(source, q) == 47 && q + 1 < slen && str_char_at(source, q + 1) == 47 {
                    while q < slen && str_char_at(source, q) != 10 { q = q + 1; };
                } else if str_char_at(source, q) == 35 {
                    while q < slen && str_char_at(source, q) != 10 { q = q + 1; };
                } else if str_eq_at(source, q, "extern fn ") == 1 {
                    q = q + 10;
                    let nm_start: i64 = q;
                    while q < slen && (is_alnum(str_char_at(source, q)) == 1 || str_char_at(source, q) == 95) { q = q + 1; };
                    if q > nm_start {
                        let nm: str = str_substring(source, nm_start, q);
                        names.push(nm);
                        found = 1;
                    } else {
                        found = 0 - 1;
                    };
                } else {
                    found = 0 - 1;
                };
            };
            p = q;
        } else {
            p = p + 1;
        };
    };
    return names;
}

// Set difference: returns elements of `all` that are NOT in
// `removed`. Used to filter FFI symbols safe for a given RT
// contract out of the "RT-005 fires" list.
fn filter_externs_keep_unsafe(all: Vec<i32>, safe: Vec<i32>) -> Vec<i32> {
    let mut out: Vec<i32> = Vec::new();
    let an: i64 = vec_len(all);
    let sn: i64 = vec_len(safe);
    let mut i: i64 = 0;
    while i < an {
        let nm: str = vec_get(all, i);
        let mut is_safe: i64 = 0;
        let mut j: i64 = 0;
        while j < sn && is_safe == 0 {
            if str_eq(vec_get(safe, j), nm) == 1 { is_safe = 1; };
            j = j + 1;
        };
        if is_safe == 0 { out.push(nm); };
        i = i + 1;
    };
    return out;
}

fn enforce_rt005_ffi(diags: Vec<i32>, source: str) -> Vec<i32> {
    let externs: Vec<i32> = collect_extern_fn_names(source);
    if vec_len(externs) == 0 { return diags; };
    // v0.3.24: per-RT-attr safe extern lists. #[no_alloc] body
    // calls are clean iff the extern carries #[ffi_no_alloc];
    // #[no_panic] body iff #[ffi_no_panic]; #[deadline] needs
    // BOTH (deadline determinism subsumes both no-* contracts).
    let mut ffi_no_alloc_safe: Vec<i32> = collect_externs_with_marker(source, "#[ffi_no_alloc]");
    let mut ffi_no_panic_safe: Vec<i32> = collect_externs_with_marker(source, "#[ffi_no_panic]");
    rt_string_vec_append(ffi_no_alloc_safe, collect_externs_with_effect(source, "no_alloc"));
    rt_string_vec_append(ffi_no_panic_safe, collect_externs_with_effect(source, "no_panic"));
    let no_alloc_unsafe_externs: Vec<i32> = filter_externs_keep_unsafe(externs, ffi_no_alloc_safe);
    let no_panic_unsafe_externs: Vec<i32> = filter_externs_keep_unsafe(externs, ffi_no_panic_safe);
    // Deadline-safe = intersection; build it as: drop from `externs`
    // any name that is in BOTH safe lists.
    let mut dl_safe: Vec<i32> = Vec::new();
    let an2: i64 = vec_len(ffi_no_alloc_safe);
    let pn2: i64 = vec_len(ffi_no_panic_safe);
    let mut ii: i64 = 0;
    while ii < an2 {
        let nm2: str = vec_get(ffi_no_alloc_safe, ii);
        let mut in_panic: i64 = 0;
        let mut jj: i64 = 0;
        while jj < pn2 && in_panic == 0 {
            if str_eq(vec_get(ffi_no_panic_safe, jj), nm2) == 1 { in_panic = 1; };
            jj = jj + 1;
        };
        if in_panic == 1 { dl_safe.push(nm2); };
        ii = ii + 1;
    };
    let dl_unsafe_externs: Vec<i32> = filter_externs_keep_unsafe(externs, dl_safe);
    let no_alloc_fns: Vec<i32> = collect_no_alloc_fns(source);
    let mut i: i64 = 0;
    while i < vec_len(no_alloc_fns) {
        check_no_ffi_violations(diags, source, vec_get(no_alloc_fns, i), no_alloc_unsafe_externs, "#[no_alloc]");
        i = i + 1;
    };
    let no_panic_fns: Vec<i32> = collect_no_panic_fns(source);
    i = 0;
    while i < vec_len(no_panic_fns) {
        check_no_ffi_violations(diags, source, vec_get(no_panic_fns, i), no_panic_unsafe_externs, "#[no_panic]");
        i = i + 1;
    };
    // Deadline fns live as the wcet inner pair after T3.1 expansion.
    let dl_entries: Vec<i32> = wcet_collect_deadline_fns(source);
    let n: i64 = vec_len(dl_entries);
    let mut k: i64 = 0;
    while k + 1 < n {
        check_no_ffi_violations(diags, source, vec_get(dl_entries, k), dl_unsafe_externs, "#[deadline]");
        k = k + 2;
    };
    return diags;
}

// === T3.10 (v0.3.9): RT-008 — direct recursion in #[deadline] fn ===
// Recursion blows the deadline budget unless the call depth is
// bounded. We detect *direct* self-recursion: the inner fn's
// body contains a literal call to the original (wrapper) name.
// `#[max_depth = N]` opts out — bounded recursion is fine if
// the user has declared a static bound that fits in the budget.
//
// Indirect recursion (A→B→A) requires a call graph and is left
// for the v2 AST-based check.

fn dl_get_wrapper_name(source: str, inner_name: str) -> str {
    // The T3.1 expander emits the inner fn first, then a blank,
    // then the wrapper fn whose body calls deadline_check. Walk
    // forward from the inner's brace-balanced body close, skip
    // whitespace, and read the next `fn NAME(` identifier.
    let needle: str = str_concat("fn ", str_concat(inner_name, "("));
    let nlen: i64 = str_len(needle);
    let slen: i64 = str_len(source);
    let mut p: i64 = 0;
    let mut found_at: i64 = 0 - 1;
    while p + nlen <= slen && found_at < 0 {
        let mut m: i64 = 1;
        let mut k: i64 = 0;
        while k < nlen && m == 1 {
            if str_char_at(source, p + k) != str_char_at(needle, k) { m = 0; };
            k = k + 1;
        };
        if m == 1 { found_at = p; }
        else { p = p + 1; };
    };
    if found_at < 0 { return ""; };
    let mut q: i64 = found_at + nlen;
    while q < slen && str_char_at(source, q) != 123 { q = q + 1; };
    if q >= slen { return ""; };
    q = q + 1;
    let mut depth: i64 = 1;
    while q < slen && depth > 0 {
        let c: i64 = str_char_at(source, q);
        if c == 123 { depth = depth + 1; };
        if c == 125 { depth = depth - 1; };
        q = q + 1;
    };
    while q < slen && (str_char_at(source, q) == 32 || str_char_at(source, q) == 9 || str_char_at(source, q) == 10 || str_char_at(source, q) == 13) {
        q = q + 1;
    };
    if q + 3 > slen { return ""; };
    if str_char_at(source, q) != 102 || str_char_at(source, q + 1) != 110 || str_char_at(source, q + 2) != 32 {
        return "";
    };
    q = q + 3;
    let nm_start: i64 = q;
    while q < slen && (is_alnum(str_char_at(source, q)) == 1 || str_char_at(source, q) == 95) { q = q + 1; };
    if q == nm_start { return ""; };
    return str_substring(source, nm_start, q);
}

fn md_extract_int_value(line: str) -> i64 {
    let compact: str = strip_spaces(line);
    let needle: str = "#[max_depth";
    let pos: i64 = source_find(compact, needle);
    if pos < 0 { return 0 - 1; };
    let clen: i64 = str_len(compact);
    let mut p: i64 = pos + str_len(needle);
    if p >= clen { return 0 - 1; };
    if str_char_at(compact, p) == 61 {
        p = p + 1;
        let ns: i64 = p;
        while p < clen && is_digit(str_char_at(compact, p)) == 1 { p = p + 1; };
        if p == ns { return 0 - 1; };
        let v: i64 = str_to_int(str_substring(compact, ns, p));
        if v <= 0 { return 0 - 1; };
        return v;
    };
    if str_char_at(compact, p) == 40 {
        p = p + 1;
        let ns2: i64 = p;
        while p < clen && is_digit(str_char_at(compact, p)) == 1 { p = p + 1; };
        if p == ns2 { return 0 - 1; };
        let v2: i64 = str_to_int(str_substring(compact, ns2, p));
        if v2 <= 0 { return 0 - 1; };
        return v2;
    };
    return 0 - 1;
}

fn md_first_param_name(params_text: str) -> str {
    // v0.5.7 fix for impl-method false-DEPTH-001: when the recursion-bounding
    // analyzer scans `fn count(self, depth: i64)`, the first identifier is
    // `self` — a self-receiver, not a depth parameter. Treat the receiver
    // (`self`, or a leading reference form `&self`) as a skip token and
    // return the FIRST non-receiver identifier so the guard / increment
    // patterns are checked against the real depth parameter.
    let plen: i64 = str_len(params_text);
    let mut p: i64 = 0;
    let mut tries: i64 = 0;
    // Loop through up to two leading idents; the first may be `self` (or
    // `&self`), in which case we step over the comma and pull the next.
    while tries < 2 {
        // Skip whitespace.
        while p < plen && (str_char_at(params_text, p) == 32 || str_char_at(params_text, p) == 9 || str_char_at(params_text, p) == 10 || str_char_at(params_text, p) == 13) { p = p + 1; };
        // Skip a leading `&` (and optional whitespace + `mut`) so `&self` /
        // `&mut self` resolve to ident `self`.
        if p < plen && str_char_at(params_text, p) == 38 {
            p = p + 1;
            while p < plen && (str_char_at(params_text, p) == 32 || str_char_at(params_text, p) == 9) { p = p + 1; };
            if p + 3 <= plen && str_eq_at(params_text, p, "mut") == 1
               && (p + 3 == plen || str_char_at(params_text, p + 3) == 32 || str_char_at(params_text, p + 3) == 9) {
                p = p + 3;
                while p < plen && (str_char_at(params_text, p) == 32 || str_char_at(params_text, p) == 9) { p = p + 1; };
            };
        };
        let ns: i64 = p;
        while p < plen && (is_alnum(str_char_at(params_text, p)) == 1 || str_char_at(params_text, p) == 95) { p = p + 1; };
        if p == ns { return ""; };
        let ident: str = str_substring(params_text, ns, p);
        if str_eq(ident, "self") == 0 {
            return ident;
        };
        // Receiver: skip the rest of this param up to the next comma at
        // top-level (depth-0). Type annotation `self: T` may include
        // arbitrary characters; conservatively scan for the next `,` at
        // bracket-depth zero.
        let mut depth: i64 = 0;
        while p < plen {
            let c: i64 = str_char_at(params_text, p);
            if depth == 0 && c == 44 { p = p + 1; break; };
            if c == 60 || c == 40 || c == 91 || c == 123 { depth = depth + 1; };
            if c == 62 || c == 41 || c == 93 || c == 125 { if depth > 0 { depth = depth - 1; }; };
            p = p + 1;
        };
        tries = tries + 1;
    };
    return "";
}

fn md_parse_digits_at(s: str, p0: i64) -> i64 {
    let slen: i64 = str_len(s);
    let mut p: i64 = p0;
    let ns: i64 = p;
    while p < slen && is_digit(str_char_at(s, p)) == 1 { p = p + 1; };
    if p == ns { return 0 - 1; };
    return str_to_int(str_substring(s, ns, p));
}

fn md_guard_limit(body: str, param_name: str) -> i64 {
    let compact: str = strip_spaces(body);
    let ge_pat: str = str_concat(param_name, ">=");
    let ge_pos: i64 = source_find(compact, ge_pat);
    if ge_pos >= 0 {
        let v: i64 = md_parse_digits_at(compact, ge_pos + str_len(ge_pat));
        if v >= 0 { return v; };
    };
    let gt_pat: str = str_concat(param_name, ">");
    let gt_pos: i64 = source_find(compact, gt_pat);
    if gt_pos >= 0 {
        let v2: i64 = md_parse_digits_at(compact, gt_pos + str_len(gt_pat));
        if v2 >= 0 { return v2 + 1; };
    };
    return 0 - 1;
}

fn md_body_contains_call(body_raw: str, callee: str) -> i64 {
    if str_len(callee) == 0 { return 0; };
    let body: str = strip_strings_and_line_comments(body_raw);
    let pat: str = str_concat(callee, "(");
    return str_contains(body, pat);
}

fn md_proven_limit(body_raw: str, params_text: str, callee: str) -> i64 {
    let param: str = md_first_param_name(params_text);
    if str_len(param) == 0 { return 0 - 1; };
    let body: str = strip_strings_and_line_comments(body_raw);
    let compact: str = strip_spaces(body);
    let guard: i64 = md_guard_limit(compact, param);
    let inc_a: str = str_concat(param, "+1");
    let inc_b: str = str_concat("1+", param);
    let call_pat: str = str_concat(callee, "(");
    if guard >= 0
       && str_contains(compact, call_pat) == 1
       && (str_contains(compact, inc_a) == 1 || str_contains(compact, inc_b) == 1) {
        return guard;
    };
    let dec_a: str = str_concat(param, "-1");
    let le_zero: str = str_concat(param, "<=0");
    let lt_one: str = str_concat(param, "<1");
    if str_contains(compact, call_pat) == 1
       && str_contains(compact, dec_a) == 1
       && (str_contains(compact, le_zero) == 1 || str_contains(compact, lt_one) == 1) {
        return 1;
    };
    return 0 - 1;
}

fn md_estimate_frame_bytes(body_raw: str) -> i64 {
    let body: str = strip_strings_and_line_comments(body_raw);
    let blen: i64 = str_len(body);
    let mut p: i64 = 0;
    let mut stmts: i64 = 0;
    while p < blen {
        if str_char_at(body, p) == 59 { stmts = stmts + 1; };
        p = p + 1;
    };
    if stmts < 1 { stmts = 1; };
    return stmts * 64;
}

fn source_has_max_depth_attr_line(source: str) -> i64 {
    let slen: i64 = str_len(source);
    let mut p: i64 = 0;
    while p < slen {
        let mut q: i64 = p;
        while q < slen && (str_char_at(source, q) == 32 || str_char_at(source, q) == 9) { q = q + 1; };
        if str_eq_at(source, q, "#[max_depth") == 1 { return 1; };
        while p < slen && str_char_at(source, p) != 10 { p = p + 1; };
        p = p + 1;
    };
    return 0;
}

fn collect_max_depth_entries(diags: Vec<i32>, source: str) -> Vec<i32> {
    // Alternating records:
    // [fn_name, public_call_name, bound, body_raw, params_text, ...].
    // `fn_name` is the function carrying the attribute after the
    // deadline rewrite; `public_call_name` is the recursive callee that
    // appears in the user's body.
    let mut entries: Vec<i32> = Vec::new();
    let slen: i64 = str_len(source);
    let mut p: i64 = 0;
    while p < slen {
        let mut eol: i64 = p;
        while eol < slen && str_char_at(source, eol) != 10 { eol = eol + 1; };
        let line: str = str_substring(source, p, eol);
        let compact_line: str = strip_spaces(line);
        if str_starts_with(compact_line, "#[max_depth") == 1 {
            let bound: i64 = md_extract_int_value(line);
            let mut probe: i64 = eol + 1;
            let mut found_fn: i64 = 0 - 1;
            let mut gave_up: i64 = 0;
            while probe < slen && found_fn < 0 && gave_up == 0 {
                let mut peol: i64 = probe;
                while peol < slen && str_char_at(source, peol) != 10 { peol = peol + 1; };
                let pline: str = str_substring(source, probe, peol);
                let mut lp: i64 = 0;
                let llen: i64 = str_len(pline);
                while lp < llen && (str_char_at(pline, lp) == 32 || str_char_at(pline, lp) == 9) { lp = lp + 1; };
                let ptrim: str = strip_spaces(pline);
                if str_len(ptrim) == 0 {
                    probe = peol + 1;
                } else if str_starts_with(ptrim, "///") == 1 {
                    probe = peol + 1;
                } else if str_eq_at(pline, lp, "fn ") == 1 {
                    found_fn = probe + lp;
                } else if str_eq_at(pline, lp, "pub fn ") == 1 {
                    found_fn = probe + lp + 4;
                } else if lp < llen && str_char_at(pline, lp) == 35 {
                    probe = peol + 1;
                } else {
                    gave_up = 1;
                };
            };
            if bound <= 0 || found_fn < 0 {
                let msg4: str = "`#[max_depth = N]` must use a positive integer literal and apply directly to a fn declaration";
                let mut lc4: Vec<i32> = find_linecol_in_source(source, "max_depth", "max_depth");
                diag_add_ex(diags, "error", "rt", "DEPTH-004", msg4, "max_depth", vec_get(lc4, 0), vec_get(lc4, 1), "");
            } else {
                let info: Vec<i32> = dl_parse_fn_signature(source, found_fn, slen);
                if vec_len(info) == 0 {
                    let msg4b: str = "`#[max_depth = N]` could not parse the following fn declaration";
                    let mut lc4b: Vec<i32> = find_linecol_in_source(source, "max_depth", "max_depth");
                    diag_add_ex(diags, "error", "rt", "DEPTH-004", msg4b, "max_depth", vec_get(lc4b, 0), vec_get(lc4b, 1), "");
                } else {
                    let fn_name: str = vec_get(info, 0);
                    let params_text: str = vec_get(info, 1);
                    let body_open: i64 = vec_get(info, 4);
                    let body_end: i64 = vec_get(info, 5);
                    let mut public_name: str = fn_name;
                    if str_starts_with(fn_name, "__nuc_dl_inner_") == 1 {
                        let wname: str = dl_get_wrapper_name(source, fn_name);
                        if str_len(wname) > 0 { public_name = wname; };
                    };
                    let body_raw: str = str_substring(source, body_open + 1, body_end - 1);
                    entries.push(fn_name);
                    entries.push(public_name);
                    entries.push(bound);
                    entries.push(body_raw);
                    entries.push(params_text);
                };
            };
        };
        p = eol + 1;
    };
    return entries;
}

fn enforce_max_depth_static(diags: Vec<i32>, source: str) -> Vec<i32> {
    if source_has_max_depth_attr_line(source) == 0 { return diags; };
    let entries: Vec<i32> = collect_max_depth_entries(diags, source);
    let n: i64 = vec_len(entries);
    let stack_budget: i64 = 8192;
    let mut i: i64 = 0;
    while i + 4 < n {
        let fn_name: str = vec_get(entries, i);
        let public_name: str = vec_get(entries, i + 1);
        let bound: i64 = vec_get(entries, i + 2);
        let body_raw: str = vec_get(entries, i + 3);
        let params_text: str = vec_get(entries, i + 4);
        if md_body_contains_call(body_raw, public_name) == 1 {
            let proven: i64 = md_proven_limit(body_raw, params_text, public_name);
            if proven < 0 {
                let msg1: str = str_concat("analysis cannot bound recursive path in `", str_concat(public_name, "`; use an explicit depth parameter, an entry guard, and recursive calls with depth + 1"));
                let mut lc1: Vec<i32> = find_linecol_in_source(source, public_name, public_name);
                diag_add_ex(diags, "error", "rt", "DEPTH-001", msg1, public_name, vec_get(lc1, 0), vec_get(lc1, 1), "");
            } else if proven > bound {
                let msg2: str = str_concat("static recursion depth ", str_concat(str_from_int(proven), str_concat(" exceeds #[max_depth = ", str_concat(str_from_int(bound), "]"))));
                let mut lc2: Vec<i32> = find_linecol_in_source(source, public_name, public_name);
                diag_add_ex(diags, "error", "rt", "DEPTH-002", msg2, public_name, vec_get(lc2, 0), vec_get(lc2, 1), "");
            };
        };
        let frame_bytes: i64 = md_estimate_frame_bytes(body_raw);
        if frame_bytes * bound > stack_budget {
            let msg5: str = str_concat("estimated stack use ", str_concat(str_from_int(frame_bytes * bound), str_concat(" bytes exceeds #[max_depth] stack budget ", str_from_int(stack_budget))));
            let mut lc5: Vec<i32> = find_linecol_in_source(source, fn_name, fn_name);
            diag_add_ex(diags, "error", "rt", "DEPTH-005", msg5, fn_name, vec_get(lc5, 0), vec_get(lc5, 1), "");
        };
        i = i + 5;
    };
    i = 0;
    while i + 4 < n {
        let a_name: str = vec_get(entries, i + 1);
        let a_bound: i64 = vec_get(entries, i + 2);
        let a_body: str = vec_get(entries, i + 3);
        let a_params: str = vec_get(entries, i + 4);
        let mut j: i64 = i + 5;
        while j + 4 < n {
            let b_name: str = vec_get(entries, j + 1);
            let b_bound: i64 = vec_get(entries, j + 2);
            let b_body: str = vec_get(entries, j + 3);
            let b_params: str = vec_get(entries, j + 4);
            if md_body_contains_call(a_body, b_name) == 1 && md_body_contains_call(b_body, a_name) == 1 {
                let a_proven: i64 = md_proven_limit(a_body, a_params, b_name);
                let b_proven: i64 = md_proven_limit(b_body, b_params, a_name);
                if a_bound != b_bound || a_proven < 0 || b_proven < 0 || a_proven > a_bound || b_proven > b_bound {
                    let msg3: str = str_concat("mutually recursive cycle `", str_concat(a_name, str_concat(" <-> ", str_concat(b_name, "` has incompatible or unproven #[max_depth] bounds"))));
                    let mut lc3: Vec<i32> = find_linecol_in_source(source, a_name, a_name);
                    diag_add_ex(diags, "error", "rt", "DEPTH-003", msg3, a_name, vec_get(lc3, 0), vec_get(lc3, 1), "");
                };
            };
            j = j + 5;
        };
        i = i + 5;
    };
    return diags;
}

fn enforce_rt008_recursion(diags: Vec<i32>, source: str) -> Vec<i32> {
    let dl_entries: Vec<i32> = wcet_collect_deadline_fns(source);
    let n: i64 = vec_len(dl_entries);
    if n == 0 { return diags; };
    let max_depth_entries: Vec<i32> = collect_max_depth_entries(diags, source);
    let mut k: i64 = 0;
    while k + 1 < n {
        let inner_name: str = vec_get(dl_entries, k);
        let wrapper_name: str = dl_get_wrapper_name(source, inner_name);
        if str_len(wrapper_name) > 0 {
            // Is the inner (the one carrying the user's #[max_depth]
            // attribute after T3.1 preserves it) opted out?
            let mut bounded: i64 = 0;
            let mut j: i64 = 0;
            let mn: i64 = vec_len(max_depth_entries);
            while j + 4 < mn && bounded == 0 {
                if str_eq(vec_get(max_depth_entries, j), inner_name) == 1 { bounded = 1; };
                j = j + 5;
            };
            if bounded == 0 {
                // Scan the inner body (stripped) for `<wrapper>(`.
                let needle: str = str_concat("fn ", str_concat(inner_name, "("));
                let nlen: i64 = str_len(needle);
                let slen: i64 = str_len(source);
                let mut p: i64 = 0;
                while p + nlen <= slen {
                    let mut m: i64 = 1;
                    let mut q: i64 = 0;
                    while q < nlen && m == 1 {
                        if str_char_at(source, p + q) != str_char_at(needle, q) { m = 0; };
                        q = q + 1;
                    };
                    if m == 1 { break; };
                    p = p + 1;
                };
                if p + nlen <= slen {
                    let mut bp: i64 = p + nlen;
                    while bp < slen && str_char_at(source, bp) != 123 { bp = bp + 1; };
                    if bp < slen {
                        let body_start: i64 = bp + 1;
                        let mut depth: i64 = 1;
                        bp = bp + 1;
                        while bp < slen && depth > 0 {
                            let c: i64 = str_char_at(source, bp);
                            if c == 123 { depth = depth + 1; };
                            if c == 125 { depth = depth - 1; };
                            bp = bp + 1;
                        };
                        let body_raw: str = str_substring(source, body_start, bp - 1);
                        let body: str = strip_strings_and_line_comments(body_raw);
                        let call_pat: str = str_concat(wrapper_name, "(");
                        if str_contains(body, call_pat) == 1 {
                            let msg: str = str_concat("'", str_concat(wrapper_name, "' has #[deadline] and recursively calls itself; add #[max_depth = N] to opt out (recursion can blow the deadline budget)"));
                            diag_add_ex(diags, "warning", "rt", "RT-008", msg, wrapper_name, 0, 0, "");
                        };
                    };
                };
            };
        };
        k = k + 2;
    };
    return diags;
}

// === T3.8 (v0.3.7): RT-006 — RT attribute on async fn ===
// expand_async_strip_keyword (in the resolver-level expanders)
// drops the `async` keyword for good. To still detect "an RT
// attribute was attached to an `async fn`", that pass leaves
// behind a marker comment line at column 0 for every offender.
// The marker prefix is intentionally short and weird so the
// exact byte sequence (with leading newline) does not appear
// elsewhere in the s1 compiler source — without that, the
// scanner would self-match on its own needle.
//
// Per the RFC: async is non-deterministic by design (thread
// scheduling, IO wakeups, etc.) and cannot satisfy any RT
// guarantee. The two have to be mutually exclusive.

fn enforce_rt006_async(diags: Vec<i32>, source: str) -> Vec<i32> {
    // Match \n + "//__NUC6T:" — leading newline ensures we only
    // hit markers that the expander emitted at column 0, not
    // string-literal contents (preceded by ") or mid-line prose.
    let needle: str = "\n//__NUC6T:";
    let nlen: i64 = str_len(needle);
    let slen: i64 = str_len(source);
    let mut p: i64 = 0;
    while p + nlen <= slen {
        let mut m: i64 = 1;
        let mut k: i64 = 0;
        while k < nlen {
            if str_char_at(source, p + k) != str_char_at(needle, k) { m = 0; break; };
            k = k + 1;
        };
        if m == 1 {
            let nm_start: i64 = p + nlen;
            let mut q: i64 = nm_start;
            while q < slen && str_char_at(source, q) != 10 && str_char_at(source, q) != 13 { q = q + 1; };
            let fn_name: str = str_substring(source, nm_start, q);
            let msg: str = str_concat("RT attribute (e.g. #[no_alloc] / #[no_panic] / #[no_dyn] / #[deadline]) on async fn '", str_concat(fn_name, "' -- async is non-deterministic by design and cannot satisfy real-time guarantees"));
            diag_add_ex(diags, "error", "rt", "RT-006", msg, fn_name, 0, 0, "");
            p = q;
        } else {
            p = p + 1;
        };
    };
    return diags;
}

// v0.5.19: probe-agent finding 2026-05-01-async-keyword-silently-stripped.
// Sister scanner to enforce_rt006_async — picks up the
// `//__NUC6X:<fn_name>` markers that expand_async_strip_keyword emits
// for plain `async fn` (no RT attribute). Pre-fix the keyword was
// silently dropped — adopters writing the canonical Rust async pattern
// got immediate sync execution with no signal. The fn still runs (no
// halt), but the warning points adopters at the actual threading
// primitives (`async_spawn(fn_ptr, arg)` + `async_await(handle)`,
// RFC-0027 phase 1).
fn enforce_async001_warning(diags: Vec<i32>, source: str) -> Vec<i32> {
    let needle: str = "\n//__NUC6X:";
    let nlen: i64 = str_len(needle);
    let slen: i64 = str_len(source);
    let mut p: i64 = 0;
    while p + nlen <= slen {
        let mut m: i64 = 1;
        let mut k: i64 = 0;
        while k < nlen {
            if str_char_at(source, p + k) != str_char_at(needle, k) { m = 0; break; };
            k = k + 1;
        };
        if m == 1 {
            let nm_start: i64 = p + nlen;
            let mut q: i64 = nm_start;
            while q < slen && str_char_at(source, q) != 10 && str_char_at(source, q) != 13 { q = q + 1; };
            let fn_name: str = str_substring(source, nm_start, q);
            let msg: str = str_concat("`async` keyword on fn `", str_concat(fn_name, "` is silently stripped — Nucleor v0.5 has no Future / no .await polling. Adopters writing the canonical Rust pattern get immediate sync execution. Use `async_spawn(fn_ptr, arg)` to run on a real OS thread (returns a handle) + `async_await(handle)` to join (RFC-0027 phase 1, see stdlib/rods/async.nr). Or drop the `async` keyword if sync execution was intended."));
            diag_add_ex(diags, "warning", "async", "ASYNC-001", msg, fn_name, 0, 0, "");
            p = q;
        } else {
            p = p + 1;
        };
    };
    return diags;
}

// === T3.3 (v0.3.2): static WCET (v1 estimator, RT-004) ===
// Parses every `#[deadline = N]` fn, estimates its worst-case
// execution time via a simple statement counter, and emits a
// compile-time RT-004 warning when the estimate exceeds the
// declared deadline.
//
// v1 estimator heuristics (conservative, prone to false positives
// — explicitly documented so users can `#[allow(RT-004)]` when
// the estimator is wrong):
//   - Each `;` (statement terminator) = 1 unit = 0.1 µs
//   - Each `while` keyword multiplies the inner unit count by a
//     coarse multiplier (1, 100, 1000, 10000 for 0/1/2/3+ whiles)
//   - Hard cap at 1e6 units to prevent runaway
// Conversion: estimated_us = ceil(units / 10).
//
// Ship shape: warning-level diagnostic (not error) because the
// estimator is deliberately crude. v0.3.2b's AST-based v2 will
// tighten the estimate + promote to error for unambiguous cases.

fn wcet_collect_deadline_fns(source: str) -> Vec<i32> {
    // Returns alternating [inner_name1, limit1_us, ...].
    // Scans for `deadline_check(__nuc_dl_start, N)` which the
    // T3.1 expander emits in every wrapper, then walks back up to
    // 1024 bytes for the matching `__nuc_dl_inner_<...>` ident.
    let mut out: Vec<i32> = Vec::new();
    let slen: i64 = str_len(source);
    let needle: str = "deadline_check(__nuc_dl_start,";
    let nlen: i64 = str_len(needle);
    let inner_pat: str = "__nuc_dl_inner_";
    let ipl: i64 = str_len(inner_pat);
    let mut p: i64 = 0;
    let max_outer_iters: i64 = 1000000;  // safety bound
    let mut outer_iters: i64 = 0;
    while p + nlen <= slen && outer_iters < max_outer_iters {
        outer_iters = outer_iters + 1;
        let mut m: i64 = 1;
        let mut k: i64 = 0;
        while k < nlen && m == 1 {
            if str_char_at(source, p + k) != str_char_at(needle, k) { m = 0; };
            k = k + 1;
        };
        if m == 1 {
            let mut q: i64 = p + nlen;
            while q < slen && (str_char_at(source, q) == 32 || str_char_at(source, q) == 9) { q = q + 1; };
            let num_start: i64 = q;
            while q < slen && is_digit(str_char_at(source, q)) == 1 { q = q + 1; };
            if q > num_start {
                let limit_us: i64 = str_to_int(str_substring(source, num_start, q));
                let scan_floor: i64 = if p > 1024 { p - 1024 } else { 0 };
                let mut bp: i64 = p;
                let mut found: i64 = 0;
                while bp > scan_floor && found == 0 {
                    if bp + ipl <= slen {
                        let mut im: i64 = 1;
                        let mut ik: i64 = 0;
                        while ik < ipl && im == 1 {
                            if str_char_at(source, bp + ik) != str_char_at(inner_pat, ik) { im = 0; };
                            ik = ik + 1;
                        };
                        if im == 1 {
                            let mut np: i64 = bp + ipl;
                            while np < slen && (is_alnum(str_char_at(source, np)) == 1 || str_char_at(source, np) == 95) {
                                np = np + 1;
                            };
                            let inner_name: str = str_substring(source, bp, np);
                            out.push(inner_name);
                            out.push(limit_us);
                            found = 1;
                        };
                    };
                    if found == 0 { bp = bp - 1; };
                };
            };
            p = q + 1;
        } else {
            p = p + 1;
        };
    };
    return out;
}

fn wcet_estimate_fn_units(source: str, fn_name: str) -> i64 {
    // Counts `;` (statements) inside the named fn body, separately
    // counts `while` keywords, applies a coarse multiplier ladder
    // (1, 100, 1000, 10000 for 0/1/2/3+ loops). Hard-capped at 1e6
    // units. No string/comment skipping — false positives on `;`
    // inside string literals are an acceptable v1 tradeoff.
    let needle: str = str_concat("fn ", str_concat(fn_name, "("));
    let nlen: i64 = str_len(needle);
    let slen: i64 = str_len(source);
    let mut p: i64 = 0;
    let mut found_at: i64 = 0 - 1;
    while p + nlen <= slen && found_at < 0 {
        let mut m: i64 = 1;
        let mut k: i64 = 0;
        while k < nlen && m == 1 {
            if str_char_at(source, p + k) != str_char_at(needle, k) { m = 0; };
            k = k + 1;
        };
        if m == 1 { found_at = p; }
        else { p = p + 1; };
    };
    if found_at < 0 { return 0; };
    let mut q: i64 = found_at + nlen;
    while q < slen && str_char_at(source, q) != 123 { q = q + 1; };
    if q >= slen { return 0; };
    q = q + 1;
    let mut depth: i64 = 1;
    let mut stmt_count: i64 = 0;
    let mut while_count: i64 = 0;
    let stmt_cap: i64 = 1000000;
    while q < slen && depth > 0 && stmt_count < stmt_cap {
        let c: i64 = str_char_at(source, q);
        if c == 123 { depth = depth + 1; };
        if c == 125 { depth = depth - 1; };
        if c == 59 { stmt_count = stmt_count + 1; };
        if c == 119 && q + 5 <= slen {
            if str_char_at(source, q + 1) == 104 && str_char_at(source, q + 2) == 105
                && str_char_at(source, q + 3) == 108 && str_char_at(source, q + 4) == 101 {
                let prev: i64 = if q > 0 { str_char_at(source, q - 1) } else { 32 };
                let next: i64 = if q + 5 < slen { str_char_at(source, q + 5) } else { 32 };
                let prev_ok: i64 = if is_alnum(prev) == 0 && prev != 95 { 1 } else { 0 };
                let next_ok: i64 = if is_alnum(next) == 0 && next != 95 { 1 } else { 0 };
                if prev_ok == 1 && next_ok == 1 { while_count = while_count + 1; };
            };
        };
        q = q + 1;
    };
    let mut multiplier: i64 = 1;
    if while_count == 1 { multiplier = 100; };
    if while_count == 2 { multiplier = 1000; };
    if while_count >= 3 { multiplier = 10000; };
    let units: i64 = stmt_count * multiplier;
    if units > stmt_cap { return stmt_cap; };
    return units;
}

fn enforce_static_wcet(diags: Vec<i32>, source: str) -> Vec<i32> {
    // For each #[deadline = N] fn (post-resolver shape — inner +
    // outer wrapper pair from T3.1), estimate WCET on the inner
    // body and warn if the estimate exceeds the budget.
    let entries: Vec<i32> = wcet_collect_deadline_fns(source);
    let n: i64 = vec_len(entries);
    let mut i: i64 = 0;
    while i + 1 < n {
        let inner_name: str = vec_get(entries, i);
        let limit_us: i64 = vec_get(entries, i + 1);
        let units: i64 = wcet_estimate_fn_units(source, inner_name);
        let estimated_us: i64 = (units + 9) / 10;
        if estimated_us > limit_us {
            let msg: str = str_concat("static WCET estimate ", str_concat(str_from_int(estimated_us), str_concat(" us (", str_concat(str_from_int(units), str_concat(" units x 0.1 us) exceeds #[deadline = ", str_concat(str_from_int(limit_us), str_concat(" us] (v1 estimator -- use #[allow(RT-004)] file-wide or #[allow_fn(RT-004)] per-fn if the estimate is wrong; default loop multiplier 100x)", "")))))));
            diag_add_ex(diags, "warning", "rt", "RT-004", msg, inner_name, 0, 0, "");
        };
        i = i + 2;
    };
    return diags;
}

// === T3.5 (v0.3.3): RT-007 cross-check — #[deadline] without #[no_alloc] / #[no_panic] ===
// Allocations and panics are non-deterministic and can blow past
// any fixed deadline budget. The runtime deadline check (RT-004)
// catches overruns AFTER the fact. RT-007 nudges authors to also
// declare intent: at least one of #[no_alloc] or #[no_panic]
// should accompany #[deadline] so the compiler can statically
// rule out the most common deadline-busters.

fn enforce_deadline_safety(diags: Vec<i32>, source: str) -> Vec<i32> {
    let dl_entries: Vec<i32> = wcet_collect_deadline_fns(source);
    let no_alloc_fns: Vec<i32> = collect_no_alloc_fns(source);
    let no_panic_fns: Vec<i32> = collect_no_panic_fns(source);
    let n: i64 = vec_len(dl_entries);
    let mut i: i64 = 0;
    while i + 1 < n {
        let inner_name: str = vec_get(dl_entries, i);
        let mut has_no_alloc: i64 = 0;
        let mut j: i64 = 0;
        let na_n: i64 = vec_len(no_alloc_fns);
        while j < na_n && has_no_alloc == 0 {
            if str_eq(vec_get(no_alloc_fns, j), inner_name) == 1 { has_no_alloc = 1; };
            j = j + 1;
        };
        let mut has_no_panic: i64 = 0;
        j = 0;
        let np_n: i64 = vec_len(no_panic_fns);
        while j < np_n && has_no_panic == 0 {
            if str_eq(vec_get(no_panic_fns, j), inner_name) == 1 { has_no_panic = 1; };
            j = j + 1;
        };
        if has_no_alloc == 0 && has_no_panic == 0 {
            let msg: str = str_concat("'", str_concat(inner_name, "' has #[deadline] but neither #[no_alloc] nor #[no_panic]; allocations or panics can break WCET determinism (use #[allow(RT-007)] file-wide, or #[allow_fn(RT-007)] per-fn)"));
            diag_add_ex(diags, "warning", "rt", "RT-007", msg, inner_name, 0, 0, "");
        };
        i = i + 2;
    };
    return diags;
}

fn byte_to_line(source: str, byte_off: i64) -> i64 {
    let slen: i64 = str_len(source);
    let mut line: i64 = 1;
    let mut i: i64 = 0;
    let limit: i64 = byte_off;
    if limit > slen { return 0; };
    while i < limit {
        if str_char_at(source, i) == 10 { line = line + 1; };
        i = i + 1;
    };
    return line;
}

// RFC-0020 phase 1: LineMap — precomputed line-start byte offsets.
// linemap_build returns Vec<i32> where item[k] = byte offset of line (k+1)'s
// first character (line 1 starts at offset 0). Lookup is O(log n) via
// binary search; pair with linemap_col for column number.
fn linemap_build(source: str) -> Vec<i32> {
    let mut starts: Vec<i32> = Vec::new();
    starts.push(0);  // line 1 starts at offset 0
    let slen: i64 = str_len(source);
    let mut i: i64 = 0;
    while i < slen {
        if str_char_at(source, i) == 10 { starts.push(i + 1); };
        i = i + 1;
    };
    return starts;
}

fn linemap_line(starts: Vec<i32>, byte_off: i64) -> i64 {
    let n: i64 = vec_len(starts);
    if n == 0 { return 1; };
    let mut lo: i64 = 0;
    let mut hi: i64 = n - 1;
    // Find the largest index `k` such that starts[k] <= byte_off.
    // Returned line number is k + 1 (1-indexed).
    while lo < hi {
        let mid: i64 = (lo + hi + 1) / 2;
        if vec_get(starts, mid) <= byte_off { lo = mid; }
        else { hi = mid - 1; };
    };
    return lo + 1;
}

fn linemap_col(starts: Vec<i32>, byte_off: i64) -> i64 {
    let line: i64 = linemap_line(starts, byte_off);
    let line_start: i64 = vec_get(starts, line - 1);
    return byte_off - line_start + 1;
}

fn linemap_line_count(starts: Vec<i32>) -> i64 { return vec_len(starts); }

fn find_linecol_in_source(source: str, fn_name: str, var_name: str) -> Vec<i32> {
    let slen: i64 = str_len(source);
    let fnlen: i64 = str_len(fn_name);
    let vlen: i64 = str_len(var_name);
    let mut out: Vec<i32> = Vec::new();
    if fnlen == 0 || vlen == 0 { out.push(0); out.push(0); return out; };
    let target: str = str_concat("fn ", fn_name);
    let tlen: i64 = str_len(target);
    let mut i: i64 = 0;
    let mut fn_start: i64 = 0 - 1;
    while i < slen - tlen {
        if str_eq_at(source, i, target) == 1 { fn_start = i; i = slen; };
        i = i + 1;
    };
    if fn_start < 0 { out.push(0); out.push(0); return out; };
    let mut line: i64 = byte_to_line(source, fn_start);
    let mut col: i64 = 1;
    i = fn_start;
    while i < slen - vlen {
        if str_eq_at(source, i, var_name) == 1 {
            out.push(line);
            out.push(col);
            return out;
        };
        if str_char_at(source, i) == 10 { line = line + 1; col = 1; }
        else { col = col + 1; };
        i = i + 1;
    };
    out.push(byte_to_line(source, fn_start));
    out.push(1);
    return out;
}
fn find_in_source(source: str, fn_name: str, var_name: str) -> i64 {
    return vec_get(find_linecol_in_source(source, fn_name, var_name), 0);
}

fn find_column_in_source(source: str, fn_name: str, var_name: str) -> i64 {
    return vec_get(find_linecol_in_source(source, fn_name, var_name), 1);
}

// RFC-0020 phase 1: Rust-style diagnostic rendering.
// Detects TTY via NO_COLOR env; ANSI when colored, plain otherwise.
fn diag_use_color() -> i64 {
    if str_len(getenv("NO_COLOR")) > 0 { return 0; };
    if str_len(getenv("NUCLEOR_NO_COLOR")) > 0 { return 0; };
    if isatty_stdout() == 0 { return 0; };
    return 1;
}

fn ansi_red(s: str) -> str {
    if diag_use_color() == 0 { return s; };
    let esc: str = chr(27);
    return str_concat(esc, str_concat("[31m", str_concat(s, str_concat(esc, "[0m"))));
}

fn ansi_yellow(s: str) -> str {
    if diag_use_color() == 0 { return s; };
    let esc: str = chr(27);
    return str_concat(esc, str_concat("[33m", str_concat(s, str_concat(esc, "[0m"))));
}

fn ansi_dim(s: str) -> str {
    if diag_use_color() == 0 { return s; };
    let esc: str = chr(27);
    return str_concat(esc, str_concat("[2m", str_concat(s, str_concat(esc, "[0m"))));
}

fn ansi_bold(s: str) -> str {
    if diag_use_color() == 0 { return s; };
    let esc: str = chr(27);
    return str_concat(esc, str_concat("[1m", str_concat(s, str_concat(esc, "[0m"))));
}

// RFC-0020 phase 2: JSON renderer for IDE / CI consumption.
// Honors NUCLEOR_DIAG_JSON env var (when set, all diags emit as one JSON
// array of objects). Stable schema for tool integration:
//   { "code": "OWN-008", "severity": "error", "message": "...",
//     "fn": "main", "line": 14, "col": 5,
//     "child": "moved here", "child_line": 13,
//     "suggestion": "consider `let mut x` here" }
fn diag_use_json() -> i64 {
    if str_len(getenv("NUCLEOR_DIAG_JSON")) > 0 { return 1; };
    return 0;
}

fn diag_json_escape(s: str) -> str {
    let mut sb: i64 = sb_new();
    let slen: i64 = str_len(s);
    let mut i: i64 = 0;
    while i < slen {
        let c: i64 = str_char_at(s, i);
        if c == 34 { sb_append(sb, "\\\""); }
        else if c == 92 { sb_append(sb, "\\\\"); }
        else if c == 10 { sb_append(sb, "\\n"); }
        else if c == 13 { sb_append(sb, "\\r"); }
        else if c == 9 { sb_append(sb, "\\t"); }
        else { sb_append(sb, str_substring(s, i, i + 1)); };
        i = i + 1;
    };
    return sb_to_str(sb);
}

fn diag_emit_json(diags: Vec<i32>) -> i64 {
    let cnt: i64 = vec_len(diags);
    print("[");
    let mut i: i64 = 0;
    while i < cnt {
        let d: Vec<i32> = vec_get(diags, i);
        let severity: str = vec_get(d, 0);
        let code: str = vec_get(d, 2);
        let message: str = vec_get(d, 3);
        let fn_name: str = vec_get(d, 4);
        let line: i64 = vec_get(d, 5);
        let col: i64 = vec_get(d, 6);
        let suggestion: str = vec_get(d, 8);
        let child_msg: str = vec_get(d, 10);
        let child_line: i64 = vec_get(d, 11);
        let mut sb: i64 = sb_new();
        if i > 0 { sb_append(sb, ","); };
        sb_append(sb, "{\"code\":\"");
        sb_append(sb, diag_json_escape(code));
        sb_append(sb, "\",\"severity\":\"");
        sb_append(sb, severity);
        sb_append(sb, "\",\"message\":\"");
        sb_append(sb, diag_json_escape(message));
        sb_append(sb, "\"");
        if str_len(fn_name) > 0 {
            sb_append(sb, ",\"fn\":\"");
            sb_append(sb, diag_json_escape(fn_name));
            sb_append(sb, "\"");
        };
        if line > 0 {
            sb_append(sb, ",\"line\":");
            sb_append(sb, str_from_int(line));
        };
        if col > 0 {
            sb_append(sb, ",\"col\":");
            sb_append(sb, str_from_int(col));
        };
        if str_len(child_msg) > 0 {
            sb_append(sb, ",\"child\":\"");
            sb_append(sb, diag_json_escape(child_msg));
            sb_append(sb, "\"");
        };
        if child_line > 0 {
            sb_append(sb, ",\"child_line\":");
            sb_append(sb, str_from_int(child_line));
        };
        if str_len(suggestion) > 0 {
            sb_append(sb, ",\"suggestion\":\"");
            sb_append(sb, diag_json_escape(suggestion));
            sb_append(sb, "\"");
        };
        sb_append(sb, "}");
        print(sb_to_str(sb));
        i = i + 1;
    };
    print("]");
    return cnt;
}

// T1.8 (v0.2.335): extract a single 1-based line from a source
// string. Returns "" if line is out of range. Memory-safe: walks
// the source by index without allocating a substring per
// candidate.
fn diag_extract_line(source: str, line_no: i64) -> str {
    if line_no <= 0 || str_len(source) == 0 { return ""; };
    let slen: i64 = str_len(source);
    let mut p: i64 = 0;
    let mut cur_line: i64 = 1;
    let mut line_start: i64 = 0;
    while p < slen && cur_line < line_no {
        if str_char_at(source, p) == 10 { cur_line = cur_line + 1; line_start = p + 1; };
        p = p + 1;
    };
    if cur_line != line_no { return ""; };
    let mut line_end: i64 = line_start;
    while line_end < slen && str_char_at(source, line_end) != 10 { line_end = line_end + 1; };
    return str_substring(source, line_start, line_end);
}

// T1.8: build a caret line "    ^^^^^^" pointing at column `col`
// (1-based). Length defaults to 1 (single caret) for now; future
// work can pass a token span.
fn diag_caret_line(col: i64) -> str {
    if col <= 0 { return ""; };
    let mut sb: i64 = sb_new();
    let mut i: i64 = 1;
    while i < col { sb_append(sb, " "); i = i + 1; };
    sb_append(sb, "^");
    return sb_to_str(sb);
}

fn diag_emit_text(diags: Vec<i32>) -> i64 {
    return diag_emit_text_with_source(diags, "");
}

// T1.8: source-aware text emit. Renders Rust-style frame:
//   error[CODE]: message
//     --> fn:line:col
//     |
//   42 |     let x: u8 = 256;
//      |                 ^
//     = help: ...
fn diag_emit_text_with_source(diags: Vec<i32>, source: str) -> i64 {
    let cnt: i64 = vec_len(diags);
    let mut i: i64 = 0;
    while i < cnt {
        let d: Vec<i32> = vec_get(diags, i);
        let severity: str = vec_get(d, 0);
        let code: str = vec_get(d, 2);
        let message: str = vec_get(d, 3);
        let fn_name: str = vec_get(d, 4);
        let line: i64 = vec_get(d, 5);
        let col: i64 = vec_get(d, 6);
        let suggestion: str = vec_get(d, 8);
        let child_msg: str = vec_get(d, 10);
        let child_line: i64 = vec_get(d, 11);

        // First line: severity[CODE]: message
        let mut head: i64 = sb_new();
        let label: str = if str_eq(severity, "error") == 1 { ansi_red("error") } else { ansi_yellow("warning") };
        sb_append(head, label);
        sb_append(head, ansi_bold(str_concat("[", str_concat(code, "]"))));
        sb_append(head, ": ");
        sb_append(head, message);
        print(sb_to_str(head));

        // Second line: --> file:line:col  (file currently unknown; emit fn:line:col)
        if line > 0 {
            let mut loc: i64 = sb_new();
            sb_append(loc, "  ");
            sb_append(loc, ansi_dim("-->"));
            sb_append(loc, " ");
            if str_len(fn_name) > 0 {
                sb_append(loc, ansi_dim("fn "));
                sb_append(loc, fn_name);
                sb_append(loc, ansi_dim("@"));
            };
            sb_append(loc, ansi_dim(str_concat("line ", str_from_int(line))));
            if col > 0 {
                sb_append(loc, ansi_dim(str_concat(":", str_from_int(col))));
            };
            print(sb_to_str(loc));
        };

        // T1.8: source snippet + caret frame, when source is available.
        // Format (Rust-style):
        //     |
        //  42 | let x: u8 = 256;
        //     |             ^
        if str_len(source) > 0 && line > 0 {
            let snippet: str = diag_extract_line(source, line);
            if str_len(snippet) > 0 {
                let line_str: str = str_from_int(line);
                let gutter_w: i64 = str_len(line_str);
                // Pad line number gutter + vertical bar on blank row.
                let mut blank: i64 = sb_new();
                let mut pi: i64 = 0;
                while pi < gutter_w { sb_append(blank, " "); pi = pi + 1; };
                sb_append(blank, " ");
                sb_append(blank, ansi_dim("|"));
                print(sb_to_str(blank));
                // Source line row.
                let mut src_row: i64 = sb_new();
                sb_append(src_row, ansi_dim(line_str));
                sb_append(src_row, " ");
                sb_append(src_row, ansi_dim("|"));
                sb_append(src_row, " ");
                sb_append(src_row, snippet);
                print(sb_to_str(src_row));
                // Caret row.
                if col > 0 {
                    let mut caret_row: i64 = sb_new();
                    pi = 0;
                    while pi < gutter_w { sb_append(caret_row, " "); pi = pi + 1; };
                    sb_append(caret_row, " ");
                    sb_append(caret_row, ansi_dim("|"));
                    sb_append(caret_row, " ");
                    sb_append(caret_row, ansi_red(diag_caret_line(col)));
                    print(sb_to_str(caret_row));
                };
            };
        };

        // Child note line ("moved here", "borrowed here", etc.)
        if str_len(child_msg) > 0 && child_line > 0 {
            let mut child: i64 = sb_new();
            sb_append(child, "  ");
            sb_append(child, ansi_dim("note: "));
            sb_append(child, child_msg);
            sb_append(child, ansi_dim(str_concat(" (line ", str_concat(str_from_int(child_line), ")"))));
            print(sb_to_str(child));
        };

        // Suggestion / help line
        if str_len(suggestion) > 0 {
            let mut help: i64 = sb_new();
            sb_append(help, "  ");
            sb_append(help, ansi_dim("help: "));
            sb_append(help, suggestion);
            print(sb_to_str(help));
        };

        // Blank separator between diagnostics
        if i + 1 < cnt { print(""); };
        i = i + 1;
    };
    return cnt;
}

// =====================================================
// OWNERSHIP CHECKER (S11.5)
// =====================================================
fn own_new() -> Vec<i32> { return Vec::new(); }
fn own_put_i(o: Vec<i32>, key: str, val: i64) -> i64 {
    // v0.3.221 perf: scan backward and break on first match.
    // v0.4.3: sync the warm aux hashmap on in-place updates IF this
    // sym is currently warm. __nucleor_sym_aux_get returns the warm
    // handle if `o` matches, else -1; we only touch on match.
    let mut i: i64 = vec_len(o) - 2;
    while i >= 0 {
        if str_eq(vec_get(o, i), key) == 1 {
            vec_set(o, i + 1, val);
            let h: i64 = __nucleor_sym_aux_get(o);
            if h > 0 { __nucleor_hashmap_insert(h, key, val); };
            return 0;
        };
        i = i - 2;
    };
    o.push(key);
    o.push(val);
    return 0;
}
fn own_put_s(o: Vec<i32>, key: str, val: str) -> i64 {
    // v0.3.221 perf: same backward-scan break-on-match optimization.
    // v0.4.3: same warm-aux sync as own_put_i. str values are stored
    // as i64-cast pointers under the i64-everywhere ABI.
    let mut i: i64 = vec_len(o) - 2;
    while i >= 0 {
        if str_eq(vec_get(o, i), key) == 1 {
            vec_set(o, i + 1, val);
            let h: i64 = __nucleor_sym_aux_get(o);
            if h > 0 { __nucleor_hashmap_insert(h, key, val); };
            return 0;
        };
        i = i - 2;
    };
    o.push(key);
    o.push(val);
    return 0;
}
fn own_set(o: Vec<i32>, name: str, state: i64) -> i64 { return own_put_i(o, str_concat("__os_", name), state); }
fn own_get(o: Vec<i32>, name: str) -> i64 {
    let v: i64 = sym_get(o, str_concat("__os_", name));
    if v < 0 { return 1; }; // unknown variables default to alive
    return v;
}
fn own_set_type(o: Vec<i32>, name: str, tstr: str) -> i64 { return own_put_s(o, str_concat("__ot_", name), tstr); }
fn own_get_type(o: Vec<i32>, name: str) -> str {
    let v: i64 = sym_get(o, str_concat("__ot_", name));
    if v < 0 { return ""; };
    return v;
}
fn own_set_i(o: Vec<i32>, key: str, val: i64) -> i64 { return own_put_i(o, str_concat("__oi_", key), val); }
fn own_get_i(o: Vec<i32>, key: str) -> i64 {
    let v: i64 = sym_get(o, str_concat("__oi_", key));
    if v < 0 { return 0; };
    return v;
}
fn own_set_s(o: Vec<i32>, key: str, val: str) -> i64 { return own_put_s(o, str_concat("__os2_", key), val); }
fn own_get_s(o: Vec<i32>, key: str) -> str {
    let v: i64 = sym_get(o, str_concat("__os2_", key));
    if v < 0 { return ""; };
    return v;
}
fn own_diags(o: Vec<i32>) -> Vec<i32> {
    if vec_len(o) > 1 { return vec_get(o, 1); };
    return own_get_type(o, "__diags");
}
fn own_source(o: Vec<i32>) -> str {
    if vec_len(o) > 3 { return vec_get(o, 3); };
    return own_get_type(o, "__source");
}
fn own_shared_keys_vec(o: Vec<i32>) -> Vec<i32> {
    if vec_len(o) > 5 { return vec_get(o, 5); };
    return own_get_type(o, "__shared_keys");
}
fn own_mut_keys_vec(o: Vec<i32>) -> Vec<i32> {
    if vec_len(o) > 7 { return vec_get(o, 7); };
    return own_get_type(o, "__mut_keys");
}
fn own_scope_keys_vec(o: Vec<i32>) -> Vec<i32> {
    if vec_len(o) > 9 { return vec_get(o, 9); };
    return own_get_type(o, "__scope_keys");
}
fn own_cur_scope(o: Vec<i32>) -> i64 {
    if vec_len(o) > 11 { return vec_get(o, 11); };
    return own_get_i(o, "cur_scope");
}
fn own_set_cur_scope(o: Vec<i32>, depth: i64) -> i64 {
    if vec_len(o) > 11 { vec_set(o, 11, depth); return 0; };
    return own_set_i(o, "cur_scope", depth);
}
fn own_set_mutable(o: Vec<i32>, name: str, is_mut: i64) -> i64 { return own_set_i(o, str_concat("mutable_", name), is_mut); }
fn own_get_mutable(o: Vec<i32>, name: str) -> i64 { return own_get_i(o, str_concat("mutable_", name)); }
fn own_track_key(o: Vec<i32>, list_key: str, name: str) -> i64 {
    let keys: Vec<i32> = if str_eq(list_key, "__shared_keys") == 1 { own_shared_keys_vec(o) } else { if str_eq(list_key, "__mut_keys") == 1 { own_mut_keys_vec(o) } else { if str_eq(list_key, "__scope_keys") == 1 { own_scope_keys_vec(o) } else { own_get_type(o, list_key) } } };
    let mut i: i64 = 0;
    while i < vec_len(keys) {
        if str_eq(vec_get(keys, i), name) == 1 { return 0; };
        i = i + 1;
    };
    keys.push(name);
    return 0;
}
fn own_set_scope(o: Vec<i32>, name: str, depth: i64) -> i64 {
    own_track_key(o, "__scope_keys", name);
    return own_set_i(o, str_concat("scope_", name), depth);
}
fn own_get_scope(o: Vec<i32>, name: str) -> i64 { return own_get_i(o, str_concat("scope_", name)); }
fn own_set_param(o: Vec<i32>, name: str, is_param: i64) -> i64 { return own_set_i(o, str_concat("param_", name), is_param); }
fn own_get_param(o: Vec<i32>, name: str) -> i64 { return own_get_i(o, str_concat("param_", name)); }
fn own_set_ref_target(o: Vec<i32>, name: str, target: str) -> i64 { return own_set_s(o, str_concat("ref_target_", name), target); }
fn own_get_ref_target(o: Vec<i32>, name: str) -> str { return own_get_s(o, str_concat("ref_target_", name)); }
fn own_set_ref_kind(o: Vec<i32>, name: str, kind: i64) -> i64 { return own_set_i(o, str_concat("ref_kind_", name), kind); }
fn own_get_ref_kind(o: Vec<i32>, name: str) -> i64 { return own_get_i(o, str_concat("ref_kind_", name)); }
fn own_shared_borrows(o: Vec<i32>, key: str) -> i64 { return own_get_i(o, str_concat("shared_", key)); }
fn own_mut_borrowed(o: Vec<i32>, key: str) -> i64 { return own_get_i(o, str_concat("mut_", key)); }
fn own_inc_shared(o: Vec<i32>, key: str) -> i64 {
    own_track_key(o, "__shared_keys", key);
    return own_set_i(o, str_concat("shared_", key), own_shared_borrows(o, key) + 1);
}
fn own_dec_shared(o: Vec<i32>, key: str) -> i64 {
    let cur: i64 = own_shared_borrows(o, key);
    if cur > 0 { own_set_i(o, str_concat("shared_", key), cur - 1); };
    return 0;
}
fn own_set_mut_borrow(o: Vec<i32>, key: str, on: i64) -> i64 {
    own_track_key(o, "__mut_keys", key);
    return own_set_i(o, str_concat("mut_", key), on);
}
fn str_starts_with(s: str, prefix: str) -> i64 {
    // Non-allocating prefix check. Avoid str_len(s): this helper is
    // hot in type-name probes, and str_char_at(s, strlen(s)) returns
    // NUL, so a short source string fails safely while walking prefix.
    let plen: i64 = str_len(prefix);
    let mut i: i64 = 0;
    while i < plen {
        let sc: i64 = str_char_at(s, i);
        if sc == 0 { return 0; };
        if sc != str_char_at(prefix, i) { return 0; };
        i = i + 1;
    };
    return 1;
}

// Non-allocating "is target string at source[pos..pos+len(target)]"
// check. Replaces the `str_eq(str_substring(source, pos, pos+tlen),
// target)` anti-pattern that was the dominant memory leak in the
// self-host compile (find_linecol_in_source, line_contains_text,
// source_box_binding_type, substring-search loops — each scanned
// the full source allocating a substring per byte position; for a
// 485 KB source that was ~485,000 transient allocations per
// invocation × thousands of invocations = ~9.5 GB of leaked
// transient strings during type-check).
fn str_eq_at(source: str, pos: i64, target: str) -> i64 {
    // CRITICAL: do NOT call str_len(source) here — it's O(n) (walks
    // to the null terminator). The dominant caller (find_linecol_in_
    // source) already guarantees pos + str_len(target) <= str_len(
    // source) via its outer loop bound, so we don't need to recheck.
    // A naive bounds check made the s1 self-host compile take >5 min
    // (was ~25 s) because the per-call str_len walked the entire
    // 485 KB source for every byte position scanned.
    let tlen: i64 = str_len(target);
    let mut k: i64 = 0;
    while k < tlen {
        if str_char_at(source, pos + k) != str_char_at(target, k) { return 0; };
        k = k + 1;
    };
    return 1;
}
fn path_overlaps(a: str, b: str) -> i64 {
    if str_len(a) == 0 || str_len(b) == 0 { return 0; };
    if str_eq(a, b) == 1 { return 1; };
    let ap: str = str_concat(a, ".");
    let bp: str = str_concat(b, ".");
    if str_starts_with(b, ap) == 1 { return 1; };
    if str_starts_with(a, bp) == 1 { return 1; };
    return 0;
}
fn expr_borrow_key(pool: Vec<i32>, nid: i64, own: Vec<i32>) -> str {
    if nid < 0 || nid >= vec_len(pool) { return ""; };
    let kind: i64 = node_kind(pool, nid);
    if kind == 3 {
        let name: str = node_field(pool, nid, 1);
        if type_is_ref(own_get_type(own, name)) == 1 {
            let target: str = own_get_ref_target(own, name);
            if str_len(target) > 0 { return target; };
        };
        return name;
    };
    if kind == 9 {
        let base: str = expr_borrow_key(pool, node_field(pool, nid, 1), own);
        if str_len(base) == 0 { return ""; };
        return str_concat(base, str_concat(".", node_field(pool, nid, 2)));
    };
    if kind == 92 { return expr_borrow_key(pool, node_field(pool, nid, 1), own); };
    return "";
}
fn expr_root_name(pool: Vec<i32>, nid: i64, own: Vec<i32>) -> str {
    if nid < 0 || nid >= vec_len(pool) { return ""; };
    let kind: i64 = node_kind(pool, nid);
    if kind == 3 {
        let name: str = node_field(pool, nid, 1);
        if type_is_ref(own_get_type(own, name)) == 1 {
            let target: str = own_get_ref_target(own, name);
            if str_len(target) > 0 {
                let mut i: i64 = 0;
                while i < str_len(target) {
                    if str_char_at(target, i) == 46 { return str_substring(target, 0, i); };
                    i = i + 1;
                };
                return target;
            };
        };
        return name;
    };
    if kind == 9 || kind == 90 || kind == 91 || kind == 92 { return expr_root_name(pool, node_field(pool, nid, 1), own); };
    return "";
}
fn own_has_shared_overlap(o: Vec<i32>, key: str) -> i64 {
    let keys: Vec<i32> = own_shared_keys_vec(o);
    let mut i: i64 = 0;
    while i < vec_len(keys) {
        let target: str = vec_get(keys, i);
        if own_shared_borrows(o, target) > 0 && path_overlaps(target, key) == 1 { return 1; };
        i = i + 1;
    };
    return 0;
}
fn own_has_mut_overlap(o: Vec<i32>, key: str) -> i64 {
    let keys: Vec<i32> = own_mut_keys_vec(o);
    let mut i: i64 = 0;
    while i < vec_len(keys) {
        let target: str = vec_get(keys, i);
        if own_mut_borrowed(o, target) == 1 && path_overlaps(target, key) == 1 { return 1; };
        i = i + 1;
    };
    return 0;
}
fn own_release_ref(o: Vec<i32>, name: str) -> i64 {
    let target: str = own_get_ref_target(o, name);
    if str_len(target) == 0 { return 0; };
    if own_get_ref_kind(o, name) == 1 { own_set_mut_borrow(o, target, 0); }
    else { own_dec_shared(o, target); };
    own_set_ref_target(o, name, "");
    own_set_ref_kind(o, name, 0);
    return 0;
}
fn own_release_scope(o: Vec<i32>, depth: i64) -> i64 {
    let keys: Vec<i32> = own_scope_keys_vec(o);
    let mut i: i64 = 0;
    while i < vec_len(keys) {
        let name: str = vec_get(keys, i);
        if own_get_scope(o, name) == depth { own_release_ref(o, name); };
        i = i + 1;
    };
    return 0;
}

fn own_snapshot(o: Vec<i32>) -> Vec<i32> {
    let mut snap: Vec<i32> = Vec::with_capacity(vec_len(o));
    let mut i: i64 = 0;
    while i < vec_len(o) { snap.push(vec_get(o, i)); i = i + 1; };
    return snap;
}
fn own_restore(o: Vec<i32>, snap: Vec<i32>) -> i64 {
    // Reset o to snap state without dropping the whole backing store.
    // Branch isolation calls this in hot ownership paths; pop-all then
    // push-all preserved semantics but churned the Vec on every branch.
    let target_len: i64 = vec_len(snap);
    while vec_len(o) > target_len { o.pop(); };
    let mut i: i64 = 0;
    while i < target_len {
        if i < vec_len(o) { vec_set(o, i, vec_get(snap, i)); }
        else { o.push(vec_get(snap, i)); };
        i = i + 1;
    };
    // v0.4.3: if this sym is the currently-warm one, the aux hashmap
    // holds stale entries from inside-the-branch own_put_i calls.
    // Clear it and reset built_at so the next sym_get rebuilds from
    // the post-restore vec. If it's not warm, the next sym_get will
    // rebuild anyway when it switches the warm slot.
    let h: i64 = __nucleor_sym_aux_get(o);
    if h > 0 {
        hashmap_clear(h);
        __nucleor_sym_aux_set_built_at(o, 0);
    };
    return 0;
}
fn own_merge_moved(o: Vec<i32>, a: Vec<i32>, b: Vec<i32>) -> i64 {
    // If a variable is moved in either branch, mark it moved.
    // Both `a` and `b` are consumed (freed) — they are then/else
    // env snapshots that no caller references after merge.
    let mut i: i64 = 0;
    while i < vec_len(a) {
        let key: str = vec_get(a, i);
        let va: i64 = vec_get(a, i + 1);
        if va == 2 { own_put_i(o, key, 2); }
        else {
            let vb: i64 = sym_get(b, key);
            if vb == 2 { own_put_i(o, key, 2); };
        };
        i = i + 2;
    };
    return 0;
}

fn enum_find(pool: Vec<i32>, enums: Vec<i32>, name: str) -> i64 {
    let mut i: i64 = 0;
    while i < vec_len(enums) {
        if str_eq(node_field(pool, vec_get(enums, i), 1), name) { return i; };
        i = i + 1;
    };
    return 0 - 1;
}

fn is_copy_type(tstr: str, pool: Vec<i32>, structs: Vec<i32>, enums: Vec<i32>) -> i64 {
    if str_len(tstr) == 0 { return 1; };
    if type_is_mut_ref(tstr) == 1 { return 0; };
    if type_is_shared_ref(tstr) == 1 { return 1; };
    let base: str = type_base_name(tstr);
    if str_eq(base, "i64") { return 1; }; if str_eq(base, "i32") { return 1; };
    if str_eq(base, "str") { return 1; }; if str_eq(base, "bool") { return 1; };
    if str_eq(base, "f64") { return 1; }; if str_eq(base, "ptr") { return 1; };
    if str_eq(base, "void") { return 1; };
    if str_eq(base, "Vec") { return 1; }; if str_eq(base, "HashMap") { return 1; };
    if str_eq(base, "StringBuilder") { return 1; };
    if str_eq(base, "Box") { return 0; };
    if str_eq(base, "Option") { return 0; };
    if str_eq(base, "Result") { return 0; };
    if str_eq(base, "Arena") { return 1; };
    if str_eq(base, "DeviceBuffer") { return 0; };
    if str_eq(base, "RandomCap") { return 1; };
    if str_eq(base, "Tensor") { return 0; };
    // User-defined struct or enum is Move
    if struct_find(pool, structs, base) >= 0 { return 0; };
    if enum_find(pool, enums, base) >= 0 { return 0; };
    return 1; // unknown types default to Copy
}

fn own_binding_move_type(tstr: str, pool: Vec<i32>, structs: Vec<i32>, enums: Vec<i32>) -> i64 {
    if is_copy_type(tstr, pool, structs, enums) == 0 { return 1; };
    let base: str = type_base_name(tstr);
    if str_eq(base, "String") { return 1; };
    return 0;
}

fn check_expr(pool: Vec<i32>, nid: i64, own: Vec<i32>, structs: Vec<i32>, enums: Vec<i32>, fn_name: str) -> i64 {
    if nid < 0 { return 0; };
    if nid >= vec_len(pool) { return 0; };
    let kind: i64 = node_kind(pool, nid);
    let mut warns: i64 = 0;
    if kind == 1 || kind == 2 || kind == 71 || kind == 72 { return 0; }; // literals
    if kind == 3 {
        // IDENT — check for use-after-move
        let vname: str = node_field(pool, nid, 1);
        let state: i64 = own_get(own, vname);
        if state == 2 {
            let source_text_move: str = own_source(own);
            let diag_vec_move: Vec<i32> = own_diags(own);
            // v0.5 ship 7 final: span-aware caret. Pre-fix, the OWN-001
            // line/col came from `find_in_source` / `find_column_in_source`
            // which scan the function body for the FIRST textual
            // occurrence of `vname` — wrong-caret bug for any variable
            // used multiple times in the same fn (the fix points at the
            // first use, not the actual use-after-move site). With var-
            // ref nids now spanned in parse_primary, we read the use
            // site directly.
            let move_sp: i64 = node_get_span(pool, nid);
            let mut ln: i64 = 0;
            let mut col: i64 = 0;
            if move_sp >= 0 {
                let lm_om: Vec<i32> = linemap_build(source_text_move);
                ln = linemap_line(lm_om, move_sp);
                col = linemap_col(lm_om, move_sp);
            } else {
                ln = find_in_source(source_text_move, fn_name, vname);
                col = find_column_in_source(source_text_move, fn_name, vname);
            };
            let d_idx: i64 = diag_add_ex(diag_vec_move, "warning", "ownership", "OWN-001", str_concat("use of moved variable '", str_concat(vname, "'")), fn_name, ln, col, "");
            // Add child note: where was it moved?
            let moved_by: str = own_get_type(own, str_concat("__moved_by_", vname));
            if str_len(moved_by) > 0 {
                let d: Vec<i32> = diag_get(diag_vec_move, d_idx - 1);
                let move_line: i64 = find_in_source(source_text_move, fn_name, moved_by);
                vec_set(d, 10, str_concat("'", str_concat(vname, str_concat("' was moved here by call to '", str_concat(moved_by, "'")))));
                vec_set(d, 11, move_line);
            };
            return 1;
        };
        return 0;
    };
    if kind == 4 {
        warns = warns + check_expr(pool, node_field(pool, nid, 2), own, structs, enums, fn_name);
        warns = warns + check_expr(pool, node_field(pool, nid, 3), own, structs, enums, fn_name);
        return warns;
    };
    if kind == 5 || kind == 6 || kind == 90 || kind == 91 || kind == 92 { return check_expr(pool, node_field(pool, nid, 1), own, structs, enums, fn_name); };
    if kind == 7 {
        // CALL — check args, move Move-type idents
        let callee_name: str = node_field(pool, nid, 1);
        let args: i64 = node_field(pool, nid, 2);
        let ac: i64 = list_len(pool, args);
        let mut ai: i64 = 0;
        while ai < ac {
            let arg_nid: i64 = list_get(pool, args, ai);
            warns = warns + check_expr(pool, arg_nid, own, structs, enums, fn_name);
            if node_kind(pool, arg_nid) == 90 || node_kind(pool, arg_nid) == 91 {
                warns = warns + own_register_borrow_expr(pool, arg_nid, own, fn_name, "", 0, 0);
                let key: str = expr_borrow_key(pool, node_field(pool, arg_nid, 1), own);
                if node_kind(pool, arg_nid) == 90 { own_dec_shared(own, key); }
                else { own_set_mut_borrow(own, key, 0); };
            };
            if node_kind(pool, arg_nid) == 3 {
                let aname: str = node_field(pool, arg_nid, 1);
                let atype: str = own_get_type(own, aname);
                if type_is_mut_ref(atype) == 1 {
                    ai = ai + 1;
                    continue;
                };
                if str_eq(callee_name, "arena_destroy") == 1 {
                    let arena_key: str = str_concat("@arena:", aname);
                    if own_has_shared_overlap(own, arena_key) == 1 {
                        warns = warns + own_diag(own, fn_name, "OWN-012", str_concat("cannot destroy arena '", str_concat(aname, "': live arena references still exist")), aname);
                    };
                };
                if is_copy_type(atype, pool, structs, enums) == 0 {
                    if own_has_shared_overlap(own, aname) == 1 || own_has_mut_overlap(own, aname) == 1 {
                        warns = warns + own_diag(own, fn_name, "OWN-003", str_concat("cannot move '", str_concat(aname, "': value is borrowed")), aname);
                    } else {
                        own_set(own, aname, 2); own_set_type(own, str_concat("__moved_by_", aname), callee_name);
                    };
                };
            };
            ai = ai + 1;
        };
        return warns;
    };
    if kind == 8 {
        // METHOD — check receiver (don't move it) and args
        warns = warns + check_expr(pool, node_field(pool, nid, 1), own, structs, enums, fn_name);
        let method_name: str = node_field(pool, nid, 2);
        let args: i64 = node_field(pool, nid, 3);
        let ac: i64 = list_len(pool, args);
        let mut ai: i64 = 0;
        while ai < ac {
            let arg_nid: i64 = list_get(pool, args, ai);
            warns = warns + check_expr(pool, arg_nid, own, structs, enums, fn_name);
            if node_kind(pool, arg_nid) == 90 || node_kind(pool, arg_nid) == 91 {
                warns = warns + own_register_borrow_expr(pool, arg_nid, own, fn_name, "", 0, 0);
                let key: str = expr_borrow_key(pool, node_field(pool, arg_nid, 1), own);
                if node_kind(pool, arg_nid) == 90 { own_dec_shared(own, key); }
                else { own_set_mut_borrow(own, key, 0); };
            };
            if node_kind(pool, arg_nid) == 3 {
                let aname: str = node_field(pool, arg_nid, 1);
                let atype: str = own_get_type(own, aname);
                if type_is_mut_ref(atype) == 1 {
                    ai = ai + 1;
                    continue;
                };
                if is_copy_type(atype, pool, structs, enums) == 0 {
                    if own_has_shared_overlap(own, aname) == 1 || own_has_mut_overlap(own, aname) == 1 {
                        warns = warns + own_diag(own, fn_name, "OWN-003", str_concat("cannot move '", str_concat(aname, "': value is borrowed")), aname);
                    } else {
                        own_set(own, aname, 2); own_set_type(own, str_concat("__moved_by_", aname), method_name);
                    };
                };
            };
            ai = ai + 1;
        };
        return warns;
    };
    if kind == 9 { return check_expr(pool, node_field(pool, nid, 1), own, structs, enums, fn_name); };
    if kind == 10 {
        warns = warns + check_expr(pool, node_field(pool, nid, 1), own, structs, enums, fn_name);
        warns = warns + check_expr(pool, node_field(pool, nid, 2), own, structs, enums, fn_name);
        return warns;
    };
    if kind == 47 || kind == 48 {
        let items: i64 = node_field(pool, nid, 1);
        let ic: i64 = list_len(pool, items);
        let mut ii: i64 = 0;
        while ii < ic {
            warns = warns + check_expr(pool, list_get(pool, items, ii), own, structs, enums, fn_name);
            ii = ii + 1;
        };
        return warns;
    };
    if kind == 12 {
        let qual_name: str = str_concat(node_field(pool, nid, 1), str_concat("::", node_field(pool, nid, 2)));
        let args: i64 = node_field(pool, nid, 3);
        let ac: i64 = list_len(pool, args);
        let mut ai: i64 = 0;
        while ai < ac {
            let arg_nid: i64 = list_get(pool, args, ai);
            warns = warns + check_expr(pool, arg_nid, own, structs, enums, fn_name);
            if node_kind(pool, arg_nid) == 90 || node_kind(pool, arg_nid) == 91 {
                warns = warns + own_register_borrow_expr(pool, arg_nid, own, fn_name, "", 0, 0);
                let key: str = expr_borrow_key(pool, node_field(pool, arg_nid, 1), own);
                if node_kind(pool, arg_nid) == 90 { own_dec_shared(own, key); }
                else { own_set_mut_borrow(own, key, 0); };
            };
            if node_kind(pool, arg_nid) == 3 {
                let aname: str = node_field(pool, arg_nid, 1);
                let atype: str = own_get_type(own, aname);
                if type_is_mut_ref(atype) == 1 {
                    ai = ai + 1;
                    continue;
                };
                if is_copy_type(atype, pool, structs, enums) == 0 {
                    if own_has_shared_overlap(own, aname) == 1 || own_has_mut_overlap(own, aname) == 1 {
                        warns = warns + own_diag(own, fn_name, "OWN-003", str_concat("cannot move '", str_concat(aname, "': value is borrowed")), aname);
                    } else {
                        own_set(own, aname, 2); own_set_type(own, str_concat("__moved_by_", aname), qual_name);
                    };
                };
            };
            ai = ai + 1;
        };
        return warns;
    };
    if kind == 34 {
        // STRUCT_INIT — check field init exprs
        let source_text: str = own_source(own);
        let diag_vec: Vec<i32> = own_diags(own);
        let inits: i64 = node_field(pool, nid, 2);
        let ic: i64 = list_len(pool, inits);
        let mut ii: i64 = 0;
        while ii < ic {
            let init_nid: i64 = list_get(pool, inits, ii);
            let val_nid: i64 = node_field(pool, init_nid, 2);
            warns = warns + check_expr(pool, val_nid, own, structs, enums, fn_name);
            if node_kind(pool, val_nid) == 3 {
                let vn: str = node_field(pool, val_nid, 1);
                let vt: str = own_get_type(own, vn);
                if own_binding_move_type(vt, pool, structs, enums) == 1 { own_set(own, vn, 2); };
            };
            ii = ii + 1;
        };
        // v0.4.62: NUC-FEEDBACK silent-default-zero close. Pre-fix
        // `Point { x: 1, y: 2 }` for a struct with 3 fields silently
        // defaulted the missing field to 0 (or ""). Adopters writing
        // the canonical Rust idiom (which errors with E0063 — missing
        // field) got a quiet wrong value. Emit TYP-012 listing the
        // missing field count when ic < struct's declared field count.
        let struct_name: str = node_field(pool, nid, 1);
        let s_idx: i64 = struct_find_type(pool, structs, struct_name);
        if s_idx >= 0 {
            let s_nid: i64 = vec_get(structs, s_idx);
            let s_flist: i64 = node_field(pool, s_nid, 2);
            let expected_fc: i64 = list_len(pool, s_flist);
            if ic < expected_fc {
                let part_a: str = str_concat("missing field(s) in `", str_concat(struct_name, "` initialization: only "));
                let part_b: str = str_concat(str_from_int(ic), str_concat(" of ", str_concat(str_from_int(expected_fc), " fields supplied.")));
                let part_c: str = " Pre-v0.4.62 missing fields silently defaulted to 0 / empty. List every field explicitly or use a constructor fn.";
                diag_add_at_or_scan(diag_vec, source_text, pool, nid, struct_name, "error", "type", "TYP-012", str_concat(part_a, str_concat(part_b, part_c)), fn_name, "");
                warns = warns + 1;
            };
            // v0.4.63: NUC-FEEDBACK silent-extra-field close. Pre-fix
            // `Point { x: 1, y: 2, z: 3 }` for a 2-field Point silently
            // dropped the extra `z` field (Rust E0560 errors here).
            // Walk the init-list and check each field name against the
            // struct's declared fields via struct_field_idx; emit
            // TYP-013 for any unknown name.
            let mut fii: i64 = 0;
            while fii < ic {
                let init_check: i64 = list_get(pool, inits, fii);
                let fname: str = node_field(pool, init_check, 1);
                // v0.4.128: TYP-017 — duplicate field in struct init.
                // Pre-fix `Pt { x: 1, y: 2, x: 3 }` silently took the
                // FIRST occurrence of `x` (=1) with no signal —
                // adopter's intent (was 3 the override?) opaque, and
                // Rust rejects this with E0062. Walk the init list
                // back from current index and check for any prior
                // entry with the same field name.
                let mut dup_chk: i64 = 0;
                while dup_chk < fii {
                    let prior_init: i64 = list_get(pool, inits, dup_chk);
                    let prior_name: str = node_field(pool, prior_init, 1);
                    if str_eq(prior_name, fname) == 1 {
                        let dp1: str = str_concat("duplicate field `", str_concat(fname, "` in `"));
                        let dp2: str = str_concat(struct_name, "` initialization. Pre-v0.4.128 the FIRST occurrence won silently with no signal — adopter intent (was the second value the override?) was opaque. Remove one of the duplicate field assignments.");
                        diag_add_at_or_scan(diag_vec, source_text, pool, init_check, fname, "error", "type", "TYP-017", str_concat(dp1, dp2), fn_name, "");
                        warns = warns + 1;
                        dup_chk = fii;
                    };
                    dup_chk = dup_chk + 1;
                };
                let f_idx: i64 = struct_field_idx(pool, s_nid, fname);
                if f_idx < 0 {
                    let p1: str = str_concat("unknown field `", str_concat(fname, "` in `"));
                    let p2: str = str_concat(struct_name, "` initialization. Pre-v0.4.63 the extra field was silently dropped (Rust E0560 errors).");
                    diag_add_at_or_scan(diag_vec, source_text, pool, init_check, fname, "error", "type", "TYP-013", str_concat(p1, p2), fn_name, "");
                    warns = warns + 1;
                } else {
                    // v0.4.84: TYP-008 ext — narrow struct-field type
                    // mismatch check (literal RHS only, avoids
                    // type_expr recursion which has crashed compiler
                    // self-build in prior attempts). Pre-fix `Point {
                    // x: "hello", y: 2 }` for `x: i64` silently
                    // i64-stored the str pointer; reads of p.x then
                    // produced garbage like 140700202648688. Adopters
                    // got a quiet wrong value with no diagnostic.
                    // Fires for: int-lit (kind 1) into str field;
                    // str-lit (kind 2) into int/bool field;
                    // float-lit (kind 71) into int/bool/str field.
                    let val_nid: i64 = node_field(pool, init_check, 2);
                    let val_kind: i64 = node_kind(pool, val_nid);
                    let f_param: i64 = list_get(pool, s_flist, f_idx);
                    let f_type: str = node_field(pool, f_param, 2);
                    let mut mismatch: i64 = 0;
                    let mut got_kind: str = "";
                    if val_kind == 1 && str_eq(f_type, "str") == 1 { mismatch = 1; got_kind = "int literal"; };
                    // v0.4.133: int literal into bool field. Pre-fix
                    // `P { x: 5 }` for `x: bool` silently stored 5 as
                    // i64; reads of p.x evaluated truthy (5 != 0) but
                    // adopters lost the type guarantee. Rust E0308.
                    if val_kind == 1 && str_eq(f_type, "bool") == 1 { mismatch = 1; got_kind = "int literal (use `true`/`false`)"; };
                    if val_kind == 2 && (str_eq(f_type, "i64") == 1 || str_eq(f_type, "i32") == 1 || str_eq(f_type, "i16") == 1 || str_eq(f_type, "i8") == 1 || str_eq(f_type, "u64") == 1 || str_eq(f_type, "u32") == 1 || str_eq(f_type, "u16") == 1 || str_eq(f_type, "u8") == 1 || str_eq(f_type, "bool") == 1 || str_eq(f_type, "f64") == 1 || str_eq(f_type, "f32") == 1) { mismatch = 1; got_kind = "str literal"; };
                    if val_kind == 71 && (str_eq(f_type, "i64") == 1 || str_eq(f_type, "i32") == 1 || str_eq(f_type, "i16") == 1 || str_eq(f_type, "i8") == 1 || str_eq(f_type, "u64") == 1 || str_eq(f_type, "u32") == 1 || str_eq(f_type, "u16") == 1 || str_eq(f_type, "u8") == 1 || str_eq(f_type, "bool") == 1 || str_eq(f_type, "str") == 1) { mismatch = 1; got_kind = "float literal"; };
                    if mismatch == 1 {
                        let tm_msg: str = str_concat("struct-field type mismatch: `", str_concat(struct_name, str_concat(".", str_concat(fname, str_concat("` declared `", str_concat(f_type, str_concat("`, got ", str_concat(got_kind, ". Pre-v0.4.84 this silently bit-cast the value into the field's slot, producing garbage at read sites."))))))));
                        diag_add_at_or_scan(diag_vec, source_text, pool, init_check, fname, "error", "type", "TYP-008", tm_msg, fn_name, "");
                        warns = warns + 1;
                    };
                };
                fii = fii + 1;
            };
        };
        return warns;
    };
    if kind == 52 {
        let cur_scope: i64 = own_cur_scope(own);
        own_set_cur_scope(own, cur_scope + 1);
        warns = warns + check_stmts(pool, node_field(pool, nid, 2), own, structs, enums, fn_name);
        own_release_scope(own, cur_scope + 1);
        own_set_cur_scope(own, cur_scope);
        return warns;
    };
    if kind == 42 { return 0; }; // closure — skip for now
    if kind == 38 {
        let source_text: str = own_source(own);
        let diag_vec: Vec<i32> = own_diags(own);
        // v0.4.59 (deferred from v0.4.56): MATCH-001 in match-as-expression.
        // Pre-fix `let n: i64 = match c { Color::Red => 1 };` over a non-Red
        // value silently returned 0 because check_expr lacked a kind-38
        // handler — only check_stmt did the exhaustiveness check, so
        // matches in expression position escaped MATCH-001 entirely.
        // Mirror the check_stmt logic: walk arms, detect wildcard,
        // and if no wildcard + first arm is enum, compare ac < vcnt.
        warns = warns + check_expr(pool, node_field(pool, nid, 1), own, structs, enums, fn_name);
        let arms_e: i64 = node_field(pool, nid, 2);
        let ac_e: i64 = list_len(pool, arms_e);
        let mut has_wild_e: i64 = 0;
        let mut ai_e: i64 = 0;
        while ai_e < ac_e {
            let arm_e: i64 = list_get(pool, arms_e, ai_e);
            let ename_e: str = node_field(pool, arm_e, 1);
            if str_eq(ename_e, "__wild") == 1 { has_wild_e = 1; };
            // Recurse into the arm body so use-after-move etc. fires.
            warns = warns + check_stmts(pool, node_field(pool, arm_e, 4), own, structs, enums, fn_name);
            ai_e = ai_e + 1;
        };
        if has_wild_e == 0 && ac_e > 0 {
            let first_arm_e: i64 = list_get(pool, arms_e, 0);
            let first_ename_e: str = node_field(pool, first_arm_e, 1);
            // v0.4.109: int/str match-as-expr without wildcard is
            // provably non-exhaustive (cannot list every i32/i64/str
            // value). Pre-fix `match x { 1 => 10, 2 => 20 }` for
            // x=5 silently returned 0 — same hazard class as the
            // v0.4.59 enum match-as-expr close, but the existing
            // exhaustiveness check explicitly excluded __int/__str
            // (lines 9760/10060) so int/str matches escaped MATCH-001
            // entirely. Now: any int/str match-as-expr without an
            // `_` arm is MATCH-001.
            if (str_eq(first_ename_e, "__int") == 1 || str_eq(first_ename_e, "__str") == 1) && has_wild_e == 0 {
                let kind_label: str = if str_eq(first_ename_e, "__int") == 1 { "integer" } else { "string" };
                let msg_int_e: str = str_concat("non-exhaustive ", str_concat(kind_label, str_concat(" match (in expression context): ", str_concat(str_from_int(ac_e), " arms with no `_` wildcard. The set of values is unbounded so the unmatched case silently fell through to 0 pre-v0.4.109 — add a `_ => default_value,` arm to cover it explicitly."))));
                match_diag_at(diag_vec, source_text, pool, nid, "error", "MATCH-001", msg_int_e, fn_name);
                warns = warns + 1;
            };
            if str_eq(first_ename_e, "__int") == 0 && str_eq(first_ename_e, "__str") == 0 && str_eq(first_ename_e, "__wild") == 0 && str_eq(first_ename_e, "__range") == 0 && str_eq(first_ename_e, "__range_bad") == 0 {
                let ei_e: i64 = enum_find(pool, enums, first_ename_e);
                if ei_e >= 0 {
                    let e_nid_e: i64 = vec_get(enums, ei_e);
                    let vlist_e: i64 = node_field(pool, e_nid_e, 2);
                    let vcnt_e: i64 = list_len(pool, vlist_e);
                    if ac_e < vcnt_e {
                        let msg_e: str = str_concat("non-exhaustive match (in expression context): ", str_concat(str_from_int(ac_e), str_concat(" arms for enum with ", str_from_int(vcnt_e))));
                        let canon_e: str = str_concat(msg_e, ". Workaround: add a `_ => default_value,` arm or list every variant explicitly.");
                        // v0.5.18: MATCH-001 only. Pre-fix emitted both TYP-001
                        // (legacy umbrella) and MATCH-001 (RFC-0016 canonical)
                        // with identical text — adopter saw the same diagnostic
                        // twice. Probe-agent finding 2026-05-01-match-001-typ-001-dual-emit.
                        // MATCH-001 is the subsystem-specific code; it stays.
                        // TYP-001 is retained in the explain registry so
                        // adopters can `nuc explain TYP-001` to see it's been
                        // unified under MATCH-001.
                        match_diag_at(diag_vec, source_text, pool, nid, "error", "MATCH-001", canon_e, fn_name);
                        warns = warns + 1;
                    };
                };
            };
        };
        // v0.4.134: bool literal match arm detection. Outside the
        // `has_wild_e == 0` gate above because the parser misparses
        // `true => ...` as `__wild` with binding="true" (silently
        // matches ANY bool, returns the body for ALL inputs —
        // `match false { true => 1 }` returns 1).
        let mut bool_arm_v134: i64 = 0;
        let mut chk_v134: i64 = 0;
        while chk_v134 < ac_e {
            let arm_v134: i64 = list_get(pool, arms_e, chk_v134);
            let arm_n_v134: str = node_field(pool, arm_v134, 1);
            let arm_b_v134: str = node_field(pool, arm_v134, 3);
            if str_eq(arm_n_v134, "__wild") == 1
                && (str_eq(arm_b_v134, "true") == 1 || str_eq(arm_b_v134, "false") == 1) {
                bool_arm_v134 = 1;
            };
            chk_v134 = chk_v134 + 1;
        };
        if bool_arm_v134 == 1 {
            let msg_b_v134: str = "bool literal arm in `match` (`true => ...` or `false => ...`) is parsed as a wildcard binding pre-v0.4.134, not as a value comparison — `match b { true => 1 }` matches ANY bool and silently returns 1 even for b=false. Use `if cond { ... } else { ... }` for two-way bool branching, or convert the bool to i64 (`match b as i64 { 1 => ..., 0 => ..., _ => ... }`).";
            match_diag_at(diag_vec, source_text, pool, nid, "error", "MATCH-001", msg_b_v134, fn_name);
            warns = warns + 1;
        };
        return warns;
    };
    return warns;
}

fn check_stmt(pool: Vec<i32>, nid: i64, own: Vec<i32>, structs: Vec<i32>, enums: Vec<i32>, fn_name: str) -> i64 {
    if nid < 0 || nid >= vec_len(pool) { return 0; };
    let kind: i64 = node_kind(pool, nid);
    let mut warns: i64 = 0;
    let scope_depth: i64 = own_cur_scope(own);
    if kind == 20 {
        let vname: str = node_field(pool, nid, 1);
        let is_mut: i64 = node_field(pool, nid, 2);
        let mut tstr: str = node_field(pool, nid, 3);
        let init: i64 = node_field(pool, nid, 4);
        own_set_mutable(own, vname, is_mut);
        own_set_scope(own, vname, scope_depth);
        own_set_param(own, vname, 0);
        if init >= 0 {
            if str_len(tstr) == 0 && node_kind(pool, init) == 34 { tstr = node_field(pool, init, 1); };
            if str_len(tstr) == 0 && node_kind(pool, init) == 3 { tstr = own_get_type(own, node_field(pool, init, 1)); };
            warns = warns + check_expr(pool, init, own, structs, enums, fn_name);
            if type_is_ref(tstr) == 1 {
                if node_kind(pool, init) == 90 || node_kind(pool, init) == 91 {
                    warns = warns + own_register_borrow_expr(pool, init, own, fn_name, vname, scope_depth, 1);
                } else if node_kind(pool, init) == 7 && str_eq(node_field(pool, init, 1), "arena_alloc") == 1 {
                    let a_args: i64 = node_field(pool, init, 2);
                    if list_len(pool, a_args) > 0 && node_kind(pool, list_get(pool, a_args, 0)) == 3 {
                        let arena_name: str = node_field(pool, list_get(pool, a_args, 0), 1);
                        let arena_key: str = str_concat("@arena:", arena_name);
                        own_inc_shared(own, arena_key);
                        own_set_ref_target(own, vname, arena_key);
                        own_set_ref_kind(own, vname, 0);
                        own_set_scope(own, vname, scope_depth);
                    };
                } else if node_kind(pool, init) == 3 {
                    let src: str = node_field(pool, init, 1);
                    let st: str = own_get_type(own, src);
                    if type_is_ref(st) == 1 {
                        own_copy_ref_binding(own, src, vname, scope_depth);
                        if type_is_mut_ref(st) == 1 {
                            own_set_ref_target(own, src, "");
                            own_set_ref_kind(own, src, 0);
                            own_set(own, src, 2);
                        };
                    };
                };
                let escape_root: str = expr_escape_root(pool, init, own);
                if str_len(escape_root) > 0 && own_get_scope(own, escape_root) > scope_depth {
                    warns = warns + own_diag(own, fn_name, "OWN-010", str_concat("cannot let reference to inner-scope value '", str_concat(escape_root, "' escape its scope")), escape_root);
                };
            } else if node_kind(pool, init) == 3 {
                let src: str = node_field(pool, init, 1);
                let mut st: str = own_get_type(own, src);
                if str_len(st) == 0 { st = tstr; };
                if str_len(st) == 0 {
                    let hinted_box: str = own_box_hint(own, fn_name, vname);
                    if str_len(hinted_box) > 0 { st = hinted_box; };
                };
                if own_binding_move_type(st, pool, structs, enums) == 1 {
                    if own_has_shared_overlap(own, src) == 1 || own_has_mut_overlap(own, src) == 1 {
                        warns = warns + own_diag(own, fn_name, "OWN-003", str_concat("cannot move '", str_concat(src, "': value is borrowed")), src);
                    } else {
                        own_set(own, src, 2);
                    };
                };
            };
            own_set(own, vname, 1);
        } else {
            own_set(own, vname, 0);
        };
        own_set_type(own, vname, tstr);
        return warns;
    };
    if kind == 21 {
        let lhs: i64 = node_field(pool, nid, 1);
        let rhs: i64 = node_field(pool, nid, 2);
        warns = warns + check_expr(pool, rhs, own, structs, enums, fn_name);
        // v0.3.81 safety net: assignment LHS shapes that aren't yet
        // supported. Pre-v0.3.81 these segfaulted the compiler with
        // ACCESS_VIOLATION because downstream code in lower_stmt
        // assumed the LHS was a var-ref (kind 3) or field-access
        // (kind 9) and treated other node-ids as string offsets.
        // Kind 10 = indexing (`v[i] = X`); other kinds = tuple/literal/
        // computed expressions that have no addressable storage.
        let lhs_kind_check: i64 = node_kind(pool, lhs);
        // v0.3.124: kind-10 indexed assignment now lowered to vec_set
        // in lower_stmt; the prior diag-only stub here is no longer
        // needed.
        if lhs_kind_check != 3 && lhs_kind_check != 9 && lhs_kind_check != 10 {
            print("ERROR: assignment to this LHS form is not supported (only var-ref `x = ...`, field-access `obj.f = ...`, and indexed `v[i] = ...` are recognized; tuple destructuring assignment / computed-expression LHS is not). The pre-v0.3.81 compiler would segfault on this shape.");
            return warns + 1;
        };
        if node_kind(pool, lhs) == 3 {
            let lname: str = node_field(pool, lhs, 1);
            if own_get_mutable(own, lname) == 0 && own_get_param(own, lname) == 0 {
                warns = warns + own_diag(own, fn_name, "OWN-008", str_concat("cannot assign to immutable binding '", str_concat(lname, "'")), lname);
            };
            own_release_ref(own, lname);
            if node_kind(pool, rhs) == 90 || node_kind(pool, rhs) == 91 {
                warns = warns + own_register_borrow_expr(pool, rhs, own, fn_name, lname, scope_depth, 1);
                let escape_root: str = expr_escape_root(pool, rhs, own);
                if str_len(escape_root) > 0 && own_get_scope(own, escape_root) > scope_depth {
                    warns = warns + own_diag(own, fn_name, "OWN-010", str_concat("cannot let reference to inner-scope value '", str_concat(escape_root, "' escape its scope")), escape_root);
                };
            } else if node_kind(pool, rhs) == 3 {
                let src: str = node_field(pool, rhs, 1);
                let mut st: str = own_get_type(own, src);
                if str_len(st) == 0 { st = own_get_type(own, lname); };
                if str_len(st) == 0 {
                    let hinted_box: str = own_box_hint(own, fn_name, lname);
                    if str_len(hinted_box) > 0 { st = hinted_box; };
                };
                if type_is_ref(st) == 1 {
                    own_copy_ref_binding(own, src, lname, scope_depth);
                    if type_is_mut_ref(st) == 1 {
                        own_set_ref_target(own, src, "");
                        own_set_ref_kind(own, src, 0);
                        own_set(own, src, 2);
                    };
                } else if own_binding_move_type(st, pool, structs, enums) == 1 {
                    if own_has_shared_overlap(own, src) == 1 || own_has_mut_overlap(own, src) == 1 {
                        warns = warns + own_diag(own, fn_name, "OWN-003", str_concat("cannot move '", str_concat(src, "': value is borrowed")), src);
                    } else {
                        own_set(own, src, 2);
                    };
                };
            };
            own_set(own, lname, 1);
            return warns;
        };
        if node_kind(pool, lhs) == 9 {
            let recv: i64 = node_field(pool, lhs, 1);
            // v0.3.80 safety net: nested field assignment
            // (`outer.inner.field = X`) was crashing the compiler with
            // a segfault during the ownership/type check pass. Detect
            // the nested kind-9-on-kind-9 LHS and emit a clear
            // diagnostic instead of crashing. The actual feature
            // (deep field-path mutation) requires a get-modify-set
            // lowering tracked for a future ship.
            if node_kind(pool, recv) == 9 {
                print("ERROR: nested struct field assignment is not yet supported (e.g. `outer.inner.field = X`). Workaround: copy the inner struct to a local, mutate the local, then assign it back: `let mut tmp = outer.inner; tmp.field = X; outer.inner = tmp;`. Tracked for a future ship — get-modify-set lowering needed.");
                return warns + 1;
            };
            if node_kind(pool, recv) == 3 && type_is_shared_ref(own_get_type(own, node_field(pool, recv, 1))) == 1 {
                let rname: str = node_field(pool, recv, 1);
                warns = warns + own_diag(own, fn_name, "OWN-006", str_concat("cannot assign through shared reference '", str_concat(rname, "'")), rname);
                return warns;
            };
            let mut recv_is_mut_ref: i64 = 0;
            if node_kind(pool, recv) == 3 && type_is_mut_ref(own_get_type(own, node_field(pool, recv, 1))) == 1 { recv_is_mut_ref = 1; };
            if recv_is_mut_ref == 0 {
                let key: str = expr_borrow_key(pool, lhs, own);
                if own_has_shared_overlap(own, key) == 1 || own_has_mut_overlap(own, key) == 1 {
                    let root: str = expr_root_name(pool, lhs, own);
                    warns = warns + own_diag(own, fn_name, "OWN-007", str_concat("cannot assign to borrowed location '", str_concat(key, "'")), root);
                };
            };
        };
        return warns;
    };
    if kind == 22 {
        let val: i64 = node_field(pool, nid, 1);
        if val >= 0 {
            warns = warns + check_expr(pool, val, own, structs, enums, fn_name);
            let escape_root: str = expr_escape_root(pool, val, own);
            if str_len(escape_root) > 0 && own_get_param(own, escape_root) == 0 {
                warns = warns + own_diag(own, fn_name, "OWN-009", str_concat("cannot return reference to local value '", str_concat(escape_root, "'")), escape_root);
            };
        };
        return warns;
    };
    if kind == 23 {
        warns = warns + check_expr(pool, node_field(pool, nid, 1), own, structs, enums, fn_name);
        let snap: Vec<i32> = own_snapshot(own);
        own_set_cur_scope(own, scope_depth + 1);
        warns = warns + check_stmts(pool, node_field(pool, nid, 2), own, structs, enums, fn_name);
        own_release_scope(own, scope_depth + 1);
        own_set_cur_scope(own, scope_depth);
        let then_state: Vec<i32> = own_snapshot(own);
        own_restore(own, snap);
        vec_free(snap);
        let enode: i64 = node_field(pool, nid, 3);
        if enode >= 0 {
            own_set_cur_scope(own, scope_depth + 1);
            warns = warns + check_stmts(pool, enode, own, structs, enums, fn_name);
            own_release_scope(own, scope_depth + 1);
            own_set_cur_scope(own, scope_depth);
        };
        let else_state: Vec<i32> = own_snapshot(own);
        own_merge_moved(own, then_state, else_state);
        vec_free(then_state);
        vec_free(else_state);
        return warns;
    };
    if kind == 24 {
        warns = warns + check_expr(pool, node_field(pool, nid, 1), own, structs, enums, fn_name);
        own_set_cur_scope(own, scope_depth + 1);
        warns = warns + check_stmts(pool, node_field(pool, nid, 2), own, structs, enums, fn_name);
        own_release_scope(own, scope_depth + 1);
        own_set_cur_scope(own, scope_depth);
        return warns;
    };
    if kind == 25 {
        return check_expr(pool, node_field(pool, nid, 1), own, structs, enums, fn_name);
    };
    if kind == 28 {
        let loop_var: str = node_field(pool, nid, 1);
        own_set(own, loop_var, 1);
        own_set_type(own, loop_var, "i64");
        own_set_mutable(own, loop_var, 1);
        own_set_scope(own, loop_var, scope_depth + 1);
        own_set_param(own, loop_var, 0);
        own_set_cur_scope(own, scope_depth + 1);
        warns = warns + check_stmts(pool, node_field(pool, nid, 4), own, structs, enums, fn_name);
        own_release_scope(own, scope_depth + 1);
        own_set_cur_scope(own, scope_depth);
        return warns;
    };
    if kind == 49 {
        let loop_var: str = node_field(pool, nid, 1);
        own_set(own, loop_var, 1);
        own_set_type(own, loop_var, "Vec");
        own_set_mutable(own, loop_var, 1);
        own_set_scope(own, loop_var, scope_depth + 1);
        own_set_param(own, loop_var, 0);
        warns = warns + check_expr(pool, node_field(pool, nid, 2), own, structs, enums, fn_name);
        own_set_cur_scope(own, scope_depth + 1);
        warns = warns + check_stmts(pool, node_field(pool, nid, 3), own, structs, enums, fn_name);
        own_release_scope(own, scope_depth + 1);
        own_set_cur_scope(own, scope_depth);
        return warns;
    };
    if kind == 38 {
        let source_text: str = own_source(own);
        let diag_vec: Vec<i32> = own_diags(own);
        warns = warns + check_expr(pool, node_field(pool, nid, 1), own, structs, enums, fn_name);
        let arms: i64 = node_field(pool, nid, 2);
        let ac: i64 = list_len(pool, arms);
        let snap: Vec<i32> = own_snapshot(own);
        let mut has_wildcard: i64 = 0;
        let mut wildcard_idx: i64 = 0 - 1;
        let mut ai: i64 = 0;
        while ai < ac {
            let arm_nid: i64 = list_get(pool, arms, ai);
            own_restore(own, snap);
            let ename: str = node_field(pool, arm_nid, 1);
            // v0.4.215: a `__wild` arm (`_ => ...` or var-binder
            // `x => ...`) is only an exhaustive catch-all when it
            // carries NO guard. With a guard (`x if cond => ...`)
            // the arm only matches when the guard evaluates true,
            // so following arms remain reachable for the
            // guard-fail case. Pre-fix MATCH-002 false-fired on
            // common idioms like `match n { x if x < 0 => -1, 0
            // => 0, x if x < 100 => 1, _ => 2 }` because arm 0's
            // `x if x < 0` was treated as exhaustive (wildcard
            // ename) and arms 1-3 flagged unreachable.
            // Closes findings/inbox/2026-04-30-match-002-false-positive-on-guarded-arm.md.
            if str_eq(ename, "__wild") {
                let v215_guard: i64 = node_field(pool, arm_nid, 5);
                if v215_guard <= 0 {
                    has_wildcard = 1;
                    if wildcard_idx < 0 { wildcard_idx = ai; };
                };
            };
            // RFC-0023 §3.1 + MATCH-007: range pattern with bounds in
            // wrong order (LO > HI) — would never match.
            if str_eq(ename, "__range_bad") {
                // v0.4.43 (RFC-0020 Phase 3, v0.2 deferred row #8):
                // span migration — use line + col instead of line-only.
                match_diag_at(diag_vec, source_text, pool, nid, "warning", "MATCH-007", str_concat("range pattern bounds in wrong order at arm ", str_concat(str_from_int(ai + 1), " — pattern can never match")), fn_name);
                warns = warns + 1;
            };
            let binding: str = node_field(pool, arm_nid, 3);
            // For __range / __range_bad the `binding` field holds the
            // string-encoded high bound (e.g. "9"), not a variable name.
            // Skip the binding-as-variable scope setup for those arms.
            let is_range: i64 = if str_eq(ename, "__range") == 1 || str_eq(ename, "__range_bad") == 1 { 1 } else { 0 };
            if is_range == 0 && str_len(binding) > 0 {
                own_set(own, binding, 1);
                own_set_type(own, binding, "i64");
                own_set_mutable(own, binding, 0);
                own_set_scope(own, binding, scope_depth + 1);
                own_set_param(own, binding, 0);
            };
            own_set_cur_scope(own, scope_depth + 1);
            warns = warns + check_stmts(pool, node_field(pool, arm_nid, 4), own, structs, enums, fn_name);
            own_release_scope(own, scope_depth + 1);
            own_set_cur_scope(own, scope_depth);
            ai = ai + 1;
        };
        vec_free(snap);
        // RFC-0016 phase 5 — MATCH-002: any arm following a wildcard is
        // unreachable (the wildcard already captures every value).
        if wildcard_idx >= 0 && wildcard_idx < ac - 1 {
            // v0.4.43 span migration: line+col via diag_add_ex.
            match_diag_at(diag_vec, source_text, pool, nid, "warning", "MATCH-002", str_concat("unreachable match arm after wildcard at arm ", str_concat(str_from_int(wildcard_idx + 1), str_concat(" of ", str_from_int(ac)))), fn_name);
            warns = warns + 1;
        };
        if has_wildcard == 0 && ac > 0 {
            let first_arm: i64 = list_get(pool, arms, 0);
            let first_ename: str = node_field(pool, first_arm, 1);
            // v0.4.109: int/str match-as-stmt without wildcard.
            // Mirror of the match-as-expr check at line 9757; same
            // silent-fall-through hazard (statement form quietly did
            // nothing for unmatched values pre-v0.4.109).
            if (str_eq(first_ename, "__int") == 1 || str_eq(first_ename, "__str") == 1) && has_wildcard == 0 {
                let kind_label_s: str = if str_eq(first_ename, "__int") == 1 { "integer" } else { "string" };
                let msg_int_s: str = str_concat("non-exhaustive ", str_concat(kind_label_s, str_concat(" match: ", str_concat(str_from_int(ac), " arms with no `_` wildcard. The set of values is unbounded so unmatched cases silently no-op'd pre-v0.4.109 — add a `_ => { … }` arm to cover them explicitly."))));
                match_diag_at(diag_vec, source_text, pool, nid, "error", "MATCH-001", msg_int_s, fn_name);
                warns = warns + 1;
            };
            if str_eq(first_ename, "__int") == 0 && str_eq(first_ename, "__str") == 0 && str_eq(first_ename, "__wild") == 0 {
                let ei: i64 = enum_find(pool, enums, first_ename);
                if ei >= 0 {
                    let e_nid: i64 = vec_get(enums, ei);
                    let vlist: i64 = node_field(pool, e_nid, 2);
                    let vcnt: i64 = list_len(pool, vlist);
                    if ac < vcnt {
                        // v0.4.43 span migration: line+col via diag_add_ex.
                        // RFC-0016 phase 5 — MATCH-001 (canonical) alongside
                        // legacy TYP-001 for backwards compatibility.
                        let msg: str = str_concat("non-exhaustive match: ", str_concat(str_from_int(ac), str_concat(" arms for enum with ", str_concat(str_from_int(vcnt), " variants"))));
                        // v0.4.56: NUC-FEEDBACK silent-miscompute close.
                        // Pre-fix non-exhaustive match silently returned 0
                        // for unmatched scrutinee values (e.g. `match
                        // Color::Green { Color::Red => 1 }` returned 0).
                        // Adopters writing the canonical Rust idiom got
                        // a quiet wrong result. MATCH-001 was already in
                        // the error-tier code list but emitted as warning
                        // severity, so the build didn't halt. Promote
                        // both diags to "error" severity so MATCH-001
                        // halts the build like every other TYP-* error.
                        let canon_msg: str = str_concat(msg, ". Workaround: add a `_ => default_value,` arm or list every variant explicitly.");
                        // v0.5.18: MATCH-001 only — see expression-context
                        // sister site at line ~12517 for rationale.
                        match_diag_at(diag_vec, source_text, pool, nid, "error", "MATCH-001", canon_msg, fn_name);
                        warns = warns + 1;
                    };
                };
            };
        };
        return warns;
    };
    return warns;
}

fn check_stmts(pool: Vec<i32>, lid: i64, own: Vec<i32>, structs: Vec<i32>, enums: Vec<i32>, fn_name: str) -> i64 {
    if lid < 0 || lid >= vec_len(pool) { return 0; };
    let cnt: i64 = list_len(pool, lid);
    let mut i: i64 = 0; let mut warns: i64 = 0;
    while i < cnt { warns = warns + check_stmt(pool, list_get(pool, lid, i), own, structs, enums, fn_name); i = i + 1; };
    return warns;
}

fn check_fn(pool: Vec<i32>, fn_nid: i64, structs: Vec<i32>, enums: Vec<i32>, diags: Vec<i32>, source: str) -> i64 {
    let fn_name: str = node_field(pool, fn_nid, 1);
    let plist: i64 = node_field(pool, fn_nid, 2);
    let body: i64 = node_field(pool, fn_nid, 4);
    if body < 0 || body >= vec_len(pool) { return 0; };
    let pc: i64 = list_len(pool, plist);
    let mut own: Vec<i32> = own_new();
    own_set_type(own, "__diags", diags);
    own_set_type(own, "__source", source);
    own_set_type(own, "__shared_keys", Vec::new());
    own_set_type(own, "__mut_keys", Vec::new());
    own_set_type(own, "__scope_keys", Vec::new());
    own_set_i(own, "cur_scope", 0);
    let mut pi: i64 = 0;
    while pi < pc {
        let pnid: i64 = list_get(pool, plist, pi);
        let pname: str = node_field(pool, pnid, 1);
        let ptype: str = node_field(pool, pnid, 2);
        own_set(own, pname, 1);
        own_set_type(own, pname, ptype);
        own_set_mutable(own, pname, 0);
        own_set_scope(own, pname, 0);
        own_set_param(own, pname, 1);
        if type_is_ref(ptype) == 1 {
            own_set_ref_target(own, pname, pname);
            if type_is_mut_ref(ptype) == 1 { own_set_ref_kind(own, pname, 1); }
            else { own_set_ref_kind(own, pname, 0); };
        };
        pi = pi + 1;
    };
    let w: i64 = check_stmts(pool, body, own, structs, enums, fn_name);
    let rtype: str = node_field(pool, fn_nid, 3);
    if type_is_ref(rtype) == 1 {
        let body_cnt: i64 = list_len(pool, body);
        if body_cnt > 0 {
            let last_stmt: i64 = list_get(pool, body, body_cnt - 1);
            let last_kind: i64 = node_kind(pool, last_stmt);
            if last_kind == 25 || last_kind == 23 || last_kind == 52 {
                let mut escape_root: str = "";
                if last_kind == 25 { escape_root = expr_escape_root(pool, node_field(pool, last_stmt, 1), own); }
                else { escape_root = expr_escape_root(pool, last_stmt, own); };
                if str_len(escape_root) > 0 && own_get_param(own, escape_root) == 0 {
                    own_diag(own, fn_name, "OWN-009", str_concat("cannot return reference to local value '", str_concat(escape_root, "'")), escape_root);
                };
            };
        };
    };
    return w;
}

// =====================================================
// EFFECT CHECKER (S11.6)
// =====================================================
fn is_tainted_type(tstr: str) -> i64 {
    // Hot path: was allocating a 7-byte substring per call.
    if str_starts_with(tstr, "tainted") == 1 { return 1; };
    return 0;
}
fn taint_inner_type(t: str) -> str {
    let slen: i64 = str_len(t);
    if str_starts_with(t, "tainted<") == 1 { return str_substring(t, 8, slen - 1); };
    return t;
}
fn types_compatible(expected: str, actual: str) -> i64 {
    if str_len(expected) == 0 || str_len(actual) == 0 { return 1; };
    if str_eq(expected, "_") == 1 { return 1; };
    if str_eq(actual, "_") == 1 { return 1; };
    if str_eq(expected, actual) == 1 { return 1; };
    let ebase: str = type_base_name(expected);
    let abase: str = type_base_name(actual);
    if str_eq(ebase, abase) == 1 {
        if str_eq(ebase, "Option") == 1 || str_eq(ebase, "Vec") == 1 {
            let earg: str = type_first_arg(expected);
            let aarg: str = type_first_arg(actual);
            if str_eq(ebase, "Vec") == 1 && (vec_element_type_is_legacy_cell(earg) == 1 || vec_element_type_is_legacy_cell(aarg) == 1) {
                return 1;
            };
            if str_len(earg) > 0 && str_len(aarg) > 0 {
                return types_compatible(earg, aarg);
            };
        };
        if str_eq(ebase, "Result") == 1 {
            let eok: str = type_first_arg(expected);
            let aok: str = type_first_arg(actual);
            if str_len(eok) > 0 && str_len(aok) > 0 {
                if types_compatible(eok, aok) == 0 { return 0; };
            };
            let eerr: str = generic_second_type(expected);
            let aerr: str = generic_second_type(actual);
            if str_len(eerr) > 0 && str_len(aerr) > 0 {
                if types_compatible(eerr, aerr) == 0 { return 0; };
            };
            return 1;
        };
    };
    if str_eq(ebase, "Vec") == 1 && (str_eq(actual, "i64") == 1 || str_eq(actual, "i32") == 1 || str_eq(actual, "ptr") == 1) { return 1; };
    if str_eq(abase, "Vec") == 1 && (str_eq(expected, "i64") == 1 || str_eq(expected, "i32") == 1 || str_eq(expected, "ptr") == 1) { return 1; };
    // T1.2 (v0.2.336): Option/Result constructors lower to a Vec<i32>
    // tag-payload runtime representation. Allow them to flow into
    // Vec / Vec<i32> / Vec<i64> return types.
    // v0.4.46: switched the actual-side bare-name checks to abase
    // (and expected-side to ebase) so the compat survives v0.4.45's
    // Phase 2 change which now returns `Option<T>` / `Result<T>`
    // (with generic) from constructor expressions instead of bare
    // `Option` / `Result`. Pre-fix this caused
    // tests/features/option_result_basic.nr to fail TYP-010 because
    // `Ok(100)` typed as `Result<i64>` no longer matched `actual ==
    // "Result"`. Switching to abase strips the generic for the
    // family-equality check while preserving the rest of the
    // type-prop information for downstream Phase 3+ work.
    if (str_eq(abase, "Option") == 1 || str_eq(abase, "Result") == 1) &&
       (str_eq(ebase, "Vec") == 1 || str_eq(ebase, "Option") == 1 || str_eq(ebase, "Result") == 1) { return 1; };
    if (str_eq(ebase, "Option") == 1 || str_eq(ebase, "Result") == 1) &&
       (str_eq(abase, "Vec") == 1 || str_eq(abase, "Option") == 1 || str_eq(abase, "Result") == 1) { return 1; };
    // Option ↔ Result interop (rare but useful for ? in ad-hoc contexts).
    if (str_eq(ebase, "Option") == 1 && str_eq(abase, "Result") == 1) { return 1; };
    if (str_eq(ebase, "Result") == 1 && str_eq(abase, "Option") == 1) { return 1; };
    if (str_eq(expected, "i64") == 1 || str_eq(expected, "i32") == 1) && str_eq(actual, "bool") == 1 { return 1; };
    if str_eq(expected, "bool") == 1 && (str_eq(actual, "i64") == 1 || str_eq(actual, "i32") == 1) { return 1; };
    if str_eq(expected, "Int") == 1 && (str_eq(actual, "i32") == 1 || str_eq(actual, "i64") == 1) { return 1; };
    if str_eq(expected, "Float") == 1 && (str_eq(actual, "f64") == 1 || str_eq(actual, "i32") == 1 || str_eq(actual, "i64") == 1) { return 1; };
    if str_len(ebase) >= 2 && (str_char_at(ebase, 0) == 105 || str_char_at(ebase, 0) == 117) {
        let mut digits_only: i64 = 1;
        let mut di: i64 = 1;
        while di < str_len(ebase) {
            let dc: i64 = str_char_at(ebase, di);
            if dc < 48 || dc > 57 { digits_only = 0; };
            di = di + 1;
        };
        if digits_only == 1 && (str_eq(actual, "i32") == 1 || str_eq(actual, "i64") == 1 || str_eq(actual, "f64") == 1) { return 1; };
    };
    // T1.1 Phase 6: narrow integer → i64/i32 widening for argument
    // passing. Storage is i64 anyway, so a u8 / u16 / i8 / i16 / u32
    // can be passed as an i64 / i32 argument without loss.
    if (str_eq(expected, "i64") == 1 || str_eq(expected, "i32") == 1) {
        if str_eq(actual, "i8") == 1 || str_eq(actual, "i16") == 1 ||
           str_eq(actual, "u8") == 1 || str_eq(actual, "u16") == 1 ||
           str_eq(actual, "u32") == 1 { return 1; };
    };
    // T1.1 Phase 2: f32 / f16 / bf16 accept f64 literals (the parser
    // emits all float literals as f64; lowering inserts the conversion).
    if (str_eq(expected, "f32") == 1 || str_eq(expected, "f16") == 1 || str_eq(expected, "bf16") == 1)
       && (str_eq(actual, "f64") == 1 || str_eq(actual, "i32") == 1 || str_eq(actual, "i64") == 1) { return 1; };
    if str_len(expected) == 1 {
        let c: i64 = str_char_at(expected, 0);
        if c >= 65 && c <= 90 { return 1; };
    };
    if str_len(actual) == 1 {
        let c: i64 = str_char_at(actual, 0);
        if c >= 65 && c <= 90 { return 1; };
    };
    if str_eq(strip_spaces(expected), strip_spaces(actual)) == 1 { return 1; };
    if (str_eq(expected, "i64") == 1 || str_eq(expected, "i32") == 1 || str_eq(expected, "f64") == 1) &&
       (str_eq(actual, "i64") == 1 || str_eq(actual, "i32") == 1 || str_eq(actual, "f64") == 1) { return 1; };
    if is_tainted_type(expected) == 1 && is_tainted_type(actual) == 0 {
        if str_eq(strip_spaces(taint_inner_type(expected)), strip_spaces(actual)) == 1 { return 1; };
    };
    if is_tainted_type(expected) == 0 && is_tainted_type(actual) == 1 { return 0; };
    if type_is_unit(expected) == 1 || type_is_unit(actual) == 1 { return 0; };
    if (str_eq(ebase, "HashMap") == 1 || str_eq(ebase, "HashSet") == 1
        || str_eq(ebase, "BTreeMap") == 1 || str_eq(ebase, "BTreeSet") == 1
        || str_eq(ebase, "VecDeque") == 1)
        && (str_eq(actual, "i64") == 1 || str_eq(actual, "i32") == 1 || str_eq(actual, "ptr") == 1) {
        return 1;
    };
    if (str_eq(abase, "HashMap") == 1 || str_eq(abase, "HashSet") == 1
        || str_eq(abase, "BTreeMap") == 1 || str_eq(abase, "BTreeSet") == 1
        || str_eq(abase, "VecDeque") == 1)
        && (str_eq(expected, "i64") == 1 || str_eq(expected, "i32") == 1 || str_eq(expected, "ptr") == 1) {
        return 1;
    };
    if str_eq(ebase, abase) == 1 { return 1; };
    return 0;
}
fn dyn_trait_name(t: str) -> str {
    let s: str = t;
    if str_starts_with(s, "dyn ") == 1 {
        return strip_spaces(str_substring(s, 4, str_len(s)));
    };
    return "";
}
fn box_dyn_trait_name(t: str) -> str {
    let s: str = t;
    let dyn_pos: i64 = str_index_of(s, "dyn ");
    if dyn_pos >= 0 && str_starts_with(s, "Box<") == 1 {
        let mut end: i64 = str_len(s);
        if end > 0 && str_char_at(s, end - 1) == 62 { end = end - 1; };
        return strip_spaces(str_substring(s, dyn_pos + 4, end));
    };
    if str_starts_with(s, "Box<") == 1 {
        return dyn_trait_name(type_first_arg(s));
    };
    return "";
}
fn type_implements_trait(pool: Vec<i32>, prog: i64, type_name: str, trait_name: str) -> i64 {
    let tbase: str = type_base_name(type_name);
    let cnt: i64 = list_len(pool, prog);
    let mut i: i64 = 0;
    while i < cnt {
        let nid: i64 = list_get(pool, prog, i);
        if node_kind(pool, nid) == 45 &&
           str_eq(node_field(pool, nid, 1), trait_name) == 1 &&
           str_eq(type_base_name(node_field(pool, nid, 2)), tbase) == 1 {
            return 1;
        };
        i = i + 1;
    };
    return 0;
}
fn types_compatible_context(pool: Vec<i32>, prog: i64, expected: str, actual: str) -> i64 {
    if types_compatible(expected, actual) == 1 { return 1; };
    let trait_name: str = box_dyn_trait_name(expected);
    if str_len(trait_name) > 0 && str_starts_with(strip_spaces(actual), "Box<") == 1 {
        let actual_arg: str = type_first_arg(actual);
        if str_len(actual_arg) > 0 && str_len(dyn_trait_name(actual_arg)) == 0 {
            return type_implements_trait(pool, prog, actual_arg, trait_name);
        };
    };
    return 0;
}
fn target_root_name(target: str) -> str {
    let mut i: i64 = 0;
    while i < str_len(target) {
        if str_char_at(target, i) == 46 { return str_substring(target, 0, i); };
        i = i + 1;
    };
    return target;
}
fn expr_escape_root(pool: Vec<i32>, nid: i64, own: Vec<i32>) -> str {
    if nid < 0 || nid >= vec_len(pool) { return ""; };
    let kind: i64 = node_kind(pool, nid);
    if kind == 90 || kind == 91 {
        let root: str = expr_root_name(pool, node_field(pool, nid, 1), own);
        if own_get_param(own, root) == 0 { return root; };
        return "";
    };
    if kind == 3 {
        let name: str = node_field(pool, nid, 1);
        if type_is_ref(own_get_type(own, name)) == 1 {
            let target: str = own_get_ref_target(own, name);
            if str_len(target) > 0 {
                let root: str = target_root_name(target);
                if own_get_param(own, root) == 0 { return root; };
                return "";
            };
            if own_get_param(own, name) == 0 { return name; };
        };
        return "";
    };
    if kind == 52 {
        let body: i64 = node_field(pool, nid, 2);
        if body < 0 || body >= vec_len(pool) { return ""; };
        let cnt: i64 = list_len(pool, body);
        if cnt == 0 { return ""; };
        let last_stmt: i64 = list_get(pool, body, cnt - 1);
        let sk: i64 = node_kind(pool, last_stmt);
        if sk == 22 || sk == 25 { return expr_escape_root(pool, node_field(pool, last_stmt, 1), own); };
        if sk == 23 { return expr_escape_root(pool, last_stmt, own); };
        return "";
    };
    if kind == 23 {
        let mut root: str = expr_escape_root(pool, node_field(pool, nid, 2), own);
        if str_len(root) > 0 { return root; };
        let enode: i64 = node_field(pool, nid, 3);
        if enode >= 0 { return expr_escape_root(pool, enode, own); };
        return "";
    };
    return "";
}

fn builtin_rtype(name: str) -> str {
    if str_eq(name, "ambient_scheduler") == 1 { return "SchedulerCap"; };
    if str_eq(name, "ambient_random") == 1 { return "RandomCap"; };
    if str_eq(name, "random_uniform") == 1 { return "f64"; };
    if str_eq(name, "random_normal") == 1 { return "f64"; };
    if str_eq(name, "arena_new") == 1 { return "Arena"; };
    if str_eq(name, "arena_alloc") == 1 { return "&i64"; };
    if str_eq(name, "device_alloc") == 1 { return "DeviceBuffer"; };
    if str_eq(name, "device_transfer") == 1 { return "DeviceBuffer"; };
    if str_eq(name, "tensor_view") == 1 { return "i64"; };
    if str_eq(name, "max_depth_enter") == 1 || str_eq(name, "max_depth_exit") == 1 { return "i64"; };
    if str_eq(name, "channel") == 1 { return "i64"; };
    if str_eq(name, "rwlock_new") == 1 || str_eq(name, "rwlock_read") == 1 || str_eq(name, "rwlock_write") == 1 || str_eq(name, "rwlock_unlock") == 1 { return "i64"; };
    if str_eq(name, "cancel_token_new") == 1 || str_eq(name, "cancel_token_cancel") == 1 { return "i64"; };
    if is_atomic_ordered_builtin(name) == 1 { return "i64"; };
    if str_eq(name, "print") == 1 || str_eq(name, "print_int") == 1 || str_eq(name, "print_f64") == 1 || str_eq(name, "print_bool") == 1 || str_eq(name, "putchar") == 1 { return "void"; };
    if str_eq(name, "rng_seed") == 1 || str_eq(name, "device_free") == 1 || str_eq(name, "arena_destroy") == 1 || str_eq(name, "arena_reset") == 1 { return "void"; };
    return "";
}

fn source_line(source: str, line: i64) -> str {
    let slen: i64 = str_len(source);
    let mut cur: i64 = 1;
    let mut start: i64 = 0;
    let mut i: i64 = 0;
    while i < slen {
        if cur == line {
            let mut end: i64 = i;
            while end < slen && str_char_at(source, end) != 10 { end = end + 1; };
            return str_substring(source, start, end);
        };
        if str_char_at(source, i) == 10 { cur = cur + 1; start = i + 1; };
        i = i + 1;
    };
    if cur == line { return str_substring(source, start, slen); };
    return "";
}
fn line_has_unit_literal(source: str, fn_name: str, symbol: str) -> i64 {
    let line: i64 = find_in_source(source, fn_name, symbol);
    let txt: str = source_line(source, line);
    let mut i: i64 = 0;
    while i < str_len(txt) {
        if str_char_at(txt, i) == 123 { return 1; };
        i = i + 1;
    };
    return 0;
}
fn line_contains_text(source: str, fn_name: str, symbol: str, text: str) -> i64 {
    let line: i64 = find_in_source(source, fn_name, symbol);
    let txt: str = source_line(source, line);
    let tlen: i64 = str_len(text);
    let llen: i64 = str_len(txt);
    if llen < tlen { return 0; };
    let mut i: i64 = 0;
    while i <= llen - tlen {
        if str_eq_at(txt, i, text) == 1 { return 1; };
        i = i + 1;
    };
    return 0;
}
fn source_box_binding_type(source: str, fn_name: str, name: str) -> str {
    let target: str = str_concat("let ", str_concat(name, ": Box<"));
    let tlen: i64 = str_len(target);
    let slen: i64 = str_len(source);
    let mut i: i64 = 0;
    while i <= slen - tlen {
        if str_eq_at(source, i, target) == 1 {
            let mut end: i64 = i + tlen;
            while end < slen && str_char_at(source, end) != 62 { end = end + 1; };
            if end < slen { return str_concat("Box<", str_concat(str_substring(source, i + tlen, end), ">")); };
        };
        i = i + 1;
    };
    return "";
}
fn own_diag_ex(own: Vec<i32>, fn_name: str, code: str, message: str, symbol: str, checker: str) -> i64 {
    let src: str = own_source(own);
    let diags: Vec<i32> = own_diags(own);
    let loc: Vec<i32> = find_linecol_in_source(src, fn_name, symbol);
    diag_add_ex(diags, "error", checker, code, message, fn_name, vec_get(loc, 0), vec_get(loc, 1), "");
    return 1;
}
fn own_diag(own: Vec<i32>, fn_name: str, code: str, message: str, symbol: str) -> i64 {
    return own_diag_ex(own, fn_name, code, message, symbol, "ownership");
}
fn own_box_hint(own: Vec<i32>, fn_name: str, name: str) -> str {
    let cache_key: str = str_concat("__box_hint_", name);
    let cached: str = own_get_s(own, cache_key);
    if str_eq(cached, "_none_") == 1 { return ""; };
    if str_len(cached) > 0 { return cached; };
    let source_text: str = own_source(own);
    let guessed: str = source_box_binding_type(source_text, fn_name, name);
    if str_len(guessed) > 0 {
        own_set_s(own, cache_key, guessed);
        return guessed;
    };
    if line_contains_text(source_text, fn_name, name, "Box<") == 1 {
        own_set_s(own, cache_key, "Box");
        return "Box";
    };
    own_set_s(own, cache_key, "_none_");
    return "";
}
fn own_copy_ref_binding(own: Vec<i32>, src: str, dst: str, scope_depth: i64) -> i64 {
    let target: str = own_get_ref_target(own, src);
    if str_len(target) == 0 { return 0; };
    let kind: i64 = own_get_ref_kind(own, src);
    if kind == 0 { own_inc_shared(own, target); };
    own_set_ref_target(own, dst, target);
    own_set_ref_kind(own, dst, kind);
    own_set_scope(own, dst, scope_depth);
    return 0;
}
fn own_register_borrow_expr(pool: Vec<i32>, nid: i64, own: Vec<i32>, fn_name: str, ref_name: str, scope_depth: i64, persist: i64) -> i64 {
    if nid < 0 || nid >= vec_len(pool) { return 0; };
    let kind: i64 = node_kind(pool, nid);
    if kind != 90 && kind != 91 { return 0; };
    let target_expr: i64 = node_field(pool, nid, 1);
    let key: str = expr_borrow_key(pool, target_expr, own);
    let root: str = expr_root_name(pool, target_expr, own);
    if str_len(key) == 0 || str_len(root) == 0 { return 0; };
    if own_get(own, root) == 2 {
        return own_diag(own, fn_name, "OWN-002", str_concat("cannot borrow moved value '", str_concat(root, "'")), root);
    };
    if kind == 90 {
        if own_has_mut_overlap(own, key) == 1 {
            return own_diag(own, fn_name, "OWN-005", str_concat("cannot shared-borrow '", str_concat(root, "': value is mutably borrowed")), root);
        };
        own_inc_shared(own, key);
        if persist == 1 && str_len(ref_name) > 0 {
            own_set_ref_target(own, ref_name, key);
            own_set_ref_kind(own, ref_name, 0);
            own_set_scope(own, ref_name, scope_depth);
        };
        return 0;
    };
    if own_get_mutable(own, root) == 0 && own_get_param(own, root) == 0 && type_is_mut_ref(own_get_type(own, root)) == 0 {
        return own_diag(own, fn_name, "OWN-011", str_concat("cannot mutably borrow immutable value '", str_concat(root, "'")), root);
    };
    if own_has_mut_overlap(own, key) == 1 || own_has_shared_overlap(own, key) == 1 {
        return own_diag(own, fn_name, "OWN-004", str_concat("cannot mutably borrow '", str_concat(root, "': value is already borrowed")), root);
    };
    own_set_mut_borrow(own, key, 1);
    if persist == 1 && str_len(ref_name) > 0 {
        own_set_ref_target(own, ref_name, key);
        own_set_ref_kind(own, ref_name, 1);
        own_set_scope(own, ref_name, scope_depth);
    };
    return 0;
}

fn tprof_new(enabled: i64) -> Vec<i32> {
    let mut prof: Vec<i32> = Vec::new();
    let mut i: i64 = 0;
    prof.push(enabled);
    while i < 12 {
        prof.push(0);
        i = i + 1;
    };
    return prof;
}
fn tprof_enabled(prof: Vec<i32>) -> i64 {
    if vec_len(prof) == 0 { return 0; };
    return vec_get(prof, 0);
}
fn tprof_start(prof: Vec<i32>) -> i64 {
    if tprof_enabled(prof) == 1 { return now_ms(); };
    return 0;
}
fn tprof_mark(prof: Vec<i32>, count_idx: i64, time_idx: i64, start_ms: i64) -> i64 {
    if tprof_enabled(prof) == 1 {
        vec_set(prof, count_idx, vec_get(prof, count_idx) + 1);
        vec_set(prof, time_idx, vec_get(prof, time_idx) + (now_ms() - start_ms));
    };
    return 0;
}
fn tprof_dump(prof: Vec<i32>) -> i64 {
    if tprof_enabled(prof) == 0 { return 0; };
    print(str_concat("  type profile stmt: ", str_concat(str_from_int(vec_get(prof, 1)), str_concat(" ops / ", str_concat(str_from_int(vec_get(prof, 2)), " ms")))));
    print(str_concat("  type profile env_lookup: ", str_concat(str_from_int(vec_get(prof, 3)), str_concat(" ops / ", str_concat(str_from_int(vec_get(prof, 4)), " ms")))));
    print(str_concat("  type profile sig_lookup: ", str_concat(str_from_int(vec_get(prof, 5)), str_concat(" ops / ", str_concat(str_from_int(vec_get(prof, 6)), " ms")))));
    print(str_concat("  type profile compat: ", str_concat(str_from_int(vec_get(prof, 7)), str_concat(" ops / ", str_concat(str_from_int(vec_get(prof, 8)), " ms")))));
    print(str_concat("  type profile call_expr: ", str_concat(str_from_int(vec_get(prof, 9)), str_concat(" ops / ", str_concat(str_from_int(vec_get(prof, 10)), " ms")))));
    print(str_concat("  type profile box_hint: ", str_concat(str_from_int(vec_get(prof, 11)), str_concat(" ops / ", str_concat(str_from_int(vec_get(prof, 12)), " ms")))));
    return 0;
}
fn type_diag(diags: Vec<i32>, source: str, fn_name: str, symbol: str, code: str, message: str) -> i64 {
    let loc: Vec<i32> = find_linecol_in_source(source, fn_name, symbol);
    return diag_add_ex(diags, "error", "type", code, message, fn_name, vec_get(loc, 0), vec_get(loc, 1), "");
}
fn diag_add_at_or_scan(diags: Vec<i32>, source: str, pool: Vec<i32>, nid: i64, fallback_symbol: str, severity: str, checker: str, code: str, message: str, fn_name: str, related_id: str) -> i64 {
    let sp: i64 = node_get_span(pool, nid);
    if sp >= 0 {
        let lm: Vec<i32> = linemap_build(source);
        return diag_add_ex(diags, severity, checker, code, message, fn_name, linemap_line(lm, sp), linemap_col(lm, sp), related_id);
    };
    let loc: Vec<i32> = find_linecol_in_source(source, fn_name, fallback_symbol);
    return diag_add_ex(diags, severity, checker, code, message, fn_name, vec_get(loc, 0), vec_get(loc, 1), related_id);
}
fn type_diag_at(diags: Vec<i32>, source: str, pool: Vec<i32>, nid: i64, fn_name: str, fallback_symbol: str, code: str, message: str) -> i64 {
    return diag_add_at_or_scan(diags, source, pool, nid, fallback_symbol, "error", "type", code, message, fn_name, "");
}
fn match_diag_at(diags: Vec<i32>, source: str, pool: Vec<i32>, nid: i64, severity: str, code: str, message: str, fn_name: str) -> i64 {
    return diag_add_at_or_scan(diags, source, pool, nid, "match", severity, "type", code, message, fn_name, "");
}
fn sig_new() -> Vec<i32> { return smap_new(); }
fn sig_entry_new(plist: i64, rtype: str, is_extern: i64, gparams: i64) -> Vec<i32> {
    let mut entry: Vec<i32> = Vec::new();
    entry.push(plist);
    entry.push(rtype);
    entry.push(is_extern);
    entry.push(gparams);
    return entry;
}
fn sig_add(sigs: Vec<i32>, name: str, plist: i64, rtype: str, is_extern: i64, gparams: i64) -> i64 {
    return smap_set(sigs, name, sig_entry_new(plist, rtype, is_extern, gparams));
}
fn sig_find(sigs: Vec<i32>, name: str) -> i64 {
    return smap_get(sigs, name);
}
fn sig_plist(sigs: Vec<i32>, name: str) -> i64 {
    let entry: i64 = sig_find(sigs, name);
    if entry < 0 { return 0 - 1; };
    return vec_get(entry, 0);
}
fn sig_rtype(sigs: Vec<i32>, name: str) -> str {
    let entry: i64 = sig_find(sigs, name);
    if entry < 0 { return ""; };
    return vec_get(entry, 1);
}
fn sig_is_extern(sigs: Vec<i32>, name: str) -> i64 {
    let entry: i64 = sig_find(sigs, name);
    if entry < 0 { return 0; };
    return vec_get(entry, 2);
}
fn sig_gparams_from_entry(entry: i64) -> i64 {
    if entry < 0 { return 0 - 1; };
    if vec_len(entry) < 4 { return 0 - 1; };
    return vec_get(entry, 3);
}
fn tenv_new() -> Vec<i32> { return Vec::new(); }
fn tenv_set(env: Vec<i32>, name: str, tstr: str) -> i64 { env.push(name); env.push(tstr); return 0; }
fn tenv_get(env: Vec<i32>, name: str) -> str {
    let v: i64 = sym_get(env, name);
    if v < 0 { return ""; };
    return v;
}
fn tenv_const_key(name: str) -> str {
    return str_concat("__const:", name);
}
fn tenv_set_const_i64(env: Vec<i32>, name: str, val: i64) -> i64 {
    return tenv_set(env, tenv_const_key(name), str_from_int(val));
}
fn tenv_clear_const(env: Vec<i32>, name: str) -> i64 {
    return tenv_set(env, tenv_const_key(name), "");
}
fn tenv_get_const_i64(env: Vec<i32>, name: str) -> str {
    return tenv_get(env, tenv_const_key(name));
}
fn const_i64_result(have: i64, val: i64) -> Vec<i32> {
    let mut r: Vec<i32> = Vec::new();
    r.push(have);
    r.push(val);
    return r;
}
fn const_i64_expr(pool: Vec<i32>, nid: i64, env: Vec<i32>) -> Vec<i32> {
    if nid < 0 || nid >= vec_len(pool) { return const_i64_result(0, 0); };
    let k: i64 = node_kind(pool, nid);
    if k == 1 { return const_i64_result(1, node_field(pool, nid, 1)); };
    if k == 5 {
        let inner: Vec<i32> = const_i64_expr(pool, node_field(pool, nid, 1), env);
        if vec_get(inner, 0) == 1 { return const_i64_result(1, 0 - vec_get(inner, 1)); };
        return const_i64_result(0, 0);
    };
    if k == 3 {
        let cv: str = tenv_get_const_i64(env, node_field(pool, nid, 1));
        if str_len(cv) > 0 { return const_i64_result(1, str_to_int(cv)); };
    };
    return const_i64_result(0, 0);
}
fn tenv_set_pattern_item(env: Vec<i32>, item: str, tstr: str) -> i64 {
    let name: str = pattern_binding_item_name(item);
    if str_len(name) == 0 { return 0; };
    let btype: str = if str_len(tstr) > 0 { tstr } else { "i64" };
    tenv_set(env, name, btype);
    return 0;
}
fn tenv_set_pattern_list(env: Vec<i32>, binding: str, tstr: str) -> i64 {
    let work: str = pattern_after_at_prefix(binding);
    let blen: i64 = str_len(work);
    let mut start: i64 = 0;
    while start < blen {
        let mut end: i64 = start;
        while end < blen && str_char_at(work, end) != 124 { end = end + 1; };
        tenv_set_pattern_item(env, str_substring(work, start, end), tstr);
        start = end + 1;
    };
    return 0;
}
fn tenv_set_struct_pattern(pool: Vec<i32>, structs: Vec<i32>, env: Vec<i32>, sname: str, binding: str) -> i64 {
    let si: i64 = struct_find_type(pool, structs, sname);
    if si < 0 { return 0; };
    let s_nid: i64 = vec_get(structs, si);
    let work: str = pattern_after_at_prefix(binding);
    let blen: i64 = str_len(work);
    let mut start: i64 = 0;
    while start < blen {
        let mut end: i64 = start;
        while end < blen && str_char_at(work, end) != 124 { end = end + 1; };
        let item: str = str_substring(work, start, end);
        let field_name: str = str_before_char_local(item, 58);
        let bind_name: str = pattern_binding_item_name(item);
        if str_len(bind_name) > 0 {
            let ft: str = struct_field_type(pool, s_nid, field_name);
            tenv_set(env, bind_name, if str_len(ft) > 0 { ft } else { "i64" });
        };
        start = end + 1;
    };
    return 0;
}
fn strip_spaces(s: str) -> str {
    // Fast path: most type strings (the dominant caller) have no
    // whitespace. Scan once to detect; if clean, return the input
    // unchanged — no allocation. Only allocate the SB when we
    // actually have characters to strip. The previous version
    // always allocated a SB and a 1-byte substring per non-space
    // character; for a 12-byte type name that was 12 separate
    // allocations even when no whitespace was present.
    let slen: i64 = str_len(s);
    let mut i: i64 = 0;
    let mut has_ws: i64 = 0;
    while i < slen {
        let c: i64 = str_char_at(s, i);
        if c == 32 || c == 9 || c == 10 || c == 13 { has_ws = 1; break; };
        i = i + 1;
    };
    if has_ws == 0 { return s; };
    let mut sb: i64 = sb_new();
    let mut j: i64 = 0;
    while j < slen {
        let c2: i64 = str_char_at(s, j);
        if c2 != 32 && c2 != 9 && c2 != 10 && c2 != 13 { sb_append(sb, str_substring(s, j, j + 1)); };
        j = j + 1;
    };
    return sb_to_str(sb);
}
fn type_is_unit(t: str) -> i64 {
    if str_starts_with(t, "unit<") == 1 { return 1; };
    return 0;
}
fn unit_dim(t: str) -> str {
    if type_is_unit(t) == 0 { return ""; };
    let slen: i64 = str_len(t);
    let mut i: i64 = 5;
    while i < slen && str_char_at(t, i) != 44 { i = i + 1; };
    if i >= slen { return ""; };
    return strip_spaces(str_substring(t, i + 1, slen - 1));
}
fn type_dynamic_helper(name: str) -> i64 {
    if str_eq(name, "tok_type") == 1 { return 1; };
    if str_eq(name, "tok_val") == 1 { return 1; };
    if str_eq(name, "node_field") == 1 { return 1; };
    if str_eq(name, "list_get") == 1 { return 1; };
    if str_eq(name, "vec_get") == 1 { return 1; };
    if str_eq(name, "sym_get") == 1 { return 1; };
    if str_eq(name, "sym_set") == 1 { return 1; };
    if str_eq(name, "smap_get") == 1 { return 1; };
    if str_eq(name, "smap_set") == 1 { return 1; };
    if str_eq(name, "tenv_get") == 1 { return 1; };
    if str_eq(name, "tenv_set") == 1 { return 1; };
    if str_eq(name, "pr") == 1 { return 1; };
    if str_eq(name, "pkv") == 1 { return 1; };
    if str_eq(name, "pr_pos") == 1 { return 1; };
    if str_eq(name, "pr_val") == 1 { return 1; };
    if str_eq(name, "mk2") == 1 { return 1; };
    if str_eq(name, "mk3") == 1 { return 1; };
    if str_eq(name, "mk4") == 1 { return 1; };
    if str_eq(name, "mk5") == 1 { return 1; };
    if str_eq(name, "mk6") == 1 { return 1; };
    if str_eq(name, "mk_list") == 1 { return 1; };
    if str_eq(name, "diag_get") == 1 { return 1; };
    if str_eq(name, "own_get_type") == 1 { return 1; };
    if str_eq(name, "own_set_type") == 1 { return 1; };
    if str_eq(name, "own_get_s") == 1 { return 1; };
    if str_eq(name, "sig_plist") == 1 { return 1; };
    if str_eq(name, "sig_add") == 1 { return 1; };
    if str_eq(name, "sig_rtype") == 1 { return 1; };
    if str_eq(name, "sig_is_extern") == 1 { return 1; };
    if str_eq(name, "ir_op") == 1 { return 1; };
    if str_eq(name, "ir_dest") == 1 { return 1; };
    if str_eq(name, "ir_op1") == 1 { return 1; };
    if str_eq(name, "ir_op2") == 1 { return 1; };
    if str_eq(name, "ir_extra") == 1 { return 1; };
    if str_eq(name, "ir_block_label") == 1 { return 1; };
    if str_eq(name, "ir_block_get_inst") == 1 { return 1; };
    if str_eq(name, "ir_fn_name") == 1 { return 1; };
    if str_eq(name, "ir_fn_param_count") == 1 { return 1; };
    if str_eq(name, "ir_fn_get_block") == 1 { return 1; };
    if str_eq(name, "lx_reg") == 1 { return 1; };
    if str_eq(name, "lx_blk") == 1 { return 1; };
    if str_eq(name, "ir_const_int") == 1 { return 1; };
    if str_starts_with(name, "json_") == 1 { return 1; };
    if str_starts_with(name, "map_") == 1 { return 1; };
    if str_starts_with(name, "vec_") == 1 { return 1; };
    if str_starts_with(name, "nuc_json_") == 1 { return 1; };
    if str_starts_with(name, "nuc_graph_") == 1 { return 1; };
    if str_starts_with(name, "nuc_bm25_") == 1 { return 1; };
    if str_starts_with(name, "nuc_hnsw_") == 1 { return 1; };
    if str_starts_with(name, "nuc_emb_") == 1 { return 1; };
    if str_starts_with(name, "nuc_sym_") == 1 { return 1; };
    if str_starts_with(name, "nuc_stat_") == 1 { return 1; };
    return 0;
}
fn type_stmt_value(pool: Vec<i32>, nid: i64) -> i64 {
    let kind: i64 = node_kind(pool, nid);
    if kind == 25 || kind == 22 { return node_field(pool, nid, 1); };
    return 0 - 1;
}
fn type_last_stmt(pool: Vec<i32>, prog: i64, lid: i64, env: Vec<i32>, sigs: Vec<i32>, structs: Vec<i32>, fn_name: str, diags: Vec<i32>, source: str, tprof: Vec<i32>) -> str {
    if lid < 0 || lid >= vec_len(pool) { return ""; };
    let cnt: i64 = list_len(pool, lid);
    if cnt == 0 { return ""; };
    let last_stmt: i64 = list_get(pool, lid, cnt - 1);
    let val: i64 = type_stmt_value(pool, last_stmt);
    if val >= 0 { return type_expr(pool, prog, val, env, sigs, structs, fn_name, diags, source, tprof); };
    if node_kind(pool, last_stmt) == 23 || node_kind(pool, last_stmt) == 52 { return type_expr(pool, prog, last_stmt, env, sigs, structs, fn_name, diags, source, tprof); };
    return "";
}
fn type_expr(pool: Vec<i32>, prog: i64, nid: i64, env: Vec<i32>, sigs: Vec<i32>, structs: Vec<i32>, fn_name: str, diags: Vec<i32>, source: str, tprof: Vec<i32>) -> str {
    if nid < 0 || nid >= vec_len(pool) { return ""; };
    let kind: i64 = node_kind(pool, nid);
    if kind == 1 { return "i32"; };
    if kind == 71 { return "f64"; };
    if kind == 72 { return "f64"; };
    if kind == 2 { return "str"; };
    if kind == 122 {
        // RFC-0016 phase 1: ? operator.
        // v0.4.54: NUC-FEEDBACK silent-segfault guard. Pre-fix
        // `let x: i64 = some_fn()?;` where some_fn returns bare i64
        // (not Result<T,E> or Option<T>) silently SIGSEGVed at runtime.
        // The `?` lower called `vec_get(val_r, 0)` to extract the tag,
        // dereferencing the i64 value as a pointer. Halt now with a
        // clear diagnostic naming the call.
        let qinner: i64 = node_field(pool, nid, 1);
        if node_kind(pool, qinner) == 7 {
            let qcallee: str = node_field(pool, qinner, 1);
            let qrtype: str = sig_rtype(sigs, qcallee);
            if str_len(qrtype) > 0 {
                let qbase: str = type_base_name(qrtype);
                let qok: i64 = if str_eq(qbase, "Result") == 1
                    || str_eq(qbase, "Option") == 1
                    || str_eq(qbase, "Vec") == 1 { 1 } else { 0 };
                if qok == 0 {
                    type_diag(diags, source, fn_name, qcallee, "TYP-011", str_concat("`?` operator requires receiver to return `Result<T,E>` or `Option<T>` (or the legacy untyped `Vec<i32>` stub) — `", str_concat(qcallee, str_concat("()` returns `", str_concat(qrtype, "`. Pre-v0.4.54 this silently SIGSEGVed at runtime. Workaround: change the fn signature to return Result/Option, or check the value explicitly with `if ... { return ...; }`.")))));
                };
            };
        };
        // v0.4.157: extend the v0.4.54 check to kind-3 (var-ref)
        // receivers. Pre-fix `let x: i64 = 5; let y = x?;` matched
        // only the kind-7 call branch above, so x's `?` lower
        // emitted the same `vec_get(val_r, 0)` tag-extract as the
        // pre-v0.4.54 era and SIGSEGVed at runtime when the i64
        // value was dereferenced as a pointer. Same TYP-011 family
        // as the kind-7 case; lookup goes through tenv (binding
        // type) instead of sigs (fn rtype).
        if node_kind(pool, qinner) == 3 {
            let qvname: str = node_field(pool, qinner, 1);
            let qvtype: str = tenv_get(env, qvname);
            if str_len(qvtype) > 0 {
                let qvbase: str = type_base_name(qvtype);
                let qvok: i64 = if str_eq(qvbase, "Result") == 1
                    || str_eq(qvbase, "Option") == 1
                    || str_eq(qvbase, "Vec") == 1 { 1 } else { 0 };
                if qvok == 0 {
                    type_diag(diags, source, fn_name, qvname, "TYP-011", str_concat("`?` operator on binding `", str_concat(qvname, str_concat("` of type `", str_concat(qvtype, "` — `?` requires `Result<T,E>` or `Option<T>`. Pre-v0.4.157 (kind-7 case caught in v0.4.54; kind-3 var-ref escaped) this silently lowered `vec_get(val_r, 0)` against the i64 cell and SIGSEGVed at runtime when the value was dereferenced as a pointer. Either change the binding's type to Result / Option, or check the value explicitly with `if ... { return ...; }`."))))));
                };
            };
        };
        let qfull: str = type_expr(pool, prog, qinner, env, sigs, structs, fn_name, diags, source, tprof);
        let qbase2: str = type_base_name(qfull);
        if str_eq(qbase2, "Result") == 1 || str_eq(qbase2, "Option") == 1 {
            let qpayload: str = type_first_arg(qfull);
            if str_len(qpayload) > 0 { return qpayload; };
        };
        return "i64";
    };
    if kind == 99 {
        // RFC-0015 phase 2: `as` cast. Fire NUM-003 (warning) when the
        // cast loses precision (target_width < source_width within the
        // same class). Returns "" (the legacy unknown-type marker) so
        // existing v0.1.x code that assigns a cast result to a wider
        // binding (e.g. `let x: i64 = small as u8;`) still type-checks
        // — strict cast typing flips on with the stdlib audit.
        let target_type: str = node_field(pool, nid, 2);
        let source_t: str = type_expr(pool, prog, node_field(pool, nid, 1), env, sigs, structs, fn_name, diags, source, tprof);
        let sw: i64 = type_width(source_t);
        let tw: i64 = type_width(target_type);
        let ss: i64 = type_signedness(source_t);
        let ts: i64 = type_signedness(target_type);
        if sw > 0 && tw > 0 && ss == ts && tw < sw {
            // v0.5 ship 7: span-aware caret. Use the cast nid's span
            // (set in parse_unary at the `as` token) when available;
            // fall back to the legacy fn-name scan otherwise. This
            // makes NUM-003 caret at the cast site instead of the
            // function declaration.
            let nloc: Vec<i32> = if node_get_span(pool, nid) >= 0 {
                let lm99: Vec<i32> = linemap_build(source);
                let sp99: i64 = node_get_span(pool, nid);
                let mut lc99: Vec<i32> = Vec::new();
                lc99.push(linemap_line(lm99, sp99));
                lc99.push(linemap_col(lm99, sp99));
                lc99
            } else {
                find_linecol_in_source(source, fn_name, fn_name)
            };
            // v0.4.216: dedupe NUM-003 by fn_name + line + col. type_expr
            // kind 99 runs multiple times for the same cast site when
            // the cast appears in fn-call argument position (once at
            // arg-typing, once at coercion check). Pre-fix `print_int(x
            // as i32)` for `x: i64` emitted 2 identical NUM-003 lines
            // with the same span. Adopters got noisy duplicate warnings
            // hiding other diagnostics. Linear scan over diags is OK
            // here because NUM-003 emit sites are rare (one per
            // narrowing cast in source).
            // Closes findings/inbox/2026-04-30-num-003-duplicate-warning-in-fnarg.md.
            let v216_line: i64 = vec_get(nloc, 0);
            let v216_col: i64 = vec_get(nloc, 1);
            let mut v216_dup: i64 = 0;
            let v216_dc: i64 = diag_count(diags);
            let mut v216_di: i64 = 0;
            while v216_di < v216_dc {
                let v216_d: Vec<i32> = diag_get(diags, v216_di);
                if str_eq(vec_get(v216_d, 2), "NUM-003") == 1
                    && str_eq(vec_get(v216_d, 4), fn_name) == 1
                    && vec_get(v216_d, 5) == v216_line
                    && vec_get(v216_d, 6) == v216_col {
                    v216_dup = 1;
                    v216_di = v216_dc;
                } else {
                    v216_di = v216_di + 1;
                };
            };
            if v216_dup == 0 {
                diag_add_ex(diags, "warning", "type", "NUM-003", str_concat("`as` cast loses precision: ", str_concat(source_t, str_concat(" (", str_concat(str_from_int(sw), str_concat("-bit) -> ", str_concat(target_type, str_concat(" (", str_concat(str_from_int(tw), "-bit)")))))))), fn_name, v216_line, v216_col, "");
            };
        };
        // v0.4.72 NOT enforcing `str as <numeric>` — Nucleor's
        // i64-everywhere ABI makes str pointers castable to i64 by
        // convention (used by intern/hash code in tools_suite + s1).
        // Rust errors here but Nucleor does not. Documented as a
        // Nucleor design choice, not a silent miscompute.
        // v0.4.143: NUM-023 — float / bool as-cast to `str`. Pre-fix
        // `let s: str = x as str` for `x: f64` lowered to a no-op
        // (the i64-cell holding the f64 bit pattern was reinterpreted
        // as a char ptr) and SIGSEGV'd at print time when the bit
        // pattern was dereferenced. Same hazard for bool — `true as
        // str` produced a str ptr equal to 1, segfault on print. The
        // i*/u* -> str direction stays allowed (the v0.4.72
        // i64-everywhere convention covers heap-pointer pun); only
        // f* and bool sources halt because their i64 cells are
        // never legitimate heap pointers.
        if str_eq(target_type, "str") == 1 && (type_is_float(source_t) == 1 || str_eq(source_t, "bool") == 1) {
            let v23a: str = str_concat("`", str_concat(source_t, "` cannot be `as`-cast to `str`."));
            let v23b: str = str_concat(" Pre-v0.4.143 `let s: str = x as str` for `x: ", str_concat(source_t, "` lowered to a no-op (the i64 cell holding the value was reinterpreted as a char ptr) and SIGSEGV'd at the next print/str operation when the bit pattern was dereferenced as a heap address."));
            let v23c: str = if type_is_float(source_t) == 1 { " Use `f64_to_str(x)` (or the matching narrow-float helper) to get a heap-allocated string of the value." } else { " Use `if b { \"true\" } else { \"false\" }` (or convert via `b as i64` then `int_to_str`) to get a heap-allocated string of the bool." };
            type_diag(diags, source, fn_name, fn_name, "NUM-023", str_concat(v23a, str_concat(v23b, v23c)));
        };
        // v0.4.47: NUC-FEEDBACK-002 silent-miscompute guard. Detect
        // `v[i] as <NarrowFloat>` where v: Vec<NarrowFloat>. The cell
        // holds the bit pattern of the float in an i64; `as` is a
        // numeric conversion (i64 → f32), not a bit-reinterpret, so
        // the result is wrong (e.g. bit pattern 0x3FC00000 = 1069547520
        // would cast to 1069547520.0_f32 instead of 1.5_f32). Tell
        // the adopter to use the explicit reinterpret surface.
        let src_nid: i64 = node_field(pool, nid, 1);
        let mut guard_v_nid: i64 = 0 - 1;
        let mut guard_call_name: str = "";
        if node_kind(pool, src_nid) == 10 {
            guard_v_nid = node_field(pool, src_nid, 1);
        };
        // v0.4.48: extend the guard to the fn-call form
        // `vec_get(v, i) as f32`, `vec_first(v) as f32`,
        // `vec_last(v) as f32`, `vec_pop(v) as f32`. Same hazard
        // as the `v[i] as f32` form caught in v0.4.47.
        if node_kind(pool, src_nid) == 7 {
            let cname: str = node_field(pool, src_nid, 1);
            let is_vec_read: i64 = if str_eq(cname, "vec_get") == 1
                || str_eq(cname, "vec_first") == 1
                || str_eq(cname, "vec_last") == 1
                || str_eq(cname, "vec_pop") == 1 { 1 } else { 0 };
            if is_vec_read == 1 {
                let cargs: i64 = node_field(pool, src_nid, 2);
                if list_len(pool, cargs) > 0 {
                    let first_arg: i64 = list_get(pool, cargs, 0);
                    if node_kind(pool, first_arg) == 3 {
                        guard_v_nid = first_arg;
                        guard_call_name = cname;
                    };
                };
            };
        };
        if guard_v_nid >= 0 && node_kind(pool, guard_v_nid) == 3 {
            let vname: str = node_field(pool, guard_v_nid, 1);
            let mut vt: str = tenv_get(env, vname);
            if str_len(vt) == 0 { vt = infer_var_type_from_source(source, vname); };
            let velt: str = strip_container_one_level(vt);
            if str_len(velt) > 0 {
                let mut hint: str = "";
                if str_eq(velt, "f32") == 1 && str_eq(target_type, "f32") == 1 {
                    hint = "f32_from_bits";
                };
                if str_eq(velt, "f16") == 1 && str_eq(target_type, "f32") == 1 {
                    hint = "f16_to_f32";
                };
                if str_eq(velt, "bf16") == 1 && str_eq(target_type, "f32") == 1 {
                    hint = "bf16_to_f32";
                };
                if str_eq(velt, "f8e4m3") == 1 && str_eq(target_type, "f32") == 1 {
                    hint = "f8e4m3_to_f32";
                };
                if str_eq(velt, "f8e5m2") == 1 && str_eq(target_type, "f32") == 1 {
                    hint = "f8e5m2_to_f32";
                };
                if str_len(hint) > 0 {
                    let mut surface: str = str_concat(vname, "[i]");
                    if str_len(guard_call_name) > 0 {
                        surface = str_concat(guard_call_name, str_concat("(", str_concat(vname, ", ...)")));
                    };
                    let part1: str = str_concat("`", str_concat(surface, str_concat(" as ", str_concat(target_type, "` numeric-casts the i64 cell holding the "))));
                    let part2: str = str_concat(velt, str_concat(" bit pattern; use ", str_concat(hint, str_concat("(", str_concat(surface, ") for bit-reinterpret")))));
                    // v0.5 ship 7: span-aware caret. The kind-99 cast nid
                    // carries the `as` token's byte offset (set in
                    // parse_unary), so this lands at the cast site.
                    diag_add_at_or_scan(diags, source, pool, nid, vname, "error", "type", "NUM-006", str_concat(part1, part2), fn_name, "");
                };
            };
        };
        return "";
    };
    if kind == 3 {
        let name: str = node_field(pool, nid, 1);
        if str_eq(name, "true") == 1 || str_eq(name, "false") == 1 { return "bool"; };
        let env_start: i64 = tprof_start(tprof);
        let out: str = tenv_get(env, name);
        tprof_mark(tprof, 3, 4, env_start);
        // v0.4.209 RFC-0015 phase 3a-step-3: width tagging moved from
        // type_expr (which doesn't reliably visit every var-ref —
        // kind-7 call args bypass it) to lower_stmt kind 20 (let),
        // keyed by alloca reg in fir's slot 4. AST node slot 2 is
        // unused now but kept for backward shape compatibility.
        // v0.4.138: TYP-022 — struct name used as a value. Pre-fix
        // `let e: E = E;` for `struct E { ... }` lowered the RHS as
        // a kind-3 var-ref to "E", emitting `ptrtoint ptr @E to i64`
        // — failed late at clang link with `error: use of undefined
        // value '@E'`. The v0.4.106 lift suppresses uppercase-leading
        // names from the TYP-005 surface (because most uppercase names
        // are legitimate type-prefixed mangled calls handled via kind
        // 12), so adopters got the raw clang error text pointing at
        // compiler-emitted IR rather than their source. Detect: name
        // is not in tenv AND matches a defined struct in the structs
        // table. Halt cleanly with the right hint.
        if str_len(out) == 0 && struct_find_type(pool, structs, name) >= 0 {
            let v22a: str = str_concat("`", str_concat(name, "` is a struct type, not a value. Pre-v0.4.138 a bare struct name in value position (e.g. `let e = E;`) lowered to `ptrtoint ptr @<Name> to i64` and failed late at clang link with `error: use of undefined value '@<Name>'`."));
            let v22b: str = str_concat(" Use struct-init syntax `", str_concat(name, " { field1: val1, field2: val2, ... }` to construct a value of this type, or call an inherent constructor `<Name>::new(...)` if one is defined."));
            type_diag(diags, source, fn_name, name, "TYP-022", str_concat(v22a, v22b));
        };
        return out;
    };
    if kind == 4 {
        let op: i64 = node_field(pool, nid, 1);
        let lt: str = type_expr(pool, prog, node_field(pool, nid, 2), env, sigs, structs, fn_name, diags, source, tprof);
        let rt: str = type_expr(pool, prog, node_field(pool, nid, 3), env, sigs, structs, fn_name, diags, source, tprof);
        // v0.4.132: TYP-020 — void-typed expression in arithmetic /
        // comparison binop. Pre-fix `5 + print_int(10)` silently
        // accepted print_int's void return as 0 — adopters who
        // confused side-effect-only fns with value-returning fns got
        // wrong results with no signal. Catches arithmetic (20/21/
        // 22/23/24) AND comparison (25/26/27/28/29/30/31/32) since
        // both presume value operands. Skips logical ops because
        // && / || already short-circuit. The void detection uses
        // the existing builtin_rtype "void" string + the
        // type_is_unit predicate.
        let lt_is_void: i64 = if str_eq(lt, "void") == 1 || type_is_unit(lt) == 1 { 1 } else { 0 };
        let rt_is_void: i64 = if str_eq(rt, "void") == 1 || type_is_unit(rt) == 1 { 1 } else { 0 };
        if (op == 20 || op == 21 || op == 22 || op == 23 || op == 24
            || op == 25 || op == 26 || op == 27 || op == 28 || op == 29
            || op == 30 || op == 31 || op == 32 || op == 33 || op == 34 || op == 35)
            && (lt_is_void == 1 || rt_is_void == 1) {
            let void_side: str = if lt_is_void == 1 { "left" } else { "right" };
            let v20msg: str = str_concat("`void`-typed expression on the ", str_concat(void_side, " side of binop. Pre-v0.4.132 the void return was silently coerced to 0 — adopters who confused side-effect-only fns (`print_int`, `print`, etc.) with value-returning fns got wrong arithmetic with no signal. Use the value-returning sibling fn (e.g. `int_to_str` instead of `print_int`) or split the side-effect into its own statement."));
            type_diag(diags, source, fn_name, fn_name, "TYP-020", v20msg);
        };
        // v0.4.137: NUM-022 — integer vs float cross in comparison binop.
        // Pre-fix `5 == 5.0` (i64 vs f64) silently compared the i64 bit
