        let gp_count_v529: i64 = list_len(pool, fn_gparams_v529);
        let mut current_gparam_v529: str = "";
        while gp_v529 < gp_count_v529 {
            let ge_v529: str = list_get(pool, fn_gparams_v529, gp_v529);
