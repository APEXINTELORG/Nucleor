    if str_eq(name, "vec_all_i64") { return "__nucleor_vec_all_i64"; };
    // Char predicates / transformations (RFC-0017 stdlib enrichment)
    if str_eq(name, "char_is_alpha") { return "__nucleor_char_is_alpha"; };
