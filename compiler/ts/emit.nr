        sb_append(sb, "declare { i8, i1 } @llvm.usub.with.overflow.i8(i8, i8)\n");
        sb_append(sb, "declare { i16, i1 } @llvm.usub.with.overflow.i16(i16, i16)\n");
        sb_append(sb, "declare { i32, i1 } @llvm.usub.with.overflow.i32(i32, i32)\n");
