# Build outputs
target/
.nuc_cache/
*.exe
*.dll
*.lib
*.obj
*.o
*.a
*.ll
*.bc
*.wasm
*.ptx

# Allow the shipped bootstrap binary
!bin/nucleor.exe

# T1.7 (v0.2.339): allow the cross-platform IR seed used by
# tools/bootstrap_linux.sh to produce bin/nucleor on fresh Linux/macOS
# hosts. See bootstrap/README.md for the refresh workflow.
!bootstrap/nucleor_s1_seed.ll

# Scratch binaries from self-host fixed-point checks. Chain commands
# of the form `nuc build ... -o bin/nucleor_vNNN.exe` should write to
# target/ instead, but the convention through v0.2.x left them in
# bin/. Excluded here so they never slip into a commit. Do NOT add
# a `!` exception for these. (See bin/README.md.)
bin/nucleor_v*.exe
bin/nucleor_tools.exe

# rust_bridge build artifacts
stdlib/rods/rust_bridge/target/
stdlib/rods/rust_bridge/Cargo.lock

# Editor/OS
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db

# Local logs and JSONL outputs
*.jsonl
*.log

# Test scratch
_verify_*.exe
_test_*.exe

# Linux-native bootstrap binary — reproducible from bootstrap/nucleor_s1_seed.ll
# via tools/bootstrap_linux.sh. Not committed; bin/nucleor.exe is the canonical
# cross-platform bootstrap binary per NUCLEOR_BOOTSTRAP_CONTRACT.md.
bin/nucleor

# Windows null-redirect artifact (2>NUL creates a literal file on POSIX)
NUL

# Operational verify-gate timing data — regenerates per run; the
# recipe in tools/VERIFY_TIMING_RECIPE.md is the contract, the CSV
# is rolling local-machine output that bloats history if committed.
tools/verify_timings.csv
# v0.5.19: per-agent CSV namespacing (NUC_VERIFY_AGENT=<name>) means
# each agent writes its own tools/verify_timings.<name>.csv. Same
# rolling-output rationale — don't track per-agent timing logs.
tools/verify_timings.*.csv

# Bootstrap iteration scratch (3-iter fixed-point check artifacts)
out_v*.txt
err_v*.txt
