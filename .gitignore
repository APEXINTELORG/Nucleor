# Build outputs
target/
.nuc_cache/
.nuc_rt_cache/
*.exe
*.dll
*.lib
*.obj
*.o
*.a
*.ll
*.bc
*.wasm
*.ptx

# Allow the shipped bootstrap binary
!bin/nucleor.exe

# Allow the cross-platform IR seed used by tools/bootstrap_linux.sh to
# produce bin/nucleor on fresh Linux hosts.
!bootstrap/nucleor_s1_seed.ll

# Scratch binaries from self-host fixed-point checks. Chain commands
# of the form `nuc build ... -o bin/nucleor_vNNN.exe` should write to
# target/ instead. Excluded here so they never slip into a commit. Do
# NOT add a `!` exception for these.
bin/nucleor_v*.exe
bin/nucleor_tools.exe

# rust_bridge build artifacts
stdlib/rods/rust_bridge/target/
stdlib/rods/rust_bridge/Cargo.lock

# Editor/OS
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db

# Local logs and JSONL outputs
*.jsonl
*.log

# Test scratch
_verify_*.exe
_test_*.exe

# Linux-native bootstrap binary — reproducible from bootstrap/nucleor_s1_seed.ll
# via tools/bootstrap_linux.sh. Not committed; bin/nucleor.exe plus the
# bootstrap seed are the canonical public bootstrap artifacts.
bin/nucleor
# Linux-native tools-suite binary (symmetric counterpart to
# bin/nucleor_tools.exe above). Reproducible via
# `./bin/nucleor build compiler/nucleor_tools_suite.nr -o nucleor_tools`
# and staged into bin/ so the in-process resolver finds it.
bin/nucleor_tools

# Windows null-redirect artifact (2>NUL creates a literal file on POSIX)
NUL

# Operational verify-gate timing data — regenerates per run; the
# recipe in tools/VERIFY_TIMING_RECIPE.md is the contract, the CSV
# is rolling local-machine output that bloats history if committed.
tools/verify_timings.csv
# Per-agent CSV namespacing (NUC_VERIFY_AGENT=<name>) means each agent
# writes its own tools/verify_timings.<name>.csv. Same rolling-output
# rationale: do not track per-agent timing logs.
tools/verify_timings.*.csv
tools/memory_drift_profile.csv

# Bootstrap iteration scratch (3-iter fixed-point check artifacts)
out_v*.txt
err_v*.txt
audit_scratch_*/
